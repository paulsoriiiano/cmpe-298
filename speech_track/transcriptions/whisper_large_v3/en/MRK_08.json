, "avg_logprob": -0.26543775927118896, "compression_ratio": 1.748898678414097, "no_speech_prob": 0.04692654311656952}, {"id": 46, "seek": 14618, "start": 149.26000000000002, "end": 150.54000000000002, "text": " And they said to him,", "tokens": [50519, 400, 436, 848, 281, 796, 11, 50583], "temperature": 0.0, "avg_logprob": -0.26543775927118896, "compression_ratio": 1.748898678414097, "no_speech_prob": 0.04692654311656952}, {"id": 47, "seek": 14618, "start": 151.20000000000002, "end": 151.84, "text": " Seven.", "tokens": [50616, 14868, 13, 50648], "temperature": 0.0, "avg_logprob": -0.26543775927118896, "compression_ratio": 1.748898678414097, "no_speech_prob": 0.04692654311656952}, {"id": 48, "seek": 14618, "start": 152.52, "end": 153.82, "text": " And he said to them,", "tokens": [50682, 400, 415, 848, 281, 552, 11, 50747], "temperature": 0.0, "avg_logprob": -0.26543775927118896, "compression_ratio": 1.748898678414097, "no_speech_prob": 0.04692654311656952}, {"id": 49, "seek": 14618, "start": 154.54000000000002, "end": 156.64000000000001, "text": " Do you not yet understand?", "tokens": [50783, 1144, 291, 406, 1939, 1223, 30, 50888], "temperature": 0.0, "avg_logprob": -0.26543775927118896, "compression_ratio": 1.748898678414097, "no_speech_prob": 0.04692654311656952}, {"id": 50, "seek": 14618, "start": 158.48000000000002, "end": 160.26000000000002, "text": " And they came to Bethsaida,", "tokens": [50980, 400, 436, 1361, 281, 14011, 5790, 2887, 11, 51069], "temperature": 0.0, "avg_logprob": -0.26543775927118896, "compression_ratio": 1.748898678414097, "no_speech_prob": 0.04692654311656952}, {"id": 51, "seek": 14618, "start": 160.6, "end": 164.70000000000002, "text": " and some people brought to him a blind man and begged him to touch him.", "tokens": [51086, 293, 512, 561, 3038, 281, 796, 257, 6865, 587, 293, 47653, 796, 281, 2557, 796, 13, 51291], "temperature": 0.0, "avg_logprob": -0.26543775927118896, "compression_ratio": 1.748898678414097, "no_speech_prob": 0.04692654311656952}, {"id": 52, "seek": 14618, "start": 165.3, "end": 168.74, "text": " And he took the blind man by the hand and led him out of the village.", "tokens": [51321, 400, 415, 1890, 264, 6865, 587, 538, 264, 1011, 293, 4684, 796, 484, 295, 264, 7288, 13, 51493], "temperature": 0.0, "avg_logprob": -0.26543775927118896, "compression_ratio": 1.748898678414097, "no_speech_prob": 0.04692654311656952}, {"id": 53, "seek": 14618, "start": 169.08, "end": 173.08, "text": " And when he had spit on his eyes and laid his hands on him, he asked him,", "tokens": [51510, 400, 562, 415, 632, 22127, 322, 702, 2575, 293, 9897, 702, 2377, 322, 796, 11, 415, 2351, 796, 11, 51710], "temperature": 0.0, "avg_logprob": -0.26543775927118896, "compression_ratio": 1.748898678414097, "no_speech_prob": 0.04692654311656952}, {"id": 54, "seek": 14618, "start": 173.44, "end": 175.22, "text": " Do you see anything?", "tokens": [51728, 1144, 291, 536, 1340, 30, 51817], "temperature": 0.0, "avg_logprob": -0.26543775927118896, "compression_ratio": 1.748898678414097, "no_speech_prob": 0.04692654311656952}, {"id": 55, "seek": 17522, "start": 175.22, "end": 177.8, "text": " And he looked up and said,", "tokens": [50365, 400, 415, 2956, 493, 293, 848, 11, 50494], "temperature": 0.0, "avg_logprob": -0.18144096212184174, "compression_ratio": 1.6018957345971565, "no_speech_prob": 0.0017541757551953197}, {"id": 56, "seek": 17522, "start": 178.56, "end": 185.1, "text": " I see men, but they look like trees walking.", "tokens": [50532, 286, 536, 1706, 11, 457, 436, 574, 411, 5852, 4494, 13, 50859], "temperature": 0.0, "avg_logprob": -0.18144096212184174, "compression_ratio": 1.6018957345971565, "no_speech_prob": 0.0017541757551953197}, {"id": 57, "seek": 17522, "start": 186.06, "end": 190.44, "text": " Then Jesus laid his hands on his eyes again, and he opened his eyes,", "tokens": [50907, 1396, 2705, 9897, 702, 2377, 322, 702, 2575, 797, 11, 293, 415, 5625, 702, 2575, 11, 51126], "temperature": 0.0, "avg_logprob": -0.18144096212184174, "compression_ratio": 1.6018957345971565, "no_speech_prob": 0.0017541757551953197}, {"id": 58, "seek": 17522, "start": 190.54, "end": 193.57999999999998, "text": " his sight was restored, and he saw everything clearly.", "tokens": [51131, 702, 7860, 390, 23143, 11, 293, 415, 1866, 1203, 4448, 13, 51283], "temperature": 0.0, "avg_logprob": -0.18144096212184174, "compression_ratio": 1.6018957345971565, "no_speech_prob": 0.0017541757551953197}, {"id": 59, "seek": 17522, "start": 194.07999999999998, "end": 196.16, "text": " And he sent him to his home, saying,", "tokens": [51308, 400, 415, 2279, 796, 281, 702, 1280, 11, 1566, 11, 51412], "temperature": 0.0, "avg_logprob": -0.18144096212184174, "compression_ratio": 1.6018957345971565, "no_speech_prob": 0.0017541757551953197}, {"id": 60, "seek": 17522, "start": 196.88, "end": 198.68, "text": " Do not even enter the village.", "tokens": [51448, 1144, 406, 754, 3242, 264, 7288, 13, 51538], "temperature": 0.0, "avg_logprob": -0.18144096212184174, "compression_ratio": 1.6018957345971565, "no_speech_prob": 0.0017541757551953197}, {"id": 61, "seek": 17522, "start": 200.34, "end": 204.92, "text": " And Jesus went on with his disciples to the villages of Caesarea Philippi,", "tokens": [51621, 400, 2705, 1437, 322, 365, 702, 17209, 281, 264, 20444, 295, 7544, 279, 35425, 13694, 72, 11, 51850], "temperature": 0.0, "avg_logprob": -0.18144096212184174, "compression_ratio": 1.6018957345971565, "no_speech_prob": 0.0017541757551953197}, {"id": 62, "seek": 20522, "start": 205.22, "end": 207.78, "text": " and on the way he asked his disciples,", "tokens": [50365, 293, 322, 264, 636, 415, 2351, 702, 17209, 11, 50493], "temperature": 0.0, "avg_logprob": -0.2756723766484536, "compression_ratio": 1.6791666666666667, "no_speech_prob": 0.002082480350509286}, {"id": 63, "seek": 20522, "start": 208.66, "end": 210.72, "text": " Who do people say that I am?", "tokens": [50537, 2102, 360, 561, 584, 300, 286, 669, 30, 50640], "temperature": 0.0, "avg_logprob": -0.2756723766484536, "compression_ratio": 1.6791666666666667, "no_speech_prob": 0.002082480350509286}, {"id": 64, "seek": 20522, "start": 211.24, "end": 212.5, "text": " And they told him,", "tokens": [50666, 400, 436, 1907, 796, 11, 50729], "temperature": 0.0, "avg_logprob": -0.2756723766484536, "compression_ratio": 1.6791666666666667, "no_speech_prob": 0.002082480350509286}, {"id": 65, "seek": 20522, "start": 213.18, "end": 215.06, "text": " John the Baptist, and others say Elijah,", "tokens": [50763, 2619, 264, 32410, 11, 293, 2357, 584, 36147, 11, 50857], "temperature": 0.0, "avg_logprob": -0.2756723766484536, "compression_ratio": 1.6791666666666667, "no_speech_prob": 0.002082480350509286}, {"id": 66, "seek": 20522, "start": 215.62, "end": 217.28, "text": " and others one of the prophets.", "tokens": [50885, 293, 2357, 472, 295, 264, 27297, 13, 50968], "temperature": 0.0, "avg_logprob": -0.2756723766484536, "compression_ratio": 1.6791666666666667, "no_speech_prob": 0.002082480350509286}, {"id": 67, "seek": 20522, "start": 218.12, "end": 219.14, "text": " And he asked them,", "tokens": [51010, 400, 415, 2351, 552, 11, 51061], "temperature": 0.0, "avg_logprob": -0.2756723766484536, "compression_ratio": 1.6791666666666667, "no_speech_prob": 0.002082480350509286}, {"id": 68, "seek": 20522, "start": 219.76, "end": 221.72, "text": " But who do you say that I am?", "tokens": [51092, 583, 567, 360, 291, 584, 300, 286, 669, 30, 51190], "temperature": 0.0, "avg_logprob": -0.2756723766484536, "compression_ratio": 1.6791666666666667, "no_speech_prob": 0.002082480350509286}, {"id": 69, "seek": 20522, "start": 222.3, "end": 223.48, "text": " Peter answered him,", "tokens": [51219, 6508, 10103, 796, 11, 51278], "temperature": 0.0, "avg_logprob": -0.2756723766484536, "compression_ratio": 1.6791666666666667, "no_speech_prob": 0.002082480350509286}, {"id": 70, "seek": 20522, "start": 224.16, "end": 225.44, "text": " You are the Christ.", "tokens": [51312, 509, 366, 264, 2040, 13, 51376], "temperature": 0.0, "avg_logprob": -0.2756723766484536, "compression_ratio": 1.6791666666666667, "no_speech_prob": 0.002082480350509286}, {"id": 71, "seek": 20522, "start": 226.06, "end": 229.44, "text": " And he strictly charged them to tell no one about him,", "tokens": [51407, 400, 415, 20792, 11109, 552, 281, 980, 572, 472, 466, 796, 11, 51576], "temperature": 0.0, "avg_logprob": -0.2756723766484536, "compression_ratio": 1.6791666666666667, "no_speech_prob": 0.002082480350509286}, {"id": 72, "seek": 20522, "start": 229.66, "end": 233.76, "text": " and he began to teach them that the Son of Man must suffer many things", "tokens": [51587, 293, 415, 4283, 281, 2924, 552, 300, 264, 5185, 295, 2458, 1633, 9753, 867, 721, 51792], "temperature": 0.0, "avg_logprob": -0.2756723766484536, "compression_ratio": 1.6791666666666667, "no_speech_prob": 0.002082480350509286}, {"id": 73, "seek": 20522, "start": 233.76, "end": 235.2, "text": " and be rejected by the Lord.", "tokens": [51792, 293, 312, 15749, 538, 264, 3257, 13, 51864], "temperature": 0.0, "avg_logprob": -0.2756723766484536, "compression_ratio": 1.6791666666666667, "no_speech_prob": 0.002082480350509286}, {"id": 74, "seek": 23520, "start": 235.2, "end": 235.7, "text": " And he said to them,", "tokens": [50365, 400, 415, 848, 281, 552, 11, 50390], "temperature": 0.0, "avg_logprob": -0.24790205372323235, "compression_ratio": 1.818867924528302, "no_speech_prob": 0.005552976857870817}, {"id": 75, "seek": 23520, "start": 235.7, "end": 237.73999999999998, "text": " I will be rejected by the elders and the chief priests and the scribes,", "tokens": [50390, 286, 486, 312, 15749, 538, 264, 22737, 293, 264, 9588, 27192, 293, 264, 39435, 279, 11, 50492], "temperature": 0.0, "avg_logprob": -0.24790205372323235, "compression_ratio": 1.818867924528302, "no_speech_prob": 0.005552976857870817}, {"id": 76, "seek": 23520, "start": 238.1, "end": 241.42, "text": " and be killed, and after three days rise again.", "tokens": [50510, 293, 312, 4652, 11, 293, 934, 1045, 1708, 6272, 797, 13, 50676], "temperature": 0.0, "avg_logprob": -0.24790205372323235, "compression_ratio": 1.818867924528302, "no_speech_prob": 0.005552976857870817}, {"id": 77, "seek": 23520, "start": 241.92, "end": 243.56, "text": " And he said this plainly.", "tokens": [50701, 400, 415, 848, 341, 11121, 356, 13, 50783], "temperature": 0.0, "avg_logprob": -0.24790205372323235, "compression_ratio": 1.818867924528302, "no_speech_prob": 0.005552976857870817}, {"id": 78, "seek": 23520, "start": 243.98, "end": 246.54, "text": " And Peter took him aside and began to rebuke him.", "tokens": [50804, 400, 6508, 1890, 796, 7359, 293, 4283, 281, 319, 6021, 330, 796, 13, 50932], "temperature": 0.0, "avg_logprob": -0.24790205372323235, "compression_ratio": 1.818867924528302, "no_speech_prob": 0.005552976857870817}, {"id": 79, "seek": 23520, "start": 247.0, "end": 250.85999999999999, "text": " But turning and seeing his disciples, he rebuked Peter and said,", "tokens": [50955, 583, 6246, 293, 2577, 702, 17209, 11, 415, 12970, 2034, 292, 6508, 293, 848, 11, 51148], "temperature": 0.0, "avg_logprob": -0.24790205372323235, "compression_ratio": 1.818867924528302, "no_speech_prob": 0.005552976857870817}, {"id": 80, "seek": 23520, "start": 251.66, "end": 253.72, "text": " Get behind me, Satan,", "tokens": [51188, 3240, 2261, 385, 11, 16583, 11, 51291], "temperature": 0.0, "avg_logprob": -0.24790205372323235, "compression_ratio": 1.818867924528302, "no_speech_prob": 0.005552976857870817}, {"id": 81, "seek": 23520, "start": 254.32, "end": 256.71999999999997, "text": " for you are not setting your mind on the things of God,", "tokens": [51321, 337, 291, 366, 406, 3287, 428, 1575, 322, 264, 721, 295, 1265, 11, 51441], "temperature": 0.0, "avg_logprob": -0.24790205372323235, "compression_ratio": 1.818867924528302, "no_speech_prob": 0.005552976857870817}, {"id": 82, "seek": 23520, "start": 257.03999999999996, "end": 258.53999999999996, "text": " but on the things of man.", "tokens": [51457, 457, 322, 264, 721, 295, 587, 13, 51532], "temperature": 0.0, "avg_logprob": -0.24790205372323235, "compression_ratio": 1.818867924528302, "no_speech_prob": 0.005552976857870817}, {"id": 83, "seek": 23520, "start": 259.03999999999996, "end": 262.46, "text": " And calling the crowd to him with his disciples, he said to them,", "tokens": [51557, 400, 5141, 264, 6919, 281, 796, 365, 702, 17209, 11, 415, 848, 281, 552, 11, 51728], "temperature": 0.0, "avg_logprob": -0.24790205372323235, "compression_ratio": 1.818867924528302, "no_speech_prob": 0.005552976857870817}, {"id": 84, "seek": 23520, "start": 262.96, "end": 265.09999999999997, "text": " If anyone would come after me,", "tokens": [51753, 759, 2878, 576, 808, 934, 385, 11, 51860], "temperature": 0.0, "avg_logprob": -0.24790205372323235, "compression_ratio": 1.818867924528302, "no_speech_prob": 0.005552976857870817}, {"id": 85, "seek": 26520, "start": 265.2, "end": 268.96, "text": " let him deny himself and take up his cross and follow me.", "tokens": [50365, 718, 796, 15744, 3647, 293, 747, 493, 702, 3278, 293, 1524, 385, 13, 50553], "temperature": 0.0, "avg_logprob": -0.18715866825036837, "compression_ratio": 1.786610878661088, "no_speech_prob": 0.0026519582606852055}, {"id": 86, "seek": 26520, "start": 269.78, "end": 272.58, "text": " For whoever would save his life will lose it.", "tokens": [50594, 1171, 11387, 576, 3155, 702, 993, 486, 3624, 309, 13, 50734], "temperature": 0.0, "avg_logprob": -0.18715866825036837, "compression_ratio": 1.786610878661088, "no_speech_prob": 0.0026519582606852055}, {"id": 87, "seek": 26520, "start": 273.03999999999996, "end": 277.42, "text": " But whoever loses his life for my sake and the gospels will save it.", "tokens": [50757, 583, 11387, 18293, 702, 993, 337, 452, 9717, 293, 264, 37250, 1625, 486, 3155, 309, 13, 50976], "temperature": 0.0, "avg_logprob": -0.18715866825036837, "compression_ratio": 1.786610878661088, "no_speech_prob": 0.0026519582606852055}, {"id": 88, "seek": 26520, "start": 278.08, "end": 282.88, "text": " For what does it profit a man to gain the whole world and forfeit his soul?", "tokens": [51009, 1171, 437, 775, 309, 7475, 257, 587, 281, 6052, 264, 1379, 1002, 293, 337, 37434, 702, 5133, 30, 51249], "temperature": 0.0, "avg_logprob": -0.18715866825036837, "compression_ratio": 1.786610878661088, "no_speech_prob": 0.0026519582606852055}, {"id": 89, "seek": 26520, "start": 283.38, "end": 286.14, "text": " For what can a man give in return for his soul?", "tokens": [51274, 1171, 437, 393, 257, 587, 976, 294, 2736, 337, 702, 5133, 30, 51412], "temperature": 0.0, "avg_logprob": -0.18715866825036837, "compression_ratio": 1.786610878661088, "no_speech_prob": 0.0026519582606852055}, {"id": 90, "seek": 26520, "start": 286.7, "end": 292.4, "text": " For whoever is ashamed of me and of my words in this adulterous and sinful generation,", "tokens": [51440, 1171, 11387, 307, 19489, 295, 385, 293, 295, 452, 2283, 294, 341, 26885, 391, 563, 293, 41861, 5125, 11, 51725], "temperature": 0.0, "avg_logprob": -0.18715866825036837, "compression_ratio": 1.786610878661088, "no_speech_prob": 0.0026519582606852055}, {"id": 91, "seek": 26520, "start": 292.64, "end": 295.18, "text": " of him will the Son of Man also be ashamed,", "tokens": [51737, 295, 796, 486, 264, 5185, 295, 2458, 611, 312, 19489, 11, 51864], "temperature": 0.0, "avg_logprob": -0.18715866825036837, "compression_ratio": 1.786610878661088, "no_speech_prob": 0.0026519582606852055}, {"id": 92, "seek": 29520, "start": 295.2, "end": 299.26, "text": " when he comes in the glory of his Father with the holy angels.", "tokens": [50380, 562, 415, 1487, 294, 264, 11924, 295, 702, 7085, 365, 264, 10622, 18175, 13, 50568], "temperature": 0.0, "avg_logprob": -0.280796303468592, "compression_ratio": 0.96875, "no_speech_prob": 0.014834764413535595}], "language": "English"}