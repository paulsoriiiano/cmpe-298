2162162162, "no_speech_prob": 1.020941181195667e-05}, {"id": 48, "seek": 17698, "start": 195.94, "end": 198.35999999999999, "text": " so that they questioned among themselves, saying,", "tokens": [51313, 370, 300, 436, 28146, 3654, 2969, 11, 1566, 11, 51434], "temperature": 0.0, "avg_logprob": -0.2057558298110962, "compression_ratio": 1.662162162162162, "no_speech_prob": 1.020941181195667e-05}, {"id": 49, "seek": 17698, "start": 198.89999999999998, "end": 201.78, "text": " What is this, a new teaching with authority?", "tokens": [51461, 708, 307, 341, 11, 257, 777, 4571, 365, 8281, 30, 51605], "temperature": 0.0, "avg_logprob": -0.2057558298110962, "compression_ratio": 1.662162162162162, "no_speech_prob": 1.020941181195667e-05}, {"id": 50, "seek": 17698, "start": 202.54, "end": 205.0, "text": " He commands even the unclean spirits,", "tokens": [51643, 634, 16901, 754, 264, 9153, 282, 16388, 11, 51766], "temperature": 0.0, "avg_logprob": -0.2057558298110962, "compression_ratio": 1.662162162162162, "no_speech_prob": 1.020941181195667e-05}, {"id": 51, "seek": 17698, "start": 205.0, "end": 206.95999999999998, "text": " and they obey him.", "tokens": [51766, 293, 436, 19297, 796, 13, 51864], "temperature": 0.0, "avg_logprob": -0.2057558298110962, "compression_ratio": 1.662162162162162, "no_speech_prob": 1.020941181195667e-05}, {"id": 52, "seek": 20698, "start": 207.73999999999998, "end": 210.17999999999998, "text": " And at once his fame spread everywhere", "tokens": [50403, 400, 412, 1564, 702, 16874, 3974, 5315, 50525], "temperature": 0.0, "avg_logprob": -0.15830146975633574, "compression_ratio": 1.6691449814126393, "no_speech_prob": 0.17091399431228638}, {"id": 53, "seek": 20698, "start": 210.17999999999998, "end": 212.79999999999998, "text": " throughout all the surrounding region of Galilee.", "tokens": [50525, 3710, 439, 264, 11498, 4458, 295, 7336, 33914, 13, 50656], "temperature": 0.0, "avg_logprob": -0.15830146975633574, "compression_ratio": 1.6691449814126393, "no_speech_prob": 0.17091399431228638}, {"id": 54, "seek": 20698, "start": 213.94, "end": 215.82, "text": " And immediately he left the synagogue", "tokens": [50713, 400, 4258, 415, 1411, 264, 49169, 50807], "temperature": 0.0, "avg_logprob": -0.15830146975633574, "compression_ratio": 1.6691449814126393, "no_speech_prob": 0.17091399431228638}, {"id": 55, "seek": 20698, "start": 215.82, "end": 218.23999999999998, "text": " and entered the house of Simon and Andrew", "tokens": [50807, 293, 9065, 264, 1782, 295, 13193, 293, 10110, 50928], "temperature": 0.0, "avg_logprob": -0.15830146975633574, "compression_ratio": 1.6691449814126393, "no_speech_prob": 0.17091399431228638}, {"id": 56, "seek": 20698, "start": 218.23999999999998, "end": 219.44, "text": " with James and John.", "tokens": [50928, 365, 5678, 293, 2619, 13, 50988], "temperature": 0.0, "avg_logprob": -0.15830146975633574, "compression_ratio": 1.6691449814126393, "no_speech_prob": 0.17091399431228638}, {"id": 57, "seek": 20698, "start": 220.2, "end": 222.84, "text": " Now Simon's mother-in-law lay ill with a fever,", "tokens": [51026, 823, 13193, 311, 2895, 12, 259, 12, 5901, 2360, 3171, 365, 257, 18277, 11, 51158], "temperature": 0.0, "avg_logprob": -0.15830146975633574, "compression_ratio": 1.6691449814126393, "no_speech_prob": 0.17091399431228638}, {"id": 58, "seek": 20698, "start": 223.06, "end": 225.12, "text": " and immediately they told him about her.", "tokens": [51169, 293, 4258, 436, 1907, 796, 466, 720, 13, 51272], "temperature": 0.0, "avg_logprob": -0.15830146975633574, "compression_ratio": 1.6691449814126393, "no_speech_prob": 0.17091399431228638}, {"id": 59, "seek": 20698, "start": 225.45999999999998, "end": 227.67999999999998, "text": " And he came and took her by the hand", "tokens": [51289, 400, 415, 1361, 293, 1890, 720, 538, 264, 1011, 51400], "temperature": 0.0, "avg_logprob": -0.15830146975633574, "compression_ratio": 1.6691449814126393, "no_speech_prob": 0.17091399431228638}, {"id": 60, "seek": 20698, "start": 227.67999999999998, "end": 230.22, "text": " and lifted her up, and the fever left her,", "tokens": [51400, 293, 17854, 720, 493, 11, 293, 264, 18277, 1411, 720, 11, 51527], "temperature": 0.0, "avg_logprob": -0.15830146975633574, "compression_ratio": 1.6691449814126393, "no_speech_prob": 0.17091399431228638}, {"id": 61, "seek": 20698, "start": 230.48, "end": 231.85999999999999, "text": " and she began to serve them.", "tokens": [51540, 293, 750, 4283, 281, 4596, 552, 13, 51609], "temperature": 0.0, "avg_logprob": -0.15830146975633574, "compression_ratio": 1.6691449814126393, "no_speech_prob": 0.17091399431228638}, {"id": 62, "seek": 20698, "start": 232.72, "end": 234.23999999999998, "text": " That evening at sundown", "tokens": [51652, 663, 5634, 412, 33047, 648, 51728], "temperature": 0.0, "avg_logprob": -0.15830146975633574, "compression_ratio": 1.6691449814126393, "no_speech_prob": 0.17091399431228638}, {"id": 63, "seek": 20698, "start": 234.23999999999998, "end": 236.01999999999998, "text": " they brought to him all who were sick", "tokens": [51728, 436, 3038, 281, 796, 439, 567, 645, 4998, 51817], "temperature": 0.0, "avg_logprob": -0.15830146975633574, "compression_ratio": 1.6691449814126393, "no_speech_prob": 0.17091399431228638}, {"id": 64, "seek": 23602, "start": 236.02, "end": 237.26000000000002, "text": " or oppressed by demons.", "tokens": [50365, 420, 39640, 538, 19733, 13, 50427], "temperature": 0.0, "avg_logprob": -0.18880367279052734, "compression_ratio": 1.7768924302788844, "no_speech_prob": 0.0014320226619020104}, {"id": 65, "seek": 23602, "start": 237.66, "end": 240.54000000000002, "text": " And the whole city was gathered together at the door.", "tokens": [50447, 400, 264, 1379, 2307, 390, 13032, 1214, 412, 264, 2853, 13, 50591], "temperature": 0.0, "avg_logprob": -0.18880367279052734, "compression_ratio": 1.7768924302788844, "no_speech_prob": 0.0014320226619020104}, {"id": 66, "seek": 23602, "start": 240.84, "end": 243.46, "text": " And he healed many who were sick with various diseases", "tokens": [50606, 400, 415, 20482, 867, 567, 645, 4998, 365, 3683, 11044, 50737], "temperature": 0.0, "avg_logprob": -0.18880367279052734, "compression_ratio": 1.7768924302788844, "no_speech_prob": 0.0014320226619020104}, {"id": 67, "seek": 23602, "start": 243.46, "end": 245.20000000000002, "text": " and cast out many demons.", "tokens": [50737, 293, 4193, 484, 867, 19733, 13, 50824], "temperature": 0.0, "avg_logprob": -0.18880367279052734, "compression_ratio": 1.7768924302788844, "no_speech_prob": 0.0014320226619020104}, {"id": 68, "seek": 23602, "start": 246.02, "end": 248.64000000000001, "text": " And he would not permit the demons to speak", "tokens": [50865, 400, 415, 576, 406, 13423, 264, 19733, 281, 1710, 50996], "temperature": 0.0, "avg_logprob": -0.18880367279052734, "compression_ratio": 1.7768924302788844, "no_speech_prob": 0.0014320226619020104}, {"id": 69, "seek": 23602, "start": 248.64000000000001, "end": 249.96, "text": " because they knew him.", "tokens": [50996, 570, 436, 2586, 796, 13, 51062], "temperature": 0.0, "avg_logprob": -0.18880367279052734, "compression_ratio": 1.7768924302788844, "no_speech_prob": 0.0014320226619020104}, {"id": 70, "seek": 23602, "start": 251.64000000000001, "end": 253.88, "text": " And rising very early in the morning", "tokens": [51146, 400, 11636, 588, 2440, 294, 264, 2446, 51258], "temperature": 0.0, "avg_logprob": -0.18880367279052734, "compression_ratio": 1.7768924302788844, "no_speech_prob": 0.0014320226619020104}, {"id": 71, "seek": 23602, "start": 253.88, "end": 255.22, "text": " while it was still dark,", "tokens": [51258, 1339, 309, 390, 920, 2877, 11, 51325], "temperature": 0.0, "avg_logprob": -0.18880367279052734, "compression_ratio": 1.7768924302788844, "no_speech_prob": 0.0014320226619020104}, {"id": 72, "seek": 23602, "start": 255.60000000000002, "end": 258.06, "text": " he departed and went out to a desolate place,", "tokens": [51344, 415, 47018, 293, 1437, 484, 281, 257, 730, 48278, 1081, 11, 51467], "temperature": 0.0, "avg_logprob": -0.18880367279052734, "compression_ratio": 1.7768924302788844, "no_speech_prob": 0.0014320226619020104}, {"id": 73, "seek": 23602, "start": 258.26, "end": 259.44, "text": " and there he prayed.", "tokens": [51477, 293, 456, 415, 22532, 13, 51536], "temperature": 0.0, "avg_logprob": -0.18880367279052734, "compression_ratio": 1.7768924302788844, "no_speech_prob": 0.0014320226619020104}, {"id": 74, "seek": 23602, "start": 260.34000000000003, "end": 262.78000000000003, "text": " And Simon and those who were with him searched for him,", "tokens": [51581, 400, 13193, 293, 729, 567, 645, 365, 796, 22961, 337, 796, 11, 51703], "temperature": 0.0, "avg_logprob": -0.18880367279052734, "compression_ratio": 1.7768924302788844, "no_speech_prob": 0.0014320226619020104}, {"id": 75, "seek": 23602, "start": 262.78000000000003, "end": 264.48, "text": " and they found him and said to him,", "tokens": [51703, 293, 436, 1352, 796, 293, 848, 281, 796, 11, 51788], "temperature": 0.0, "avg_logprob": -0.18880367279052734, "compression_ratio": 1.7768924302788844, "no_speech_prob": 0.0014320226619020104}, {"id": 76, "seek": 26448, "start": 264.48, "end": 268.64000000000004, "text": " And he said to them,", "tokens": [50365, 400, 415, 848, 281, 552, 11, 50573], "temperature": 0.0, "avg_logprob": -0.19724624697901622, "compression_ratio": 1.6578947368421053, "no_speech_prob": 0.0018528797663748264}, {"id": 77, "seek": 26448, "start": 269.04, "end": 270.98, "text": " Let us go on to the next towns,", "tokens": [50593, 961, 505, 352, 322, 281, 264, 958, 18104, 11, 50690], "temperature": 0.0, "avg_logprob": -0.19724624697901622, "compression_ratio": 1.6578947368421053, "no_speech_prob": 0.0018528797663748264}, {"id": 78, "seek": 26448, "start": 271.18, "end": 272.66, "text": " that I may preach there also,", "tokens": [50700, 300, 286, 815, 21552, 456, 611, 11, 50774], "temperature": 0.0, "avg_logprob": -0.19724624697901622, "compression_ratio": 1.6578947368421053, "no_speech_prob": 0.0018528797663748264}, {"id": 79, "seek": 26448, "start": 273.20000000000005, "end": 274.64000000000004, "text": " for that is why I came out.", "tokens": [50801, 337, 300, 307, 983, 286, 1361, 484, 13, 50873], "temperature": 0.0, "avg_logprob": -0.19724624697901622, "compression_ratio": 1.6578947368421053, "no_speech_prob": 0.0018528797663748264}, {"id": 80, "seek": 26448, "start": 275.38, "end": 277.06, "text": " And he went throughout all Galilee,", "tokens": [50910, 400, 415, 1437, 3710, 439, 7336, 33914, 11, 50994], "temperature": 0.0, "avg_logprob": -0.19724624697901622, "compression_ratio": 1.6578947368421053, "no_speech_prob": 0.0018528797663748264}, {"id": 81, "seek": 26448, "start": 277.3, "end": 279.56, "text": " preaching in their synagogues and casting out demons.", "tokens": [51006, 25381, 294, 641, 5451, 31599, 1247, 293, 17301, 484, 19733, 13, 51119], "temperature": 0.0, "avg_logprob": -0.19724624697901622, "compression_ratio": 1.6578947368421053, "no_speech_prob": 0.0018528797663748264}, {"id": 82, "seek": 26448, "start": 280.46000000000004, "end": 281.94, "text": " And a leper came to him,", "tokens": [51164, 400, 257, 476, 610, 1361, 281, 796, 11, 51238], "temperature": 0.0, "avg_logprob": -0.19724624697901622, "compression_ratio": 1.6578947368421053, "no_speech_prob": 0.0018528797663748264}, {"id": 83, "seek": 26448, "start": 282.14000000000004, "end": 284.52000000000004, "text": " imploring him and kneeling, said to him,", "tokens": [51248, 8484, 3662, 796, 293, 32704, 11031, 11, 848, 281, 796, 11, 51367], "temperature": 0.0, "avg_logprob": -0.19724624697901622, "compression_ratio": 1.6578947368421053, "no_speech_prob": 0.0018528797663748264}, {"id": 84, "seek": 26448, "start": 285.32, "end": 289.12, "text": " If you will, you can make me clean.", "tokens": [51407, 759, 291, 486, 11, 291, 393, 652, 385, 2541, 13, 51597], "temperature": 0.0, "avg_logprob": -0.19724624697901622, "compression_ratio": 1.6578947368421053, "no_speech_prob": 0.0018528797663748264}, {"id": 85, "seek": 26448, "start": 290.02000000000004, "end": 292.76, "text": " Moved with pity, he stretched out his hand", "tokens": [51642, 3335, 937, 365, 21103, 11, 415, 23563, 484, 702, 1011, 51779], "temperature": 0.0, "avg_logprob": -0.19724624697901622, "compression_ratio": 1.6578947368421053, "no_speech_prob": 0.0018528797663748264}, {"id": 86, "seek": 26448, "start": 292.76, "end": 294.46000000000004, "text": " and touched him and said to him,", "tokens": [51779, 293, 9828, 796, 293, 848, 281, 796, 11, 51864], "temperature": 0.0, "avg_logprob": -0.19724624697901622, "compression_ratio": 1.6578947368421053, "no_speech_prob": 0.0018528797663748264}, {"id": 87, "seek": 29448, "start": 294.48, "end": 297.3, "text": " I will, be clean.", "tokens": [50365, 286, 486, 11, 312, 2541, 13, 50506], "temperature": 0.0, "avg_logprob": -0.24300311593448415, "compression_ratio": 1.7431906614785992, "no_speech_prob": 0.01342312153428793}, {"id": 88, "seek": 29448, "start": 298.12, "end": 300.34000000000003, "text": " And immediately the leprosy left him,", "tokens": [50547, 400, 4258, 264, 476, 1424, 329, 88, 1411, 796, 11, 50658], "temperature": 0.0, "avg_logprob": -0.24300311593448415, "compression_ratio": 1.7431906614785992, "no_speech_prob": 0.01342312153428793}, {"id": 89, "seek": 29448, "start": 300.6, "end": 301.82, "text": " and he was made clean.", "tokens": [50671, 293, 415, 390, 1027, 2541, 13, 50732], "temperature": 0.0, "avg_logprob": -0.24300311593448415, "compression_ratio": 1.7431906614785992, "no_speech_prob": 0.01342312153428793}, {"id": 90, "seek": 29448, "start": 302.56, "end": 305.62, "text": " And Jesus sternly charged him and sent him away at once,", "tokens": [50769, 400, 2705, 38312, 356, 11109, 796, 293, 2279, 796, 1314, 412, 1564, 11, 50922], "temperature": 0.0, "avg_logprob": -0.24300311593448415, "compression_ratio": 1.7431906614785992, "no_speech_prob": 0.01342312153428793}, {"id": 91, "seek": 29448, "start": 305.88, "end": 306.64000000000004, "text": " and said to him,", "tokens": [50935, 293, 848, 281, 796, 11, 50973], "temperature": 0.0, "avg_logprob": -0.24300311593448415, "compression_ratio": 1.7431906614785992, "no_speech_prob": 0.01342312153428793}, {"id": 92, "seek": 29448, "start": 307.34000000000003, "end": 308.96000000000004, "text": " See that you say nothing to anyone,", "tokens": [51008, 3008, 300, 291, 584, 1825, 281, 2878, 11, 51089], "temperature": 0.0, "avg_logprob": -0.24300311593448415, "compression_ratio": 1.7431906614785992, "no_speech_prob": 0.01342312153428793}, {"id": 93, "seek": 29448, "start": 309.38, "end": 311.64000000000004, "text": " but go, show yourself to the priest,", "tokens": [51110, 457, 352, 11, 855, 1803, 281, 264, 15703, 11, 51223], "temperature": 0.0, "avg_logprob": -0.24300311593448415, "compression_ratio": 1.7431906614785992, "no_speech_prob": 0.01342312153428793}, {"id": 94, "seek": 29448, "start": 311.90000000000003, "end": 314.26, "text": " and offer for your cleansing what Moses commanded,", "tokens": [51236, 293, 2626, 337, 428, 29345, 437, 17580, 34359, 11, 51354], "temperature": 0.0, "avg_logprob": -0.24300311593448415, "compression_ratio": 1.7431906614785992, "no_speech_prob": 0.01342312153428793}, {"id": 95, "seek": 29448, "start": 314.74, "end": 315.70000000000005, "text": " for a proof to them.", "tokens": [51378, 337, 257, 8177, 281, 552, 13, 51426], "temperature": 0.0, "avg_logprob": -0.24300311593448415, "compression_ratio": 1.7431906614785992, "no_speech_prob": 0.01342312153428793}, {"id": 96, "seek": 29448, "start": 316.40000000000003, "end": 319.04, "text": " But he went out and began to talk freely about it,", "tokens": [51461, 583, 415, 1437, 484, 293, 4283, 281, 751, 16433, 466, 309, 11, 51593], "temperature": 0.0, "avg_logprob": -0.24300311593448415, "compression_ratio": 1.7431906614785992, "no_speech_prob": 0.01342312153428793}, {"id": 97, "seek": 29448, "start": 319.20000000000005, "end": 320.38, "text": " and to spread the news,", "tokens": [51601, 293, 281, 3974, 264, 2583, 11, 51660], "temperature": 0.0, "avg_logprob": -0.24300311593448415, "compression_ratio": 1.7431906614785992, "no_speech_prob": 0.01342312153428793}, {"id": 98, "seek": 29448, "start": 320.5, "end": 323.28000000000003, "text": " so that Jesus could no longer openly enter a town,", "tokens": [51666, 370, 300, 2705, 727, 572, 2854, 23109, 3242, 257, 3954, 11, 51805], "temperature": 0.0, "avg_logprob": -0.24300311593448415, "compression_ratio": 1.7431906614785992, "no_speech_prob": 0.01342312153428793}, {"id": 99, "seek": 29448, "start": 323.28000000000003, "end": 324.46000000000004, "text": " but was out in the city,", "tokens": [51805, 457, 390, 484, 294, 264, 2307, 11, 51864], "temperature": 0.0, "avg_logprob": -0.24300311593448415, "compression_ratio": 1.7431906614785992, "no_speech_prob": 0.01342312153428793}, {"id": 100, "seek": 32446, "start": 324.62, "end": 325.35999999999996, "text": " in desolate places,", "tokens": [50373, 294, 730, 48278, 3190, 11, 50410], "temperature": 0.0, "avg_logprob": -0.590604305267334, "compression_ratio": 1.0266666666666666, "no_speech_prob": 0.003974257502704859}, {"id": 101, "seek": 32446, "start": 325.64, "end": 328.14, "text": " and people were coming to him from every quarter.", "tokens": [50424, 293, 561, 645, 1348, 281, 796, 490, 633, 6555, 13, 50549], "temperature": 0.0, "avg_logprob": -0.590604305267334, "compression_ratio": 1.0266666666666666, "no_speech_prob": 0.003974257502704859}, {"id": 102, "seek": 32446, "start": 328.14, "end": 330.14, "text": " The End", "tokens": [50549, 440, 6967, 50649], "temperature": 0.0, "avg_logprob": -0.590604305267334, "compression_ratio": 1.0266666666666666, "no_speech_prob": 0.003974257502704859}], "language": "English"}