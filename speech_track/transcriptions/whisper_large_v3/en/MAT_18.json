7, 1413, 30, 51864], "temperature": 0.0, "avg_logprob": -0.18358124279585042, "compression_ratio": 1.7663934426229508, "no_speech_prob": 0.010730801150202751}, {"id": 50, "seek": 17758, "start": 178.4, "end": 179.64000000000001, "text": " Jesus said to him,", "tokens": [50406, 2705, 848, 281, 796, 11, 50468], "temperature": 0.0, "avg_logprob": -0.21493264548798913, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.02548559196293354}, {"id": 51, "seek": 17758, "start": 180.4, "end": 184.74, "text": " I do not say to you seven times, but seventy times seven.", "tokens": [50506, 286, 360, 406, 584, 281, 291, 3407, 1413, 11, 457, 25662, 1413, 3407, 13, 50723], "temperature": 0.0, "avg_logprob": -0.21493264548798913, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.02548559196293354}, {"id": 52, "seek": 17758, "start": 185.72000000000003, "end": 188.8, "text": " Therefore the kingdom of heaven may be compared to a king", "tokens": [50772, 7504, 264, 10231, 295, 7162, 815, 312, 5347, 281, 257, 4867, 50926], "temperature": 0.0, "avg_logprob": -0.21493264548798913, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.02548559196293354}, {"id": 53, "seek": 17758, "start": 188.8, "end": 190.86, "text": " who wished to settle accounts with his servants.", "tokens": [50926, 567, 25811, 281, 11852, 9402, 365, 702, 21705, 13, 51029], "temperature": 0.0, "avg_logprob": -0.21493264548798913, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.02548559196293354}, {"id": 54, "seek": 17758, "start": 191.64000000000001, "end": 193.16000000000003, "text": " When he began to settle,", "tokens": [51068, 1133, 415, 4283, 281, 11852, 11, 51144], "temperature": 0.0, "avg_logprob": -0.21493264548798913, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.02548559196293354}, {"id": 55, "seek": 17758, "start": 193.58, "end": 196.58, "text": " one was brought to him who owed him ten thousand talents.", "tokens": [51165, 472, 390, 3038, 281, 796, 567, 41262, 796, 2064, 4714, 19933, 13, 51315], "temperature": 0.0, "avg_logprob": -0.21493264548798913, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.02548559196293354}, {"id": 56, "seek": 17758, "start": 197.24, "end": 198.58, "text": " And since he could not pay,", "tokens": [51348, 400, 1670, 415, 727, 406, 1689, 11, 51415], "temperature": 0.0, "avg_logprob": -0.21493264548798913, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.02548559196293354}, {"id": 57, "seek": 17758, "start": 198.9, "end": 202.26000000000002, "text": " his master ordered him to be sold with his wife and children", "tokens": [51431, 702, 4505, 8866, 796, 281, 312, 3718, 365, 702, 3836, 293, 2227, 51599], "temperature": 0.0, "avg_logprob": -0.21493264548798913, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.02548559196293354}, {"id": 58, "seek": 17758, "start": 202.26000000000002, "end": 204.5, "text": " and all that he had in payment to be made.", "tokens": [51599, 293, 439, 300, 415, 632, 294, 10224, 281, 312, 1027, 13, 51711], "temperature": 0.0, "avg_logprob": -0.21493264548798913, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.02548559196293354}, {"id": 59, "seek": 17758, "start": 205.3, "end": 207.10000000000002, "text": " So the servant fell on his knees,", "tokens": [51751, 407, 264, 17896, 5696, 322, 702, 10546, 11, 51841], "temperature": 0.0, "avg_logprob": -0.21493264548798913, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.02548559196293354}, {"id": 60, "seek": 20710, "start": 207.1, "end": 208.01999999999998, "text": " imploring him,", "tokens": [50365, 8484, 3662, 796, 11, 50411], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 61, "seek": 20710, "start": 208.44, "end": 209.79999999999998, "text": " Have patience with me,", "tokens": [50432, 3560, 14826, 365, 385, 11, 50500], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 62, "seek": 20710, "start": 210.04, "end": 211.51999999999998, "text": " and I will pay you everything.", "tokens": [50512, 293, 286, 486, 1689, 291, 1203, 13, 50586], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 63, "seek": 20710, "start": 212.56, "end": 213.76, "text": " And out of pity for him,", "tokens": [50638, 400, 484, 295, 21103, 337, 796, 11, 50698], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 64, "seek": 20710, "start": 214.01999999999998, "end": 215.94, "text": " the master of that servant released him", "tokens": [50711, 264, 4505, 295, 300, 17896, 4736, 796, 50807], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 65, "seek": 20710, "start": 215.94, "end": 217.38, "text": " and forgave him the debt.", "tokens": [50807, 293, 3667, 946, 796, 264, 7831, 13, 50879], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 66, "seek": 20710, "start": 218.04, "end": 219.95999999999998, "text": " But when that same servant went out,", "tokens": [50912, 583, 562, 300, 912, 17896, 1437, 484, 11, 51008], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 67, "seek": 20710, "start": 220.29999999999998, "end": 221.88, "text": " he found one of his fellow servants", "tokens": [51025, 415, 1352, 472, 295, 702, 7177, 21705, 51104], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 68, "seek": 20710, "start": 221.88, "end": 223.95999999999998, "text": " who owed him a hundred denarii,", "tokens": [51104, 567, 41262, 796, 257, 3262, 1441, 3504, 72, 11, 51208], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 69, "seek": 20710, "start": 224.22, "end": 225.5, "text": " and seizing him,", "tokens": [51221, 293, 369, 3319, 796, 11, 51285], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 70, "seek": 20710, "start": 225.72, "end": 227.35999999999999, "text": " he began to choke him, saying,", "tokens": [51296, 415, 4283, 281, 34427, 796, 11, 1566, 11, 51378], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 71, "seek": 20710, "start": 227.7, "end": 228.57999999999998, "text": " Pay what you owe.", "tokens": [51395, 11431, 437, 291, 16655, 13, 51439], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 72, "seek": 20710, "start": 228.98, "end": 231.79999999999998, "text": " So his fellow servant fell down and pleaded with him,", "tokens": [51459, 407, 702, 7177, 17896, 5696, 760, 293, 3362, 12777, 365, 796, 11, 51600], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 73, "seek": 20710, "start": 232.18, "end": 233.48, "text": " Have patience with me,", "tokens": [51619, 3560, 14826, 365, 385, 11, 51684], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 74, "seek": 20710, "start": 233.66, "end": 234.85999999999999, "text": " and I will pay you.", "tokens": [51693, 293, 286, 486, 1689, 291, 13, 51753], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 75, "seek": 20710, "start": 235.42, "end": 236.45999999999998, "text": " He refused,", "tokens": [51781, 634, 14654, 11, 51833], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 76, "seek": 20710, "start": 236.45999999999998, "end": 236.54, "text": " and refused,", "tokens": [51833, 293, 14654, 11, 51837], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 77, "seek": 20710, "start": 236.54, "end": 236.62, "text": " and refused,", "tokens": [51837, 293, 14654, 11, 51841], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 78, "seek": 20710, "start": 236.62, "end": 236.64, "text": " and refused,", "tokens": [51841, 293, 14654, 11, 51842], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 79, "seek": 20710, "start": 236.64, "end": 236.68, "text": " and refused,", "tokens": [51842, 293, 14654, 11, 51844], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 80, "seek": 20710, "start": 236.68, "end": 236.72, "text": " and refused,", "tokens": [51844, 293, 14654, 11, 51846], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 81, "seek": 20710, "start": 236.72, "end": 236.79999999999998, "text": " and refused,", "tokens": [51846, 293, 14654, 11, 51850], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 82, "seek": 20710, "start": 236.79999999999998, "end": 236.82, "text": " and refused,", "tokens": [51850, 293, 14654, 11, 51851], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 83, "seek": 20710, "start": 236.82, "end": 236.84, "text": " and refused,", "tokens": [51851, 293, 14654, 11, 51852], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 84, "seek": 20710, "start": 236.84, "end": 237.07999999999998, "text": " and refused,", "tokens": [51852, 293, 14654, 11, 51864], "temperature": 0.0, "avg_logprob": -0.24508977587757214, "compression_ratio": 2.2975206611570247, "no_speech_prob": 0.0021321678068488836}, {"id": 85, "seek": 23710, "start": 237.1, "end": 238.22, "text": " and went and put him in prison", "tokens": [50365, 293, 1437, 293, 829, 796, 294, 6168, 50421], "temperature": 0.0, "avg_logprob": -0.1732558453176904, "compression_ratio": 1.792, "no_speech_prob": 0.0009621632052585483}, {"id": 86, "seek": 23710, "start": 238.22, "end": 239.76, "text": " until he should pay the debt.", "tokens": [50421, 1826, 415, 820, 1689, 264, 7831, 13, 50498], "temperature": 0.0, "avg_logprob": -0.1732558453176904, "compression_ratio": 1.792, "no_speech_prob": 0.0009621632052585483}, {"id": 87, "seek": 23710, "start": 240.34, "end": 243.18, "text": " When his fellow servants saw what had taken place,", "tokens": [50527, 1133, 702, 7177, 21705, 1866, 437, 632, 2726, 1081, 11, 50669], "temperature": 0.0, "avg_logprob": -0.1732558453176904, "compression_ratio": 1.792, "no_speech_prob": 0.0009621632052585483}, {"id": 88, "seek": 23710, "start": 243.44, "end": 245.24, "text": " they were greatly distressed,", "tokens": [50682, 436, 645, 14147, 1483, 3805, 11, 50772], "temperature": 0.0, "avg_logprob": -0.1732558453176904, "compression_ratio": 1.792, "no_speech_prob": 0.0009621632052585483}, {"id": 89, "seek": 23710, "start": 245.64, "end": 247.82, "text": " and they went and reported to their master", "tokens": [50792, 293, 436, 1437, 293, 7055, 281, 641, 4505, 50901], "temperature": 0.0, "avg_logprob": -0.1732558453176904, "compression_ratio": 1.792, "no_speech_prob": 0.0009621632052585483}, {"id": 90, "seek": 23710, "start": 247.82, "end": 249.34, "text": " all that had taken place.", "tokens": [50901, 439, 300, 632, 2726, 1081, 13, 50977], "temperature": 0.0, "avg_logprob": -0.1732558453176904, "compression_ratio": 1.792, "no_speech_prob": 0.0009621632052585483}, {"id": 91, "seek": 23710, "start": 250.44, "end": 253.04, "text": " Then his master summoned him and said to him,", "tokens": [51032, 1396, 702, 4505, 40791, 796, 293, 848, 281, 796, 11, 51162], "temperature": 0.0, "avg_logprob": -0.1732558453176904, "compression_ratio": 1.792, "no_speech_prob": 0.0009621632052585483}, {"id": 92, "seek": 23710, "start": 253.56, "end": 254.95999999999998, "text": " You wicked servant,", "tokens": [51188, 509, 22663, 17896, 11, 51258], "temperature": 0.0, "avg_logprob": -0.1732558453176904, "compression_ratio": 1.792, "no_speech_prob": 0.0009621632052585483}, {"id": 93, "seek": 23710, "start": 255.26, "end": 257.06, "text": " I forgave you all that debt", "tokens": [51273, 286, 3667, 946, 291, 439, 300, 7831, 51363], "temperature": 0.0, "avg_logprob": -0.1732558453176904, "compression_ratio": 1.792, "no_speech_prob": 0.0009621632052585483}, {"id": 94, "seek": 23710, "start": 257.06, "end": 258.58, "text": " because you pleaded with me,", "tokens": [51363, 570, 291, 3362, 12777, 365, 385, 11, 51439], "temperature": 0.0, "avg_logprob": -0.1732558453176904, "compression_ratio": 1.792, "no_speech_prob": 0.0009621632052585483}, {"id": 95, "seek": 23710, "start": 259.04, "end": 260.76, "text": " and should not you have had mercy", "tokens": [51462, 293, 820, 406, 291, 362, 632, 13174, 51548], "temperature": 0.0, "avg_logprob": -0.1732558453176904, "compression_ratio": 1.792, "no_speech_prob": 0.0009621632052585483}, {"id": 96, "seek": 23710, "start": 260.76, "end": 261.94, "text": " on your fellow servant", "tokens": [51548, 322, 428, 7177, 17896, 51607], "temperature": 0.0, "avg_logprob": -0.1732558453176904, "compression_ratio": 1.792, "no_speech_prob": 0.0009621632052585483}, {"id": 97, "seek": 23710, "start": 261.94, "end": 263.94, "text": " as I had mercy on you?", "tokens": [51607, 382, 286, 632, 13174, 322, 291, 30, 51707], "temperature": 0.0, "avg_logprob": -0.1732558453176904, "compression_ratio": 1.792, "no_speech_prob": 0.0009621632052585483}, {"id": 98, "seek": 23710, "start": 264.8, "end": 267.08, "text": " And in anger his master delivered,", "tokens": [51750, 400, 294, 10240, 702, 4505, 10144, 11, 51864], "temperature": 0.0, "avg_logprob": -0.1732558453176904, "compression_ratio": 1.792, "no_speech_prob": 0.0009621632052585483}, {"id": 99, "seek": 26708, "start": 267.08, "end": 267.12, "text": " And in anger his master delivered,", "tokens": [50365, 400, 294, 10240, 702, 4505, 10144, 11, 50367], "temperature": 1.0, "avg_logprob": -1.7571932077407837, "compression_ratio": 2.013574660633484, "no_speech_prob": 0.003292821580544114}, {"id": 100, "seek": 26708, "start": 267.12, "end": 268.26, "text": " and delivered him to the jailers,", "tokens": [50367, 293, 10144, 796, 281, 264, 10511, 433, 11, 50424], "temperature": 1.0, "avg_logprob": -1.7571932077407837, "compression_ratio": 2.013574660633484, "no_speech_prob": 0.003292821580544114}, {"id": 101, "seek": 26708, "start": 268.26, "end": 270.64, "text": " until he should pay all his debt.", "tokens": [50424, 1826, 415, 820, 1689, 439, 702, 7831, 13, 50543], "temperature": 1.0, "avg_logprob": -1.7571932077407837, "compression_ratio": 2.013574660633484, "no_speech_prob": 0.003292821580544114}, {"id": 102, "seek": 26708, "start": 270.64, "end": 271.24, "text": " until he should pay all his debt.", "tokens": [50543, 1826, 415, 820, 1689, 439, 702, 7831, 13, 50573], "temperature": 1.0, "avg_logprob": -1.7571932077407837, "compression_ratio": 2.013574660633484, "no_speech_prob": 0.003292821580544114}, {"id": 103, "seek": 26708, "start": 271.24, "end": 271.7, "text": " But he did not even fall for your lies,", "tokens": [50573, 583, 415, 630, 406, 754, 2100, 337, 428, 9134, 11, 50596], "temperature": 1.0, "avg_logprob": -1.7571932077407837, "compression_ratio": 2.013574660633484, "no_speech_prob": 0.003292821580544114}, {"id": 104, "seek": 26708, "start": 271.7, "end": 272.32, "text": " and will ever prevent you", "tokens": [50596, 293, 486, 1562, 4871, 291, 50627], "temperature": 1.0, "avg_logprob": -1.7571932077407837, "compression_ratio": 2.013574660633484, "no_speech_prob": 0.003292821580544114}, {"id": 105, "seek": 26708, "start": 272.32, "end": 272.46, "text": " And he did not even fall for your lies,", "tokens": [50627, 400, 415, 630, 406, 754, 2100, 337, 428, 9134, 11, 50634], "temperature": 1.0, "avg_logprob": -1.7571932077407837, "compression_ratio": 2.013574660633484, "no_speech_prob": 0.003292821580544114}, {"id": 106, "seek": 26708, "start": 272.46, "end": 273.41999999999996, "text": " although he had enough", "tokens": [50634, 4878, 415, 632, 1547, 50682], "temperature": 1.0, "avg_logprob": -1.7571932077407837, "compression_ratio": 2.013574660633484, "no_speech_prob": 0.003292821580544114}, {"id": 107, "seek": 26708, "start": 273.41999999999996, "end": 274.12, "text": " and also my heavenly father", "tokens": [50682, 293, 611, 452, 29406, 3086, 50717], "temperature": 1.0, "avg_logprob": -1.7571932077407837, "compression_ratio": 2.013574660633484, "no_speech_prob": 0.003292821580544114}, {"id": 108, "seek": 26708, "start": 274.12, "end": 275.88, "text": " will do to every one of you", "tokens": [50717, 486, 360, 281, 633, 472, 295, 291, 50805], "temperature": 1.0, "avg_logprob": -1.7571932077407837, "compression_ratio": 2.013574660633484, "no_speech_prob": 0.003292821580544114}, {"id": 109, "seek": 26708, "start": 275.88, "end": 278.53999999999996, "text": " if you do not forgive your brother", "tokens": [50805, 498, 291, 360, 406, 10718, 428, 3708, 50938], "temperature": 1.0, "avg_logprob": -1.7571932077407837, "compression_ratio": 2.013574660633484, "no_speech_prob": 0.003292821580544114}, {"id": 110, "seek": 26708, "start": 278.53999999999996, "end": 279.65999999999997, "text": " from your heart.", "tokens": [50938, 490, 428, 1917, 13, 50994], "temperature": 1.0, "avg_logprob": -1.7571932077407837, "compression_ratio": 2.013574660633484, "no_speech_prob": 0.003292821580544114}, {"id": 111, "seek": 26708, "start": 279.84, "end": 290.06, "text": " How will you forgive him?", "tokens": [51003, 1012, 486, 291, 10718, 796, 30, 51514], "temperature": 1.0, "avg_logprob": -1.7571932077407837, "compression_ratio": 2.013574660633484, "no_speech_prob": 0.003292821580544114}, {"id": 112, "seek": 26708, "start": 292.36, "end": 295.06, "text": " Whether you forgive his brother", "tokens": [51629, 8503, 291, 10718, 702, 3708, 51764], "temperature": 1.0, "avg_logprob": -1.7571932077407837, "compression_ratio": 2.013574660633484, "no_speech_prob": 0.003292821580544114}, {"id": 113, "seek": 26708, "start": 295.06, "end": 297.06, "text": " By loving him", "tokens": [51764, 3146, 9344, 796, 51864], "temperature": 1.0, "avg_logprob": -1.7571932077407837, "compression_ratio": 2.013574660633484, "no_speech_prob": 0.003292821580544114}], "language": "English"}