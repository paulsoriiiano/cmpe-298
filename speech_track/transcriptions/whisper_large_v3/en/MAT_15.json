 "compression_ratio": 1.5814977973568283, "no_speech_prob": 0.0037312672939151525}, {"id": 57, "seek": 14378, "start": 162.74, "end": 165.94, "text": " I was sent only to the lost sheep of the house of Israel.", "tokens": [51313, 286, 390, 2279, 787, 281, 264, 2731, 14213, 295, 264, 1782, 295, 5674, 13, 51473], "temperature": 0.0, "avg_logprob": -0.2742889404296875, "compression_ratio": 1.5814977973568283, "no_speech_prob": 0.0037312672939151525}, {"id": 58, "seek": 14378, "start": 166.6, "end": 168.76, "text": " But she came and knelt before him, saying,", "tokens": [51506, 583, 750, 1361, 293, 444, 2018, 949, 796, 11, 1566, 11, 51614], "temperature": 0.0, "avg_logprob": -0.2742889404296875, "compression_ratio": 1.5814977973568283, "no_speech_prob": 0.0037312672939151525}, {"id": 59, "seek": 14378, "start": 169.56, "end": 171.66, "text": " Lord, help me.", "tokens": [51654, 3257, 11, 854, 385, 13, 51759], "temperature": 0.0, "avg_logprob": -0.2742889404296875, "compression_ratio": 1.5814977973568283, "no_speech_prob": 0.0037312672939151525}, {"id": 60, "seek": 14378, "start": 172.08, "end": 173.24, "text": " And he answered,", "tokens": [51780, 400, 415, 10103, 11, 51838], "temperature": 0.0, "avg_logprob": -0.2742889404296875, "compression_ratio": 1.5814977973568283, "no_speech_prob": 0.0037312672939151525}, {"id": 61, "seek": 17378, "start": 173.78, "end": 176.12, "text": " It is not right to take the children's bread", "tokens": [50365, 467, 307, 406, 558, 281, 747, 264, 2227, 311, 5961, 50482], "temperature": 0.0, "avg_logprob": -0.24334814609625402, "compression_ratio": 1.5933609958506223, "no_speech_prob": 0.001634789863601327}, {"id": 62, "seek": 17378, "start": 176.12, "end": 177.54, "text": " and throw it to the dogs.", "tokens": [50482, 293, 3507, 309, 281, 264, 7197, 13, 50553], "temperature": 0.0, "avg_logprob": -0.24334814609625402, "compression_ratio": 1.5933609958506223, "no_speech_prob": 0.001634789863601327}, {"id": 63, "seek": 17378, "start": 178.36, "end": 178.96, "text": " She said,", "tokens": [50594, 1240, 848, 11, 50624], "temperature": 0.0, "avg_logprob": -0.24334814609625402, "compression_ratio": 1.5933609958506223, "no_speech_prob": 0.001634789863601327}, {"id": 64, "seek": 17378, "start": 179.76, "end": 181.1, "text": " Yes, Lord.", "tokens": [50664, 1079, 11, 3257, 13, 50731], "temperature": 0.0, "avg_logprob": -0.24334814609625402, "compression_ratio": 1.5933609958506223, "no_speech_prob": 0.001634789863601327}, {"id": 65, "seek": 17378, "start": 181.76, "end": 184.16, "text": " Yet even the dogs eat the crumbs", "tokens": [50764, 10890, 754, 264, 7197, 1862, 264, 42675, 50884], "temperature": 0.0, "avg_logprob": -0.24334814609625402, "compression_ratio": 1.5933609958506223, "no_speech_prob": 0.001634789863601327}, {"id": 66, "seek": 17378, "start": 184.16, "end": 186.5, "text": " that fall from their master's table.", "tokens": [50884, 300, 2100, 490, 641, 4505, 311, 3199, 13, 51001], "temperature": 0.0, "avg_logprob": -0.24334814609625402, "compression_ratio": 1.5933609958506223, "no_speech_prob": 0.001634789863601327}, {"id": 67, "seek": 17378, "start": 187.44, "end": 189.08, "text": " Then Jesus answered her,", "tokens": [51048, 1396, 2705, 10103, 720, 11, 51130], "temperature": 0.0, "avg_logprob": -0.24334814609625402, "compression_ratio": 1.5933609958506223, "no_speech_prob": 0.001634789863601327}, {"id": 68, "seek": 17378, "start": 189.74, "end": 192.22, "text": " O woman, great is your faith.", "tokens": [51163, 422, 3059, 11, 869, 307, 428, 4522, 13, 51287], "temperature": 0.0, "avg_logprob": -0.24334814609625402, "compression_ratio": 1.5933609958506223, "no_speech_prob": 0.001634789863601327}, {"id": 69, "seek": 17378, "start": 192.8, "end": 194.6, "text": " Be it done for you as you desire.", "tokens": [51316, 879, 309, 1096, 337, 291, 382, 291, 7516, 13, 51406], "temperature": 0.0, "avg_logprob": -0.24334814609625402, "compression_ratio": 1.5933609958506223, "no_speech_prob": 0.001634789863601327}, {"id": 70, "seek": 17378, "start": 195.02, "end": 197.94, "text": " And her daughter was healed instantly.", "tokens": [51427, 400, 720, 4653, 390, 20482, 13518, 13, 51573], "temperature": 0.0, "avg_logprob": -0.24334814609625402, "compression_ratio": 1.5933609958506223, "no_speech_prob": 0.001634789863601327}, {"id": 71, "seek": 17378, "start": 199.04, "end": 200.3, "text": " Jesus went on from there", "tokens": [51628, 2705, 1437, 322, 490, 456, 51691], "temperature": 0.0, "avg_logprob": -0.24334814609625402, "compression_ratio": 1.5933609958506223, "no_speech_prob": 0.001634789863601327}, {"id": 72, "seek": 17378, "start": 200.3, "end": 202.08, "text": " and walked beside the Sea of Galilee.", "tokens": [51691, 293, 7628, 15726, 264, 11352, 295, 7336, 33914, 13, 51780], "temperature": 0.0, "avg_logprob": -0.24334814609625402, "compression_ratio": 1.5933609958506223, "no_speech_prob": 0.001634789863601327}, {"id": 73, "seek": 17378, "start": 202.56, "end": 203.76, "text": " And he went up on the mountain,", "tokens": [51804, 400, 415, 1437, 493, 322, 264, 6937, 11, 51864], "temperature": 0.0, "avg_logprob": -0.24334814609625402, "compression_ratio": 1.5933609958506223, "no_speech_prob": 0.001634789863601327}, {"id": 74, "seek": 20378, "start": 203.78, "end": 205.04, "text": " and sat down there.", "tokens": [50365, 293, 3227, 760, 456, 13, 50428], "temperature": 0.0, "avg_logprob": -0.17468463510706805, "compression_ratio": 1.8007662835249043, "no_speech_prob": 0.003705143230035901}, {"id": 75, "seek": 20378, "start": 205.56, "end": 207.16, "text": " And great crowds came to him,", "tokens": [50454, 400, 869, 26070, 1361, 281, 796, 11, 50534], "temperature": 0.0, "avg_logprob": -0.17468463510706805, "compression_ratio": 1.8007662835249043, "no_speech_prob": 0.003705143230035901}, {"id": 76, "seek": 20378, "start": 207.26, "end": 209.7, "text": " bringing with them the lame, the blind,", "tokens": [50539, 5062, 365, 552, 264, 27635, 11, 264, 6865, 11, 50661], "temperature": 0.0, "avg_logprob": -0.17468463510706805, "compression_ratio": 1.8007662835249043, "no_speech_prob": 0.003705143230035901}, {"id": 77, "seek": 20378, "start": 209.86, "end": 211.86, "text": " the crippled, the mute, and many others.", "tokens": [50669, 264, 37667, 1493, 11, 264, 24523, 11, 293, 867, 2357, 13, 50769], "temperature": 0.0, "avg_logprob": -0.17468463510706805, "compression_ratio": 1.8007662835249043, "no_speech_prob": 0.003705143230035901}, {"id": 78, "seek": 20378, "start": 212.24, "end": 213.64, "text": " And they put them at his feet.", "tokens": [50788, 400, 436, 829, 552, 412, 702, 3521, 13, 50858], "temperature": 0.0, "avg_logprob": -0.17468463510706805, "compression_ratio": 1.8007662835249043, "no_speech_prob": 0.003705143230035901}, {"id": 79, "seek": 20378, "start": 214.08, "end": 215.22, "text": " And he healed them,", "tokens": [50880, 400, 415, 20482, 552, 11, 50937], "temperature": 0.0, "avg_logprob": -0.17468463510706805, "compression_ratio": 1.8007662835249043, "no_speech_prob": 0.003705143230035901}, {"id": 80, "seek": 20378, "start": 215.52, "end": 217.08, "text": " so that the crowd wondered.", "tokens": [50952, 370, 300, 264, 6919, 17055, 13, 51030], "temperature": 0.0, "avg_logprob": -0.17468463510706805, "compression_ratio": 1.8007662835249043, "no_speech_prob": 0.003705143230035901}, {"id": 81, "seek": 20378, "start": 217.64, "end": 219.28, "text": " When they saw the mute speaking,", "tokens": [51058, 1133, 436, 1866, 264, 24523, 4124, 11, 51140], "temperature": 0.0, "avg_logprob": -0.17468463510706805, "compression_ratio": 1.8007662835249043, "no_speech_prob": 0.003705143230035901}, {"id": 82, "seek": 20378, "start": 219.52, "end": 220.58, "text": " the crippled healthy,", "tokens": [51152, 264, 37667, 1493, 4627, 11, 51205], "temperature": 0.0, "avg_logprob": -0.17468463510706805, "compression_ratio": 1.8007662835249043, "no_speech_prob": 0.003705143230035901}, {"id": 83, "seek": 20378, "start": 220.74, "end": 222.68, "text": " the lame walking, and the blind seeing,", "tokens": [51213, 264, 27635, 4494, 11, 293, 264, 6865, 2577, 11, 51310], "temperature": 0.0, "avg_logprob": -0.17468463510706805, "compression_ratio": 1.8007662835249043, "no_speech_prob": 0.003705143230035901}, {"id": 84, "seek": 20378, "start": 222.8, "end": 225.52, "text": " and they glorified the God of Israel.", "tokens": [51316, 293, 436, 26623, 2587, 264, 1265, 295, 5674, 13, 51452], "temperature": 0.0, "avg_logprob": -0.17468463510706805, "compression_ratio": 1.8007662835249043, "no_speech_prob": 0.003705143230035901}, {"id": 85, "seek": 20378, "start": 226.46, "end": 228.88, "text": " Then Jesus called his disciples to him and said,", "tokens": [51499, 1396, 2705, 1219, 702, 17209, 281, 796, 293, 848, 11, 51620], "temperature": 0.0, "avg_logprob": -0.17468463510706805, "compression_ratio": 1.8007662835249043, "no_speech_prob": 0.003705143230035901}, {"id": 86, "seek": 20378, "start": 229.34, "end": 231.44, "text": " I have compassion on the crowd,", "tokens": [51643, 286, 362, 12601, 322, 264, 6919, 11, 51748], "temperature": 0.0, "avg_logprob": -0.17468463510706805, "compression_ratio": 1.8007662835249043, "no_speech_prob": 0.003705143230035901}, {"id": 87, "seek": 20378, "start": 231.44, "end": 233.76, "text": " because they have been with me now three days,", "tokens": [51748, 570, 436, 362, 668, 365, 385, 586, 1045, 1708, 11, 51864], "temperature": 0.0, "avg_logprob": -0.17468463510706805, "compression_ratio": 1.8007662835249043, "no_speech_prob": 0.003705143230035901}, {"id": 88, "seek": 23376, "start": 233.85999999999999, "end": 235.54, "text": " and have nothing to eat.", "tokens": [50370, 293, 362, 1825, 281, 1862, 13, 50454], "temperature": 0.0, "avg_logprob": -0.2815958752351649, "compression_ratio": 1.6795366795366795, "no_speech_prob": 0.0038479783106595278}, {"id": 89, "seek": 23376, "start": 235.54, "end": 237.94, "text": " And I am unwilling to send them away hungry,", "tokens": [50454, 400, 286, 669, 38246, 281, 2845, 552, 1314, 8067, 11, 50574], "temperature": 0.0, "avg_logprob": -0.2815958752351649, "compression_ratio": 1.6795366795366795, "no_speech_prob": 0.0038479783106595278}, {"id": 90, "seek": 23376, "start": 237.94, "end": 239.94, "text": " lest they faint on the way.", "tokens": [50574, 287, 377, 436, 21104, 322, 264, 636, 13, 50674], "temperature": 0.0, "avg_logprob": -0.2815958752351649, "compression_ratio": 1.6795366795366795, "no_speech_prob": 0.0038479783106595278}, {"id": 91, "seek": 23376, "start": 239.94, "end": 241.94, "text": " And the disciples said to him,", "tokens": [50674, 400, 264, 17209, 848, 281, 796, 11, 50774], "temperature": 0.0, "avg_logprob": -0.2815958752351649, "compression_ratio": 1.6795366795366795, "no_speech_prob": 0.0038479783106595278}, {"id": 92, "seek": 23376, "start": 241.94, "end": 243.94, "text": " Where are we to get enough bread", "tokens": [50774, 2305, 366, 321, 281, 483, 1547, 5961, 50874], "temperature": 0.0, "avg_logprob": -0.2815958752351649, "compression_ratio": 1.6795366795366795, "no_speech_prob": 0.0038479783106595278}, {"id": 93, "seek": 23376, "start": 243.94, "end": 246.94, "text": " in such a desolate place to feed so great a crowd?", "tokens": [50874, 294, 1270, 257, 730, 48278, 1081, 281, 3154, 370, 869, 257, 6919, 30, 51024], "temperature": 0.0, "avg_logprob": -0.2815958752351649, "compression_ratio": 1.6795366795366795, "no_speech_prob": 0.0038479783106595278}, {"id": 94, "seek": 23376, "start": 246.94, "end": 248.94, "text": " And Jesus said to them,", "tokens": [51024, 400, 2705, 848, 281, 552, 11, 51124], "temperature": 0.0, "avg_logprob": -0.2815958752351649, "compression_ratio": 1.6795366795366795, "no_speech_prob": 0.0038479783106595278}, {"id": 95, "seek": 23376, "start": 248.94, "end": 250.94, "text": " How many loaves do you have?", "tokens": [51124, 1012, 867, 450, 5423, 360, 291, 362, 30, 51224], "temperature": 0.0, "avg_logprob": -0.2815958752351649, "compression_ratio": 1.6795366795366795, "no_speech_prob": 0.0038479783106595278}, {"id": 96, "seek": 23376, "start": 250.94, "end": 252.44, "text": " They said,", "tokens": [51224, 814, 848, 11, 51299], "temperature": 0.0, "avg_logprob": -0.2815958752351649, "compression_ratio": 1.6795366795366795, "no_speech_prob": 0.0038479783106595278}, {"id": 97, "seek": 23376, "start": 252.44, "end": 255.44, "text": " Seven, and a few small fish.", "tokens": [51299, 14868, 11, 293, 257, 1326, 1359, 3506, 13, 51449], "temperature": 0.0, "avg_logprob": -0.2815958752351649, "compression_ratio": 1.6795366795366795, "no_speech_prob": 0.0038479783106595278}, {"id": 98, "seek": 23376, "start": 255.44, "end": 258.44, "text": " And directing the crowd to sit down on the ground,", "tokens": [51449, 400, 26979, 264, 6919, 281, 1394, 760, 322, 264, 2727, 11, 51599], "temperature": 0.0, "avg_logprob": -0.2815958752351649, "compression_ratio": 1.6795366795366795, "no_speech_prob": 0.0038479783106595278}, {"id": 99, "seek": 23376, "start": 258.44, "end": 260.44, "text": " he took the seven loaves and the fish,", "tokens": [51599, 415, 1890, 264, 3407, 450, 5423, 293, 264, 3506, 11, 51699], "temperature": 0.0, "avg_logprob": -0.2815958752351649, "compression_ratio": 1.6795366795366795, "no_speech_prob": 0.0038479783106595278}, {"id": 100, "seek": 23376, "start": 260.44, "end": 262.44, "text": " and having given thanks,", "tokens": [51699, 293, 1419, 2212, 3231, 11, 51799], "temperature": 0.0, "avg_logprob": -0.2815958752351649, "compression_ratio": 1.6795366795366795, "no_speech_prob": 0.0038479783106595278}, {"id": 101, "seek": 23376, "start": 262.44, "end": 263.53999999999996, "text": " he broke them.", "tokens": [51799, 415, 6902, 552, 13, 51854], "temperature": 0.0, "avg_logprob": -0.2815958752351649, "compression_ratio": 1.6795366795366795, "no_speech_prob": 0.0038479783106595278}, {"id": 102, "seek": 26354, "start": 263.54, "end": 265.54, "text": " And gave them to the disciples,", "tokens": [50