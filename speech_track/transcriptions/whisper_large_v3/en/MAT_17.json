compression_ratio": 1.6967213114754098, "no_speech_prob": 0.05890984088182449}, {"id": 51, "seek": 14760, "start": 163.6, "end": 165.6, "text": " As they were gathering in Galilee,", "tokens": [51165, 1018, 436, 645, 13519, 294, 7336, 33914, 11, 51265], "temperature": 0.0, "avg_logprob": -0.10488233791561577, "compression_ratio": 1.6967213114754098, "no_speech_prob": 0.05890984088182449}, {"id": 52, "seek": 14760, "start": 165.6, "end": 167.6, "text": " Jesus said to them,", "tokens": [51265, 2705, 848, 281, 552, 11, 51365], "temperature": 0.0, "avg_logprob": -0.10488233791561577, "compression_ratio": 1.6967213114754098, "no_speech_prob": 0.05890984088182449}, {"id": 53, "seek": 14760, "start": 167.6, "end": 171.6, "text": " The Son of Man is about to be delivered into the hands of men,", "tokens": [51365, 440, 5185, 295, 2458, 307, 466, 281, 312, 10144, 666, 264, 2377, 295, 1706, 11, 51565], "temperature": 0.0, "avg_logprob": -0.10488233791561577, "compression_ratio": 1.6967213114754098, "no_speech_prob": 0.05890984088182449}, {"id": 54, "seek": 14760, "start": 171.6, "end": 173.6, "text": " and they will kill him,", "tokens": [51565, 293, 436, 486, 1961, 796, 11, 51665], "temperature": 0.0, "avg_logprob": -0.10488233791561577, "compression_ratio": 1.6967213114754098, "no_speech_prob": 0.05890984088182449}, {"id": 55, "seek": 14760, "start": 173.6, "end": 176.6, "text": " and he will be raised on the third day.", "tokens": [51665, 293, 415, 486, 312, 6005, 322, 264, 2636, 786, 13, 51815], "temperature": 0.0, "avg_logprob": -0.10488233791561577, "compression_ratio": 1.6967213114754098, "no_speech_prob": 0.05890984088182449}, {"id": 56, "seek": 17660, "start": 176.6, "end": 179.6, "text": " And they were greatly distressed.", "tokens": [50365, 400, 436, 645, 14147, 1483, 3805, 13, 50515], "temperature": 0.0, "avg_logprob": -0.06141461356211517, "compression_ratio": 1.5836909871244635, "no_speech_prob": 0.002017156220972538}, {"id": 57, "seek": 17660, "start": 179.6, "end": 181.6, "text": " When they came to Capernaum,", "tokens": [50515, 1133, 436, 1361, 281, 383, 2332, 629, 449, 11, 50615], "temperature": 0.0, "avg_logprob": -0.06141461356211517, "compression_ratio": 1.5836909871244635, "no_speech_prob": 0.002017156220972538}, {"id": 58, "seek": 17660, "start": 181.6, "end": 185.6, "text": " the collectors of the two drachma tax went up to Peter and said,", "tokens": [50615, 264, 35384, 295, 264, 732, 1224, 608, 1696, 3366, 1437, 493, 281, 6508, 293, 848, 11, 50815], "temperature": 0.0, "avg_logprob": -0.06141461356211517, "compression_ratio": 1.5836909871244635, "no_speech_prob": 0.002017156220972538}, {"id": 59, "seek": 17660, "start": 185.6, "end": 188.6, "text": " Does your teacher not pay the tax?", "tokens": [50815, 4402, 428, 5027, 406, 1689, 264, 3366, 30, 50965], "temperature": 0.0, "avg_logprob": -0.06141461356211517, "compression_ratio": 1.5836909871244635, "no_speech_prob": 0.002017156220972538}, {"id": 60, "seek": 17660, "start": 188.6, "end": 189.6, "text": " He said,", "tokens": [50965, 634, 848, 11, 51015], "temperature": 0.0, "avg_logprob": -0.06141461356211517, "compression_ratio": 1.5836909871244635, "no_speech_prob": 0.002017156220972538}, {"id": 61, "seek": 17660, "start": 189.6, "end": 190.6, "text": " Yes.", "tokens": [51015, 1079, 13, 51065], "temperature": 0.0, "avg_logprob": -0.06141461356211517, "compression_ratio": 1.5836909871244635, "no_speech_prob": 0.002017156220972538}, {"id": 62, "seek": 17660, "start": 190.6, "end": 192.6, "text": " And when he came into the house,", "tokens": [51065, 400, 562, 415, 1361, 666, 264, 1782, 11, 51165], "temperature": 0.0, "avg_logprob": -0.06141461356211517, "compression_ratio": 1.5836909871244635, "no_speech_prob": 0.002017156220972538}, {"id": 63, "seek": 17660, "start": 192.6, "end": 194.6, "text": " Jesus spoke to him first, saying,", "tokens": [51165, 2705, 7179, 281, 796, 700, 11, 1566, 11, 51265], "temperature": 0.0, "avg_logprob": -0.06141461356211517, "compression_ratio": 1.5836909871244635, "no_speech_prob": 0.002017156220972538}, {"id": 64, "seek": 17660, "start": 194.6, "end": 196.6, "text": " What do you think, Simon?", "tokens": [51265, 708, 360, 291, 519, 11, 13193, 30, 51365], "temperature": 0.0, "avg_logprob": -0.06141461356211517, "compression_ratio": 1.5836909871244635, "no_speech_prob": 0.002017156220972538}, {"id": 65, "seek": 17660, "start": 196.6, "end": 200.6, "text": " From whom do kings of the earth take toll or tax,", "tokens": [51365, 3358, 7101, 360, 21581, 295, 264, 4120, 747, 16629, 420, 3366, 11, 51565], "temperature": 0.0, "avg_logprob": -0.06141461356211517, "compression_ratio": 1.5836909871244635, "no_speech_prob": 0.002017156220972538}, {"id": 66, "seek": 17660, "start": 200.6, "end": 202.6, "text": " from their sons or from others?", "tokens": [51565, 490, 641, 13476, 420, 490, 2357, 30, 51665], "temperature": 0.0, "avg_logprob": -0.06141461356211517, "compression_ratio": 1.5836909871244635, "no_speech_prob": 0.002017156220972538}, {"id": 67, "seek": 17660, "start": 202.6, "end": 204.6, "text": " And when he said,", "tokens": [51665, 400, 562, 415, 848, 11, 51765], "temperature": 0.0, "avg_logprob": -0.06141461356211517, "compression_ratio": 1.5836909871244635, "no_speech_prob": 0.002017156220972538}, {"id": 68, "seek": 20460, "start": 204.6, "end": 206.6, "text": " From others?", "tokens": [50365, 3358, 2357, 30, 50465], "temperature": 0.0, "avg_logprob": -0.08252106156460075, "compression_ratio": 1.5517241379310345, "no_speech_prob": 0.00399332121014595}, {"id": 69, "seek": 20460, "start": 206.6, "end": 208.6, "text": " Jesus said to him,", "tokens": [50465, 2705, 848, 281, 796, 11, 50565], "temperature": 0.0, "avg_logprob": -0.08252106156460075, "compression_ratio": 1.5517241379310345, "no_speech_prob": 0.00399332121014595}, {"id": 70, "seek": 20460, "start": 208.6, "end": 210.6, "text": " Then the sons are free.", "tokens": [50565, 1396, 264, 13476, 366, 1737, 13, 50665], "temperature": 0.0, "avg_logprob": -0.08252106156460075, "compression_ratio": 1.5517241379310345, "no_speech_prob": 0.00399332121014595}, {"id": 71, "seek": 20460, "start": 210.6, "end": 213.6, "text": " However, not to give offense to them,", "tokens": [50665, 2908, 11, 406, 281, 976, 17834, 281, 552, 11, 50815], "temperature": 0.0, "avg_logprob": -0.08252106156460075, "compression_ratio": 1.5517241379310345, "no_speech_prob": 0.00399332121014595}, {"id": 72, "seek": 20460, "start": 213.6, "end": 215.6, "text": " go to the sea and cast a hook", "tokens": [50815, 352, 281, 264, 4158, 293, 4193, 257, 6328, 50915], "temperature": 0.0, "avg_logprob": -0.08252106156460075, "compression_ratio": 1.5517241379310345, "no_speech_prob": 0.00399332121014595}, {"id": 73, "seek": 20460, "start": 215.6, "end": 217.6, "text": " and take the first fish that comes up,", "tokens": [50915, 293, 747, 264, 700, 3506, 300, 1487, 493, 11, 51015], "temperature": 0.0, "avg_logprob": -0.08252106156460075, "compression_ratio": 1.5517241379310345, "no_speech_prob": 0.00399332121014595}, {"id": 74, "seek": 20460, "start": 217.6, "end": 219.6, "text": " and when you open its mouth,", "tokens": [51015, 293, 562, 291, 1269, 1080, 4525, 11, 51115], "temperature": 0.0, "avg_logprob": -0.08252106156460075, "compression_ratio": 1.5517241379310345, "no_speech_prob": 0.00399332121014595}, {"id": 75, "seek": 20460, "start": 219.6, "end": 221.6, "text": " you will find a shekel.", "tokens": [51115, 291, 486, 915, 257, 750, 7124, 13, 51215], "temperature": 0.0, "avg_logprob": -0.08252106156460075, "compression_ratio": 1.5517241379310345, "no_speech_prob": 0.00399332121014595}, {"id": 76, "seek": 20460, "start": 221.6, "end": 225.6, "text": " Take that and give it to them for me and for yourself.", "tokens": [51215, 3664, 300, 293, 976, 309, 281, 552, 337, 385, 293, 337, 1803, 13, 51415], "temperature": 0.0, "avg_logprob": -0.08252106156460075, "compression_ratio": 1.5517241379310345, "no_speech_prob": 0.003993321210