64, 1708, 13, 51167], "temperature": 0.0, "avg_logprob": -0.18302849897249476, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.003016937989741564}, {"id": 55, "seek": 14996, "start": 166.78, "end": 168.64000000000001, "text": " And then if anyone says to you,", "tokens": [51206, 400, 550, 498, 2878, 1619, 281, 291, 11, 51299], "temperature": 0.0, "avg_logprob": -0.18302849897249476, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.003016937989741564}, {"id": 56, "seek": 14996, "start": 168.98000000000002, "end": 170.60000000000002, "text": " Look, here is the Christ,", "tokens": [51316, 2053, 11, 510, 307, 264, 2040, 11, 51397], "temperature": 0.0, "avg_logprob": -0.18302849897249476, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.003016937989741564}, {"id": 57, "seek": 14996, "start": 170.86, "end": 172.20000000000002, "text": " or look, there he is,", "tokens": [51410, 420, 574, 11, 456, 415, 307, 11, 51477], "temperature": 0.0, "avg_logprob": -0.18302849897249476, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.003016937989741564}, {"id": 58, "seek": 14996, "start": 172.64000000000001, "end": 173.74, "text": " do not believe it.", "tokens": [51499, 360, 406, 1697, 309, 13, 51554], "temperature": 0.0, "avg_logprob": -0.18302849897249476, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.003016937989741564}, {"id": 59, "seek": 14996, "start": 173.74, "end": 177.20000000000002, "text": " For false Christs and false prophets will arise", "tokens": [51554, 1171, 7908, 1721, 1751, 293, 7908, 27297, 486, 20288, 51727], "temperature": 0.0, "avg_logprob": -0.18302849897249476, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.003016937989741564}, {"id": 60, "seek": 14996, "start": 177.20000000000002, "end": 178.72, "text": " and perform signs and wonders", "tokens": [51727, 293, 2042, 7880, 293, 27348, 51803], "temperature": 0.0, "avg_logprob": -0.18302849897249476, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.003016937989741564}, {"id": 61, "seek": 14996, "start": 178.72, "end": 179.74, "text": " to lead astray,", "tokens": [51803, 281, 1477, 5357, 3458, 11, 51854], "temperature": 0.0, "avg_logprob": -0.18302849897249476, "compression_ratio": 1.7211155378486056, "no_speech_prob": 0.003016937989741564}, {"id": 62, "seek": 17996, "start": 179.96, "end": 181.42000000000002, "text": " if possible, the elect.", "tokens": [50365, 498, 1944, 11, 264, 2185, 13, 50438], "temperature": 0.0, "avg_logprob": -0.20110471108380487, "compression_ratio": 1.81640625, "no_speech_prob": 0.00013942529039923102}, {"id": 63, "seek": 17996, "start": 181.98000000000002, "end": 183.4, "text": " But be on guard.", "tokens": [50466, 583, 312, 322, 6290, 13, 50537], "temperature": 0.0, "avg_logprob": -0.20110471108380487, "compression_ratio": 1.81640625, "no_speech_prob": 0.00013942529039923102}, {"id": 64, "seek": 17996, "start": 183.66, "end": 185.74, "text": " I have told you all things beforehand.", "tokens": [50550, 286, 362, 1907, 291, 439, 721, 22893, 13, 50654], "temperature": 0.0, "avg_logprob": -0.20110471108380487, "compression_ratio": 1.81640625, "no_speech_prob": 0.00013942529039923102}, {"id": 65, "seek": 17996, "start": 186.84, "end": 188.32, "text": " But in those days,", "tokens": [50709, 583, 294, 729, 1708, 11, 50783], "temperature": 0.0, "avg_logprob": -0.20110471108380487, "compression_ratio": 1.81640625, "no_speech_prob": 0.00013942529039923102}, {"id": 66, "seek": 17996, "start": 188.62, "end": 189.9, "text": " after that tribulation,", "tokens": [50798, 934, 300, 15039, 2776, 11, 50862], "temperature": 0.0, "avg_logprob": -0.20110471108380487, "compression_ratio": 1.81640625, "no_speech_prob": 0.00013942529039923102}, {"id": 67, "seek": 17996, "start": 190.3, "end": 191.72, "text": " the sun will be darkened,", "tokens": [50882, 264, 3295, 486, 312, 2877, 5320, 11, 50953], "temperature": 0.0, "avg_logprob": -0.20110471108380487, "compression_ratio": 1.81640625, "no_speech_prob": 0.00013942529039923102}, {"id": 68, "seek": 17996, "start": 191.94, "end": 193.62, "text": " and the moon will not give its light,", "tokens": [50964, 293, 264, 7135, 486, 406, 976, 1080, 1442, 11, 51048], "temperature": 0.0, "avg_logprob": -0.20110471108380487, "compression_ratio": 1.81640625, "no_speech_prob": 0.00013942529039923102}, {"id": 69, "seek": 17996, "start": 193.84, "end": 195.98000000000002, "text": " and the stars will be falling from heaven,", "tokens": [51059, 293, 264, 6105, 486, 312, 7440, 490, 7162, 11, 51166], "temperature": 0.0, "avg_logprob": -0.20110471108380487, "compression_ratio": 1.81640625, "no_speech_prob": 0.00013942529039923102}, {"id": 70, "seek": 17996, "start": 196.08, "end": 198.16, "text": " and the powers in the heavens will be shaken.", "tokens": [51171, 293, 264, 8674, 294, 264, 26011, 486, 312, 40971, 13, 51275], "temperature": 0.0, "avg_logprob": -0.20110471108380487, "compression_ratio": 1.81640625, "no_speech_prob": 0.00013942529039923102}, {"id": 71, "seek": 17996, "start": 199.0, "end": 201.10000000000002, "text": " And then they will see the Son of Man", "tokens": [51317, 400, 550, 436, 486, 536, 264, 5185, 295, 2458, 51422], "temperature": 0.0, "avg_logprob": -0.20110471108380487, "compression_ratio": 1.81640625, "no_speech_prob": 0.00013942529039923102}, {"id": 72, "seek": 17996, "start": 201.10000000000002, "end": 204.02, "text": " coming in clouds with great power and glory.", "tokens": [51422, 1348, 294, 12193, 365, 869, 1347, 293, 11924, 13, 51568], "temperature": 0.0, "avg_logprob": -0.20110471108380487, "compression_ratio": 1.81640625, "no_speech_prob": 0.00013942529039923102}, {"id": 73, "seek": 17996, "start": 204.5, "end": 206.88, "text": " And then he will send out the angels", "tokens": [51592, 400, 550, 415, 486, 2845, 484, 264, 18175, 51711], "temperature": 0.0, "avg_logprob": -0.20110471108380487, "compression_ratio": 1.81640625, "no_speech_prob": 0.00013942529039923102}, {"id": 74, "seek": 17996, "start": 206.88, "end": 209.08, "text": " and gather his elect from the four winds,", "tokens": [51711, 293, 5448, 702, 2185, 490, 264, 1451, 17765, 11, 51821], "temperature": 0.0, "avg_logprob": -0.20110471108380487, "compression_ratio": 1.81640625, "no_speech_prob": 0.00013942529039923102}, {"id": 75, "seek": 17996, "start": 209.08, "end": 209.94, "text": " from the ends of the earth,", "tokens": [51821, 490, 264, 5314, 295, 264, 4120, 11, 51864], "temperature": 0.0, "avg_logprob": -0.20110471108380487, "compression_ratio": 1.81640625, "no_speech_prob": 0.00013942529039923102}, {"id": 76, "seek": 20994, "start": 209.96, "end": 212.0, "text": " to the ends of heaven.", "tokens": [50366, 281, 264, 5314, 295, 7162, 13, 50468], "temperature": 0.0, "avg_logprob": -0.20415266020959164, "compression_ratio": 1.7359307359307359, "no_speech_prob": 0.002620619721710682}, {"id": 77, "seek": 20994, "start": 213.2, "end": 216.02, "text": " From the fig tree, learn its lesson.", "tokens": [50528, 3358, 264, 2147, 4230, 11, 1466, 1080, 6898, 13, 50669], "temperature": 0.0, "avg_logprob": -0.20415266020959164, "compression_ratio": 1.7359307359307359, "no_speech_prob": 0.002620619721710682}, {"id": 78, "seek": 20994, "start": 216.57999999999998, "end": 218.52, "text": " As soon as its branch becomes tender", "tokens": [50697, 1018, 2321, 382, 1080, 9819, 3643, 15036, 50794], "temperature": 0.0, "avg_logprob": -0.20415266020959164, "compression_ratio": 1.7359307359307359, "no_speech_prob": 0.002620619721710682}, {"id": 79, "seek": 20994, "start": 218.52, "end": 219.64, "text": " and puts out its leaves,", "tokens": [50794, 293, 8137, 484, 1080, 5510, 11, 50850], "temperature": 0.0, "avg_logprob": -0.20415266020959164, "compression_ratio": 1.7359307359307359, "no_speech_prob": 0.002620619721710682}, {"id": 80, "seek": 20994, "start": 220.02, "end": 221.62, "text": " you know that summer is near.", "tokens": [50869, 291, 458, 300, 4266, 307, 2651, 13, 50949], "temperature": 0.0, "avg_logprob": -0.20415266020959164, "compression_ratio": 1.7359307359307359, "no_speech_prob": 0.002620619721710682}, {"id": 81, "seek": 20994, "start": 222.16, "end": 225.6, "text": " So also, when you see these things taking place,", "tokens": [50976, 407, 611, 11, 562, 291, 536, 613, 721, 1940, 1081, 11, 51148], "temperature": 0.0, "avg_logprob": -0.20415266020959164, "compression_ratio": 1.7359307359307359, "no_speech_prob": 0.002620619721710682}, {"id": 82, "seek": 20994, "start": 225.94, "end": 227.48, "text": " you know that he is near,", "tokens": [51165, 291, 458, 300, 415, 307, 2651, 11, 51242], "temperature": 0.0, "avg_logprob": -0.20415266020959164, "compression_ratio": 1.7359307359307359, "no_speech_prob": 0.002620619721710682}, {"id": 83, "seek": 20994, "start": 227.72, "end": 228.86, "text": " at the very gates.", "tokens": [51254, 412, 264, 588, 19792, 13, 51311], "temperature": 0.0, "avg_logprob": -0.20415266020959164, "compression_ratio": 1.7359307359307359, "no_speech_prob": 0.002620619721710682}, {"id": 84, "seek": 20994, "start": 229.8, "end": 231.22, "text": " Truly I say to you,", "tokens": [51358, 43548, 286, 584, 281, 291, 11, 51429], "temperature": 0.0, "avg_logprob": -0.20415266020959164, "compression_ratio": 1.7359307359307359, "no_speech_prob": 0.002620619721710682}, {"id": 85, "seek": 20994, "start": 231.48, "end": 233.46, "text": " this generation will not pass away", "tokens": [51442, 341, 5125, 486, 406, 1320, 1314, 51541], "temperature": 0.0, "avg_logprob": -0.20415266020959164, "compression_ratio": 1.7359307359307359, "no_speech_prob": 0.002620619721710682}, {"id": 86, "seek": 20994, "start": 233.46, "end": 235.4, "text": " until all these things take place.", "tokens": [51541, 1826, 439, 613, 721, 747, 1081, 13, 51638], "temperature": 0.0, "avg_logprob": -0.20415266020959164, "compression_ratio": 1.7359307359307359, "no_speech_prob": 0.002620619721710682}, {"id": 87, "seek": 20994, "start": 235.92, "end": 237.54, "text": " Heaven and earth will pass away,", "tokens": [51664, 13676, 293, 4120, 486, 1320, 1314, 11, 51745], "temperature": 0.0, "avg_logprob": -0.20415266020959164, "compression_ratio": 1.7359307359307359, "no_speech_prob": 0.002620619721710682}, {"id": 88, "seek": 20994, "start": 237.54, "end": 239.92, "text": " but my words will not pass away.", "tokens": [51745, 457, 452, 2283, 486, 406, 1320, 1314, 13, 51864], "temperature": 0.0, "avg_logprob": -0.20415266020959164, "compression_ratio": 1.7359307359307359, "no_speech_prob": 0.002620619721710682}, {"id": 89, "seek": 23994, "start": 239.94, "end": 243.48, "text": " But concerning that day or that hour,", "tokens": [50365, 583, 18087, 300, 786, 420, 300, 1773, 11, 50542], "temperature": 0.0, "avg_logprob": -0.20017240815243478, "compression_ratio": 1.6637554585152838, "no_speech_prob": 0.30676722526550293}, {"id": 90, "seek": 23994, "start": 243.94, "end": 244.76, "text": " no one knows,", "tokens": [50565, 572, 472, 3255, 11, 50606], "temperature": 0.0, "avg_logprob": -0.20017240815243478, "compression_ratio": 1.6637554585152838, "no_speech_prob": 0.30676722526550293}, {"id": 91, "seek": 23994, "start": 245.04, "end": 246.56, "text": " not even the angels in heaven,", "tokens": [50620, 406, 754, 264, 18175, 294, 7162, 11, 50696], "temperature": 0.0, "avg_logprob": -0.20017240815243478, "compression_ratio": 1.6637554585152838, "no_speech_prob": 0.30676722526550293}, {"id": 92, "seek": 23994, "start": 246.88, "end": 247.76, "text": " nor the Son,", "tokens": [50712, 6051, 264, 5185, 11, 50756], "temperature": 0.0, "avg_logprob": -0.20017240815243478, "compression_ratio": 1.6637554585152838, "no_speech_prob": 0.30676722526550293}, {"id": 93, "seek": 23994, "start": 248.16, "end": 249.48, "text": " but only the Father.", "tokens": [50776, 457, 787, 264, 7085, 13, 50842], "temperature": 0.0, "avg_logprob": -0.20017240815243478, "compression_ratio": 1.6637554585152838, "no_speech_prob": 0.30676722526550293}, {"id": 94, "seek": 23994, "start": 250.62, "end": 252.84, "text": " Be on guard, keep awake,", "tokens": [50899, 879, 322, 6290, 11, 1066, 15994, 11, 51010], "temperature": 0.0, "avg_logprob": -0.20017240815243478, "compression_ratio": 1.6637554585152838, "no_speech_prob": 0.30676722526550293}, {"id": 95, "seek": 23994, "start": 253.22, "end": 255.4, "text": " for you do not know when the time will come.", "tokens": [51029, 337, 291, 360, 406, 458, 562, 264, 565, 486, 808, 13, 51138], "temperature": 0.0, "avg_logprob": -0.20017240815243478, "compression_ratio": 1.6637554585152838, "no_speech_prob": 0.30676722526550293}, {"id": 96, "seek": 23994, "start": 256.42, "end": 258.44, "text": " It is like a man going on a journey,", "tokens": [51189, 467, 307, 411, 257, 587, 516, 322, 257, 4671, 11, 51290], "temperature": 0.0, "avg_logprob": -0.20017240815243478, "compression_ratio": 1.6637554585152838, "no_speech_prob": 0.30676722526550293}, {"id": 97, "seek": 23994, "start": 258.76, "end": 261.24, "text": " when he leaves home and puts his servants in charge,", "tokens": [51306, 562, 415, 5510, 1280, 293, 8137, 702, 21705, 294, 4602, 11, 51430], "temperature": 0.0, "avg_logprob": -0.20017240815243478, "compression_ratio": 1.6637554585152838, "no_speech_prob": 0.30676722526550293}, {"id": 98, "seek": 23994, "start": 261.54, "end": 262.48, "text": " each with his work,", "tokens": [51445, 1184, 365, 702, 589, 11, 51492], "temperature": 0.0, "avg_logprob": -0.20017240815243478, "compression_ratio": 1.6637554585152838, "no_speech_prob": 0.30676722526550293}, {"id": 99, "seek": 23994, "start": 262.65999999999997, "end": 265.12, "text": " and commands the doorkeeper to stay awake.", "tokens": [51501, 293, 16901, 264, 2853, 23083, 281, 1754, 15994, 13, 51624], "temperature": 0.0, "avg_logprob": -0.20017240815243478, "compression_ratio": 1.6637554585152838, "no_speech_prob": 0.30676722526550293}, {"id": 100, "seek": 23994, "start": 266.36, "end": 267.94, "text": " Therefore stay awake,", "tokens": [51686, 7504, 1754, 15994, 11, 51765], "temperature": 0.0, "avg_logprob": -0.20017240815243478, "compression_ratio": 1.6637554585152838, "no_speech_prob": 0.30676722526550293}, {"id": 101, "seek": 23994, "start": 267.94, "end": 269.44, "text": " for you do not know", "tokens": [51765, 337, 291, 360, 406, 458, 51840], "temperature": 0.0, "avg_logprob": -0.20017240815243478, "compression_ratio": 1.6637554585152838, "no_speech_prob": 0.30676722526550293}, {"id": 102, "seek": 26944, "start": 269.44, "end": 271.12, "text": " when the master of the house will come,", "tokens": [50365, 562, 264, 4505, 295, 264, 1782, 486, 808, 11, 50449], "temperature": 0.0, "avg_logprob": -0.23623494134433026, "compression_ratio": 1.5182481751824817, "no_speech_prob": 0.004143839702010155}, {"id": 103, "seek": 26944, "start": 271.5, "end": 273.16, "text": " in the evening, or at midnight,", "tokens": [50468, 294, 264, 5634, 11, 420, 412, 19006, 11, 50551], "temperature": 0.0, "avg_logprob": -0.23623494134433026, "compression_ratio": 1.5182481751824817, "no_speech_prob": 0.004143839702010155}, {"id": 104, "seek": 26944, "start": 273.28, "end": 274.46, "text": " or when the rooster crows,", "tokens": [50557, 420, 562, 264, 744, 7096, 941, 1509, 11, 50616], "temperature": 0.0, "avg_logprob": -0.23623494134433026, "compression_ratio": 1.5182481751824817, "no_speech_prob": 0.004143839702010155}, {"id": 105, "seek": 26944, "start": 274.56, "end": 275.4, "text": " or in the morning,", "tokens": [50621, 420, 294, 264, 2446, 11, 50663], "temperature": 0.0, "avg_logprob": -0.23623494134433026, "compression_ratio": 1.5182481751824817, "no_speech_prob": 0.004143839702010155}, {"id": 106, "seek": 26944, "start": 276.18, "end": 278.9, "text": " lest he come suddenly and find you asleep.", "tokens": [50702, 287, 377, 415, 808, 5800, 293, 915, 291, 11039, 13, 50838], "temperature": 0.0, "avg_logprob": -0.23623494134433026, "compression_ratio": 1.5182481751824817, "no_speech_prob": 0.004143839702010155}, {"id": 107, "seek": 26944, "start": 279.26, "end": 281.46, "text": " And what I say to you I say to all,", "tokens": [50856, 400, 437, 286, 584, 281, 291, 286, 584, 281, 439, 11, 50966], "temperature": 0.0, "avg_logprob": -0.23623494134433026, "compression_ratio": 1.5182481751824817, "no_speech_prob": 0.004143839702010155}, {"id": 108, "seek": 26944, "start": 281.46, "end": 283.22, "text": " stay awake.", "tokens": [50966, 1754, 15994, 13, 51054], "temperature": 0.0, "avg_logprob": -0.23623494134433026, "compression_ratio": 1.5182481751824817, "no_speech_prob": 0.004143839702010155}], "language": "English"}