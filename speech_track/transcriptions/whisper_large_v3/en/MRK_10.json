text": " You lack one thing.", "tokens": [51476, 509, 5011, 472, 551, 13, 51548], "temperature": 0.0, "avg_logprob": -0.24343769096889378, "compression_ratio": 2.0458333333333334, "no_speech_prob": 0.0013991144951432943}, {"id": 50, "seek": 11494, "start": 139.24, "end": 141.92, "text": " Go, sell all that you have and give to the poor,", "tokens": [51580, 1037, 11, 3607, 439, 300, 291, 362, 293, 976, 281, 264, 4716, 11, 51714], "temperature": 0.0, "avg_logprob": -0.24343769096889378, "compression_ratio": 2.0458333333333334, "no_speech_prob": 0.0013991144951432943}, {"id": 51, "seek": 11494, "start": 142.0, "end": 143.42, "text": " and you will have treasure in heaven.", "tokens": [51718, 293, 291, 486, 362, 12985, 294, 7162, 13, 51789], "temperature": 0.0, "avg_logprob": -0.24343769096889378, "compression_ratio": 2.0458333333333334, "no_speech_prob": 0.0013991144951432943}, {"id": 52, "seek": 11494, "start": 143.42, "end": 144.42, "text": " And come forth.", "tokens": [51789, 400, 808, 5220, 13, 51839], "temperature": 0.0, "avg_logprob": -0.24343769096889378, "compression_ratio": 2.0458333333333334, "no_speech_prob": 0.0013991144951432943}, {"id": 53, "seek": 11494, "start": 144.42, "end": 144.5, "text": " And come forth.", "tokens": [51839, 400, 808, 5220, 13, 51843], "temperature": 0.0, "avg_logprob": -0.24343769096889378, "compression_ratio": 2.0458333333333334, "no_speech_prob": 0.0013991144951432943}, {"id": 54, "seek": 11494, "start": 144.5, "end": 144.52, "text": " And come forth.", "tokens": [51843, 400, 808, 5220, 13, 51844], "temperature": 0.0, "avg_logprob": -0.24343769096889378, "compression_ratio": 2.0458333333333334, "no_speech_prob": 0.0013991144951432943}, {"id": 55, "seek": 11494, "start": 144.52, "end": 144.56, "text": " And come forth.", "tokens": [51844, 400, 808, 5220, 13, 51846], "temperature": 0.0, "avg_logprob": -0.24343769096889378, "compression_ratio": 2.0458333333333334, "no_speech_prob": 0.0013991144951432943}, {"id": 56, "seek": 11494, "start": 144.56, "end": 144.62, "text": " And come forth.", "tokens": [51846, 400, 808, 5220, 13, 51849], "temperature": 0.0, "avg_logprob": -0.24343769096889378, "compression_ratio": 2.0458333333333334, "no_speech_prob": 0.0013991144951432943}, {"id": 57, "seek": 11494, "start": 144.62, "end": 144.68, "text": " And come forth.", "tokens": [51849, 400, 808, 5220, 13, 51852], "temperature": 0.0, "avg_logprob": -0.24343769096889378, "compression_ratio": 2.0458333333333334, "no_speech_prob": 0.0013991144951432943}, {"id": 58, "seek": 11494, "start": 144.68, "end": 144.72, "text": " And come forth.", "tokens": [51852, 400, 808, 5220, 13, 51854], "temperature": 0.0, "avg_logprob": -0.24343769096889378, "compression_ratio": 2.0458333333333334, "no_speech_prob": 0.0013991144951432943}, {"id": 59, "seek": 14494, "start": 144.94, "end": 145.07999999999998, "text": " And come forth.", "tokens": [50365, 400, 808, 5220, 13, 50372], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 60, "seek": 14494, "start": 145.07999999999998, "end": 145.1, "text": " And come forth.", "tokens": [50372, 400, 808, 5220, 13, 50373], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 61, "seek": 14494, "start": 145.1, "end": 145.16, "text": " And come forth.", "tokens": [50373, 400, 808, 5220, 13, 50376], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 62, "seek": 14494, "start": 145.16, "end": 145.22, "text": " And come forth.", "tokens": [50376, 400, 808, 5220, 13, 50379], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 63, "seek": 14494, "start": 145.22, "end": 145.26, "text": " And come forth.", "tokens": [50379, 400, 808, 5220, 13, 50381], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 64, "seek": 14494, "start": 145.26, "end": 145.28, "text": " And come forth.", "tokens": [50381, 400, 808, 5220, 13, 50382], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 65, "seek": 14494, "start": 145.28, "end": 145.6, "text": " Follow me.", "tokens": [50382, 9876, 385, 13, 50398], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 66, "seek": 14494, "start": 146.66, "end": 147.8, "text": " Disheartened by the saying,", "tokens": [50451, 4208, 12864, 5320, 538, 264, 1566, 11, 50508], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 67, "seek": 14494, "start": 148.0, "end": 149.2, "text": " he went away sorrowful,", "tokens": [50518, 415, 1437, 1314, 23027, 906, 11, 50578], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 68, "seek": 14494, "start": 149.35999999999999, "end": 150.72, "text": " for he had great possessions.", "tokens": [50586, 337, 415, 632, 869, 40623, 13, 50654], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 69, "seek": 14494, "start": 151.72, "end": 154.34, "text": " And Jesus looked around and said to his disciples,", "tokens": [50704, 400, 2705, 2956, 926, 293, 848, 281, 702, 17209, 11, 50835], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 70, "seek": 14494, "start": 155.16, "end": 158.18, "text": " How difficult it will be for those who have wealth", "tokens": [50876, 1012, 2252, 309, 486, 312, 337, 729, 567, 362, 7203, 51027], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 71, "seek": 14494, "start": 158.18, "end": 160.07999999999998, "text": " to enter the kingdom of God.", "tokens": [51027, 281, 3242, 264, 10231, 295, 1265, 13, 51122], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 72, "seek": 14494, "start": 160.52, "end": 163.36, "text": " And the disciples were amazed at his words.", "tokens": [51144, 400, 264, 17209, 645, 20507, 412, 702, 2283, 13, 51286], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 73, "seek": 14494, "start": 163.82, "end": 165.44, "text": " But Jesus said to them again,", "tokens": [51309, 583, 2705, 848, 281, 552, 797, 11, 51390], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 74, "seek": 14494, "start": 166.18, "end": 170.0, "text": " Children, how difficult it is to enter the kingdom of God.", "tokens": [51427, 13354, 11, 577, 2252, 309, 307, 281, 3242, 264, 10231, 295, 1265, 13, 51618], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 75, "seek": 14494, "start": 170.62, "end": 173.88, "text": " It is easier for a camel to go through the eye of a needle", "tokens": [51649, 467, 307, 3571, 337, 257, 37755, 281, 352, 807, 264, 3313, 295, 257, 11037, 51812], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 76, "seek": 14494, "start": 173.88, "end": 174.62, "text": " than for a rich man to enter the kingdom of God.", "tokens": [51812, 813, 337, 257, 4593, 587, 281, 3242, 264, 10231, 295, 1265, 13, 51849], "temperature": 0.6000000000000001, "avg_logprob": -0.28762707078313254, "compression_ratio": 2.1052631578947367, "no_speech_prob": 0.0034558395855128765}, {"id": 77, "seek": 17462, "start": 174.62, "end": 180.52, "text": " a rich person to enter the kingdom of God. And they were exceedingly astonished and said to him,", "tokens": [50365, 257, 4593, 954, 281, 3242, 264, 10231, 295, 1265, 13, 400, 436, 645, 14048, 12163, 25687, 4729, 293, 848, 281, 796, 11, 50660], "temperature": 0.0, "avg_logprob": -0.081119966506958, "compression_ratio": 1.628691983122363, "no_speech_prob": 0.08148005604743958}, {"id": 78, "seek": 17462, "start": 180.86, "end": 188.84, "text": " Then who can be saved? Jesus looked at them and said, With man it is impossible, but not with God,", "tokens": [50677, 1396, 567, 393, 312, 6624, 30, 2705, 2956, 412, 552, 293, 848, 11, 2022, 587, 309, 307, 6243, 11, 457, 406, 365, 1265, 11, 51076], "temperature": 0.0, "avg_logprob": -0.081119966506958, "compression_ratio": 1.628691983122363, "no_speech_prob": 0.08148005604743958}, {"id": 79, "seek": 17462, "start": 189.24, "end": 196.86, "text": " for all things are possible with God. Peter began to say to him, See, we have left everything and", "tokens": [51096, 337, 439, 721, 366, 1944, 365, 1265, 13, 6508, 4283, 281, 584, 281, 796, 11, 3008, 11, 321, 362, 1411, 1203, 293, 51477], "temperature": 0.0, "avg_logprob": -0.081119966506958, "compression_ratio": 1.628691983122363, "no_speech_prob": 0.08148005604743958}, {"id": 80, "seek": 17462, "start": 196.86, "end": 204.02, "text": " followed you. Jesus said, Truly I say to you, there is no one who has left house or brothers", "tokens": [51477, 6263, 291, 13, 2705, 848, 11, 43548, 286, 584, 281, 291, 11, 456, 307, 572, 472, 567, 575, 1411, 1782, 420, 8452, 51835], "temperature": 0.0, "avg_logprob": -0.081119966506958, "compression_ratio": 1.628691983122363, "no_speech_prob": 0.08148005604743958}, {"id": 81, "seek": 20402, "start": 204.02, "end": 209.22, "text": " or sisters or mother or father or children or lands for my sake and for the gospel,", "tokens": [50365, 420, 11589, 420, 2895, 420, 3086, 420, 2227, 420, 5949, 337, 452, 9717, 293, 337, 264, 14943, 11, 50625], "temperature": 0.0, "avg_logprob": -0.07282025605729482, "compression_ratio": 1.8130434782608695, "no_speech_prob": 9.314523776993155e-05}, {"id": 82, "seek": 20402, "start": 209.88000000000002, "end": 216.4, "text": " who will not receive a hundredfold now in this time, houses and brothers and sisters and mothers", "tokens": [50658, 567, 486, 406, 4774, 257, 3262, 18353, 586, 294, 341, 565, 11, 8078, 293, 8452, 293, 11589, 293, 17941, 50984], "temperature": 0.0, "avg_logprob": -0.07282025605729482, "compression_ratio": 1.8130434782608695, "no_speech_prob": 9.314523776993155e-05}, {"id": 83, "seek": 20402, "start": 216.4, "end": 223.34, "text": " and children and lands, with persecutions, and in the age to come eternal life. But many who", "tokens": [50984, 293, 2227, 293, 5949, 11, 365, 23783, 3666, 11, 293, 294, 264, 3205, 281, 808, 14503, 993, 13, 583, 867, 567, 51331], "temperature": 0.0, "avg_logprob": -0.07282025605729482, "compression_ratio": 1.8130434782608695, "no_speech_prob": 9.314523776993155e-05}, {"id": 84, "seek": 20402, "start": 223.34, "end": 230.76000000000002, "text": " are first will be last, and the last first. And they were on the road going up to Jerusalem,", "tokens": [51331, 366, 700, 486, 312, 1036, 11, 293, 264, 1036, 700, 13, 400, 436, 645, 322, 264, 3060, 516, 493, 281, 15393, 11, 51702], "temperature": 0.0, "avg_logprob": -0.07282025605729482, "compression_ratio": 1.8130434782608695, "no_speech_prob": 9.314523776993155e-05}, {"id": 85, "seek": 20402, "start": 230.76000000000002, "end": 234.0, "text": " and Jesus was walking ahead of them. And they were", "tokens": [51702, 293, 2705, 390, 4494, 2286, 295, 552, 13, 400, 436, 645, 51864], "temperature": 0.0, "avg_logprob": -0.07282025605729482, "compression_ratio": 1.8130434782608695, "no_speech_prob": 9.314523776993155e-05}, {"id": 86, "seek": 23400, "start": 234.0, "end": 239.44, "text": " amazed, and those who followed were afraid. And taking the twelve again, he began to tell them", "tokens": [50365, 20507, 11, 293, 729, 567, 6263, 645, 4638, 13, 400, 1940, 264, 14390, 797, 11, 415, 4283, 281, 980, 552, 50637], "temperature": 0.0, "avg_logprob": -0.038163936138153075, "compression_ratio": 1.7586206896551724, "no_speech_prob": 0.000527465483173728}, {"id": 87, "seek": 23400, "start": 239.44, "end": 246.0, "text": " what was to happen to him, saying, See, we are going up to Jerusalem, and the Son of Man will", "tokens": [50637, 437, 390, 281, 1051, 281, 796, 11, 1566, 11, 3008, 11, 321, 366, 516, 493, 281, 15393, 11, 293, 264, 5185, 295, 2458, 486, 50965], "temperature": 0.0, "avg_logprob": -0.038163936138153075, "compression_ratio": 1.7586206896551724, "no_speech_prob": 0.000527465483173728}, {"id": 88, "seek": 23400, "start": 246.0, "end": 251.04, "text": " be delivered over to the chief priests and the scribes. And they will condemn him to death and", "tokens": [50965, 312, 10144, 670, 281, 264, 9588, 27192, 293, 264, 39435, 279, 13, 400, 436, 486, 30733, 796, 281, 2966, 293, 51217], "temperature": 0.0, "avg_logprob": -0.038163936138153075, "compression_ratio": 1.7586206896551724, "no_speech_prob": 0.000527465483173728}, {"id": 89, "seek": 23400, "start": 251.04, "end": 256.96, "text": " deliver him over to the Gentiles. And they will mock him and spit on him and flog him and kill", "tokens": [51217, 4239, 796, 670, 281, 264, 33070, 4680, 13, 400, 436, 486, 17362, 796, 293, 22127, 322, 796, 293, 932, 664, 796, 293, 1961, 51513], "temperature": 0.0, "avg_logprob": -0.038163936138153075, "compression_ratio": 1.7586206896551724, "no_speech_prob": 0.000527465483173728}, {"id": 90, "seek": 23400, "start": 256.96, "end": 263.98, "text": " him. And after three days he will rise. And James and John, the sons of Zebedee,", "tokens": [51513, 796, 13, 400, 934, 1045, 1708, 415, 486, 6272, 13, 400, 5678, 293, 2619, 11, 264, 13476, 295, 4853, 2883, 1653, 11, 51864], "temperature": 0.0, "avg_logprob": -0.038163936138153075, "compression_ratio": 1.7586206896551724, "no_speech_prob": 0.000527465483173728}, {"id": 91, "seek": 26400, "start": 264.02, "end": 270.7, "text": " came up to him and said to him, Teacher, we want you to do for us whatever we ask of you.", "tokens": [50366, 1361, 493, 281, 796, 293, 848, 281, 796, 11, 19745, 11, 321, 528, 291, 281, 360, 337, 505, 2035, 321, 1029, 295, 291, 13, 50700], "temperature": 1.0, "avg_logprob": -0.24918720411217732, "compression_ratio": 1.7876106194690264, "no_speech_prob": 0.00962627213448286}, {"id": 92, "seek": 26400, "start": 271.02, "end": 275.04, "text": " And he said to them, What do you want me to do for you?", "tokens": [50716, 400, 415, 848, 281, 552, 11, 708, 360, 291, 528, 385, 281, 360, 337, 291, 30, 50917], "temperature": 1.0, "avg_logprob": -0.24918720411217732, "compression_ratio": 1.7876106194690264, "no_speech_prob": 0.00962627213448286}, {"id": 93, "seek": 26400, "start": 275.62, "end": 282.16, "text": " And they said to him, Grant us to sit one at your right hand and one at your left in your glory.", "tokens": [50946, 400, 436, 848, 281, 796, 11, 17529, 505, 281, 1394, 472, 412, 428, 558, 1011, 293, 472, 412, 428, 1411, 294, 428, 11924, 13, 51273], "temperature": 1.0, "avg_logprob": -0.24918720411217732, "compression_ratio": 1.7876106194690264, "no_speech_prob": 0.00962627213448286}, {"id": 94, "seek": 26400, "start": 283.04, "end": 286.82, "text": " Jesus said to them, You do not know what you are asking.", "tokens": [51317, 2705, 848, 281, 552, 11, 509, 360, 406, 458, 437, 291, 366, 3365, 13, 51506], "temperature": 1.0, "avg_logprob": -0.24918720411217732, "compression_ratio": 1.7876106194690264, "no_speech_prob": 0.00962627213448286}, {"id": 95, "seek": 26400, "start": 287.3, "end": 292.42, "text": " Are you able to drink the cup that I drink, or to be baptized with the baptism with which I am", "tokens": [51530, 2014, 291, 1075, 281, 2822, 264, 4414, 300, 286, 2822, 11, 420, 281, 312, 34006, 365, 264, 34352, 365, 597, 286, 669, 51786], "temperature": 1.0, "avg_logprob": -0.24918720411217732, "compression_ratio": 1.7876106194690264, "no_speech_prob": 0.00962627213448286}, {"id": 96, "seek": 26400, "start": 292.42, "end": 292.96, "text": " baptized?", "tokens": [51786, 34006, 30, 51813], "temperature": 1.0, "avg_logprob": -0.24918720411217732, "compression_ratio": 1.7876106194690264, "no_speech_prob": 0.00962627213448286}, {"id": 97, "seek": 29400, "start": 294.0, "end": 301.46, "text": " said to him, We are able. And Jesus said to them, The cup that I drink you will drink,", "tokens": [50365, 848, 281, 796, 11, 492, 366, 1075, 13, 400, 2705, 848, 281, 552, 11, 440, 4414, 300, 286, 2822, 291, 486, 2822, 11, 50738], "temperature": 0.0, "avg_logprob": -0.06746471990453135, "compression_ratio": 1.6741071428571428, "no_speech_prob": 0.07583920657634735}, {"id": 98, "seek": 29400, "start": 301.8, "end": 308.16, "text": " and with the baptism with which I am baptized you will be baptized. But to sit at my right hand or", "tokens": [50755, 293, 365, 264, 34352, 365, 597, 286, 669, 34006, 291, 486, 312, 34006, 13, 583, 281, 1394, 412, 452, 558, 1011, 420, 51073], "temperature": 0.0, "avg_logprob": -0.06746471990453135, "compression_ratio": 1.6741071428571428, "no_speech_prob": 0.07583920657634735}, {"id": 99, "seek": 29400, "start": 308.16, "end": 314.52, "text": " at my left is not mine to grant, but it is for those for whom it has been prepared. And when", "tokens": [51073, 412, 452, 1411, 307, 406, 3892, 281, 6386, 11, 457, 309, 307, 337, 729, 337, 7101, 309, 575, 668, 4927, 13, 400, 562, 51391], "temperature": 0.0, "avg_logprob": -0.06746471990453135, "compression_ratio": 1.6741071428571428, "no_speech_prob": 0.07583920657634735}, {"id": 100, "seek": 29400, "start": 314.52, "end": 320.2, "text": " the tin heard it, they began to be indignant at James and John. And Jesus called them to him and", "tokens": [51391, 264, 15935, 2198, 309, 11, 436, 4283, 281, 312, 1016, 36818, 412, 5678, 293, 2619, 13, 400, 2705, 1219, 552, 281, 796, 293, 51675], "temperature": 0.0, "avg_logprob": -0.06746471990453135, "compression_ratio": 1.6741071428571428, "no_speech_prob": 0.07583920657634735}, {"id": 101, "seek": 32020, "start": 320.2, "end": 325.38, "text": " said to them, You know that those who are considered rulers of the Gentiles lord it over", "tokens": [50365, 848, 281, 552, 11, 509, 458, 300, 729, 567, 366, 4888, 35009, 295, 264, 33070, 4680, 15448, 309, 670, 50624], "temperature": 0.0, "avg_logprob": -0.1481585395067258, "compression_ratio": 1.8375451263537905, "no_speech_prob": 7.254324009409174e-05}, {"id": 102, "seek": 32020, "start": 325.38, "end": 330.86, "text": " them, and their great ones exercise authority over them, but it shall not be so among you.", "tokens": [50624, 552, 11, 293, 641, 869, 2306, 5380, 8281, 670, 552, 11, 457, 309, 4393, 406, 312, 370, 3654, 291, 13, 50898], "temperature": 0.0, "avg_logprob": -0.1481585395067258, "compression_ratio": 1.8375451263537905, "no_speech_prob": 7.254324009409174e-05}, {"id": 103, "seek": 32020, "start": 331.71999999999997, "end": 336.7, "text": " But whoever would be great among you must be your servant, and whoever would be first among you must", "tokens": [50941, 583, 11387, 576, 312, 869, 3654, 291, 1633, 312, 428, 17896, 11, 293, 11387, 576, 312, 700, 3654, 291, 1633, 51190], "temperature": 0.0, "avg_logprob": -0.1481585395067258, "compression_ratio": 1.8375451263537905, "no_speech_prob": 7.254324009409174e-05}, {"id": 104, "seek": 32020, "start": 336.7, "end": 343.74, "text": " be slave of all. For even the Son of Man came not to be served, but to serve and to give his life", "tokens": [51190, 312, 14777, 295, 439, 13, 1171, 754, 264, 5185, 295, 2458, 1361, 406, 281, 312, 7584, 11, 457, 281, 4596, 293, 281, 976, 702, 993, 51542], "temperature": 0.0, "avg_logprob": -0.1481585395067258, "compression_ratio": 1.8375451263537905, "no_speech_prob": 7.254324009409174e-05}, {"id": 105, "seek": 32020, "start": 343.74, "end": 348.9, "text": " as a ransom for many. And they came to Jericho,", "tokens": [51542, 382, 257, 38279, 337, 867, 13, 400, 436, 1361, 281, 8139, 33082, 11, 51800], "temperature": 0.0, "avg_logprob": -0.1481585395067258, "compression_ratio": 1.8375451263537905, "no_speech_prob": 7.254324009409174e-05}, {"id": 106, "seek": 32020, "start": 349.2, "end": 350.18, "text": " and as he was leaving, he saw that there was a man who was in the city of Jericho,", "tokens": [51815, 293, 382, 415, 390, 5012, 11, 415, 1866, 300, 456, 390, 257, 587, 567, 390, 294, 264, 2307, 295, 8139, 33082, 11, 51864], "temperature": 0.0, "avg_logprob": -0.1481585395067258, "compression_ratio": 1.8375451263537905, "no_speech_prob": 7.254324009409174e-05}, {"id": 107, "seek": 35018, "start": 350.18, "end": 355.48, "text": " leaving Jericho with his disciples and a great crowd. Bartimaeus, a blind beggar, the son of", "tokens": [50365, 5012, 8139, 33082, 365, 702, 17209, 293, 257, 869, 6919, 13, 22338, 4775, 68, 301, 11, 257, 6865, 44914, 289, 11, 264, 1872, 295, 50630], "temperature": 0.0, "avg_logprob": -0.04164094295141832, "compression_ratio": 1.634703196347032, "no_speech_prob": 0.00017400026263203472}, {"id": 108, "seek": 35018, "start": 355.48, "end": 361.2, "text": " Timaeus, was sitting by the roadside. And when he heard that it was Jesus of Nazareth, he began to", "tokens": [50630, 314, 4775, 68, 301, 11, 390, 3798, 538, 264, 3060, 1812, 13, 400, 562, 415, 2198, 300, 309, 390, 2705, 295, 11870, 40414, 11, 415, 4283, 281, 50916], "temperature": 0.0, "avg_logprob": -0.04164094295141832, "compression_ratio": 1.634703196347032, "no_speech_prob": 0.00017400026263203472}, {"id": 109, "seek": 35018, "start": 361.2, "end": 371.68, "text": " cry out and say, Jesus, son of David, have mercy on me. And many rebuked him, telling him to be", "tokens": [50916, 3305, 484, 293, 584, 11, 2705, 11, 1872, 295, 4389, 11, 362, 13174, 322, 385, 13, 400, 867, 12970, 2034, 292, 796, 11, 3585, 796, 281, 312, 51440], "temperature": 0.0, "avg_logprob": -0.04164094295141832, "compression_ratio": 1.634703196347032, "no_speech_prob": 0.00017400026263203472}, {"id": 110, "seek": 35018, "start": 371.68, "end": 379.64, "text": " silent. But he cried out all the more, Son of David, have mercy on me.", "tokens": [51440, 12784, 13, 583, 415, 16266, 484, 439, 264, 544, 11, 5185, 295, 4389, 11, 362, 13174, 322, 385, 13, 51838], "temperature": 0.0, "avg_logprob": -0.04164094295141832, "compression_ratio": 1.634703196347032, "no_speech_prob": 0.00017400026263203472}, {"id": 111, "seek": 38018, "start": 380.18, "end": 386.44, "text": " And Jesus stopped and said, Call him. And they called the blind man, saying to him,", "tokens": [50365, 400, 2705, 5936, 293, 848, 11, 7807, 796, 13, 400, 436, 1219, 264, 6865, 587, 11, 1566, 281, 796, 11, 50678], "temperature": 0.0, "avg_logprob": -0.09711730603090267, "compression_ratio": 1.765625, "no_speech_prob": 0.0007321262964978814}, {"id": 112, "seek": 38018, "start": 386.96, "end": 393.56, "text": " Take heart, get up, he is calling you. And throwing off his cloak, he sprang up and came", "tokens": [50704, 3664, 1917, 11, 483, 493, 11, 415, 307, 5141, 291, 13, 400, 10238, 766, 702, 45004, 11, 415, 6103, 656, 493, 293, 1361, 51034], "temperature": 0.0, "avg_logprob": -0.09711730603090267, "compression_ratio": 1.765625, "no_speech_prob": 0.0007321262964978814}, {"id": 113, "seek": 38018, "start": 393.56, "end": 400.92, "text": " to Jesus. And Jesus said to him, What do you want me to do for you? And the blind man said to him,", "tokens": [51034, 281, 2705, 13, 400, 2705, 848, 281, 796, 11, 708, 360, 291, 528, 385, 281, 360, 337, 291, 30, 400, 264, 6865, 587, 848, 281, 796, 11, 51402], "temperature": 0.0, "avg_logprob": -0.09711730603090267, "compression_ratio": 1.765625, "no_speech_prob": 0.0007321262964978814}, {"id": 114, "seek": 38018, "start": 401.52, "end": 409.26, "text": " Rabbi, let me recover my sight. And Jesus said to him, Go your way,", "tokens": [51432, 32768, 11, 718, 385, 8114, 452, 7860, 13, 400, 2705, 848, 281, 796, 11, 1037, 428, 636, 11, 51819], "temperature": 0.0, "avg_logprob": -0.09711730603090267, "compression_ratio": 1.765625, "no_speech_prob": 0.0007321262964978814}, {"id": 115, "seek": 41018, "start": 410.18, "end": 415.52, "text": " faith has made you well. And immediately he recovered his sight and followed him on the way.", "tokens": [50365, 4522, 575, 1027, 291, 731, 13, 400, 4258, 415, 19542, 702, 7860, 293, 6263, 796, 322, 264, 636, 13, 50632], "temperature": 0.0, "avg_logprob": -0.08280639214949174, "compression_ratio": 1.1219512195121952, "no_speech_prob": 0.0074004242196679115}], "language": "English"}