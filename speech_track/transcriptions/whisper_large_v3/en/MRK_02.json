11, 50461], "temperature": 0.0, "avg_logprob": -0.2798153758049011, "compression_ratio": 1.722943722943723, "no_speech_prob": 0.0021476494148373604}, {"id": 79, "seek": 17854, "start": 180.82, "end": 182.16, "text": " and a worse tear is made.", "tokens": [50479, 293, 257, 5324, 12556, 307, 1027, 13, 50546], "temperature": 0.0, "avg_logprob": -0.2798153758049011, "compression_ratio": 1.722943722943723, "no_speech_prob": 0.0021476494148373604}, {"id": 80, "seek": 17854, "start": 182.62, "end": 184.04, "text": " And no one puts new wine", "tokens": [50569, 400, 572, 472, 8137, 777, 7209, 50640], "temperature": 0.0, "avg_logprob": -0.2798153758049011, "compression_ratio": 1.722943722943723, "no_speech_prob": 0.0021476494148373604}, {"id": 81, "seek": 17854, "start": 184.04, "end": 185.12, "text": " into old wineskins.", "tokens": [50640, 666, 1331, 35970, 10277, 13, 50694], "temperature": 0.0, "avg_logprob": -0.2798153758049011, "compression_ratio": 1.722943722943723, "no_speech_prob": 0.0021476494148373604}, {"id": 82, "seek": 17854, "start": 185.44, "end": 186.23999999999998, "text": " If he does,", "tokens": [50710, 759, 415, 775, 11, 50750], "temperature": 0.0, "avg_logprob": -0.2798153758049011, "compression_ratio": 1.722943722943723, "no_speech_prob": 0.0021476494148373604}, {"id": 83, "seek": 17854, "start": 186.57999999999998, "end": 188.04, "text": " the wine will burst the skins,", "tokens": [50767, 264, 7209, 486, 12712, 264, 27888, 11, 50840], "temperature": 0.0, "avg_logprob": -0.2798153758049011, "compression_ratio": 1.722943722943723, "no_speech_prob": 0.0021476494148373604}, {"id": 84, "seek": 17854, "start": 188.29999999999998, "end": 189.6, "text": " and the wine is destroyed.", "tokens": [50853, 293, 264, 7209, 307, 8937, 13, 50918], "temperature": 0.0, "avg_logprob": -0.2798153758049011, "compression_ratio": 1.722943722943723, "no_speech_prob": 0.0021476494148373604}, {"id": 85, "seek": 17854, "start": 190.12, "end": 191.28, "text": " And so are the skins.", "tokens": [50944, 400, 370, 366, 264, 27888, 13, 51002], "temperature": 0.0, "avg_logprob": -0.2798153758049011, "compression_ratio": 1.722943722943723, "no_speech_prob": 0.0021476494148373604}, {"id": 86, "seek": 17854, "start": 192.32, "end": 194.54, "text": " But new wine is for fresh wineskins.", "tokens": [51054, 583, 777, 7209, 307, 337, 4451, 35970, 10277, 13, 51165], "temperature": 0.0, "avg_logprob": -0.2798153758049011, "compression_ratio": 1.722943722943723, "no_speech_prob": 0.0021476494148373604}, {"id": 87, "seek": 17854, "start": 196.64, "end": 199.23999999999998, "text": " One Sabbath he was going through the grain fields,", "tokens": [51270, 1485, 36618, 415, 390, 516, 807, 264, 12837, 7909, 11, 51400], "temperature": 0.0, "avg_logprob": -0.2798153758049011, "compression_ratio": 1.722943722943723, "no_speech_prob": 0.0021476494148373604}, {"id": 88, "seek": 17854, "start": 199.56, "end": 201.06, "text": " and as they made their way,", "tokens": [51416, 293, 382, 436, 1027, 641, 636, 11, 51491], "temperature": 0.0, "avg_logprob": -0.2798153758049011, "compression_ratio": 1.722943722943723, "no_speech_prob": 0.0021476494148373604}, {"id": 89, "seek": 17854, "start": 201.23999999999998, "end": 203.56, "text": " his disciples began to pluck heads of grain.", "tokens": [51500, 702, 17209, 4283, 281, 41514, 8050, 295, 12837, 13, 51616], "temperature": 0.0, "avg_logprob": -0.2798153758049011, "compression_ratio": 1.722943722943723, "no_speech_prob": 0.0021476494148373604}, {"id": 90, "seek": 17854, "start": 204.07999999999998, "end": 206.44, "text": " And the Pharisees were saying to him,", "tokens": [51642, 400, 264, 47742, 279, 645, 1566, 281, 796, 11, 51760], "temperature": 0.0, "avg_logprob": -0.2798153758049011, "compression_ratio": 1.722943722943723, "no_speech_prob": 0.0021476494148373604}, {"id": 91, "seek": 17854, "start": 207.2, "end": 207.62, "text": " Look,", "tokens": [51798, 2053, 11, 51819], "temperature": 0.0, "avg_logprob": -0.2798153758049011, "compression_ratio": 1.722943722943723, "no_speech_prob": 0.0021476494148373604}, {"id": 92, "seek": 20762, "start": 207.62, "end": 209.68, "text": " why are they doing", "tokens": [50365, 983, 366, 436, 884, 50468], "temperature": 0.0, "avg_logprob": -0.1540600988599989, "compression_ratio": 1.8699186991869918, "no_speech_prob": 0.00745738111436367}, {"id": 93, "seek": 20762, "start": 209.68, "end": 211.84, "text": " what is not lawful on the Sabbath?", "tokens": [50468, 437, 307, 406, 2101, 906, 322, 264, 36618, 30, 50576], "temperature": 0.0, "avg_logprob": -0.1540600988599989, "compression_ratio": 1.8699186991869918, "no_speech_prob": 0.00745738111436367}, {"id": 94, "seek": 20762, "start": 212.74, "end": 213.78, "text": " And he said to them,", "tokens": [50621, 400, 415, 848, 281, 552, 11, 50673], "temperature": 0.0, "avg_logprob": -0.1540600988599989, "compression_ratio": 1.8699186991869918, "no_speech_prob": 0.00745738111436367}, {"id": 95, "seek": 20762, "start": 214.58, "end": 216.1, "text": " Have you never read what David did", "tokens": [50713, 3560, 291, 1128, 1401, 437, 4389, 630, 50789], "temperature": 0.0, "avg_logprob": -0.1540600988599989, "compression_ratio": 1.8699186991869918, "no_speech_prob": 0.00745738111436367}, {"id": 96, "seek": 20762, "start": 216.1, "end": 217.64000000000001, "text": " when he was in need and was hungry,", "tokens": [50789, 562, 415, 390, 294, 643, 293, 390, 8067, 11, 50866], "temperature": 0.0, "avg_logprob": -0.1540600988599989, "compression_ratio": 1.8699186991869918, "no_speech_prob": 0.00745738111436367}, {"id": 97, "seek": 20762, "start": 218.0, "end": 219.24, "text": " he and those who were with him?", "tokens": [50884, 415, 293, 729, 567, 645, 365, 796, 30, 50946], "temperature": 0.0, "avg_logprob": -0.1540600988599989, "compression_ratio": 1.8699186991869918, "no_speech_prob": 0.00745738111436367}, {"id": 98, "seek": 20762, "start": 219.76, "end": 221.42000000000002, "text": " How he entered the