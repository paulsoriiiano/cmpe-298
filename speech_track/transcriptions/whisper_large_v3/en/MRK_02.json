, 16153, 11, 51454], "temperature": 0.0, "avg_logprob": -0.20990036069884782, "compression_ratio": 1.75, "no_speech_prob": 0.038146138191223145}, {"id": 59, "seek": 11866, "start": 141.0, "end": 141.7, "text": " but sinners.", "tokens": [51482, 457, 41004, 13, 51517], "temperature": 0.0, "avg_logprob": -0.20990036069884782, "compression_ratio": 1.75, "no_speech_prob": 0.038146138191223145}, {"id": 60, "seek": 11866, "start": 142.34, "end": 145.72, "text": " Now John's disciples and the Pharisees were fasting,", "tokens": [51549, 823, 2619, 311, 17209, 293, 264, 47742, 279, 645, 22371, 11, 51718], "temperature": 0.0, "avg_logprob": -0.20990036069884782, "compression_ratio": 1.75, "no_speech_prob": 0.038146138191223145}, {"id": 61, "seek": 11866, "start": 145.72, "end": 147.84, "text": " and people came and said to him,", "tokens": [51718, 293, 561, 1361, 293, 848, 281, 796, 11, 51824], "temperature": 0.0, "avg_logprob": -0.20990036069884782, "compression_ratio": 1.75, "no_speech_prob": 0.038146138191223145}, {"id": 62, "seek": 14866, "start": 148.66, "end": 150.04, "text": " Why do John's disciples", "tokens": [50365, 1545, 360, 2619, 311, 17209, 50434], "temperature": 0.0, "avg_logprob": -0.17761027203859203, "compression_ratio": 1.777327935222672, "no_speech_prob": 0.0007206756272353232}, {"id": 63, "seek": 14866, "start": 150.04, "end": 152.48, "text": " and the disciples of the Pharisees fast,", "tokens": [50434, 293, 264, 17209, 295, 264, 47742, 279, 2370, 11, 50556], "temperature": 0.0, "avg_logprob": -0.17761027203859203, "compression_ratio": 1.777327935222672, "no_speech_prob": 0.0007206756272353232}, {"id": 64, "seek": 14866, "start": 152.85999999999999, "end": 154.94, "text": " but your disciples do not fast?", "tokens": [50575, 457, 428, 17209, 360, 406, 2370, 30, 50679], "temperature": 0.0, "avg_logprob": -0.17761027203859203, "compression_ratio": 1.777327935222672, "no_speech_prob": 0.0007206756272353232}, {"id": 65, "seek": 14866, "start": 155.62, "end": 157.24, "text": " And Jesus said to them,", "tokens": [50713, 400, 2705, 848, 281, 552, 11, 50794], "temperature": 0.0, "avg_logprob": -0.17761027203859203, "compression_ratio": 1.777327935222672, "no_speech_prob": 0.0007206756272353232}, {"id": 66, "seek": 14866, "start": 157.9, "end": 159.48, "text": " Can the wedding guests fast", "tokens": [50827, 1664, 264, 8523, 9804, 2370, 50906], "temperature": 0.0, "avg_logprob": -0.17761027203859203, "compression_ratio": 1.777327935222672, "no_speech_prob": 0.0007206756272353232}, {"id": 67, "seek": 14866, "start": 159.48, "end": 160.96, "text": " while the bridegroom is with them?", "tokens": [50906, 1339, 264, 22292, 70, 2861, 307, 365, 552, 30, 50980], "temperature": 0.0, "avg_logprob": -0.17761027203859203, "compression_ratio": 1.777327935222672, "no_speech_prob": 0.0007206756272353232}, {"id": 68, "seek": 14866, "start": 162.06, "end": 163.96, "text": " As long as they have the bridegroom with them,", "tokens": [51035, 1018, 938, 382, 436, 362, 264, 22292, 70, 2861, 365, 552, 11, 51130], "temperature": 0.0, "avg_logprob": -0.17761027203859203, "compression_ratio": 1.777327935222672, "no_speech_prob": 0.0007206756272353232}, {"id": 69, "seek": 14866, "start": 164.22, "end": 165.32, "text": " they cannot fast.", "tokens": [51143, 436, 2644, 2370, 13, 51198], "temperature": 0.0, "avg_logprob": -0.17761027203859203, "compression_ratio": 1.777327935222672, "no_speech_prob": 0.0007206756272353232}, {"id": 70, "seek": 14866, "start": 165.92, "end": 167.12, "text": " The days will come", "tokens": [51228, 440, 1708, 486, 808, 51288], "temperature": 0.0, "avg_logprob": -0.17761027203859203, "compression_ratio": 1.777327935222672, "no_speech_prob": 0.0007206756272353232}, {"id": 71, "seek": 14866, "start": 167.12, "end": 169.01999999999998, "text": " when the bridegroom is taken away from them,", "tokens": [51288, 562, 264, 22292, 70, 2861, 307, 2726, 1314, 490, 552, 11, 51383], "temperature": 0.0, "avg_logprob": -0.177610272