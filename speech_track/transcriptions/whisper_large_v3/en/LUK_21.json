439, 613, 721, 300, 366, 516, 281, 747, 1081, 11, 50483], "temperature": 0.0, "avg_logprob": -0.12715786856573982, "compression_ratio": 1.5789473684210527, "no_speech_prob": 0.017169905826449394}, {"id": 81, "seek": 26510, "start": 267.88, "end": 270.52000000000004, "text": " and to stand before the Son of Man.", "tokens": [50504, 293, 281, 1463, 949, 264, 5185, 295, 2458, 13, 50636], "temperature": 0.0, "avg_logprob": -0.12715786856573982, "compression_ratio": 1.5789473684210527, "no_speech_prob": 0.017169905826449394}, {"id": 82, "seek": 26510, "start": 271.52000000000004, "end": 274.0, "text": " And every day he was teaching in the temple,", "tokens": [50686, 400, 633, 786, 415, 390, 4571, 294, 264, 10184, 11, 50810], "temperature": 0.0, "avg_logprob": -0.12715786856573982, "compression_ratio": 1.5789473684210527, "no_speech_prob": 0.017169905826449394}, {"id": 83, "seek": 26510, "start": 274.38, "end": 277.98, "text": " but at night he went out and lodged on the mount called Olivet.", "tokens": [50829, 457, 412, 1818, 415, 1437, 484, 293, 33311, 3004, 322, 264, 3746, 1219, 42477, 302, 13, 51009], "temperature": 0.0, "avg_logprob": -0.12715786856573982, "compression_ratio": 1.5789473684210527, "no_speech_prob": 0.017169905826449394}, {"id": 84, "seek": 26510, "start": 278.58000000000004, "end": 282.8, "text": " And early in the morning all the people came to him in the temple to hear him.", "tokens": [51039, 400, 2440, 294, 264, 2446, 439, 264, 561, 1361, 281, 796, 294, 264, 10184, 281, 1568, 796, 13, 51250], "temperature": 0.0, "avg_logprob": -0.12715786856573982, "compression_ratio": 1.5789473684210527, "no_speech_prob": 0.017169905826449394}], "language": "English"}