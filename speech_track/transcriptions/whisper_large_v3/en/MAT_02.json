518}, {"id": 50, "seek": 17994, "start": 192.94, "end": 194.94, "text": " he was afraid to go there.", "tokens": [51015, 415, 390, 4638, 281, 352, 456, 13, 51115], "temperature": 0.0, "avg_logprob": -0.08156939697265625, "compression_ratio": 1.6830188679245284, "no_speech_prob": 0.0013190633617341518}, {"id": 51, "seek": 17994, "start": 194.94, "end": 197.94, "text": " And being warned in a dream, he withdrew to the district of Galilee.", "tokens": [51115, 400, 885, 21284, 294, 257, 3055, 11, 415, 12483, 2236, 281, 264, 6566, 295, 7336, 33914, 13, 51265], "temperature": 0.0, "avg_logprob": -0.08156939697265625, "compression_ratio": 1.6830188679245284, "no_speech_prob": 0.0013190633617341518}, {"id": 52, "seek": 17994, "start": 197.94, "end": 200.94, "text": " And he went and lived in a city called Nazareth,", "tokens": [51265, 400, 415, 1437, 293, 5152, 294, 257, 2307, 1219, 11870, 40414, 11, 51415], "temperature": 0.0, "avg_logprob": -0.08156939697265625, "compression_ratio": 1.6830188679245284, "no_speech_prob": 0.0013190633617341518}, {"id": 53, "seek": 17994, "start": 200.94, "end": 204.94, "text": " that what was spoken by the prophets might be fulfilled.", "tokens": [51415, 300, 437, 390, 10759, 538, 264, 27297, 1062, 312, 21380, 13, 51615], "temperature": 0.0, "avg_logprob": -0.08156939697265625, "compression_ratio": 1.6830188679245284, "no_speech_prob": 0.0013190633617341518}, {"id": 54, "seek": 17994, "start": 204.94, "end": 208.94, "text": " He shall be called a Nazarene.", "tokens": [51615, 634, 4393, 312, 1219, 257, 11870, 543, 716, 13, 51815], "temperature": 0.0, "avg_logprob": -0.08156939697265625, "compression_ratio": 1.6830188679245284, "no_speech_prob": 0.0013190633617341518}, {"id": 55, "seek": 20994, "start": 209.94, "end": 212.94, "text": " He that nuestra\u5f02 .", "tokens": [50365, 634, 300, 16825, 5702, 224, 2411, 50515], "temperature": 1.0, "avg_logprob": -0.734223160089231, "compression_ratio": 3.2941176470588234, "no_speech_prob": 0.4347324