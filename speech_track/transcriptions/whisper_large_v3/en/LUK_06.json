eek": 29984, "start": 312.44, "end": 313.84, "text": " A disciple is not above his", "tokens": [50995, 316, 32100, 307, 406, 3673, 702, 51065], "temperature": 0.0, "avg_logprob": -0.13755178098325377, "compression_ratio": 1.7357723577235773, "no_speech_prob": 0.00033533654641360044}, {"id": 59, "seek": 29984, "start": 313.84, "end": 315.85999999999996, "text": " teacher, but everyone when he is", "tokens": [51065, 5027, 11, 457, 1518, 562, 415, 307, 51166], "temperature": 0.0, "avg_logprob": -0.13755178098325377, "compression_ratio": 1.7357723577235773, "no_speech_prob": 0.00033533654641360044}, {"id": 60, "seek": 29984, "start": 315.85999999999996, "end": 317.85999999999996, "text": " fully trained will be like his", "tokens": [51166, 4498, 8895, 486, 312, 411, 702, 51266], "temperature": 0.0, "avg_logprob": -0.13755178098325377, "compression_ratio": 1.7357723577235773, "no_speech_prob": 0.00033533654641360044}, {"id": 61, "seek": 29984, "start": 317.85999999999996, "end": 319.79999999999995, "text": " teacher. Why", "tokens": [51266, 5027, 13, 1545, 51363], "temperature": 0.0, "avg_logprob": -0.13755178098325377, "compression_ratio": 1.7357723577235773, "no_speech_prob": 0.00033533654641360044}, {"id": 62, "seek": 29984, "start": 319.79999999999995, "end": 322.08, "text": " do you see the speck that is in your brother's", "tokens": [51363, 360, 291, 536, 264, 768, 547, 300, 307, 294, 428, 3708, 311, 51477], "temperature": 0.0, "avg_logprob": -0.13755178098325377, "compression_ratio": 1.7357723577235773, "no_speech_prob": 0.00033533654641360044}, {"id": 63, "seek": 29984, "start": 322.08, "end": 324.05999999999995, "text": " eye, but do not notice the log", "tokens": [51477, 3313, 11, 457, 360, 406, 3449, 264, 3565, 51576], "temperature": 0.0, "avg_logprob": -0.13755178098325377, "compression_ratio": 1.7357723577235773, "no_speech_prob": 0.00033533654641360044}, {"id": 64, "seek": 29984, "start": 324.05999999999995, "end": 325.14, "text": " that is in your own eye?", "tokens": [51576, 300, 307, 294, 428, 1065, 3313, 30, 51630], "temperature": 0.0, "avg_logprob": -0.13755178098325377, "compression_ratio": 1.7357723577235773, "no_speech_prob": 0.00033533654641360044}, {"id": 65, "seek": 29984, "start": 325.62, "end": 327.46, "text": " How can you say to your brother,", "tokens": [51654, 1012, 393, 291, 584, 281, 428, 3708, 11, 51746], "temperature": 0.0, "avg_logprob": -0.13755178098325377, "compression_ratio": 1.7357723577235773, "no_speech_prob": 0.00033533654641360044}, {"id": 66, "seek": 29984, "start": 327.46, "end": 329.55999999999995, "text": " Brother, let me take out", "tokens": [51746, 8904, 11, 718, 385, 747, 484, 51851], "temperature": 0.0, "avg_logprob": -0.13755178098325377, "compression_ratio": 1.7357723577235773, "no_speech_prob": 0.00033533654641360044}, {"id": 67, "seek": 32984, "start": 329.84, "end": 331.67999999999995, "text": " the speck that is in your eye, when you", "tokens": [50365, 264, 768, 547, 300, 307, 294, 428, 3313, 11, 562, 291, 50457], "temperature": 0.0, "avg_logprob": -0.11803034373692103, "compression_ratio": 1.8917748917748918, "no_speech_prob": 0.00033273527515120804}, {"id": 68, "seek": 32984, "start": 331.67999999999995, "end": 333.73999999999995, "text": " yourself do not see the log that is in", "tokens": [50457, 1803, 360, 406, 536, 264, 3565, 300, 307, 294, 50560], "temperature": 0.0, "avg_logprob": -0.11803034373692103, "compression_ratio": 1.8917748917748918, "no_speech_prob": 0.00033273527515120804}, {"id": 69, "seek": 32984, "start": 333.73999999999995, "end": 336.21999999999997, "text": " your own eye? You hypocrite!", "tokens": [50560, 428, 1065, 3313, 30, 509, 39419, 642, 0, 50684], "temperature": 0.0, "avg_logprob": -0.11803034373692103, "compression_ratio": 1.8917748917748918, "no_speech_prob": 0.00033273527515120804}, {"id": 70, "seek": 32984, "start": 337.02, "end": 337.53999999999996, "text": " First,", "tokens": [50724, 2386, 11, 50750], "temperature": 0.0, "avg_logprob": -0.11803034373692103, "compression_ratio": 1.8917748917748918, "no_speech_prob": 0.00033273527515120804}, {"id": 71, "seek": 32984, "start": 337.85999999999996, "end": 339.76, "text": " take the log out of your own eye,", "tokens": [50766, 747, 264, 3565, 484, 295, 428, 1065, 3313, 11, 50861], "temperature": 0.0, "avg_logprob": -0.11803034373692103, "compression_ratio": 1.8917748917748918, "no_speech_prob": 0.00033273527515120804}, {"id": 72, "seek": 32984, "start": 340.29999999999995, "end": 341.84, "text": " and then you will see clearly", "tokens": [50888, 293, 550, 291, 486, 536, 4448, 50965], "temperature": 0.0, "avg_logprob": -0.11803034373692103, "compression_ratio": 1.8917748917748918, "no_speech_prob": 0.00033273527515120804}, {"id": 73, "seek": 32984, "start": 341.84, "end": 343.65999999999997, "text": " to take out the speck that is in your", "tokens": [50965, 281, 747, 484, 264, 768, 547, 300, 307, 294, 428, 51056], "temperature": 0.0, "avg_logprob": -0.11803034373692103, "compression_ratio": 1.8917748917748918, "no_speech_prob": 0.00033273527515120804}, {"id": 74, "seek": 32984, "start": 343.65999999999997, "end": 344.34, "text": " brother's eye.", "tokens": [51056, 3708, 311, 3313, 13, 51090], "temperature": 0.0, "avg_logprob": -0.11803034373692103, "compression_ratio": 1.8917748917748918, "no_speech_prob": 0.00033273527515120804}, {"id": 75, "seek": 32984, "start": 345.23999999999995, "end": 347.62, "text": " For no good tree bears bad fruit,", "tokens": [51135, 1171, 572, 665, 4230, 17276, 1578, 6773, 11, 51254], "temperature": 0.0, "avg_logprob": -0.11803034373692103, "compression_ratio": 1.8917748917748918, "no_speech_prob": 0.00033273527515120804}, {"id": 76, "seek": 32984, "start": 347.85999999999996, "end": 349.84, "text": " nor again does a bad tree bear good", "tokens": [51266, 6051, 797, 775, 257, 1578, 4230, 6155, 665, 51365], "temperature": 0.0, "avg_logprob": -0.11803034373692103, "compression_ratio": 1.8917748917748918, "no_speech_prob": 0.00033273527515120804}, {"id": 77, "seek": 32984, "start": 349.84, "end": 351.82, "text": " fruit. For each tree is known", "tokens": [51365, 6773, 13, 1171, 1184, 4230, 307, 2570, 51464], "temperature": 0.0, "avg_logprob": -0.11803034373692103, "compression_ratio": 1.8917748917748918, "no_speech_prob": 0.00033273527515120804}, {"id": 78, "seek": 32984, "start": 351.82, "end": 352.9, "text": " by its own fruit.", "tokens": [51464, 538, 1080, 1065, 6773, 13, 51518], "temperature": 0.0, "avg_logprob": -0.11803034373692103, "compression_ratio": 1.8917748917748918, "no_speech_prob": 0.00033273527515120804}, {"id": 79, "seek": 32984, "start": 353.62, "end": 355.91999999999996, "text": " For figs are not gathered from thorn bushes,", "tokens": [51554, 1171, 2147, 82, 366, 406, 13032, 490, 258, 1865, 34303, 11, 51669], "temperature": 0.0, "avg_logprob": -0.11803034373692103, "compression_ratio": 1.8917748917748918, "no_speech_prob": 0.00033273527515120804}, {"id": 80, "seek": 32984, "start": 356.35999999999996, "end": 357.9, "text": " nor are grapes picked from", "tokens": [51691, 6051, 366, 28032, 6183, 490, 51768], "temperature": 0.0, "avg_logprob": -0.11803034373692103, "compression_ratio": 1.8917748917748918, "no_speech_prob": 0.00033273527515120804}, {"id": 81, "seek": 32984, "start": 357.9, "end": 358.82, "text": " a bramble bush.", "tokens": [51768, 257, 738, 335, 638, 19910, 13, 51814], "temperature": 0.0, "avg_logprob": -0.11803034373692103, "compression_ratio": 1.8917748917748918, "no_speech_prob": 0.00033273527515120804}, {"id": 82, "seek": 35984, "start": 359.84, "end": 361.64, "text": " The good person out of the good treasure", "tokens": [50365, 440, 665, 954, 484, 295, 264, 665, 12985, 50455], "temperature": 0.0, "avg_logprob": -0.1641383651615113, "compression_ratio": 1.7541666666666667, "no_speech_prob": 0.0035101149696856737}, {"id": 83, "seek": 35984, "start": 361.64, "end": 363.35999999999996, "text": " of his heart produces good,", "tokens": [50455