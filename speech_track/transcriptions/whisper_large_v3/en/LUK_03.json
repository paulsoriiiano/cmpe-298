no_speech_prob": 0.0008360519423149526}, {"id": 56, "seek": 19292, "start": 200.79999999999998, "end": 203.06, "text": " You are my beloved Son.", "tokens": [50759, 509, 366, 452, 14553, 5185, 13, 50872], "temperature": 0.0, "avg_logprob": -0.22275427722055977, "compression_ratio": 1.6273584905660377, "no_speech_prob": 0.0008360519423149526}, {"id": 57, "seek": 19292, "start": 203.89999999999998, "end": 206.82, "text": " With you I am well pleased.", "tokens": [50914, 2022, 291, 286, 669, 731, 10587, 13, 51060], "temperature": 0.0, "avg_logprob": -0.22275427722055977, "compression_ratio": 1.6273584905660377, "no_speech_prob": 0.0008360519423149526}, {"id": 58, "seek": 19292, "start": 208.44, "end": 212.72, "text": " Jesus, when he began his ministry, was about thirty years of age,", "tokens": [51141, 2705, 11, 562, 415, 4283, 702, 15024, 11, 390, 466, 11790, 924, 295, 3205, 11, 51355], "temperature": 0.0, "avg_logprob": -0.22275427722055977, "compression_ratio": 1.6273584905660377, "no_speech_prob": 0.0008360519423149526}, {"id": 59, "seek": 19292, "start": 213.32, "end": 215.73999999999998, "text": " being the son, as was supposed, of Joseph,", "tokens": [51385, 885, 264, 1872, 11, 382, 390, 3442, 11, 295, 11170, 11, 51506], "temperature": 0.0, "avg_logprob": -0.22275427722055977, "compression_ratio": 1.6273584905660377, "no_speech_prob": 0.0008360519423149526}, {"id": 60, "seek": 19292, "start": 216.2, "end": 218.5, "text": " the son of Heli, the son of Mathet,", "tokens": [51529, 264, 1872, 295, 6128, 72, 11, 264, 1872, 295, 15776, 302, 11, 51644], "temperature": 0.0, "avg_logprob": -0.22275427722055977, "compression_ratio": 1.6273584905660377, "no_speech_prob": 0.0008360519423149526}, {"id": 61, "seek": 19292, "start": 218.88, "end": 221.35999999999999, "text": " the son of Levi, the son of Melchi,", "tokens": [51663, 264, 1872, 295, 33987, 11, 264, 1872, 295, 7375, 8036, 11, 51787], "temperature": 0.0, "avg_logprob": -0.22275427722055977, "compression_ratio": 1