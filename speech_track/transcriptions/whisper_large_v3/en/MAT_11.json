2859908491373}, {"id": 39, "seek": 8916, "start": 114.94, "end": 117.16, "text": " But to what shall I compare this generation?", "tokens": [51654, 583, 281, 437, 4393, 286, 6794, 341, 5125, 30, 51765], "temperature": 0.0, "avg_logprob": -0.22883473502265084, "compression_ratio": 1.6140350877192982, "no_speech_prob": 0.0016612859908491373}, {"id": 40, "seek": 8916, "start": 117.16, "end": 117.8, "text": " To this generation.", "tokens": [51765, 1407, 341, 5125, 13, 51797], "temperature": 0.0, "avg_logprob": -0.22883473502265084, "compression_ratio": 1.6140350877192982, "no_speech_prob": 0.0016612859908491373}, {"id": 41, "seek": 11916, "start": 119.16, "end": 121.94, "text": " It is like children sitting in the marketplaces,", "tokens": [50365, 467, 307, 411, 2227, 3798, 294, 264, 2142, 34840, 11, 50504], "temperature": 0.0, "avg_logprob": -0.21167267522504252, "compression_ratio": 1.6991150442477876, "no_speech_prob": 0.0015246426919475198}, {"id": 42, "seek": 11916, "start": 122.36, "end": 124.06, "text": " and calling to their playmates.", "tokens": [50525, 293, 5141, 281, 641, 862, 10977, 13, 50610], "temperature": 0.0, "avg_logprob": -0.21167267522504252, "compression_ratio": 1.6991150442477876, "no_speech_prob": 0.0015246426919475198}, {"id": 43, "seek": 11916, "start": 124.6, "end": 126.3, "text": " We played the flute for you,", "tokens": [50637, 492, 3737, 264, 33088, 337, 291, 11, 50722], "temperature": 0.0, "avg_logprob": -0.21167267522504252, "compression_ratio": 1.6991150442477876, "no_speech_prob": 0.0015246426919475198}, {"id": 44, "seek": 11916, "start": 126.56, "end": 127.86, "text": " and you did not dance.", "tokens": [50735, 293, 291, 630, 406, 4489, 13, 50800], "temperature": 0.0, "avg_logprob": -0.21167267522504252, "compression_ratio": 1.6991150442477876, "no_speech_prob": 0.0015246426919475198}, {"id": 45, "seek": 11916, "start": 128.28, "end": 130.85999999999999, "text": " We sing a dirge, and you did not mourn.", "tokens": [50821, 492, 1522, 257, 4746, 432, 11, 293, 291, 630, 406, 22235, 77, 13, 50950], "temperature": 0.0, "avg_logprob": -0.21167267522504252, "compression_ratio": 1.6991150442477876, "no_speech_prob": 0.0015246426919475198}, {"id": 46, "seek": 11916, "start": 131.4, "end": 133.85999999999999, "text": " For John came neither eating nor drinking,", "tokens": [50977, 1171, 2619, 1361, 9662, 3936, 6051, 7583, 11, 51100], "temperature": 0.0, "avg_logprob": -0.21167267522504252, "compression_ratio": 1.6991150442477876, "no_speech_prob": 0.0015246426919475198}, {"id": 47, "seek": 11916, "start": 134.24, "end": 135.02, "text": " and they say,", "tokens": [51119, 293, 436, 584, 11, 51158], "temperature": 0.0, "avg_logprob": -0.21167267522504252, "compression_ratio": 1.6991150442477876, "no_speech_prob": 0.0015246426919475198}, {"id": 48, "seek": 11916, "start": 135.46, "end": 136.6, "text": " He has a demon.", "tokens": [51180, 634, 575, 257, 14283, 13, 51237], "temperature": 0.0, "avg_logprob": -0.21167267522504252, "compression_ratio": 1.6991150442477876, "no_speech_prob": 0.0015246426919475198}, {"id": 49, "seek": 11916, "start": 137.42, "end": 139.46, "text": " The Son of Man came eating and drinking,", "tokens": [51278, 440, 5185, 295, 2458, 1361, 3936, 293, 7583, 11, 51380], "temperature": 0.0, "avg_logprob": -0.21167267522504252, "compression_ratio": 1.6991150442477876, "no_speech_prob": 0.0015246426919475198}, {"id": 50, "seek": 11916, "start": 139.57999999999998, "end": 140.22, "text": " and they say,", "tokens": [51386, 293, 436, 584, 11, 51418], "temperature": 0.0, "avg_logprob": -0.21167267522504252, "compression_ratio": 1.6991150442477876, "no_speech_prob": 0.0015246426919475198}, {"id": 51, "seek": 11916, "start": 140.72, "end": 141.76, "text": " Look at him,", "tokens": [51443, 2053, 412, 796, 11, 51495], "temperature": 0.0, "avg_logprob": -0.21167267522504252, "compression_ratio": 1.6991150442477876, "no_speech_prob": 0.0015246426919475198}, {"id": 52, "seek": 11916, "start": 142.1, "end": 143.94, "text": " a glutton and a drunkard,", "tokens": [51512, 257, 33249, 1756, 293, 257, 11192, 515, 11, 51604], "temperature": 0.0, "avg_logprob": -0.21167267522504252, "compression_ratio": 1.6991150442477876, "no_speech_prob": 0.0015246426919475198}, {"id": 53, "seek": 11916, "start": 143.94, "end": 146.9, "text": " a friend of tax collectors and sinners.", "tokens": [51604, 257, 1277, 295, 3366, 35384, 293, 41004, 13, 51752], "temperature": 0.0, "avg_logprob": -0.21167267522504252, "compression_ratio": 1.6991150442477876, "no_speech_prob": 0.0015246426919475198}, {"id": 54, "seek": 11916, "start": 148.44, "end": 149.07999999999998, "text": " Yet,", "tokens": [51829, 10890, 11, 51861], "temperature": 0.0, "avg_logprob": -0.21167267522504252, "compression_ratio": 1.6991150442477876, "no_speech_prob": 0.0015246426919475198}, {"id": 55, "seek": 14916, "start": 149.16, "end": 152.46, "text": " his wisdom is justified by her deeds.", "tokens": [50365, 702, 10712, 307, 27808, 538, 720, 24539, 13, 50530], "temperature": 0.0, "avg_logprob": -0.34699925655076486, "compression_ratio": 1.6218487394957983, "no_speech_prob": 0.00869904737919569}, {"id": 56, "seek": 14916, "start": 153.46, "end": 157.16, "text": " Then he began to denounce the cities where most of his mighty works had been done,", "tokens": [50580, 1396, 415, 4283, 281, 1441, 7826, 264, 6486, 689, 881, 295, 702, 21556, 1985, 632, 668, 1096, 11, 50765], "temperature": 0.0, "avg_logprob": -0.34699925655076486, "compression_ratio": 1.6218487394957983, "no_speech_prob": 0.00869904737919569}, {"id": 57, "seek": 14916, "start": 157.16, "end": 159.16, "text": " because they did not repent.", "tokens": [50765, 570, 436, 630, 406, 19994, 13, 50865], "temperature": 0.0, "avg_logprob": -0.34699925655076486, "compression_ratio": 1.6218487394957983, "no_speech_prob": 0.00869904737919569}, {"id": 58, "seek": 14916, "start": 159.16, "end": 161.16, "text": " Woe to you, Chorazin!", "tokens": [50865, 6622, 68, 281, 291, 11, 761, 284, 921, 259, 0, 50965], "temperature": 0.0, "avg_logprob": -0.34699925655076486, "compression_ratio": 1.6218487394957983, "no_speech_prob": 0.00869904737919569}, {"id": 59, "seek": 14916, "start": 161.16, "end": 163.16, "text": " Woe to you, Bethsaida!", "tokens": [50965, 6622, 68, 281, 291, 11, 14011, 5790, 2887, 0, 51065], "temperature": 0.0, "avg_logprob": -0.34699925655076486, "compression_ratio": 1.6218487394957983, "no_speech_prob": 0.00869904737919569}, {"id": 60, "seek": 14916, "start": 163.16, "end": 169.16, "text": " For if the mighty works done in you had been done in Tyre and Sidon,", "tokens": [51065, 1171, 498, 264, 21556, 1985, 1096, 294, 291, 632, 668, 1096, 294, 5569, 265, 293, 19797, 266, 11, 51365], "temperature": 0.0, "avg_logprob": -0.34699925655076486, "compression_ratio": 1.6218487394957983, "no_speech_prob": 0.00869904737919569}, {"id": 61, "seek": 14916, "start": 169.16, "end": 174.16, "text": " they would have repented long ago in sackcloth and ashes.", "tokens": [51365, 436, 576, 362, 1085, 6003, 938, 2057, 294, 33209, 3474, 900, 293, 32942, 13, 51615], "temperature": 0.0, "avg_logprob": -0.34699925655076486, "compression_ratio": 1.6218487394957983, "no_speech_prob": 0.00869904737919569}, {"id": 62, "seek": 14916, "start": 174.16, "end": 176.16, "text": " But I tell you,", "tokens": [51615, 583, 286, 980, 291, 11, 51715], "temperature": 0.0, "avg_logprob": -0.34699925655076486, "compression_ratio": 1.6218487394957983, "no_speech_prob": 0.00869904737919569}, {"id": 63, "seek": 14916, "start": 176.16, "end": 179.16, "text": " it will be more bearable on the day of judgment,", "tokens": [51715, 309, 486, 312, 544, 6155, 712, 322, 264, 786, 295, 12216, 11, 51865], "temperature": 0.0, "avg_logprob": -0.34699925655076486, "compression_ratio": 1.6218487394957983, "no_speech_prob": 0.00869904737919569}, {"id": 64, "seek": 17916, "start": 179.16, "end": 181.16, "text": " for Tyre and Sidon,", "tokens": [50365, 337, 5569, 265, 293, 19797, 266, 11, 50465], "temperature": 0.0, "avg_logprob": -0.12415702641010284, "compression_ratio": 1.5957446808510638, "no_speech_prob": 0.006426749750971794}, {"id": 65, "seek": 17916, "start": 181.16, "end": 183.16, "text": " than for you.", "tokens": [50465, 813, 337, 291, 13, 50565], "temperature": 0.0, "avg_logprob": -0.12415702641010284, "compression_ratio": 1.5957446808510638, "no_speech_prob": 0.006426749750971794}, {"id": 66, "seek": 17916, "start": 183.16, "end": 185.16, "text": " And you, Capernaum,", "tokens": [50565, 400, 291, 11, 383, 2332, 629, 449, 11, 50665], "temperature": 0.0, "avg_logprob": -0.12415702641010284, "compression_ratio": 1.5957446808510638, "no_speech_prob": 0.006426749750971794}, {"id": 67, "seek": 17916, "start": 185.16, "end": 187.16, "text": " will you be exalted to heaven?", "tokens": [50665, 486, 291, 312, 454, 35906, 281, 7162, 30, 50765], "temperature": 0.0, "avg_logprob": -0.12415702641010284, "compression_ratio": 1.5957446808510638, "no_speech_prob": 0.006426749750971794}, {"id": 68, "seek": 17916, "start": 187.16, "end": 191.16, "text": " You will be brought down to Hades.", "tokens": [50765, 509, 486, 312, 3038, 760, 281, 389, 2977, 13, 50965], "temperature": 0.0, "avg_logprob": -0.12415702641010284, "compression_ratio": 1.5957446808510638, "no_speech_prob": 0.006426749750971794}, {"id": 69, "seek": 17916, "start": 191.16, "end": 193.16, "text": " For if the mighty works done in you", "tokens": [50965, 1171, 498, 264, 21556, 1985, 1096, 294, 291, 51065], "temperature": 0.0, "avg_logprob": -0.12415702641010284, "compression_ratio": 1.5957446808510638, "no_speech_prob": 0.006426749750971794}, {"id": 70, "seek": 17916, "start": 193.16, "end": 195.16, "text": " had been done in Sodom,", "tokens": [51065, 632, 668, 1096, 294, 42059, 298, 11, 51165], "temperature": 0.0, "avg_logprob": -0.12415702641010284, "compression_ratio": 1.5957446808510638, "no_speech_prob": 0.006426749750971794}, {"id": 71, "seek": 17916, "start": 195.16, "end": 197.16, "text": " it would have remained until this day.", "tokens": [51165, 309, 576, 362, 12780, 1826, 341, 786, 13, 51265], "temperature": 0.0, "avg_logprob": -0.12415702641010284, "compression_ratio": 1.5957446808510638, "no_speech_prob": 0.006426749750971794}, {"id": 72, "seek": 17916, "start": 197.16, "end": 199.16, "text": " But I tell you,", "tokens": [51265, 583, 286, 980, 291, 11, 51365], "temperature": 0.0, "avg_logprob": -0.12415702641010284, "compression_ratio": 1.5957446808510638, "no_speech_prob": 0.006426749750971794}, {"id": 73, "seek": 17916, "start": 199.16, "end": 201.16, "text": " that it will be more tolerable on the day of judgment", "tokens": [51365, 300, 309, 486, 312, 544, 11125, 712, 322, 264, 786, 295, 12216, 51465], "temperature": 0.0, "avg_logprob": -0.12415702641010284, "compression_ratio": 1.5957446808510638, "no_speech_prob": 0.006426749750971794}, {"id": 74, "seek": 17916, "start": 201.16, "end": 203.16, "text": " for the land of Sodom,", "tokens": [51465, 337, 264, 2117, 295, 42059, 298, 11, 51565], "temperature": 0.0, "avg_logprob": -0.12415702641010284, "compression_ratio": 1.5957446808510638, "no_speech_prob": 0.006426749750971794}, {"id": 75, "seek": 17916, "start": 203.16, "end": 205.16, "text": " than for you.", "tokens": [51565, 813, 337, 291, 13, 51665], "temperature": 0.0, "avg_logprob": -0.12415702641010284, "compression_ratio": 1.5957446808510638, "no_speech_prob": 0.006426749750971794}, {"id": 76, "seek": 17916, "start": 205.16, "end": 207.16, "text": " At that time Jesus declared,", "tokens": [51665, 1711, 300, 565, 2705, 15489, 11, 51765], "temperature": 0.0, "avg_logprob": -0.12415702641010284, "compression_ratio": 1.5957446808510638, "no_speech_prob": 0.006426749750971794}, {"id": 77, "seek": 17916, "start": 207.16, "end": 209.16, "text": " I thank you, Father,", "tokens": [51765, 286, 1309, 291, 11, 7085, 11, 51865], "temperature": 0.0, "avg_logprob": -0.12415702641010284, "compression_ratio": 1.5957446808510638, "no_speech_prob": 0.006426749750971794}, {"id": 78, "seek": 20916, "start": 209.16, "end": 211.16, "text": " Lord of heaven and earth,", "tokens": [50365, 3257, 295, 7162, 293, 4120, 11, 50465], "temperature": 0.0, "avg_logprob": -0.05628550369127662, "compression_ratio": 1.730593607305936, "no_speech_prob": 0.003969982732087374}, {"id": 79, "seek": 20916, "start": 211.16, "end": 213.16, "text": " that you have hidden these things", "tokens": [50465, 300, 291, 362, 7633, 613, 721, 50565], "temperature": 0.0, "avg_logprob": -0.05628550369127662, "compression_ratio": 1.730593607305936, "no_speech_prob": 0.003969982732087374}, {"id": 80, "seek": 20916, "start": 213.16, "end": 215.16, "text": " from the wise and understanding,", "tokens": [50565, 490, 264, 10829, 293, 3701, 11, 50665], "temperature": 0.0, "avg_logprob": -0.05628550369127662, "compression_ratio": 1.730593607305936, "no_speech_prob": 0.003969982732087374}, {"id": 81, "seek": 20916, "start": 215.16, "end": 217.16, "text": " and revealed them to little children.", "tokens": [50665, 293, 9599, 552, 281, 707, 2227, 13, 50765], "temperature": 0.0, "avg_logprob": -0.05628550369127662, "compression_ratio": 1.730593607305936, "no_speech_prob": 0.003969982732087374}, {"id": 82, "seek": 20916, "start": 217.16, "end": 219.16, "text": " Yes, Father,", "tokens": [50765, 1079, 11, 7085, 11, 50865], "temperature": 0.0, "avg_logprob": -0.05628550369127662, "compression_ratio": 1.730593607305936, "no_speech_prob": 0.003969982732087374}, {"id": 83, "seek": 20916, "start": 219.16, "end": 221.16, "text": " for such was your gracious will.", "tokens": [50865, 337, 1270, 390, 428, 36113, 486, 13, 50965], "temperature": 0.0, "avg_logprob": -0.05628550369127662, "compression_ratio": 1.730593607305936, "no_speech_prob": 0.003969982732087374}, {"id": 84, "seek": 20916, "start": 221.16, "end": 223.16, "text": " All things have been handed over", "tokens": [50965, 1057, 721, 362, 668, 16013, 670, 51065], "temperature": 0.0, "avg_logprob": -0.05628550369127662, "compression_ratio": 1.730593607305936, "no_speech_prob": 0.003969982732087374}, {"id": 85, "seek": 20916, "start": 223.16, "end": 225.16, "text": " to me by my Father,", "tokens": [51065, 281, 385, 538, 452, 7085, 11, 51165], "temperature": 0.0, "avg_logprob": -0.05628550369127662, "compression_ratio": 1.730593607305936, "no_speech_prob": 0.003969982732087374}, {"id": 86, "seek": 20916, "start": 225.16, "end": 227.16, "text": " and no one knows the Son except the Father,", "tokens": [51165, 293, 572, 472, 3255, 264, 5185, 3993, 264, 7085, 11, 51265], "temperature": 0.0, "avg_logprob": -0.05628550369127662, "compression_ratio": 1.730593607305936, "no_speech_prob": 0.003969982732087374}, {"id": 87, "seek": 20916, "start": 227.16, "end": 229.16, "text": " and no one knows the Father", "tokens": [51265, 293, 572, 472, 3255, 264, 7085, 51365], "temperature": 0.0, "avg_logprob": -0.05628550369127662, "compression_ratio": 1.730593607305936, "no_speech_prob": 0.003969982732087374}, {"id": 88, "seek": 20916, "start": 229.16, "end": 231.16, "text": " except the Son,", "tokens": [51365, 3993, 264, 5185, 11, 51465], "temperature": 0.0, "avg_logprob": -0.05628550369127662, "compression_ratio": 1.730593607305936, "no_speech_prob": 0.003969982732087374}, {"id": 89, "seek": 20916, "start": 231.16, "end": 233.16, "text": " and anyone to whom the Son", "tokens": [51465, 293, 2878, 281, 7101, 264, 5185, 51565], "temperature": 0.0, "avg_logprob": -0.05628550369127662, "compression_ratio": 1.730593607305936, "no_speech_prob": 0.003969982732087374}, {"id": 90, "seek": 20916, "start": 233.16, "end": 235.16, "text": " chooses to reveal him.", "tokens": [51565, 25963, 281, 10658, 796, 13, 51665], "temperature": 0.0, "avg_logprob": -0.05628550369127662, "compression_ratio": 1.730593607305936, "no_speech_prob": 0.003969982732087374}, {"id": 91, "seek": 20916, "start": 235.16, "end": 237.16, "text": " Come to me,", "tokens": [51665, 2492, 281, 385, 11, 51765], "temperature": 0.0, "avg_logprob": -0.05628550369127662, "compression_ratio": 1.730593607305936, "no_speech_prob": 0.003969982732087374}, {"id": 92, "seek": 23716, "start": 237.16, "end": 239.16, "text": " all who labor", "tokens": [50365, 439, 567, 5938, 50465], "temperature": 0.0, "avg_logprob": -0.047836533299198854, "compression_ratio": 1.510204081632653, "no_speech_prob": 0.0020480137318372726}, {"id": 93, "seek": 23716, "start": 239.16, "end": 241.16, "text": " and are heavy laden,", "tokens": [50465, 293, 366, 4676, 6632, 268, 11, 50565], "temperature": 0.0, "avg_logprob": -0.047836533299198854, "compression_ratio": 1.510204081632653, "no_speech_prob": 0.0020480137318372726}, {"id": 94, "seek": 23716, "start": 241.16, "end": 243.16, "text": " and I will give you rest.", "tokens": [50565, 293, 286, 486, 976, 291, 1472, 13, 50665], "temperature": 0.0, "avg_logprob": -0.047836533299198854, "compression_ratio": 1.510204081632653, "no_speech_prob": 0.0020480137318372726}, {"id": 95, "seek": 23716, "start": 243.16, "end": 245.16, "text": " Take my yoke upon you,", "tokens": [50665, 3664, 452, 288, 2949, 3564, 291, 11, 50765], "temperature": 0.0, "avg_logprob": -0.047836533299198854, "compression_ratio": 1.510204081632653, "no_speech_prob": 0.0020480137318372726}, {"id": 96, "seek": 23716, "start": 245.16, "end": 247.16, "text": " and learn from me,", "tokens": [50765, 293, 1466, 490, 385, 11, 50865], "temperature": 0.0, "avg_logprob": -0.047836533299198854, "compression_ratio": 1.510204081632653, "no_speech_prob": 0.0020480137318372726}, {"id": 97, "seek": 23716, "start": 247.16, "end": 249.16, "text": " for I am gentle and lowly in heart,", "tokens": [50865, 337, 286, 669, 6424, 293, 2295, 356, 294, 1917, 11, 50965], "temperature": 0.0, "avg_logprob": -0.047836533299198854, "compression_ratio": 1.510204081632653, "no_speech_prob": 0.0020480137318372726}, {"id": 98, "seek": 23716, "start": 249.16, "end": 251.16, "text": " and you will find rest", "tokens": [50965, 293, 291, 486, 915, 1472, 51065], "temperature": 0.0, "avg_logprob": -0.047836533299198854, "compression_ratio": 1.510204081632653, "no_speech_prob": 0.0020480137318372726}, {"id": 99, "seek": 23716, "start": 251.16, "end": 253.16, "text": " for your souls.", "tokens": [51065, 337, 428, 16588, 13, 51165], "temperature": 0.0, "avg_logprob": -0.047836533299198854, "compression_ratio": 1.510204081632653, "no_speech_prob": 0.0020480137318372726}, {"id": 100, "seek": 23716, "start": 253.16, "end": 255.16, "text": " For my yoke is easy,", "tokens": [51165, 1171, 452, 288, 2949, 307, 1858, 11, 51265], "temperature": 0.0, "avg_logprob": -0.047836533299198854, "compression_ratio": 1.510204081632653, "no_speech_prob": 0.0020480137318372726}, {"id": 101, "seek": 23716, "start": 255.16, "end": 257.15999999999997, "text": " and my burden is light.", "tokens": [51265, 293, 452, 12578, 307, 1442, 13, 51365], "temperature": 0.0, "avg_logprob": -0.047836533299198854, "compression_ratio": 1.510204081632653, "no_speech_prob": 0.0020480137318372726}], "language": "English"}