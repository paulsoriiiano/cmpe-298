27297, 645, 1826, 11, 51857], "temperature": 0.0, "avg_logprob": -0.22334609543981632, "compression_ratio": 1.7171314741035857, "no_speech_prob": 0.0010566338896751404}, {"id": 41, "seek": 14448, "start": 144.48, "end": 148.54, "text": " John, since then, the good news of the kingdom of God is preached,", "tokens": [50365, 2619, 11, 1670, 550, 11, 264, 665, 2583, 295, 264, 10231, 295, 1265, 307, 40001, 11, 50568], "temperature": 0.0, "avg_logprob": -0.1508267936059984, "compression_ratio": 1.7391304347826086, "no_speech_prob": 0.0011694813147187233}, {"id": 42, "seek": 14448, "start": 148.95999999999998, "end": 151.22, "text": " and everyone forces his way into it.", "tokens": [50589, 293, 1518, 5874, 702, 636, 666, 309, 13, 50702], "temperature": 0.0, "avg_logprob": -0.1508267936059984, "compression_ratio": 1.7391304347826086, "no_speech_prob": 0.0011694813147187233}, {"id": 43, "seek": 14448, "start": 151.78, "end": 154.6, "text": " But it is easier for heaven and earth to pass away", "tokens": [50730, 583, 309, 307, 3571, 337, 7162, 293, 4120, 281, 1320, 1314, 50871], "temperature": 0.0, "avg_logprob": -0.1508267936059984, "compression_ratio": 1.7391304347826086, "no_speech_prob": 0.0011694813147187233}, {"id": 44, "seek": 14448, "start": 154.6, "end": 157.5, "text": " than for one dot of the law to become void.", "tokens": [50871, 813, 337, 472, 5893, 295, 264, 2101, 281, 1813, 22009, 13, 51016], "temperature": 0.0, "avg_logprob": -0.1508267936059984, "compression_ratio": 1.7391304347826086, "no_speech_prob": 0.0011694813147187233}, {"id": 45, "seek": 14448, "start": 158.48, "end": 162.1, "text": " Everyone who divorces his wife and marries another commits adultery,", "tokens": [51065, 5198, 567, 11861, 887, 702, 3836, 293, 1849, 2244, 1071, 48311, 26885, 12733, 11, 51246], "temperature": 0.0, "avg_logprob": -0.1508267936059984, "compression_ratio": 1.7391304347826086, "no_speech_prob": 0.0011694813147187233}, {"id": 46, "seek": 14448, "start": 162.51999999999998, "end": 166.32, "text": " and he who marries a woman divorced from her husband commits adultery.", "tokens": [51267, 293, 415, 567, 1849, 2244, 257, 3059, 27670, 490, 720, 5213, 48311, 26885, 12733, 13, 51457], "temperature": 0.0, "avg_logprob": -0.1508267936059984, "compression_ratio": 1.7391304347826086, "no_speech_prob": 0.0011694813147187233}, {"id": 47, "seek": 14448, "start": 167.44, "end": 171.54, "text": " There was a rich man who was clothed in purple and fine linen,", "tokens": [51513, 821, 390, 257, 4593, 587, 567, 390, 13619, 292, 294, 9656, 293, 2489, 46602, 11, 51718], "temperature": 0.0, "avg_logprob": -0.1508267936059984, "compression_ratio": 1.7391304347826086, "no_speech_prob": 0.0011694813147187233}, {"id": 48, "seek": 14448, "start": 171.54, "end": 174.28, "text": " and who feasted sumptuously every day.", "tokens": [51718, 293, 567, 23707, 292, 2408, 662, 84, 5098, 633, 786, 13, 51855], "temperature": 0.0, "avg_logprob": -0.1508267936059984, "compression_ratio": 1.7391304347826086, "no_speech_prob": 0.0011694813147187233}, {"id": 49, "seek": 17448, "start": 174.48, "end": 178.14, "text": " And at his gate was laid a poor man named Lazarus,", "tokens": [50365, 400, 412, 702, 8539, 390, 9897, 257, 4716, 587, 4926, 49273, 301, 11, 50548], "temperature": 0.0, "avg_logprob": -0.17777471542358397, "compression_ratio": 1.6893617021276597, "no_speech_prob": 0.0705186128616333}, {"id": 50, "seek": 17448, "start": 178.57999999999998, "end": 179.76, "text": " covered with sores,", "tokens": [50570, 5343, 365, 370, 495, 11, 50629], "temperature": 0.0, "avg_logprob": -0.17777471542358397, "compression_ratio": 1.6893617021276597, "no_speech_prob": 0.0705186128616333}, {"id": 51, "seek": 17448, "start": 180.06, "end": 183.2, "text": " who desired to be fed with what fell from the rich man's table.", "tokens": [50644, 567, 14721, 281, 312, 4636, 365, 437, 5696, 490, 264, 4593, 587, 311, 3199, 13, 50801], "temperature": 0.0, "avg_logprob": -0.17777471542358397, "compression_ratio": 1.6893617021276597, "no_speech_prob": 0.0705186128616333}, {"id": 52, "seek": 17448, "start": 184.04, "end": 187.92, "text": " Moreover, even the dogs came and licked his sores.", "tokens": [50843, 19838, 11, 754, 264, 7197, 1361, 293, 287, 12598, 702, 370, 495, 13, 51037], "temperature": 0.0, "avg_logprob": -0.17777471542358397, "compression_ratio": 1.6893617021276597, "no_speech_prob": 0.0705186128616333}, {"id": 53, "seek": 17448, "start": 188.85999999999999, "end": 190.07999999999998, "text": " The poor man died,", "tokens": [51084, 440, 4716, 587, 4539, 11, 51145], "temperature": 0.0, "avg_logprob": -0.17777471542358397, "compression_ratio": 1.6893617021276597, "no_speech_prob": 0.0705186128616333}, {"id": 54, "seek": 17448, "start": 190.38, "end": 193.35999999999999, "text": " and was carried by the angels to Abraham's side.", "tokens": [51160, 293, 390, 9094, 538, 264, 18175, 281, 17782, 311, 1252, 13, 51309], "temperature": 0.0, "avg_logprob": -0.17777471542358397, "compression_ratio": 1.6893617021276597, "no_speech_prob": 0.0705186128616333}, {"id": 55, "seek": 17448, "start": 194.0, "end": 196.62, "text": " The rich man also died, and was buried.", "tokens": [51341, 440, 4593, 587, 611, 4539, 11, 293, 390, 14101, 13, 51472], "temperature": 0.0, "avg_logprob": -0.17777471542358397, "compression_ratio": 1.6893617021276597, "no_speech_prob": 0.0705186128616333}, {"id": 56, "seek": 17448, "start": 197.26, "end": 199.62, "text": " And in Hades, being in torment,", "tokens": [51504, 400, 294, 389, 2977, 11, 885, 294, 36662, 11, 51622], "temperature": 0.0, "avg_logprob": -0.17777471542358397, "compression_ratio": 1.6893617021276597, "no_speech_prob": 0.0705186128616333}, {"id": 57, "seek": 17448, "start": 199.79999999999998, "end": 202.66, "text": " he lifted up his eyes and saw Abraham far off,", "tokens": [51631, 415, 17854, 493, 702, 2575, 293, 1866, 17782, 1400, 766, 11, 51774], "temperature": 0.0, "avg_logprob": -0.17777471542358397, "compression_ratio": 1.6893617021276597, "no_speech_prob": 0.0705186128616333}, {"id": 58, "seek": 17448, "start": 202.66, "end": 204.45999999999998, "text": " and Lazarus at his side,", "tokens": [51774, 293, 49273, 301, 412, 702, 1252, 11, 51864], "temperature": 0.0, "avg_logprob": -0.17777471542358397, "compression_ratio": 1.6893617021276597, "no_speech_prob": 0.0705186128616333}, {"id": 59, "seek": 20448, "start": 204.48, "end": 206.72, "text": " and he called out,", "tokens": [50365, 293, 415, 1219, 484, 11, 50477], "temperature": 0.0, "avg_logprob": -0.2304197379520961, "compression_ratio": 1.6311111111111112, "no_speech_prob": 0.00012830831110477448}, {"id": 60, "seek": 20448, "start": 207.34, "end": 210.07999999999998, "text": " Father Abraham, have mercy on me,", "tokens": [50508, 7085, 17782, 11, 362, 13174, 322, 385, 11, 50645], "temperature": 0.0, "avg_logprob": -0.2304197379520961, "compression_ratio": 1.6311111111111112, "no_speech_prob": 0.00012830831110477448}, {"id": 61, "seek": 20448, "start": 210.32, "end": 213.45999999999998, "text": " and send Lazarus to dip the end of his finger in water,", "tokens": [50657, 293, 2845, 49273, 301, 281, 10460, 264, 917, 295, 702, 5984, 294, 1281, 11, 50814], "temperature": 0.0, "avg_logprob": -0.2304197379520961, "compression_ratio": 1.6311111111111112, "no_speech_prob": 0.00012830831110477448}, {"id": 62, "seek": 20448, "start": 213.82, "end": 215.14, "text": " and cool my tongue,", "tokens": [50832, 293, 1627, 452, 10601, 11, 50898], "temperature": 0.0, "avg_logprob": -0.2304197379520961, "compression_ratio": 1.6311111111111112, "no_speech_prob": 0.00012830831110477448}, {"id": 63, "seek": 20448, "start": 215.48, "end": 217.98, "text": " for I am in anguish in this flame.", "tokens": [50915, 337, 286, 669, 294, 2562, 33786, 294, 341, 13287, 13, 51040], "temperature": 0.0, "avg_logprob": -0.2304197379520961, "compression_ratio": 1.6311111111111112, "no_speech_prob": 0.00012830831110477448}, {"id": 64, "seek": 20448, "start": 218.89999999999998, "end": 220.51999999999998, "text": " But Abraham said,", "tokens": [51086, 583, 17782, 848, 11, 51167], "temperature": 0.0, "avg_logprob": -0.2304197379520961, "compression_ratio": 1.6311111111111112, "no_speech_prob": 0.00012830831110477448}, {"id": 65, "seek": 20448, "start": 221.01999999999998, "end": 225.39999999999998, "text": " Child, remember that you in your lifetime received your good things,", "tokens": [51192, 9004, 11, 1604, 300, 291, 294, 428, 11364, 4613, 428, 665, 721, 11, 51411], "temperature": 0.0, "avg_logprob": -0.2304197379520961, "compression_ratio": 1.6311111111111112, "no_speech_prob": 0.00012830831110477448}, {"id": 66, "seek": 20448, "start": 225.78, "end": 228.16, "text": " and Lazarus and like men are bad things.", "tokens": [51430, 293, 49273, 301, 293, 411, 1706, 366, 1578, 721, 13, 51549], "temperature": 0.0, "avg_logprob": -0.2304197379520961, "compression_ratio": 1.6311111111111112, "no_speech_prob": 0.00012830831110477448}, {"id": 67, "seek": 20448, "start": 228.79999999999998, "end": 231.01999999999998, "text": " But now he is comforted here,", "tokens": [51581, 583, 586, 415, 307, 3400, 292, 510, 11, 51692], "temperature": 0.0, "avg_logprob": -0.2304197379520961, "compression_ratio": 1.6311111111111112, "no_speech_prob": 0.00012830831110477448}, {"id": 68, "seek": 20448, "start": 231.51999999999998, "end": 232.78, "text": " and you are in anguish.", "tokens": [51717, 293, 291, 366, 294, 2562, 33786, 13, 51780], "temperature": 0.0, "avg_logprob": -0.2304197379520961, "compression_ratio": 1.6311111111111112, "no_speech_prob": 0.00012830831110477448}, {"id": 69, "seek": 20448, "start": 232.78, "end": 234.45999999999998, "text": " And besides all this,", "tokens": [51780, 400, 11868, 439, 341, 11, 51864], "temperature": 0.0, "avg_logprob": -0.2304197379520961, "compression_ratio": 1.6311111111111112, "no_speech_prob": 0.00012830831110477448}, {"id": 70, "seek": 23448, "start": 234.76, "end": 238.04, "text": " between us and you a great chasm has been fixed,", "tokens": [50379, 1296, 505, 293, 291, 257, 869, 417, 14774, 575, 668, 6806, 11, 50543], "temperature": 0.0, "avg_logprob": -0.19853190194189022, "compression_ratio": 1.6111111111111112, "no_speech_prob": 0.002777396934106946}, {"id": 71, "seek": 23448, "start": 238.45999999999998, "end": 242.89999999999998, "text": " in order that those who would pass from here to you may not be able,", "tokens": [50564, 294, 1668, 300, 729, 567, 576, 1320, 490, 510, 281, 291, 815, 406, 312, 1075, 11, 50786], "temperature": 0.0, "avg_logprob": -0.19853190194189022, "compression_ratio": 1.6111111111111112, "no_speech_prob": 0.002777396934106946}, {"id": 72, "seek": 23448, "start": 243.29999999999998, "end": 245.88, "text": " and none may cross from there to us.", "tokens": [50806, 293, 6022, 815, 3278, 490, 456, 281, 505, 13, 50935], "temperature": 0.0, "avg_logprob": -0.19853190194189022, "compression_ratio": 1.6111111111111112, "no_speech_prob": 0.002777396934106946}, {"id": 73, "seek": 23448, "start": 246.73999999999998, "end": 247.88, "text": " And he said,", "tokens": [50978, 400, 415, 848, 11, 51035], "temperature": 0.0, "avg_logprob": -0.19853190194189022, "compression_ratio": 1.6111111111111112, "no_speech_prob": 0.002777396934106946}, {"id": 74, "seek": 23448, "start": 248.39999999999998, "end": 252.01999999999998, "text": " Then I beg you, Father, to send him to my father's house,", "tokens": [51061, 1396, 286, 4612, 291, 11, 7085, 11, 281, 2845, 796, 281, 452, 3086, 311, 1782, 11, 51242], "temperature": 0.0, "avg_logprob": -0.19853190194189022, "compression_ratio": 1.6111111111111112, "no_speech_prob": 0.002777396934106946}, {"id": 75, "seek": 23448, "start": 252.54, "end": 253.88, "text": " for I have five brothers,", "tokens": [51268, 337, 286, 362, 1732, 8452, 11, 51335], "temperature": 0.0, "avg_logprob": -0.19853190194189022, "compression_ratio": 1.6111111111111112, "no_speech_prob": 0.002777396934106946}, {"id": 76, "seek": 23448, "start": 254.22, "end": 255.72, "text": " so that he may warn them,", "tokens": [51352, 370, 300, 415, 815, 12286, 552, 11, 51427], "temperature": 0.0, "avg_logprob": -0.19853190194189022, "compression_ratio": 1.6111111111111112, "no_speech_prob": 0.002777396934106946}, {"id": 77, "seek": 23448, "start": 256.06, "end": 258.62, "text": " lest they also come into this place of torment.", "tokens": [51444, 287, 377, 436, 611, 808, 666, 341, 1081, 295, 36662, 13, 51572], "temperature": 0.0, "avg_logprob": -0.19853190194189022, "compression_ratio": 1.6111111111111112, "no_speech_prob": 0.002777396934106946}, {"id": 78, "seek": 23448, "start": 259.62, "end": 260.92, "text": " But Abraham said,", "tokens": [51622, 583, 17782, 848, 11, 51687], "temperature": 0.0, "avg_logprob": -0.19853190194189022, "compression_ratio": 1.6111111111111112, "no_speech_prob": 0.002777396934106946}, {"id": 79, "seek": 23448, "start": 261.21999999999997, "end": 264.06, "text": " They have Moses and the prophets,", "tokens": [51702, 814, 362, 17580, 293, 264, 27297, 11, 51844], "temperature": 0.0, "avg_logprob": -0.19853190194189022, "compression_ratio": 1.6111111111111112, "no_speech_prob": 0.002777396934106946}, {"id": 80, "seek": 26448, "start": 264.48, "end": 265.78000000000003, "text": " let them hear them.", "tokens": [50365, 718, 552, 1568, 552, 13, 50430], "temperature": 0.0, "avg_logprob": -0.30714859900536473, "compression_ratio": 1.5527950310559007, "no_speech_prob": 0.0035640886053442955}, {"id": 81, "seek": 26448, "start": 266.62, "end": 267.34000000000003, "text": " And he said,", "tokens": [50472, 400, 415, 848, 11, 50508], "temperature": 0.0, "avg_logprob": -0.30714859900536473, "compression_ratio": 1.5527950310559007, "no_speech_prob": 0.0035640886053442955}, {"id": 82, "seek": 26448, "start": 267.76, "end": 269.06, "text": " No, Father Abraham,", "tokens": [50529, 883, 11, 7085, 17782, 11, 50594], "temperature": 0.0, "avg_logprob": -0.30714859900536473, "compression_ratio": 1.5527950310559007, "no_speech_prob": 0.0035640886053442955}, {"id": 83, "seek": 26448, "start": 269.40000000000003, "end": 271.58000000000004, "text": " but if someone goes to them from the dead,", "tokens": [50611, 457, 498, 1580, 1709, 281, 552, 490, 264, 3116, 11, 50720], "temperature": 0.0, "avg_logprob": -0.30714859900536473, "compression_ratio": 1.5527950310559007, "no_speech_prob": 0.0035640886053442955}, {"id": 84, "seek": 26448, "start": 272.04, "end": 272.92, "text": " they will repent.", "tokens": [50743, 436, 486, 19994, 13, 50787], "temperature": 0.0, "avg_logprob": -0.30714859900536473, "compression_ratio": 1.5527950310559007, "no_speech_prob": 0.0035640886053442955}, {"id": 85, "seek": 26448, "start": 273.94, "end": 275.1, "text": " He said to him,", "tokens": [50838, 634, 848, 281, 796, 11, 50896], "temperature": 0.0, "avg_logprob": -0.30714859900536473, "compression_ratio": 1.5527950310559007, "no_speech_prob": 0.0035640886053442955}, {"id": 86, "seek": 26448, "start": 275.5, "end": 278.40000000000003, "text": " If they do not hear Moses and the prophets,", "tokens": [50916, 759, 436, 360, 406, 1568, 17580, 293, 264, 27297, 11, 51061], "temperature": 0.0, "avg_logprob": -0.30714859900536473, "compression_ratio": 1.5527950310559007, "no_speech_prob": 0.0035640886053442955}, {"id": 87, "seek": 26448, "start": 279.04, "end": 282.46000000000004, "text": " neither will they be convinced if someone should rise from the dead.", "tokens": [51093, 9662, 486, 436, 312, 12561, 498, 1580, 820, 6272, 490, 264, 3116, 13, 51264], "temperature": 0.0, "avg_logprob": -0.30714859900536473, "compression_ratio": 1.5527950310559007, "no_speech_prob": 0.0035640886053442955}, {"id": 88, "seek": 26448, "start": 282.46000000000004, "end": 284.46000000000004, "text": " The End", "tokens": [51264, 440, 6967, 51364], "temperature": 0.0, "avg_logprob": -0.30714859900536473, "compression_ratio": 1.5527950310559007, "no_speech_prob": 0.0035640886053442955}], "language": "English"}