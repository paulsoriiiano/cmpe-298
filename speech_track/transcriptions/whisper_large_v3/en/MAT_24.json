34, "no_speech_prob": 0.003706890856847167}, {"id": 43, "seek": 14598, "start": 147.51999999999998, "end": 150.16, "text": " And if those days had not been cut short,", "tokens": [50442, 400, 498, 729, 1708, 632, 406, 668, 1723, 2099, 11, 50574], "temperature": 0.0, "avg_logprob": -0.1914438247680664, "compression_ratio": 1.6708333333333334, "no_speech_prob": 0.003706890856847167}, {"id": 44, "seek": 14598, "start": 150.45999999999998, "end": 152.45999999999998, "text": " no human being would be saved.", "tokens": [50589, 572, 1952, 885, 576, 312, 6624, 13, 50689], "temperature": 0.0, "avg_logprob": -0.1914438247680664, "compression_ratio": 1.6708333333333334, "no_speech_prob": 0.003706890856847167}, {"id": 45, "seek": 14598, "start": 152.94, "end": 156.23999999999998, "text": " But for the sake of the elect those days will be cut short.", "tokens": [50713, 583, 337, 264, 9717, 295, 264, 2185, 729, 1708, 486, 312, 1723, 2099, 13, 50878], "temperature": 0.0, "avg_logprob": -0.1914438247680664, "compression_ratio": 1.6708333333333334, "no_speech_prob": 0.003706890856847167}, {"id": 46, "seek": 14598, "start": 157.04, "end": 158.42, "text": " Then if anyone says to you,", "tokens": [50918, 1396, 498, 2878, 1619, 281, 291, 11, 50987], "temperature": 0.0, "avg_logprob": -0.1914438247680664, "compression_ratio": 1.6708333333333334, "no_speech_prob": 0.003706890856847167}, {"id": 47, "seek": 14598, "start": 158.76, "end": 161.67999999999998, "text": " Look, here is the Christ, or there he is,", "tokens": [51004, 2053, 11, 510, 307, 264, 2040, 11, 420, 456, 415, 307, 11, 51150], "temperature": 0.0, "avg_logprob": -0.1914438247680664, "compression_ratio": 1.6708333333333334, "no_speech_prob": 0.003706890856847167}, {"id": 48, "seek": 14598, "start": 162.5, "end": 163.67999999999998, "text": " do not believe it.", "tokens": [51191, 360, 406, 1697, 309, 13, 51250], "temperature": 0.0, "avg_logprob": -0.1914438247680664, "compression_ratio": 1.6708333333333334, "no_speech_prob": 0.003706890856847167}, {"id": 49, "seek": 14598, "start": 164.33999999999997, "end": 167.44, "text": " For false Christs and false prophets will arise", "tokens": [51283, 1171, 7908, 1721, 1751, 293, 7908, 27297, 486, 20288, 51438], "temperature": 0.0, "avg_logprob": -0.1914438247680664, "compression_ratio": 1.6708333333333334, "no_speech_prob": 0.003706890856847167}, {"id": 50, "seek": 14598, "start": 167.44, "end": 169.67999999999998, "text": " and perform great signs and wonders,", "tokens": [51438, 293, 2042, 869, 7880, 293, 27348, 11, 51550], "temperature": 0.0, "avg_logprob": -0.1914438247680664, "compression_ratio": 1.6708333333333334, "no_speech_prob": 0.003706890856847167}, {"id": 51, "seek": 14598, "start": 170.07999999999998, "end": 173.35999999999999, "text": " so as to lead astray, if possible, even the elect.", "tokens": [51570, 370, 382, 281, 1477, 5357, 3458, 11, 498, 1944, 11, 754, 264, 2185, 13, 51734], "temperature": 0.0, "avg_logprob": -0.1914438247680664, "compression_ratio": 1.6708333333333334, "no_speech_prob": 0.003706890856847167}, {"id": 52, "seek": 14598, "start": 174.26, "end": 175.95999999999998, "text": " See, I have told you before,", "tokens": [51779, 3008, 11, 286, 362, 1907, 291, 949, 11, 51864], "temperature": 0.0, "avg_logprob": -0.1914438247680664, "compression_ratio": 1.6708333333333334, "no_speech_prob": 0.003706890856847167}, {"id": 53, "seek": 17598, "start": 175.98, "end": 178.39999999999998, "text": " So, if they say to you,", "tokens": [50365, 407, 11, 498, 436, 584, 281, 291, 11, 50486], "temperature": 0.0, "avg_logprob": -0.2002424716949463, "compression_ratio": 1.7293577981651376, "no_speech_prob": 0.0024153266567736864}, {"id": 54, "seek": 17598, "start": 178.7, "end": 179.92, "text": " Look, he is in the wilderness,", "tokens": [50501, 2053, 11, 415, 307, 294, 264, 27613, 11, 50562], "temperature": 0.0, "avg_logprob": -0.2002424716949463, "compression_ratio": 1.7293577981651376, "no_speech_prob": 0.0024153266567736864}, {"id": 55, "seek": 17598, "start": 180.5, "end": 181.45999999999998, "text": " do not go out.", "tokens": [50591, 360, 406, 352, 484, 13, 50639], "temperature": 0.0, "avg_logprob": -0.2002424716949463, "compression_ratio": 1.7293577981651376, "no_speech_prob": 0.0024153266567736864}, {"id": 56, "seek": 17598, "start": 182.1, "end": 182.98, "text": " If they say,", "tokens": [50671, 759, 436, 584, 11, 50715], "temperature": 0.0, "avg_logprob": -0.2002424716949463, "compression_ratio": 1.7293577981651376, "no_speech_prob": 0.0024153266567736864}, {"id": 57, "seek": 17598, "start": 183.32, "end": 184.88, "text": " Look, he is in the inner rooms,", "tokens": [50732, 2053, 11, 415, 307, 294, 264, 7284, 9396, 11, 50810], "temperature": 0.0, "avg_logprob": -0.2002424716949463, "compression_ratio": 1.7293577981651376, "no_speech_prob": 0.0024153266567736864}, {"id": 58, "seek": 17598, "start": 185.26, "end": 186.44, "text": " do not believe it.", "tokens": [50829, 360, 406, 1697, 309, 13, 50888], "temperature": 0.0, "avg_logprob": -0.2002424716949463, "compression_ratio": 1.7293577981651376, "no_speech_prob": 0.0024153266567736864}, {"id": 59, "seek": 17598, "start": 187.33999999999997, "end": 191.92, "text": " For as the lightning comes from the east and shines as far as the west,", "tokens": [50933, 1171, 382, 264, 16589, 1487, 490, 264, 10648, 293, 28056, 382, 1400, 382, 264, 7009, 11, 51162], "temperature": 0.0, "avg_logprob": -0.2002424716949463, "compression_ratio": 1.7293577981651376, "no_speech_prob": 0.0024153266567736864}, {"id": 60, "seek": 17598, "start": 192.45999999999998, "end": 195.07999999999998, "text": " so will be the coming of the Son of Man.", "tokens": [51189, 370, 486, 312, 264, 1348, 295, 264, 5185, 295, 2458, 13, 51320], "temperature": 0.0, "avg_logprob": -0.2002424716949463, "compression_ratio": 1.7293577981651376, "no_speech_prob": 0.0024153266567736864}, {"id": 61, "seek": 17598, "start": 196.07999999999998, "end": 197.51999999999998, "text": " Wherever the corpse is,", "tokens": [51370, 30903, 264, 30324, 307, 11, 51442], "temperature": 0.0, "avg_logprob": -0.2002424716949463, "compression_ratio": 1.7293577981651376, "no_speech_prob": 0.0024153266567736864}, {"id": 62, "seek": 17598, "start": 197.85999999999999, "end": 199.5, "text": " there the vultures will gather.", "tokens": [51459, 456, 264, 371, 723, 1303, 486, 5448, 13, 51541], "temperature": 0.0, "avg_logprob": -0.2002424716949463, "compression_ratio": 1.7293577981651376, "no_speech_prob": 0.0024153266567736864}, {"id": 63, "seek": 17598, "start": 201.06, "end": 204.01999999999998, "text": " Immediately after the tribulation of those days,", "tokens": [51619, 34457, 934, 264, 15039, 2776, 295, 729, 1708, 11, 51767], "temperature": 0.0, "avg_logprob": -0.2002424716949463, "compression_ratio": 1.7293577981651376, "no_speech_prob": 0.0024153266567736864}, {"id": 64, "seek": 17598, "start": 204.01999999999998, "end": 205.89999999999998, "text": " the sun will be darkened,", "tokens": [51767, 264, 3295, 486, 312, 2877, 5320, 11, 51861], "temperature": 0.0, "avg_logprob": -0.2002424716949463, "compression_ratio": 1.7293577981651376, "no_speech_prob": 0.0024153266567736864}, {"id": 65, "seek": 20598, "start": 205.98, "end": 207.85999999999999, "text": " and the moon will not give its light,", "tokens": [50365, 293, 264, 7135, 486, 406, 976, 1080, 1442, 11, 50459], "temperature": 0.0, "avg_logprob": -0.1486331214589521, "compression_ratio": 1.9383259911894273, "no_speech_prob": 0.0011513498611748219}, {"id": 66, "seek": 20598, "start": 208.2, "end": 210.2, "text": " and the stars will fall from heaven,", "tokens": [50476, 293, 264, 6105, 486, 2100, 490, 7162, 11, 50576], "temperature": 0.0, "avg_logprob": -0.1486331214589521, "compression_ratio": 1.9383259911894273, "no_speech_prob": 0.0011513498611748219}, {"id": 67, "seek": 20598, "start": 210.34, "end": 212.51999999999998, "text": " and the powers of the heavens will be shaken.", "tokens": [50583, 293, 264, 8674, 295, 264, 26011, 486, 312, 40971, 13, 50692], "temperature": 0.0, "avg_logprob": -0.1486331214589521, "compression_ratio": 1.9383259911894273, "no_speech_prob": 0.0011513498611748219}, {"id": 68, "seek": 20598, "start": 213.84, "end": 217.12, "text": " Then will appear in heaven the sign of the Son of Man,", "tokens": [50758, 1396, 486, 4204, 294, 7162, 264, 1465, 295, 264, 5185, 295, 2458, 11, 50922], "temperature": 0.0, "avg_logprob": -0.1486331214589521, "compression_ratio": 1.9383259911894273, "no_speech_prob": 0.0011513498611748219}, {"id": 69, "seek": 20598, "start": 217.33999999999997, "end": 220.73999999999998, "text": " and then all the tribes of the earth will mourn,", "tokens": [50933, 293, 550, 439, 264, 19035, 295, 264, 4120, 486, 22235, 77, 11, 51103], "temperature": 0.0, "avg_logprob": -0.1486331214589521, "compression_ratio": 1.9383259911894273, "no_speech_prob": 0.0011513498611748219}, {"id": 70, "seek": 20598, "start": 220.73999999999998, "end": 224.6, "text": " and they will see the Son of Man coming on the clouds of heaven", "tokens": [51103, 293, 436, 486, 536, 264, 5185, 295, 2458, 1348, 322, 264, 12193, 295, 7162, 51296], "temperature": 0.0, "avg_logprob": -0.1486331214589521, "compression_ratio": 1.9383259911894273, "no_speech_prob": 0.0011513498611748219}, {"id": 71, "seek": 20598, "start": 224.6, "end": 226.88, "text": " with power and great glory.", "tokens": [51296, 365, 1347, 293, 869, 11924, 13, 51410], "temperature": 0.0, "avg_logprob": -0.1486331214589521, "compression_ratio": 1.9383259911894273, "no_speech_prob": 0.0011513498611748219}, {"id": 72, "seek": 20598, "start": 227.95999999999998, "end": 231.62, "text": " And he will send out his angels with a loud trumpet call,", "tokens": [51464, 400, 415, 486, 2845, 484, 702, 18175, 365, 257, 6588, 35160, 818, 11, 51647], "temperature": 0.0, "avg_logprob": -0.1486331214589521, "compression_ratio": 1.9383259911894273, "no_speech_prob": 0.0011513498611748219}, {"id": 73, "seek": 20598, "start": 231.94, "end": 234.79999999999998, "text": " and they will gather his elect from the four winds,", "tokens": [51663, 293, 436, 486, 5448, 702, 2185, 490, 264, 1451, 17765, 11, 51806], "temperature": 0.0, "avg_logprob": -0.1486331214589521, "compression_ratio": 1.9383259911894273, "no_speech_prob": 0.0011513498611748219}, {"id": 74, "seek": 20598, "start": 235.23999999999998, "end": 235.73999999999998, "text": " from one end,", "tokens": [51828, 490, 472, 917, 11, 51853], "temperature": 0.0, "avg_logprob": -0.1486331214589521, "compression_ratio": 1.9383259911894273, "no_speech_prob": 0.0011513498611748219}, {"id": 75, "seek": 23598, "start": 235.98, "end": 237.57999999999998, "text": " from one end of heaven to the other.", "tokens": [50365, 490, 472, 917, 295, 7162, 281, 264, 661, 13, 50445], "temperature": 0.0, "avg_logprob": -0.21297608073960003, "compression_ratio": 1.7339055793991416, "no_speech_prob": 0.0004238767724018544}, {"id": 76, "seek": 23598, "start": 238.89999999999998, "end": 241.16, "text": " From the fig tree learn its lesson.", "tokens": [50511, 3358, 264, 2147, 4230, 1466, 1080, 6898, 13, 50624], "temperature": 0.0, "avg_logprob": -0.21297608073960003, "compression_ratio": 1.7339055793991416, "no_speech_prob": 0.0004238767724018544}, {"id": 77, "seek": 23598, "start": 241.78, "end": 244.94, "text": " As soon as its branch becomes tender and puts out its leaves,", "tokens": [50655, 1018, 2321, 382, 1080, 9819, 3643, 15036, 293, 8137, 484, 1080, 5510, 11, 50813], "temperature": 0.0, "avg_logprob": -0.21297608073960003, "compression_ratio": 1.7339055793991416, "no_speech_prob": 0.0004238767724018544}, {"id": 78, "seek": 23598, "start": 245.42, "end": 246.92, "text": " you know that summer is near.", "tokens": [50837, 291, 458, 300, 4266, 307, 2651, 13, 50912], "temperature": 0.0, "avg_logprob": -0.21297608073960003, "compression_ratio": 1.7339055793991416, "no_speech_prob": 0.0004238767724018544}, {"id": 79, "seek": 23598, "start": 247.54, "end": 249.92, "text": " So also when you see all these things,", "tokens": [50943, 407, 611, 562, 291, 536, 439, 613, 721, 11, 51062], "temperature": 0.0, "avg_logprob": -0.21297608073960003, "compression_ratio": 1.7339055793991416, "no_speech_prob": 0.0004238767724018544}, {"id": 80, "seek": 23598, "start": 250.32, "end": 251.73999999999998, "text": " you know that he is near,", "tokens": [51082, 291, 458, 300, 415, 307, 2651, 11, 51153], "temperature": 0.0, "avg_logprob": -0.21297608073960003, "compression_ratio": 1.7339055793991416, "no_speech_prob": 0.0004238767724018544}, {"id": 81, "seek": 23598, "start": 252.28, "end": 253.48, "text": " at the very gates.", "tokens": [51180, 412, 264, 588, 19792, 13, 51240], "temperature": 0.0, "avg_logprob": -0.21297608073960003, "compression_ratio": 1.7339055793991416, "no_speech_prob": 0.0004238767724018544}, {"id": 82, "seek": 23598, "start": 254.51999999999998, "end": 255.73999999999998, "text": " Truly I say to you,", "tokens": [51292, 43548, 286, 584, 281, 291, 11, 51353], "temperature": 0.0, "avg_logprob": -0.21297608073960003, "compression_ratio": 1.7339055793991416, "no_speech_prob": 0.0004238767724018544}, {"id": 83, "seek": 23598, "start": 256.15999999999997, "end": 258.3, "text": " this generation will not pass away", "tokens": [51374, 341, 5125, 486, 406, 1320, 1314, 51481], "temperature": 0.0, "avg_logprob": -0.21297608073960003, "compression_ratio": 1.7339055793991416, "no_speech_prob": 0.0004238767724018544}, {"id": 84, "seek": 23598, "start": 258.3, "end": 260.86, "text": " until all these things take place.", "tokens": [51481, 1826, 439, 613, 721, 747, 1081, 13, 51609], "temperature": 0.0, "avg_logprob": -0.21297608073960003, "compression_ratio": 1.7339055793991416, "no_speech_prob": 0.0004238767724018544}, {"id": 85, "seek": 23598, "start": 261.46, "end": 263.06, "text": " Heaven and earth will pass away,", "tokens": [51639, 13676, 293, 4120, 486, 1320, 1314, 11, 51719], "temperature": 0.0, "avg_logprob": -0.21297608073960003, "compression_ratio": 1.7339055793991416, "no_speech_prob": 0.0004238767724018544}, {"id": 86, "seek": 23598, "start": 263.62, "end": 265.96, "text": " but my words will not pass away.", "tokens": [51747, 457, 452, 2283, 486, 406, 1320, 1314, 13, 51864], "temperature": 0.0, "avg_logprob": -0.21297608073960003, "compression_ratio": 1.7339055793991416, "no_speech_prob": 0.0004238767724018544}, {"id": 87, "seek": 26598, "start": 266.70000000000005, "end": 269.02000000000004, "text": " But concerning that day and hour,", "tokens": [50401, 583, 18087, 300, 786, 293, 1773, 11, 50517], "temperature": 0.0, "avg_logprob": -0.22958082215398803, "compression_ratio": 1.7324561403508771, "no_speech_prob": 0.07260037213563919}, {"id": 88, "seek": 26598, "start": 269.14000000000004, "end": 269.94, "text": " no one knows,", "tokens": [50523, 572, 472, 3255, 11, 50563], "temperature": 0.0, "avg_logprob": -0.22958082215398803, "compression_ratio": 1.7324561403508771, "no_speech_prob": 0.07260037213563919}, {"id": 89, "seek": 26598, "start": 270.44, "end": 272.14000000000004, "text": " not even the angels of heaven,", "tokens": [50588, 406, 754, 264, 18175, 295, 7162, 11, 50673], "temperature": 0.0, "avg_logprob": -0.22958082215398803, "compression_ratio": 1.7324561403508771, "no_speech_prob": 0.07260037213563919}, {"id": 90, "seek": 26598, "start": 272.52000000000004, "end": 273.40000000000003, "text": " nor the Son,", "tokens": [50692, 6051, 264, 5185, 11, 50736], "temperature": 0.0, "avg_logprob": -0.22958082215398803, "compression_ratio": 1.7324561403508771, "no_speech_prob": 0.07260037213563919}, {"id": 91, "seek": 26598, "start": 274.26, "end": 275.84000000000003, "text": " but the Father only.", "tokens": [50779, 457, 264, 7085, 787, 13, 50858], "temperature": 0.0, "avg_logprob": -0.22958082215398803, "compression_ratio": 1.7324561403508771, "no_speech_prob": 0.07260037213563919}, {"id": 92, "seek": 26598, "start": 277.18, "end": 278.82, "text": " For as were the days of Noah,", "tokens": [50925, 1171, 382, 645, 264, 1708, 295, 20895, 11, 51007], "temperature": 0.0, "avg_logprob": -0.22958082215398803, "compression_ratio": 1.7324561403508771, "no_speech_prob": 0.07260037213563919}, {"id": 93, "seek": 26598, "start": 278.98, "end": 281.46000000000004, "text": " so will be the coming of the Son of Man.", "tokens": [51015, 370, 486, 312, 264, 1348, 295, 264, 5185, 295, 2458, 13, 51139], "temperature": 0.0, "avg_logprob": -0.22958082215398803, "compression_ratio": 1.7324561403508771, "no_speech_prob": 0.07260037213563919}, {"id": 94, "seek": 26598, "start": 282.14000000000004, "end": 284.26, "text": " For as in those days before the flood,", "tokens": [51173, 1171, 382, 294, 729, 1708, 949, 264, 10481, 11, 51279], "temperature": 0.0, "avg_logprob": -0.22958082215398803, "compression_ratio": 1.7324561403508771, "no_speech_prob": 0.07260037213563919}, {"id": 95, "seek": 26598, "start": 284.6, "end": 286.0, "text": " they were eating and drinking,", "tokens": [51296, 436, 645, 3936, 293, 7583, 11, 51366], "temperature": 0.0, "avg_logprob": -0.22958082215398803, "compression_ratio": 1.7324561403508771, "no_speech_prob": 0.07260037213563919}, {"id": 96, "seek": 26598, "start": 286.26, "end": 287.66, "text": " marrying and giving in marriage,", "tokens": [51379, 36376, 293, 2902, 294, 7194, 11, 51449], "temperature": 0.0, "avg_logprob": -0.22958082215398803, "compression_ratio": 1.7324561403508771, "no_speech_prob": 0.07260037213563919}, {"id": 97, "seek": 26598, "start": 288.02000000000004, "end": 290.40000000000003, "text": " until the day when Noah entered the ark.", "tokens": [51467, 1826, 264, 786, 562, 20895, 9065, 264, 14408, 13, 51586], "temperature": 0.0, "avg_logprob": -0.22958082215398803, "compression_ratio": 1.7324561403508771, "no_speech_prob": 0.07260037213563919}, {"id": 98, "seek": 26598, "start": 291.08000000000004, "end": 293.8, "text": " And they were unaware until the flood came", "tokens": [51620, 400, 436, 645, 32065, 1826, 264, 10481, 1361, 51756], "temperature": 0.0, "avg_logprob": -0.22958082215398803, "compression_ratio": 1.7324561403508771, "no_speech_prob": 0.07260037213563919}, {"id": 99, "seek": 26598, "start": 293.8, "end": 295.16, "text": " and swept them all away.", "tokens": [51756, 293, 31791, 552, 439, 1314, 13, 51824], "temperature": 0.0, "avg_logprob": -0.22958082215398803, "compression_ratio": 1.7324561403508771, "no_speech_prob": 0.07260037213563919}, {"id": 100, "seek": 29598, "start": 295.98, "end": 298.5, "text": " So will be the coming of the Son of Man.", "tokens": [50365, 407, 486, 312, 264, 1348, 295, 264, 5185, 295, 2458, 13, 50491], "temperature": 0.0, "avg_logprob": -0.18895802569033496, "compression_ratio": 1.9783549783549783, "no_speech_prob": 0.00011959519906667992}, {"id": 101, "seek": 29598, "start": 299.12, "end": 300.96000000000004, "text": " Then two men will be in the field,", "tokens": [50522, 1396, 732, 1706, 486, 312, 294, 264, 2519, 11, 50614], "temperature": 0.0, "avg_logprob": -0.18895802569033496, "compression_ratio": 1.9783549783549783, "no_speech_prob": 0.00011959519906667992}, {"id": 102, "seek": 29598, "start": 301.28000000000003, "end": 303.46000000000004, "text": " one will be taken and one left.", "tokens": [50630, 472, 486, 312, 2726, 293, 472, 1411, 13, 50739], "temperature": 0.0, "avg_logprob": -0.18895802569033496, "compression_ratio": 1.9783549783549783, "no_speech_prob": 0.00011959519906667992}, {"id": 103, "seek": 29598, "start": 303.82, "end": 305.70000000000005, "text": " Two women will be grinding at the mill,", "tokens": [50757, 4453, 2266, 486, 312, 25300, 412, 264, 1728, 11, 50851], "temperature": 0.0, "avg_logprob": -0.18895802569033496, "compression_ratio": 1.9783549783549783, "no_speech_prob": 0.00011959519906667992}, {"id": 104, "seek": 29598, "start": 306.06, "end": 308.88, "text": " one will be taken and one left.", "tokens": [50869, 472, 486, 312, 2726, 293, 472, 1411, 13, 51010], "temperature": 0.0, "avg_logprob": -0.18895802569033496, "compression_ratio": 1.9783549783549783, "no_speech_prob": 0.00011959519906667992}, {"id": 105, "seek": 29598, "start": 310.32, "end": 312.24, "text": " Therefore stay awake,", "tokens": [51082, 7504, 1754, 15994, 11, 51178], "temperature": 0.0, "avg_logprob": -0.18895802569033496, "compression_ratio": 1.9783549783549783, "no_speech_prob": 0.00011959519906667992}, {"id": 106, "seek": 29598, "start": 312.66, "end": 315.42, "text": " for you do not know on what day your Lord is coming.", "tokens": [51199, 337, 291, 360, 406, 458, 322, 437, 786, 428, 3257, 307, 1348, 13, 51337], "temperature": 0.0, "avg_logprob": -0.18895802569033496, "compression_ratio": 1.9783549783549783, "no_speech_prob": 0.00011959519906667992}, {"id": 107, "seek": 29598, "start": 316.08000000000004, "end": 317.12, "text": " But know this,", "tokens": [51370, 583, 458, 341, 11, 51422], "temperature": 0.0, "avg_logprob": -0.18895802569033496, "compression_ratio": 1.9783549783549783, "no_speech_prob": 0.00011959519906667992}, {"id": 108, "seek": 29598, "start": 317.48, "end": 319.6, "text": " that if the master of the house had known", "tokens": [51440, 300, 498, 264, 4505, 295, 264, 1782, 632, 2570, 51546], "temperature": 0.0, "avg_logprob": -0.18895802569033496, "compression_ratio": 1.9783549783549783, "no_speech_prob": 0.00011959519906667992}, {"id": 109, "seek": 29598, "start": 319.6, "end": 321.68, "text": " in what part of the night the thief was coming,", "tokens": [51546, 294, 437, 644, 295, 264, 1818, 264, 23176, 390, 1348, 11, 51650], "temperature": 0.0, "avg_logprob": -0.18895802569033496, "compression_ratio": 1.9783549783549783, "no_speech_prob": 0.00011959519906667992}, {"id": 110, "seek": 29598, "start": 322.16, "end": 323.42, "text": " he would have stayed awake", "tokens": [51674, 415, 576, 362, 9181, 15994, 51737], "temperature": 0.0, "avg_logprob": -0.18895802569033496, "compression_ratio": 1.9783549783549783, "no_speech_prob": 0.00011959519906667992}, {"id": 111, "seek": 29598, "start": 323.42, "end": 325.72, "text": " and would not have let his house be broken into.", "tokens": [51737, 293, 576, 406, 362, 718, 702, 1782, 312, 5463, 666, 13, 51852], "temperature": 0.0, "avg_logprob": -0.18895802569033496, "compression_ratio": 1.9783549783549783, "no_speech_prob": 0.00011959519906667992}, {"id": 112, "seek": 29598, "start": 325.72, "end": 325.96000000000004, "text": " Therefore stay awake,", "tokens": [51852, 7504, 1754, 15994, 11, 51864], "temperature": 0.0, "avg_logprob": -0.18895802569033496, "compression_ratio": 1.9783549783549783, "no_speech_prob": 0.00011959519906667992}, {"id": 113, "seek": 32596, "start": 325.96, "end": 329.06, "text": " therefore you also must be ready,", "tokens": [50365, 4412, 291, 611, 1633, 312, 1919, 11, 50520], "temperature": 0.0, "avg_logprob": -0.15072560743852095, "compression_ratio": 1.6570247933884297, "no_speech_prob": 0.0012159759644418955}, {"id": 114, "seek": 32596, "start": 329.62, "end": 330.97999999999996, "text": " for the Son of Man is coming", "tokens": [50548, 337, 264, 5185, 295, 2458, 307, 1348, 50616], "temperature": 0.0, "avg_logprob": -0.15072560743852095, "compression_ratio": 1.6570247933884297, "no_speech_prob": 0.0012159759644418955}, {"id": 115, "seek": 32596, "start": 330.97999999999996, "end": 333.0, "text": " at an hour you do not expect.", "tokens": [50616, 412, 364, 1773, 291, 360, 406, 2066, 13, 50717], "temperature": 0.0, "avg_logprob": -0.15072560743852095, "compression_ratio": 1.6570247933884297, "no_speech_prob": 0.0012159759644418955}, {"id": 116, "seek": 32596, "start": 334.29999999999995, "end": 336.79999999999995, "text": " Who then is the faithful and wise servant", "tokens": [50782, 2102, 550, 307, 264, 17808, 293, 10829, 17896, 50907], "temperature": 0.0, "avg_logprob": -0.15072560743852095, "compression_ratio": 1.6570247933884297, "no_speech_prob": 0.0012159759644418955}, {"id": 117, "seek": 32596, "start": 336.79999999999995, "end": 339.34, "text": " whom his master has set over his household", "tokens": [50907, 7101, 702, 4505, 575, 992, 670, 702, 9888, 51034], "temperature": 0.0, "avg_logprob": -0.15072560743852095, "compression_ratio": 1.6570247933884297, "no_speech_prob": 0.0012159759644418955}, {"id": 118, "seek": 32596, "start": 339.34, "end": 342.08, "text": " to give them their food at the proper time?", "tokens": [51034, 281, 976, 552, 641, 1755, 412, 264, 2296, 565, 30, 51171], "temperature": 0.0, "avg_logprob": -0.15072560743852095, "compression_ratio": 1.6570247933884297, "no_speech_prob": 0.0012159759644418955}, {"id": 119, "seek": 32596, "start": 342.96, "end": 344.26, "text": " Blessed is that servant", "tokens": [51215, 37501, 307, 300, 17896, 51280], "temperature": 0.0, "avg_logprob": -0.15072560743852095, "compression_ratio": 1.6570247933884297, "no_speech_prob": 0.0012159759644418955}, {"id": 120, "seek": 32596, "start": 344.26, "end": 347.09999999999997, "text": " whom his master will find so doing when he comes.", "tokens": [51280, 7101, 702, 4505, 486, 915, 370, 884, 562, 415, 1487, 13, 51422], "temperature": 0.0, "avg_logprob": -0.15072560743852095, "compression_ratio": 1.6570247933884297, "no_speech_prob": 0.0012159759644418955}, {"id": 121, "seek": 32596, "start": 348.4, "end": 349.59999999999997, "text": " Truly I say to you,", "tokens": [51487, 43548, 286, 584, 281, 291, 11, 51547], "temperature": 0.0, "avg_logprob": -0.15072560743852095, "compression_ratio": 1.6570247933884297, "no_speech_prob": 0.0012159759644418955}, {"id": 122, "seek": 32596, "start": 349.97999999999996, "end": 351.97999999999996, "text": " he will set him over all his possessions.", "tokens": [51566, 415, 486, 992, 796, 670, 439, 702, 40623, 13, 51666], "temperature": 0.0, "avg_logprob": -0.15072560743852095, "compression_ratio": 1.6570247933884297, "no_speech_prob": 0.0012159759644418955}, {"id": 123, "seek": 32596, "start": 352.9, "end": 355.78, "text": " But if that wicked servant says to himself,", "tokens": [51712, 583, 498, 300, 22663, 17896, 1619, 281, 3647, 11, 51856], "temperature": 0.0, "avg_logprob": -0.15072560743852095, "compression_ratio": 1.6570247933884297, "no_speech_prob": 0.0012159759644418955}, {"id": 124, "seek": 35596, "start": 355.96, "end": 357.68, "text": " My master is delayed", "tokens": [50365, 1222, 4505, 307, 20268, 50451], "temperature": 0.0, "avg_logprob": -0.13447190367657205, "compression_ratio": 1.693121693121693, "no_speech_prob": 0.0013558302307501435}, {"id": 125, "seek": 35596, "start": 357.68, "end": 360.38, "text": " and begins to beat his fellow servants", "tokens": [50451, 293, 7338, 281, 4224, 702, 7177, 21705, 50586], "temperature": 0.0, "avg_logprob": -0.13447190367657205, "compression_ratio": 1.693121693121693, "no_speech_prob": 0.0013558302307501435}, {"id": 126, "seek": 35596, "start": 360.38, "end": 362.94, "text": " and eats and drinks with drunkards,", "tokens": [50586, 293, 18109, 293, 12142, 365, 11192, 2287, 11, 50714], "temperature": 0.0, "avg_logprob": -0.13447190367657205, "compression_ratio": 1.693121693121693, "no_speech_prob": 0.0013558302307501435}, {"id": 127, "seek": 35596, "start": 363.59999999999997, "end": 366.15999999999997, "text": " the master of that servant will come on a day", "tokens": [50747, 264, 4505, 295, 300, 17896, 486, 808, 322, 257, 786, 50875], "temperature": 0.0, "avg_logprob": -0.13447190367657205, "compression_ratio": 1.693121693121693, "no_speech_prob": 0.0013558302307501435}, {"id": 128, "seek": 35596, "start": 366.15999999999997, "end": 367.84, "text": " when he does not expect him", "tokens": [50875, 562, 415, 775, 406, 2066, 796, 50959], "temperature": 0.0, "avg_logprob": -0.13447190367657205, "compression_ratio": 1.693121693121693, "no_speech_prob": 0.0013558302307501435}, {"id": 129, "seek": 35596, "start": 367.84, "end": 370.12, "text": " and at an hour he does not know", "tokens": [50959, 293, 412, 364, 1773, 415, 775, 406, 458, 51073], "temperature": 0.0, "avg_logprob": -0.13447190367657205, "compression_ratio": 1.693121693121693, "no_speech_prob": 0.0013558302307501435}, {"id": 130, "seek": 35596, "start": 370.12, "end": 372.34, "text": " and will cut him in pieces", "tokens": [51073, 293, 486, 1723, 796, 294, 3755, 51184], "temperature": 0.0, "avg_logprob": -0.13447190367657205, "compression_ratio": 1.693121693121693, "no_speech_prob": 0.0013558302307501435}, {"id": 131, "seek": 35596, "start": 372.34, "end": 373.88, "text": " and put him with the hypocrites.", "tokens": [51184, 293, 829, 796, 365, 264, 50207, 30931, 13, 51261], "temperature": 0.0, "avg_logprob": -0.13447190367657205, "compression_ratio": 1.693121693121693, "no_speech_prob": 0.0013558302307501435}, {"id": 132, "seek": 35596, "start": 374.56, "end": 376.62, "text": " In that place there will be weeping", "tokens": [51295, 682, 300, 1081, 456, 486, 312, 321, 10921, 51398], "temperature": 0.0, "avg_logprob": -0.13447190367657205, "compression_ratio": 1.693121693121693, "no_speech_prob": 0.0013558302307501435}, {"id": 133, "seek": 35596, "start": 376.62, "end": 378.09999999999997, "text": " and gnashing of teeth.", "tokens": [51398, 293, 49819, 11077, 295, 7798, 13, 51472], "temperature": 0.0, "avg_logprob": -0.13447190367657205, "compression_ratio": 1.693121693121693, "no_speech_prob": 0.0013558302307501435}], "language": "English"}