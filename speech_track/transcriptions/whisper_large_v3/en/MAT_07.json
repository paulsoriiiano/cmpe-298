 291, 486, 5521, 552, 538, 641, 12148, 13, 51444], "temperature": 0.0, "avg_logprob": -0.2731350169462316, "compression_ratio": 1.8385650224215246, "no_speech_prob": 0.09834751486778259}, {"id": 54, "seek": 11802, "start": 140.7, "end": 142.82, "text": " Not everyone who says to me,", "tokens": [51499, 1726, 1518, 567, 1619, 281, 385, 11, 51605], "temperature": 0.0, "avg_logprob": -0.2731350169462316, "compression_ratio": 1.8385650224215246, "no_speech_prob": 0.09834751486778259}, {"id": 55, "seek": 11802, "start": 143.04, "end": 144.0, "text": " Lord, Lord,", "tokens": [51616, 3257, 11, 3257, 11, 51664], "temperature": 0.0, "avg_logprob": -0.2731350169462316, "compression_ratio": 1.8385650224215246, "no_speech_prob": 0.09834751486778259}, {"id": 56, "seek": 11802, "start": 144.16, "end": 145.94, "text": " will enter the kingdom of heaven,", "tokens": [51672, 486, 3242, 264, 10231, 295, 7162, 11, 51761], "temperature": 0.0, "avg_logprob": -0.2731350169462316, "compression_ratio": 1.8385650224215246, "no_speech_prob": 0.09834751486778259}, {"id": 57, "seek": 11802, "start": 145.94, "end": 148.0, "text": " but the one who does the will", "tokens": [51761, 457, 264, 472, 567, 775, 264, 486, 51864], "temperature": 0.0, "avg_logprob": -0.2731350169462316, "compression_ratio": 1.8385650224215246, "no_speech_prob": 0.09834751486778259}, {"id": 58, "seek": 14800, "start": 148.0, "end": 149.64, "text": " of my Father who is in heaven.", "tokens": [50365, 295, 452, 7085, 567, 307, 294, 7162, 13, 50447], "temperature": 0.0, "avg_logprob": -0.16261692207400538, "compression_ratio": 1.6680851063829787, "no_speech_prob": 0.0011513272766023874}, {"id": 59, "seek": 14800, "start": 150.36, "end": 153.04, "text": " On that day many will say to me,", "tokens": [50483, 1282, 300, 786, 867, 486, 584, 281, 385, 11, 50617], "temperature": 0.0, "avg_logprob": -0.16261692207400538, "compression_ratio": 1.6680851063829787, "no_speech_prob": 0.0011513272766023874}, {"id": 60, "seek": 14800, "start": 153.26, "end": 156.32, "text": " Lord, Lord, did we not prophesy in your name,", "tokens": [50628, 3257, 11, 3257, 11, 630, 321, 406, 17051, 17823, 294, 428, 1315, 11, 50781], "temperature": 0.0, "avg_logprob": -0.16261692207400538, "compression_ratio": 1.6680851063829787, "no_speech_prob": 0.0011513272766023874}, {"id": 61, "seek": 14800, "start": 156.48, "end": 158.74, "text": " and cast out demons in your name,", "tokens": [50789, 293, 4193, 484, 19733, 294, 428, 1315, 11, 50902], "temperature": 0.0, "avg_logprob": -0.16261692207400538, "compression_ratio": 1.6680851063829787, "no_speech_prob": 0.0011513272766023874}, {"id": 62, "seek": 14800, "start": 158.82, "end": 161.38, "text": " and do many mighty works in your name?", "tokens": [50906, 293, 360, 867, 21556, 1985, 294, 428, 1315, 30, 51034], "temperature": 0.0, "avg_logprob": -0.16261692207400538, "compression_ratio": 1.6680851063829787, "no_speech_prob": 0.0011513272766023874}, {"id": 63, "seek": 14800, "start": 161.86, "end": 163.7, "text": " And then will I declare to them,", "tokens": [51058, 400, 550, 486, 286, 19710, 281, 552, 11, 51150], "temperature": 0.0, "avg_logprob": -0.16261692207400538, "compression_ratio": 1.6680851063829787, "no_speech_prob": 0.0011513272766023874}, {"id": 64, "seek": 14800, "start": 164.12, "end": 165.64, "text": " I never knew you.", "tokens": [51171, 286, 1128, 2586, 291, 13, 51247], "temperature": 0.0, "avg_logprob": -0.16261692207400538, "compression_ratio": 1.6680851063829787, "no_speech_prob": 0.0011513272766023874}, {"id": 65, "seek": 14800, "start": 166.02, "end": 168.4, "text": " Depart from me, you workers of lawlessness.", "tokens": [51266, 4056, 446, 490, 385, 11, 291, 5600, 295, 2101, 26663, 13, 51385], "temperature": 0.0, "avg_logprob": -0.16261692207400538, "compression_ratio": 1.6680851063829787, "no_speech_prob": 0.0011513272766023874}, {"id": 66, "seek": 14800, "start": 169.96, "end": 172.98, "text": " Everyone then who hears these words of mine", "tokens": [51463, 5198, 550, 567, 25688, 613, 2283, 295, 3892, 51614], "temperature": 0.0, "avg_logprob": -0.16261692207400538, "compression_ratio": 1.6680851063829787, "no_speech_prob": 0.0011513272766023874}, {"id": 67, "seek": 14800, "start": 172.98, "end": 175.5, "text": " and does them will be like a wise man", "tokens": [51614, 293, 775, 552, 486, 312, 411, 257, 10829, 587, 51740], "temperature": 0.0, "avg_logprob": -0.16261692207400538, "compression_ratio": 1.6680851063829787, "no_speech_prob": 0.0011513272766023874}, {"id": 68, "seek": 14800, "start": 175.5, "end": 177.56, "text": " who built his house on the rock,", "tokens": [51740, 567, 3094, 702, 1782, 322, 264, 3727, 11, 51843], "temperature": 0.0, "avg_logprob": -0.16261692207400538, "compression_ratio": 1.6680851063829787, "no_speech_prob": 0.0011513272766023874}, {"id": 69, "seek": 17800, "start": 178.0, "end": 179.06, "text": " and the rain fell,", "tokens": [50365, 293, 264, 4830, 5696, 11, 50418], "temperature": 0.0, "avg_logprob": -0.18803705090153827, "compression_ratio": 1.9774774774774775, "no_speech_prob": 0.0007495096069760621}, {"id": 70, "seek": 17800, "start": 179.3, "end": 180.42, "text": " and the floods came,", "tokens": [50430, 293, 264, 35536, 1361, 11, 50486], "temperature": 0.0, "avg_logprob": -0.18803705090153827, "compression_ratio": 1.9774774774774775, "no_speech_prob": 0.0007495096069760621}, {"id": 71, "seek": 17800, "start": 180.5, "end": 182.82, "text": " and the winds blew and beat on that house,", "tokens": [50490, 293, 264, 17765, 19075, 293, 4224, 322, 300, 1782, 11, 50606], "temperature": 0.0, "avg_logprob": -0.18803705090153827, "compression_ratio": 1.9774774774774775, "no_speech_prob": 0.0007495096069760621}, {"id": 72, "seek": 17800, "start": 183.2, "end": 184.7, "text": " but it did not fall,", "tokens": [50625, 457, 309, 630, 406, 2100, 11, 50700], "temperature": 0.0, "avg_logprob": -0.18803705090153827, "compression_ratio": 1.9774774774774775, "no_speech_prob": 0.