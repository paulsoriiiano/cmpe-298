": [50365, 400, 456, 645, 611, 867, 661, 2266, 50470], "temperature": 0.0, "avg_logprob": -0.12950658445005064, "compression_ratio": 1.698581560283688, "no_speech_prob": 0.002288487972691655}, {"id": 120, "seek": 29962, "start": 301.72, "end": 303.44, "text": " who came up with him to Jerusalem.", "tokens": [50470, 567, 1361, 493, 365, 796, 281, 15393, 13, 50556], "temperature": 0.0, "avg_logprob": -0.12950658445005064, "compression_ratio": 1.698581560283688, "no_speech_prob": 0.002288487972691655}, {"id": 121, "seek": 29962, "start": 305.36, "end": 306.94, "text": " And when evening had come,", "tokens": [50652, 400, 562, 5634, 632, 808, 11, 50731], "temperature": 0.0, "avg_logprob": -0.12950658445005064, "compression_ratio": 1.698581560283688, "no_speech_prob": 0.002288487972691655}, {"id": 122, "seek": 29962, "start": 307.12, "end": 308.6, "text": " since it was the day of preparation,", "tokens": [50740, 1670, 309, 390, 264, 786, 295, 13081, 11, 50814], "temperature": 0.0, "avg_logprob": -0.12950658445005064, "compression_ratio": 1.698581560283688, "no_speech_prob": 0.002288487972691655}, {"id": 123, "seek": 29962, "start": 309.12, "end": 310.62, "text": " that is, the day before the Sabbath,", "tokens": [50840, 300, 307, 11, 264, 786, 949, 264, 36618, 11, 50915], "temperature": 0.0, "avg_logprob": -0.12950658445005064, "compression_ratio": 1.698581560283688, "no_speech_prob": 0.002288487972691655}, {"id": 124, "seek": 29962, "start": 311.26, "end": 312.68, "text": " Joseph of Arimathea,", "tokens": [50947, 11170, 295, 1587, 33862, 27799, 11, 51018], "temperature": 0.0, "avg_logprob": -0.12950658445005064, "compression_ratio": 1.698581560283688, "no_speech_prob": 0.002288487972691655}, {"id": 125, "seek": 29962, "start": 312.9, "end": 314.52, "text": " a respected member of the council", "tokens": [51029, 257, 20020, 4006, 295, 264, 9209, 51110], "temperature": 0.0, "avg_logprob": -0.12950658445005064, "compression_ratio": 1.698581560283688, "no_speech_prob": 0.002288487972691655}, {"id": 126, "seek": 29962, "start": 314.52, "end": 317.08, "text": " who was also himself looking for the kingdom of God,", "tokens": [51110, 567, 390, 611, 3647, 1237, 337, 264, 10231, 295, 1265, 11, 51238], "temperature": 0.0, "avg_logprob": -0.12950658445005064, "compression_ratio": 1.698581560283688, "no_speech_prob": 0.002288487972691655}, {"id": 127, "seek": 29962, "start": 317.48, "end": 319.08, "text": " took courage and went to Pilate", "tokens": [51258, 1890, 9892, 293, 1437, 281, 18026, 473, 51338], "temperature": 0.0, "avg_logprob": -0.12950658445005064, "compression_ratio": 1.698581560283688, "no_speech_prob": 0.002288487972691655}, {"id": 128, "seek": 29962, "start": 319.08, "end": 320.66, "text": " and asked for the body of Jesus.", "tokens": [51338, 293, 2351, 337, 264, 1772, 295, 2705, 13, 51417], "temperature": 0.0, "avg_logprob": -0.12950658445005064, "compression_ratio": 1.698581560283688, "no_speech_prob": 0.002288487972691655}, {"id": 129, "seek": 29962, "start": 321.5, "end": 322.92, "text": " Pilate was surprised to hear", "tokens": [51459, 18026, 473, 390, 6100, 281, 1568, 51530], "temperature": 0.0, "avg_logprob": -0.12950658445005064, "compression_ratio": 1.698581560283688, "no_speech_prob": 0.002288487972691655}, {"id": 130, "seek": 29962, "start": 322.92, "end": 324.46, "text": " that he should have already died,", "tokens": [51530, 300, 415, 820, 362, 1217, 4539, 11, 51607], "temperature": 0.0, "avg_logprob": -0.12950658445005064, "compression_ratio": 1.698581560283688, "no_speech_prob": 0.002288487972691655}, {"id": 131, "seek": 29962, "start": 324.84000000000003, "end": 326.32, "text": " and summoning the centurion,", "tokens": [51626, 293, 18714, 278, 264, 1489, 374, 313, 11, 51700], "temperature": 0.0, "avg_logprob": -0.12950658445005064, "compression_ratio": 1.698581560283688, "no_speech_prob": 0.002288487972691655}, {"id": 132, "seek": 29962, "start": 326.32, "end": 328.48, "text": " he asked him whether he was already dead.", "tokens": [51700, 415, 2351, 796, 1968, 415, 390, 1217, 3116, 13, 51808], "temperature": 0.0, "avg_logprob": -0.12950658445005064, "compression_ratio": 1.698581560283688, "no_speech_prob": 0.002288487972691655}, {"id": 133, "seek": 32962, "start": 329.62, "end": 331.28000000000003, "text": " And when he learned from the centurion", "tokens": [50365, 400, 562, 415, 3264, 490, 264, 1489, 374, 313, 50448], "temperature": 0.0, "avg_logprob": -0.1725366049950276, "compression_ratio": 1.6966824644549763, "no_speech_prob": 0.001995546044781804}, {"id": 134, "seek": 32962, "start": 331.28000000000003, "end": 332.22, "text": " that he was dead,", "tokens": [50448, 300, 415, 390, 3116, 11, 50495], "temperature": 0.0, "avg_logprob": -0.1725366049950276, "compression_ratio": 1.6966824644549763, "no_speech_prob": 0.001995546044781804}, {"id": 135, "seek": 32962, "start": 332.48, "end": 334.1, "text": " he granted the corpse to Joseph.", "tokens": [50508, 415, 12344, 264, 30324, 281, 11170, 13, 50589], "temperature": 0.0, "avg_logprob": -0.1725366049950276, "compression_ratio": 1.6966824644549763, "no_speech_prob": 0.001995546044781804}, {"id": 136, "seek": 32962, "start": 335.24, "end": 337.26, "text": " And Joseph bought a linen shroud", "tokens": [50646, 400, 11170, 4243, 257, 46602, 50077, 50747], "temperature": 0.0, "avg_logprob": -0.1725366049950276, "compression_ratio": 1.6966824644549763, "no_speech_prob": 0.001995546044781804}, {"id": 137, "seek": 32962, "start": 337.26, "end": 338.62, "text": " and taking him down,", "tokens": [50747, 293, 1940, 796, 760, 11, 50815], "temperature": 0.0, "avg_logprob": -0.1725366049950276, "compression_ratio": 1.6966824644549763, "no_speech_prob": 0.001995546044781804}, {"id": 138, "seek": 32962, "start": 339.44, "end": 340.96, "text": " wrapped him in the linen shroud", "tokens": [50856, 14226, 796, 294, 264, 46602, 50077, 50932], "temperature": 0.0, "avg_logprob": -0.1725366049950276, "compression_ratio": 1.6966824644