 9000, "start": 118.1, "end": 119.9, "text": " Hail, king of the Jews!", "tokens": [51770, 32495, 11, 4867, 295, 264, 11041, 0, 51860], "temperature": 0.0, "avg_logprob": -0.21358763524728228, "compression_ratio": 1.6538461538461537, "no_speech_prob": 0.010236458852887154}, {"id": 50, "seek": 12000, "start": 120.0, "end": 123.24, "text": " And they were striking his head with a reed,", "tokens": [50365, 400, 436, 645, 18559, 702, 1378, 365, 257, 319, 292, 11, 50527], "temperature": 0.0, "avg_logprob": -0.19597387313842773, "compression_ratio": 1.8075601374570447, "no_speech_prob": 0.02144007571041584}, {"id": 51, "seek": 12000, "start": 123.34, "end": 124.22, "text": " and spitting on him,", "tokens": [50532, 293, 637, 2414, 322, 796, 11, 50576], "temperature": 0.0, "avg_logprob": -0.19597387313842773, "compression_ratio": 1.8075601374570447, "no_speech_prob": 0.02144007571041584}, {"id": 52, "seek": 12000, "start": 124.32, "end": 126.06, "text": " and kneeling down in homage to him.", "tokens": [50581, 293, 32704, 11031, 760, 294, 44073, 281, 796, 13, 50668], "temperature": 0.0, "avg_logprob": -0.19597387313842773, "compression_ratio": 1.8075601374570447, "no_speech_prob": 0.02144007571041584}, {"id": 53, "seek": 12000, "start": 126.72, "end": 127.98, "text": " And when they had mocked him,", "tokens": [50701, 400, 562, 436, 632, 17362, 292, 796, 11, 50764], "temperature": 0.0, "avg_logprob": -0.19597387313842773, "compression_ratio": 1.8075601374570447, "no_speech_prob": 0.02144007571041584}, {"id": 54, "seek": 12000, "start": 128.24, "end": 129.84, "text": " they stripped him of the purple cloak,", "tokens": [50777, 436, 33221, 796, 295, 264, 9656, 45004, 11, 50857], "temperature": 0.0, "avg_logprob": -0.19597387313842773, "compression_ratio": 1.8075601374570447, "no_speech_prob": 0.02144007571041584}, {"id": 55, "seek": 12000, "start": 129.98, "end": 131.46, "text": " and put his own clothes on him.", "tokens": [50864, 293, 829, 702, 1065, 5534, 322, 796, 13, 50938], "temperature": 0.0, "avg_logprob": -0.19597387313842773, "compression_ratio": 1.8075601374570447, "no_speech_prob": 0.02144007571041584}, {"id": 56, "seek": 12000, "start": 131.94, "end": 134.28, "text": " And they led him out to crucify him.", "tokens": [50962, 400, 436, 4684, 796, 484, 281, 28154, 2505, 796, 13, 51079], "temperature": 0.0, "avg_logprob": -0.19597387313842773, "compression_ratio": 1.8075601374570447, "no_speech_prob": 0.02144007571041584}, {"id": 57, "seek": 12000, "start": 134.98, "end": 136.88, "text": " And they compelled a passerby,", "tokens": [51114, 400, 436, 40021, 257, 18509, 2322, 11, 51209], "temperature": 0.0, "avg_logprob": -0.19597387313842773, "compression_ratio": 1.8075601374570447, "no_speech_prob": 0.02144007571041584}, {"id": 58, "seek": 12000, "start": 137.16, "end": 138.14, "text": " Simon of Cyrene,", "tokens": [51223, 13193, 295, 10295, 32252, 11, 51272], "temperature": 0.0, "avg_logprob": -0.19597387313842773, "compression_ratio": 1.8075601374570447, "no_speech_prob": 0.02144007571041584}, {"id": 59, "seek": 12000, "start": 138.4, "end": 139.92000000000002, "text": " who was coming in from the country,", "tokens": [51285, 567, 390, 1348, 294, 490, 264, 1941, 11, 51361], "temperature": 0.0, "avg_logprob": -0.19597387313842773, "compression_ratio": 1.8075601374570447, "no_speech_prob": 0.02144007571041584}, {"id": 60, "seek": 12000, "start": 140.14, "end": 141.68, "text": " the father of Alexander and Rufus,", "tokens": [51372, 264, 3086, 295, 14845, 293, 497, 2947, 301, 11, 51449], "temperature": 0.0, "avg_logprob": -0.19597387313842773, "compression_ratio": 1.8075601374570447, "no_speech_prob": 0.02144007571041584}, {"id": 61, "seek": 12000, "start": 141.88, "end": 143.18, "text": " to carry his cross.", "tokens": [51459, 281, 3985, 702, 3278, 13, 51524], "temperature": 0.0, "avg_logprob": -0.19597387313842773, "compression_ratio": 1.8075601374570447, "no_speech_prob": 0.02144007571041584}, {"id": 62, "seek": 12000, "start": 144.2, "end": 146.56, "text": " And they brought him to the place called Golgotha,", "tokens": [51575, 400, 436, 3038, 796, 281, 264, 1081, 1219, 36319, 70, 900, 64, 11, 51693], "temperature": 0.0, "avg_logprob": -0.19597387313842773, "compression_ratio": 1.8075601374570447, "no_speech_prob": 0.02144007571041584}, {"id": 63, "seek": 12000, "start": 146.72, "end": 148.2, "text": " which means place of a skull.", "tokens": [51701, 597, 1355, 1081, 295, 257, 11743, 13, 51775], "temperature": 0.0, "avg_logprob": -0.19597387313842773, "compression_ratio": 1.8075601374570447, "no_speech_prob": 0.02144007571041584}, {"id": 64, "seek": 12000, "start": 148.76, "end": 149.86, "text": " And they offered him one of the most precious things in the world,", "tokens": [51803, 400, 436, 8059, 796, 472, 295, 264, 881, 12406, 721, 294, 264, 1002, 11, 51858], "temperature": 0.0, "avg_logprob": -0.19597387313842773, "compression_ratio": 1.8075601374570447, "no_speech_prob": 0.02144007571041584}, {"id": 65, "seek": 14986, "start": 149.86, "end": 151.10000000000002, "text": " wine mixed with myrrh,", "tokens": [50365, 7209, 7467, 365, 452, 16115, 71, 11, 50427], "temperature": 0.0, "avg_logprob": -0.2339098835719451, "compression_ratio": 1.764, "no_speech_prob": 0.005222778767347336}, {"id": 66, "seek": 14986, "start": 151.20000000000002, "end": 152.38000000000002, "text": " but he did not take it.", "tokens": [50432, 457, 415, 630, 406, 747, 309, 13, 50491], "temperature": 0.0, "avg_logprob": -0.2339098835719451, "compression_ratio": 1.764, "no_speech_prob": 0.005222778767347336}, {"id": 67, "seek": 14986, "start": 152.88000000000002, "end": 154.18, "text": " And they crucified him,", "tokens": [50516, 400, 436, 46846, 796, 11, 50581], "temperature": 0.0, "avg_logprob": -0.2339098835719451, "compression_ratio": 1.764, "no_speech_prob": 0.005222778767347336}, {"id": 68, "seek": 14986, "start": 154.42000000000002, "end": 156.22000000000003, "text": " and divided his garments among them,", "tokens": [50593, 293, 6666, 702, 44881, 3654, 552, 11, 50683], "temperature": 0.0, "avg_logprob": -0.2339098835719451, "compression_ratio": 1.764, "no_speech_prob": 0.005222778767347336}, {"id": 69, "seek": 14986, "start": 156.42000000000002, "end": 157.56, "text": " casting lots for them,", "tokens": [50693, 17301, 3195, 337, 552, 11, 50750], "temperature": 0.0, "avg_logprob": -0.2339098835719451, "compression_ratio": 1.764, "no_speech_prob": 0.005222778767347336}, {"id": 70, "seek": 14986, "start": 157.86, "end": 159.62, "text": " to decide what each should take.", "tokens": [50765, 281, 4536, 437, 1184, 820, 747, 13, 50853], "temperature": 0.0, "avg_logprob": -0.2339098835719451, "compression_ratio": 1.764, "no_speech_prob": 0.005222778767347336}, {"id": 71, "seek": 14986, "start": 160.46, "end": 163.0, "text": " And it was the third hour when they crucified him.", "tokens": [50895, 400, 309, 390, 264, 2636, 1773, 562, 436, 46846, 796, 13, 51022], "temperature": 0.0, "avg_logprob": -0.2339098835719451, "compression_ratio": 1.764, "no_speech_prob": 0.005222778767347336}, {"id": 72, "seek": 14986, "start": 163.58, "end": 166.16000000000003, "text": " And the inscription of the charge against him read,", "tokens": [51051, 400, 264, 49882, 295, 264, 4602, 1970, 796, 1401, 11, 51180], "temperature": 0.0, "avg_logprob": -0.2339098835719451, "compression_ratio": 1.764, "no_speech_prob": 0.005222778767347336}, {"id": 73, "seek": 14986, "start": 166.58, "end": 168.12, "text": " The king of the Jews.", "tokens": [51201, 440, 4867, 295, 264, 11041, 13, 51278], "temperature": 0.0, "avg_logprob": -0.2339098835719451, "compression_ratio": 1.764, "no_speech_prob": 0.005222778767347336}, {"id": 74, "seek": 14986, "start": 168.86, "end": 171.04000000000002, "text": " And with him they crucified two robbers,", "tokens": [51315, 400, 365, 796, 436, 46846, 732, 3870, 1616, 11, 51424], "temperature": 0.0, "avg_logprob": -0.2339098835719451, "compression_ratio": 1.764, "no_speech_prob": 0.005222778767347336}, {"id": 75, "seek": 14986, "start": 171.22000000000003, "end": 173.0, "text": " one on his right and one on his left.", "tokens": [51433, 472, 322, 702, 558, 293, 472, 322, 702, 1411, 13, 51522], "temperature": 0.0, "avg_logprob": -0.2339098835719451, "compression_ratio": 1.764, "no_speech_prob": 0.005222778767347336}, {"id": 76, "seek": 14986, "start": 173.58, "end": 175.52, "text": " And those who passed by derided him,", "tokens": [51551, 400, 729, 567, 4678, 538, 1163, 2112, 796, 11, 51648], "temperature": 0.0, "avg_logprob": -0.2339098835719451, "compression_ratio": 1.764, "no_speech_prob": 0.005222778767347336}, {"id": 77, "seek": 14986, "start": 175.88000000000002, "end": 177.28000000000003, "text": " wagging their heads and saying,", "tokens": [51666, 36854, 3249, 641, 8050, 293, 1566, 11, 51736], "temperature": 0.0, "avg_logprob": -0.2339098835719451, "compression_ratio": 1.764, "no_speech_prob": 0.005222778767347336}, {"id": 78, "seek": 14986, "start": 178.12, "end": 178.72000000000003, "text": " Aha!", "tokens": [51778, 27448, 0, 51808], "temperature": 0.0, "avg_logprob": -0.2339098835719451, "compression_ratio": 1.764, "no_speech_prob": 0.005222778767347336}, {"id": 79, "seek": 17986, "start": 179.86, "end": 183.12, "text": " You, who would destroy the temple", "tokens": [50365, 509, 11, 567, 576, 5293, 264, 10184, 50528], "temperature": 0.0, "avg_logprob": -0.24482288538852584, "compression_ratio": 1.6488888888888888, "no_speech_prob": 0.0012191988062113523}, {"id": 80, "seek": 17986, "start": 183.12, "end": 185.76000000000002, "text": " and rebuild it in three days,", "tokens": [50528, 293, 16877, 309, 294, 1045, 1708, 11, 50660], "temperature": 0.0, "avg_logprob": -0.24482288538852584, "compression_ratio": 1.6488888888888888, "no_speech_prob": 0.0012191988062113523}, {"id": 81, "seek": 17986, "start": 186.10000000000002, "end": 189.86, "text": " save yourself and come down from the cross.", "tokens": [50677, 3155, 1803, 293, 808, 760, 490, 264, 3278, 13, 50865], "temperature": 0.0, "avg_logprob": -0.24482288538852584, "compression_ratio": 1.6488888888888888, "no_speech_prob": 0.0012191988062113523}, {"id": 82, "seek": 17986, "start": 190.8, "end": 193.16000000000003, "text": " So also the chief priests with the scribes", "tokens": [50912, 407, 611, 264, 9588, 27192, 365, 264, 39435, 279, 51030], "temperature": 0.0, "avg_logprob": -0.24482288538852584, "compression_ratio": 1.6488888888888888, "no_speech_prob": 0.0012191988062113523}, {"id": 83, "seek": 17986, "start": 193.16000000000003, "end": 194.86, "text": " mocked him to one another, saying,", "tokens": [51030, 17362, 292, 796, 281, 472, 1071, 11, 1566, 11, 51115], "temperature": 0.0, "avg_logprob": -0.24482288538852584, "compression_ratio": 1.6488888888888888, "no_speech_prob": 0.0012191988062113523}, {"id": 84, "seek": 17986, "start": 195.68, "end": 197.72000000000003, "text": " He saved others.", "tokens": [51156, 634, 6624, 2357, 13, 51258], "temperature": 0.0, "avg_logprob": -0.24482288538852584, "compression_ratio": 1.6488888888888888, "no_speech_prob": 0.0012191988062113523}, {"id": 85, "seek": 17986, "start": 198.0, "end": 199.38000000000002, "text": " He could not save himself.", "tokens": [51272, 634, 727, 406, 3155, 3647, 13, 51341], "temperature": 0.0, "avg_logprob": -0.24482288538852584, "compression_ratio": 1.6488888888888888, "no_speech_prob": 0.0012191988062113523}, {"id": 86, "seek": 17986, "start": 199.88000000000002, "end": 202.02, "text": " Let the Christ, the king of Israel,", "tokens": [51366, 961, 264, 2040, 11, 264, 4867, 295, 5674, 11, 51473], "temperature": 0.0, "avg_logprob": -0.24482288538852584, "compression_ratio": 1.6488888888888888, "no_speech_prob": 0.0012191988062113523}, {"id": 87, "seek": 17986, "start": 202.18, "end": 204.0, "text": " come down now from the cross", "tokens": [51481, 808, 760, 586, 490, 264, 3278, 51572], "temperature": 0.0, "avg_logprob": -0.24482288538852584, "compression_ratio": 1.6488888888888888, "no_speech_prob": 0.0012191988062113523}, {"id": 88, "seek": 17986, "start": 204.0, "end": 206.20000000000002, "text": " that we may see and believe.", "tokens": [51572, 300, 321, 815, 536, 293, 1697, 13, 51682], "temperature": 0.0, "avg_logprob": -0.24482288538852584, "compression_ratio": 1.6488888888888888, "no_speech_prob": 0.0012191988062113523}, {"id": 89, "seek": 17986, "start": 207.04000000000002, "end": 209.10000000000002, "text": " Those who were crucified with him", "tokens": [51724, 3950, 567, 645, 46846, 365, 796, 51827], "temperature": 0.0, "avg_logprob": -0.24482288538852584, "compression_ratio": 1.6488888888888888, "no_speech_prob": 0.0012191988062113523}, {"id": 90, "seek": 17986, "start": 209.10000000000002, "end": 209.84, "text": " also replied,", "tokens": [51827, 611, 20345, 11, 51864], "temperature": 0.0, "avg_logprob": -0.24482288538852584, "compression_ratio": 1.6488888888888888, "no_speech_prob": 0.0012191988062113523}, {"id": 91, "seek": 20986, "start": 209.86, "end": 213.42000000000002, "text": " And when the sixth hour had come,", "tokens": [50365, 400, 562, 264, 15102, 1773, 632, 808, 11, 50543], "temperature": 0.0, "avg_logprob": -0.24648938860212052, "compression_ratio": 1.376068376068376, "no_speech_prob": 0.005121370777487755}, {"id": 92, "seek": 20986, "start": 213.82000000000002, "end": 215.78, "text": " there was darkness over the whole land", "tokens": [50563, 456, 390, 11262, 670, 264, 1379, 2117, 50661], "temperature": 0.0, "avg_logprob": -0.24648938860212052, "compression_ratio": 1.376068376068376, "no_speech_prob": 0.005121370777487755}, {"id": 93, "seek": 20986, "start": 215.78, "end": 217.02, "text": " until the ninth hour.", "tokens": [50661, 1826, 264, 28207, 1773, 13, 50723], "temperature": 0.0, "avg_logprob": -0.24648938860212052, "compression_ratio": 1.376068376068376, "no_speech_prob": 0.005121370777487755}, {"id": 94, "seek": 20986, "start": 217.68, "end": 218.82000000000002, "text": " And at the ninth hour,", "tokens": [50756, 400, 412, 264, 28207, 1773, 11, 50813], "temperature": 0.0, "avg_logprob": -0.24648938860212052, "compression_ratio": 1.376068376068376, "no_speech_prob": 0.005121370777487755}, {"id": 95, "seek": 20986, "start": 218.98000000000002, "end": 221.0, "text": " Jesus cried with a loud voice,", "tokens": [50821, 2705, 16266, 365, 257, 6588, 3177, 11, 50922], "temperature": 0.0, "avg_logprob": -0.24648938860212052, "compression_ratio": 1.376068376068376, "no_speech_prob": 0.005121370777487755}, {"id": 96, "seek": 20986, "start": 221.9, "end": 237.10000000000002, "text": " Which means,", "tokens": [50967, 3013, 1355, 11, 51727], "temperature": 0.0, "avg_logprob": -0.24648938860212052, "compression_ratio": 1.376068376068376, "no_speech_prob": 0.005121370777487755}, {"id": 97, "seek": 23986, "start": 239.86, "end": 241.34, "text": " My God,", "tokens": [50365, 1222, 1265, 11, 50439], "temperature": 0.0, "avg_logprob": -0.29656299109597806, "compression_ratio": 1.5023696682464456, "no_speech_prob": 0.00026653968961909413}, {"id": 98, "seek": 23986, "start": 242.18, "end": 244.4, "text": " My God,", "tokens": [50481, 1222, 1265, 11, 50592], "temperature": 0.0, "avg_logprob": -0.29656299109597806, "compression_ratio": 1.5023696682464456, "no_speech_prob": 0.00026653968961909413}, {"id": 99, "seek": 23986, "start": 245.02, "end": 250.64000000000001, "text": " Why have you forsaken me?", "tokens": [50623, 1545, 362, 291, 32299, 9846, 385, 30, 50904], "temperature": 0.0, "avg_logprob": -0.29656299109597806, "compression_ratio": 1.5023696682464456, "no_speech_prob": 0.00026653968961909413}, {"id": 100, "seek": 23986, "start": 251.9, "end": 254.42000000000002, "text": " And some of the bystanders hearing it said,", "tokens": [50967, 400, 512, 295, 264, 538, 1115, 433, 4763, 309, 848, 11, 51093], "temperature": 0.0, "avg_logprob": -0.29656299109597806, "compression_ratio": 1.5023696682464456, "no_speech_prob": 0.00026653968961909413}, {"id": 101, "seek": 23986, "start": 255.12, "end": 256.78000000000003, "text": " Behold, he is calling Elijah.", "tokens": [51128, 879, 4104, 11, 415, 307, 5141, 36147, 13, 51211], "temperature": 0.0, "avg_logprob": -0.29656299109597806, "compression_ratio": 1.5023696682464456, "no_speech_prob": 0.00026653968961909413}, {"id": 102, "seek": 23986, "start": 257.34000000000003, "end": 260.46000000000004, "text": " And someone ran and filled a sponge with sour wine,", "tokens": [51239, 400, 1580, 5872, 293, 6412, 257, 23134, 365, 11006, 7209, 11, 51395], "temperature": 0.0, "avg_logprob": -0.29656299109597806, "compression_ratio": 1.5023696682464456, "no_speech_prob": 0.00026653968961909413}, {"id": 103, "seek": 23986, "start": 260.86, "end": 263.42, "text": " put it on a reed and gave it to him to drink, saying,", "tokens": [51415, 829, 309, 322, 257, 319, 292, 293, 2729, 309, 281, 796, 281, 2822, 11, 1566, 11, 51543], "temperature": 0.0, "avg_logprob": -0.29656299109597806, "compression_ratio": 1.5023696682464456, "no_speech_prob": 0.00026653968961909413}, {"id": 104, "seek": 23986, "start": 263.8, "end": 267.7, "text": " Ah, wait, let us see whether Elijah will come to take him down.", "tokens": [51562, 2438, 11, 1699, 11, 718, 505, 536, 1968, 36147, 486, 808, 281, 747, 796, 760, 13, 51757], "temperature": 0.0, "avg_logprob": -0.29656299109597806, "compression_ratio": 1.5023696682464456, "no_speech_prob": 0.00026653968961909413}, {"id": 105, "seek": 23986, "start": 268.48, "end": 269.62, "text": " And Jesus uttered a loud voice,", "tokens": [51796, 400, 2705, 17567, 292, 257, 6588, 3177, 11, 51853], "temperature": 0.0, "avg_logprob": -0.29656299109597806, "compression_ratio": 1.5023696682464456, "no_speech_prob": 0.00026653968961909413}, {"id": 106, "seek": 26962, "start": 269.62, "end": 271.72, "text": " a loud cry and breathed his last.", "tokens": [50365, 257, 6588, 3305, 293, 6045, 292, 702, 1036, 13, 50470], "temperature": 0.0, "avg_logprob": -0.1709940972989493, "compression_ratio": 1.6856060606060606, "no_speech_prob": 0.002641970757395029}, {"id": 107, "seek": 26962, "start": 272.52, "end": 274.82, "text": " And the curtain of the temple was torn in two", "tokens": [50510, 400, 264, 26789, 295, 264, 10184, 390, 10885, 294, 732, 50625], "temperature": 0.0, "avg_logprob": -0.1709940972989493, "compression_ratio": 1.6856060606060606, "no_speech_prob": 0.002641970757395029}, {"id": 108, "seek": 26962, "start": 274.82, "end": 276.1, "text": " from top to bottom.", "tokens": [50625, 490, 1192, 281, 2767, 13, 50689], "temperature": 0.0, "avg_logprob": -0.1709940972989493, "compression_ratio": 1.6856060606060606, "no_speech_prob": 0.002641970757395029}, {"id": 109, "seek": 26962, "start": 276.84000000000003, "end": 279.0, "text": " And when the centurion who stood facing him", "tokens": [50726, 400, 562, 264, 1489, 374, 313, 567, 9371, 7170, 796, 50834], "temperature": 0.0, "avg_logprob": -0.1709940972989493, "compression_ratio": 1.6856060606060606, "no_speech_prob": 0.002641970757395029}, {"id": 110, "seek": 26962, "start": 279.0, "end": 281.6, "text": " saw that in this way he breathed his last,", "tokens": [50834, 1866, 300, 294, 341, 636, 415, 6045, 292, 702, 1036, 11, 50964], "temperature": 0.0, "avg_logprob": -0.1709940972989493, "compression_ratio": 1.6856060606060606, "no_speech_prob": 0.002641970757395029}, {"id": 111, "seek": 26962, "start": 281.84000000000003, "end": 282.34000000000003, "text": " he said,", "tokens": [50976, 415, 848, 11, 51001], "temperature": 0.0, "avg_logprob": -0.1709940972989493, "compression_ratio": 1.6856060606060606, "no_speech_prob": 0.002641970757395029}, {"id": 112, "seek": 26962, "start": 283.02, "end": 285.86, "text": " Truly, this man was the Son of God.", "tokens": [51035, 43548, 11, 341, 587, 390, 264, 5185, 295, 1265, 13, 51177], "temperature": 0.0, "avg_logprob": -0.1709940972989493, "compression_ratio": 1.6856060606060606, "no_speech_prob": 0.002641970757395029}, {"id": 113, "seek": 26962, 