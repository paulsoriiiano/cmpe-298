 {"id": 56, "seek": 11980, "start": 138.24, "end": 139.92, "text": " are the ones who hear the word", "tokens": [51287, 366, 264, 2306, 567, 1568, 264, 1349, 51371], "temperature": 0.0, "avg_logprob": -0.1659207633047393, "compression_ratio": 1.832618025751073, "no_speech_prob": 0.0007378720911219716}, {"id": 57, "seek": 11980, "start": 139.92, "end": 141.94, "text": " and accept it and bear fruit", "tokens": [51371, 293, 3241, 309, 293, 6155, 6773, 51472], "temperature": 0.0, "avg_logprob": -0.1659207633047393, "compression_ratio": 1.832618025751073, "no_speech_prob": 0.0007378720911219716}, {"id": 58, "seek": 11980, "start": 141.94, "end": 144.18, "text": " thirtyfold and sixtyfold", "tokens": [51472, 11790, 18353, 293, 21390, 18353, 51584], "temperature": 0.0, "avg_logprob": -0.1659207633047393, "compression_ratio": 1.832618025751073, "no_speech_prob": 0.0007378720911219716}, {"id": 59, "seek": 11980, "start": 144.18, "end": 145.54, "text": " and a hundredfold.", "tokens": [51584, 293, 257, 3262, 18353, 13, 51652], "temperature": 0.0, "avg_logprob": -0.1659207633047393, "compression_ratio": 1.832618025751073, "no_speech_prob": 0.0007378720911219716}, {"id": 60, "seek": 11980, "start": 145.94, "end": 147.32, "text": " And he said to them,", "tokens": [51672, 400, 415, 848, 281, 552, 11, 51741], "temperature": 0.0, "avg_logprob": -0.1659207633047393, "compression_ratio": 1.832618025751073, "no_speech_prob": 0.0007378720911219716}, {"id": 61, "seek": 11980, "start": 147.7, "end": 149.28, "text": " Is a lamp brought in", "tokens": [51760, 1119, 257, 12684, 3038, 294, 51839], "temperature": 0.0, "avg_logprob": -0.1659207633047393, "compression_ratio": 1.832618025751073, "no_speech_prob": 0.0007378720911219716}, {"id": 62, "seek": 14928, "start": 149.28, "end": 150.82, "text": " to be put under a basket", "tokens": [50365, 281, 312, 829, 833, 257, 8390, 50442], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 63, "seek": 14928, "start": 150.82, "end": 151.9, "text": " or under a bed", "tokens": [50442, 420, 833, 257, 2901, 50496], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 64, "seek": 14928, "start": 151.9, "end": 153.2, "text": " and not on a stand?", "tokens": [50496, 293, 406, 322, 257, 1463, 30, 50561], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 65, "seek": 14928, "start": 153.98, "end": 155.34, "text": " For nothing is hidden", "tokens": [50600, 1171, 1825, 307, 7633, 50668], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 66, "seek": 14928, "start": 155.34, "end": 156.86, "text": " except to be made manifest,", "tokens": [50668, 3993, 281, 312, 1027, 10067, 11, 50744], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 67, "seek": 14928, "start": 157.22, "end": 158.56, "text": " nor is anything secret", "tokens": [50762, 6051, 307, 1340, 4054, 50829], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 68, "seek": 14928, "start": 158.56, "end": 159.68, "text": " except to come to light.", "tokens": [50829, 3993, 281, 808, 281, 1442, 13, 50885], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 69, "seek": 14928, "start": 160.58, "end": 162.56, "text": " If anyone has ears to hear,", "tokens": [50930, 759, 2878, 575, 8798, 281, 1568, 11, 51029], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 70, "seek": 14928, "start": 162.88, "end": 163.9, "text": " let him hear.", "tokens": [51045, 718, 796, 1568, 13, 51096], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 71, "seek": 14928, "start": 164.62, "end": 165.62, "text": " And he said to them,", "tokens": [51132, 400, 415, 848, 281, 552, 11, 51182], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 72, "seek": 14928, "start": 166.28, "end": 168.16, "text": " Pay attention to what you hear.", "tokens": [51215, 11431, 3202, 281, 437, 291, 1568, 13, 51309], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 73, "seek": 14928, "start": 168.54, "end": 169.86, "text": " With the measure you use,", "tokens": [51328, 2022, 264, 3481, 291, 764, 11, 51394], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 74, "seek": 14928, "start": 170.06, "end": 171.36, "text": " it will be measured to you,", "tokens": [51404, 309, 486, 312, 12690, 281, 291, 11, 51469], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 75, "seek": 14928, "start": 171.36, "end": 173.46, "text": " and still more will be added to you.", "tokens": [51469, 293, 920, 544, 486, 312, 3869, 281, 291, 13, 51574], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 76, "seek": 14928, "start": 174.34, "end": 175.7, "text": " For to the one who has,", "tokens": [51618, 1171, 281, 264, 472, 567, 575, 11, 51686], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 77, "seek": 14928, "start": 175.8, "end": 176.54, "text": " more will be given.", "tokens": [51691, 544, 486, 312, 2212, 13, 51728], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 78, "seek": 14928, "start": 177.1, "end": 178.6, "text": " And from the one who has not,", "tokens": [51756, 400, 490, 264, 472, 567, 575, 406, 11, 51831], "temperature": 0.0, "avg_logprob": -0.1847889527030613, "compression_ratio": 1.774468085106383, "no_speech_prob": 0.0028655880596488714}, {"id": 79, "seek": 17860, "start": 178.6, "end": 181.35999999999999, "text": " even what he has will be taken away.", "tokens": [50365, 754, 437, 415, 575, 486, 312, 2726, 1314, 13, 50503], "temperature": 0.0, "avg_logprob": -0.20840477220939868, "compression_ratio": 1.6761133603238867, "no_speech_prob": 0.0005747492541559041}, {"id": 80, "seek": 17860, "start": 182.01999999999998, "end": 182.79999999999998, "text": " And he said,", "tokens": [50536, 400, 415, 848, 11, 50575], "temperature": 0.0, "avg_logprob": -0.20840477220939868, "compression_ratio": 1.6761133603238867, "no_speech_prob": 0.0005747492541559041}, {"id": 81, "seek": 17860, "start": 183.57999999999998, "end": 184.7, "text": " The kingdom of God", "tokens": [50614, 440, 10231, 295, 1265, 50670], "temperature": 0.0, "avg_logprob": -0.20840477220939868, "compression_ratio": 1.6761133603238867, "no_speech_prob": 0.0005747492541559041}, {"id": 82, "seek": 17860, "start": 184.7, "end": 187.38, "text": " is as if a man should scatter seed on the ground.", "tokens": [50670, 307, 382, 498, 257, 587, 820, 34951, 8871, 322, 264, 2727, 13, 50804], "temperature": 0.0, "avg_logprob": -0.20840477220939868, "compression_ratio": 1.6761133603238867, "no_speech_prob": 0.0005747492541559041}, {"id": 83, "seek": 17860, "start": 187.84, "end": 190.1, "text": " He sleeps and rises night and day,", "tokens": [50827, 634, 37991, 293, 21373, 1818, 293, 786, 11, 50940], "temperature": 0.0, "avg_logprob": -0.20840477220939868, "compression_ratio": 1.6761133603238867, "no_speech_prob": 0.0005747492541559041}, {"id": 84, "seek": 17860, "start": 190.28, "end": 191.9, "text": " and the seed sprouts and grows.", "tokens": [50949, 293, 264, 8871, 34628, 293, 13156, 13, 51030], "temperature": 0.0, "avg_logprob": -0.20840477220939868, "compression_ratio": 1.6761133603238867, "no_speech_prob": 0.0005747492541559041}, {"id": 85, "seek": 17860, "start": 192.28, "end": 193.45999999999998, "text": " He knows not how.", "tokens": [51049, 634, 3255, 406, 577, 13, 51108], "temperature": 0.0, "avg_logprob": -0.20840477220939868, "compression_ratio": 1.6761133603238867, "no_speech_prob": 0.0005747492541559041}, {"id": 86, "seek": 17860, "start": 194.07999999999998, "end": 196.07999999999998, "text": " The earth produces by itself,", "tokens": [51139, 440, 4120, 14725, 538, 2564, 11, 51239], "temperature": 0.0, "avg_logprob": -0.20840477220939868, "compression_ratio": 1.6761133603238867, "no_speech_prob": 0.0005747492541559041}, {"id": 87, "seek": 17860, "start": 196.57999999999998, "end": 198.1, "text": " first the blade, then the ear,", "tokens": [51264, 700, 264, 10959, 11, 550, 264, 1273, 11, 51340], "temperature": 0.0, "avg_logprob": -0.20840477220939868, "compression_ratio": 1.6761133603238867, "no_speech_prob": 0.0005747492541559041}, {"id": 88, "seek": 17860, "start": 198.38, "end": 199.72, "text": " then the full grain in the ear.", "tokens": [51354, 550, 264, 1577, 12837, 294, 264, 1273, 13, 51421], "temperature": 0.0, "avg_logprob": -0.20840477220939868, "compression_ratio": 1.6761133603238867, "no_speech_prob": 0.0005747492541559041}, {"id": 89, "seek": 17860, "start": 200.22, "end": 201.92, "text": " But when the grain is ripe,", "tokens": [51446, 583, 562, 264, 12837, 307, 31421, 11, 51531], "temperature": 0.0, "avg_logprob": -0.20840477220939868, "compression_ratio": 1.6761133603238867, "no_speech_prob": 0.0005747492541559041}, {"id": 90, "seek": 17860, "start": 202.18, "end": 203.79999999999998, "text": " at once he puts in the sickle,", "tokens": [51544, 412, 1564, 415, 8137, 294, 264, 4998, 306, 11, 51625], "temperature": 0.0, "avg_logprob": -0.20840477220939868, "compression_ratio": 1.6761133603238867, "no_speech_prob": 0.0005747492541559041}, {"id": 91, "seek": 17860, "start": 203.95999999999998, "end": 205.79999999999998, "text": " because the harvest has come.", "tokens": [51633, 570, 264, 11917, 575, 808, 13, 51725], "temperature": 0.0, "avg_logprob": -0.20840477220939868, "compression_ratio": 1.6761133603238867, "no_speech_prob": 0.0005747492541559041}, {"id": 92, "seek": 17860, "start": 206.51999999999998, "end": 207.38, "text": " And he said,", "tokens": [51761, 400, 415, 848, 11, 51804], "temperature": 0.0, "avg_logprob": -0.20840477220939868, "compression_ratio": 1.6761133603238867, "no_speech_prob": 0.0005747492541559041}, {"id": 93, "seek": 17860, "start": 207.72, "end": 208.38, "text": " With what seed?", "tokens": [51821, 2022, 437, 8871, 30, 51854], "temperature": 0.0, "avg_logprob": -0.20840477220939868, "compression_ratio": 1.6761133603238867, "no_speech_prob": 0.0005747492541559041}, {"id": 94, "seek": 20860, "start": 208.6, "end": 210.35999999999999, "text": " What can we compare the kingdom of God?", "tokens": [50365, 708, 393, 321, 6794, 264, 10231, 295, 1265, 30, 50453], "temperature": 0.0, "avg_logprob": -0.15384105760224012, "compression_ratio": 1.7122302158273381, "no_speech_prob": 0.0013145582051947713}, {"id": 95, "seek": 20860, "start": 210.73999999999998, "end": 212.88, "text": " Or what parable shall we use for it?", "tokens": [50472, 1610, 437, 971, 712, 4393, 321, 764, 337, 309, 30, 50579], "temperature": 0.0, "avg_logprob": -0.15384105760224012, "compression_ratio": 1.7122302158273381, "no_speech_prob": 0.0013145582051947713}, {"id": 96, "seek": 20860, "start": 213.72, "end": 215.94, "text": " It is like a grain of mustard seed,", "tokens": [50621, 467, 307, 411, 257, 12837, 295, 23659, 8871, 11, 50732], "temperature": 0.0, "avg_logprob": -0.15384105760224012, "compression_ratio": 1.7122302158273381, "no_speech_prob": 0.0013145582051947713}, {"id": 97, "seek": 20860, "start": 216.24, "end": 217.68, "text": " which when sown on the ground", "tokens": [50747, 597, 562, 262, 648, 322, 264, 2727, 50819], "temperature": 0.0, "avg_logprob": -0.15384105760224012, "compression_ratio": 1.7122302158273381, "no_speech_prob": 0.0013145582051947713}, {"id": 98, "seek": 20860, "start": 217.68, "end": 220.22, "text": " is the smallest of all the seeds on earth.", "tokens": [50819, 307, 264, 16998, 295, 439, 264, 9203, 322, 4120, 13, 50946], "temperature": 0.0, "avg_logprob": -0.15384105760224012, "compression_ratio": 1.7122302158273381, "no_speech_prob": 0.0013145582051947713}, {"id": 99, "seek": 20860, "start": 220.78, "end": 221.85999999999999, "text": " Yet when it is sown,", "tokens": [50974, 10890, 562, 309, 307, 262, 648, 11, 51028], "temperature": 0.0, "avg_logprob": -0.15384105760224012, "compression_ratio": 1.7122302158273381, "no_speech_prob": 0.0013145582051947713}, {"id": 100, "seek": 20860, "start": 221.94, "end": 223.57999999999998, "text": " it grows up and becomes larger", "tokens": [51032, 309, 13156, 493, 293, 3643, 4833, 51114], "temperature": 0.0, "avg_logprob": -0.15384105760224012, "compression_ratio": 1.7122302158273381, "no_speech_prob": 0.0013145582051947713}, {"id": 101, "seek": 20860, "start": 223.57999999999998, "end": 224.94, "text": " than all the garden plants,", "tokens": [51114, 813, 439, 264, 7431, 5972, 11, 51182], "temperature": 0.0, "avg_logprob": -0.15384105760224012, "compression_ratio": 1.7122302158273381, "no_speech_prob": 0.0013145582051947713}, {"id": 102, "seek": 20860, "start": 225.1, "end": 226.74, "text": " and puts out large branches,", "tokens": [51190, 293, 8137, 484, 2416, 14770, 11, 51272], "temperature": 0.0, "avg_logprob": -0.15384105760224012, "compression_ratio": 1.7122302158273381, "no_speech_prob": 0.0013145582051947713}, {"id": 103, "seek": 20860, "start": 227.28, "end": 228.66, "text": " so that the birds of the air", "tokens": [51299, 370, 300, 264, 9009, 295, 264, 1988, 51368], "temperature": 0.0, "avg_logprob": -0.15384105760224012, "compression_ratio": 1.7122302158273381, "no_speech_prob": 0.0013145582051947713}, {"id": 104, "seek": 20860, "start": 228.66, "end": 230.42, "text": " can make nests in its shade.", "tokens": [51368, 393, 652, 297, 4409, 294, 1080, 11466, 13, 51456], "temperature": 0.0, "avg_logprob": -0.15384105760224012, "compression_ratio": 1.7122302158273381, "no_speech_prob": 0.0013145582051947713}, {"id": 105, "seek": 20860, "start": 231.14, "end": 232.42, "text": " With many such parables", "tokens": [51492, 2022, 867, 1270, 971, 2965, 51556], "temperature": 0.0, "avg_logprob": -0.15384105760224012, "compression_ratio": 1.7122302158273381, "no_speech_prob": 0.0013145582051947713}, {"id": 106, "seek": 20860, "start": 232.42, "end": 233.68, "text": " he spoke the word to them", "tokens": [51556, 415, 7179, 264, 1349, 281, 552, 51619], "temperature": 0.0, "avg_logprob": -0.15384105760224012, "compression_ratio": 1.7122302158273381, "no_speech_prob": 0.0013145582051947713}, {"id": 107, "seek": 20860, "start": 233.68, "end": 235.16, "text": " as they were able to hear it.", "tokens": [51619, 382, 436, 645, 1075, 281, 1568, 309, 13, 51693], "temperature": 0.0, "avg_logprob": -0.15384105760224012, "compression_ratio": 1.7122302158273381, "no_speech_prob": 0.0013145582051947713}, {"id": 108, "seek": 20860, "start": 235.64, "end": 237.76, "text": " He did not speak to them without a parable,", "tokens": [51717, 634, 630, 406, 1710, 281, 552, 1553, 257, 971, 712, 11, 51823], "temperature": 0.0, "avg_logprob": -0.15384105760224012, "compression_ratio": 1.7122302158273381, "no_speech_prob": 0.0013145582051947713}, {"id": 109, "seek": 23776, "start": 237.76, "end": 239.89999999999998, "text": " but privately to his own disciples", "tokens": [50365, 457, 31919, 281, 702, 1065, 17209, 50472], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 110, "seek": 23776, "start": 239.89999999999998, "end": 241.44, "text": " he explained everything.", "tokens": [50472, 415, 8825, 1203, 13, 50549], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 111, "seek": 23776, "start": 242.23999999999998, "end": 244.14, "text": " On that day when evening had come,", "tokens": [50589, 1282, 300, 786, 562, 5634, 632, 808, 11, 50684], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 112, "seek": 23776, "start": 244.32, "end": 245.22, "text": " he said to them,", "tokens": [50693, 415, 848, 281, 552, 11, 50738], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 113, "seek": 23776, "start": 245.98, "end": 248.04, "text": " Let us go across to the other side.", "tokens": [50776, 961, 505, 352, 2108, 281, 264, 661, 1252, 13, 50879], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 114, "seek": 23776, "start": 248.7, "end": 249.7, "text": " And leaving the crowd,", "tokens": [50912, 400, 5012, 264, 6919, 11, 50962], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 115, "seek": 23776, "start": 249.88, "end": 251.5, "text": " they took him with them in the boat,", "tokens": [50971, 436, 1890, 796, 365, 552, 294, 264, 6582, 11, 51052], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 116, "seek": 23776, "start": 251.7, "end": 252.62, "text": " just as he was.", "tokens": [51062, 445, 382, 415, 390, 13, 51108], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 117, "seek": 23776, "start": 253.16, "end": 254.56, "text": " And other boats were with him.", "tokens": [51135, 400, 661, 17772, 645, 365, 796, 13, 51205], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 118, "seek": 23776, "start": 255.07999999999998, "end": 256.88, "text": " And a great windstorm arose,", "tokens": [51231, 400, 257, 869, 2468, 17367, 37192, 11, 51321], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 119, "seek": 23776, "start": 257.21999999999997, "end": 259.09999999999997, "text": " and the waves were breaking into the boat,", "tokens": [51338, 293, 264, 9417, 645, 7697, 666, 264, 6582, 11, 51432], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 120, "seek": 23776, "start": 259.18, "end": 260.8, "text": " so that the boat was already filling.", "tokens": [51436, 370, 300, 264, 6582, 390, 1217, 10623, 13, 51517], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 121, "seek": 23776, "start": 261.36, "end": 262.71999999999997, "text": " But he was in the stern,", "tokens": [51545, 583, 415, 390, 294, 264, 38312, 11, 51613], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 122, "seek": 23776, "start": 262.86, "end": 263.92, "text": " asleep on the cushion.", "tokens": [51620, 11039, 322, 264, 21908, 13, 51673], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 123, "seek": 23776, "start": 264.42, "end": 266.09999999999997, "text": " And they woke him and said to him,", "tokens": [51698, 400, 436, 12852, 796, 293, 848, 281, 796, 11, 51782], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 124, "seek": 23776, "start": 266.74, "end": 267.14, "text": " Teacher,", "tokens": [51814, 19745, 11, 51834], "temperature": 0.0, "avg_logprob": -0.21027198626840715, "compression_ratio": 1.7471264367816093, "no_speech_prob": 0.0026504499837756157}, {"id": 125, "seek": 26714, "start": 267.14, "end": 269.09999999999997, "text": " do you not care that we are perishing?", "tokens": [50365, 360, 291, 406, 1127, 300, 321, 366, 680, 3807, 30, 50463], "temperature": 0.0, "avg_logprob": -0.2542355307217302, "compression_ratio": 1.7282051282051283, "no_speech_prob": 0.0018965656636282802}, {"id": 126, "seek": 26714, "start": 269.56, "end": 271.84, "text": " And he awoke and rebuked the wind,", "tokens": [50486, 400, 415, 1714, 2949, 293, 12970, 2034, 292, 264, 2468, 11, 50600], "temperature": 0.0, "avg_logprob": -0.2542355307217302, "compression_ratio": 1.7282051282051283, "no_speech_prob": 0.0018965656636282802}, {"id": 127, "seek": 26714, "start": 272.0, "end": 272.97999999999996, "text": " and said to the sea,", "tokens": [50608, 293, 848, 281, 264, 4158, 11, 50657], "temperature": 0.0, "avg_logprob": -0.2542355307217302, "compression_ratio": 1.7282051282051283, "no_speech_prob": 0.0018965656636282802}, {"id": 128, "seek": 26714, "start": 273.71999999999997, "end": 276.2, "text": " Peace, be still.", "tokens": [50694, 13204, 11, 312, 920, 13, 50818], "temperature": 0.0, "avg_logprob": -0.2542355307217302, "compression_ratio": 1.7282051282051283, "no_speech_prob": 0.0018965656636282802}, {"id": 129, "seek": 26714, "start": 277.38, "end": 278.96, "text": " And the wind ceased,", "tokens": [50877, 400, 264, 2468, 49917, 11, 50956], "temperature": 0.0, "avg_logprob": -0.2542355307217302, "compression_ratio": 1.7282051282051283, "no_speech_prob": 0.0018965656636282802}, {"id": 130, "seek": 26714, "start": 279.28, "end": 280.64, "text": " and there was a great calm.", "tokens": [50972, 293, 456, 390, 257, 869, 7151, 13, 51040], "temperature": 0.0, "avg_logprob": -0.2542355307217302, "compression_ratio": 1.7282051282051283, "no_speech_prob": 0.0018965656636282802}, {"id": 131, "seek": 26714, "start": 281.15999999999997, "end": 281.94, "text": " He said to them,", "tokens": [51066, 634, 848, 281, 552, 11, 51105], "temperature": 0.0, "avg_logprob": -0.2542355307217302, "compression_ratio": 1.7282051282051283, "no_speech_prob": 0.0018965656636282802}, {"id": 132, "seek": 26714, "start": 282.7, "end": 284.52, "text": " Why are you so afraid?", "tokens": [51143, 1545, 366, 291, 370, 4638, 30, 51234], "temperature": 0.0, "avg_logprob": -0.2542355307217302, "compression_ratio": 1.7282051282051283, "no_speech_prob": 0.0018965656636282802}, {"id": 133, "seek": 26714, "start": 285.46, "end": 287.34, "text": " Have you still no faith?", "tokens": [51281, 3560, 291, 920, 572, 4522, 30, 51375], "temperature": 0.0, "avg_logprob": -0.2542355307217302, "compression_ratio": 1.7282051282051283, "no_speech_prob": 0.0018965656636282802}, {"id": 134, "seek": 26714, "start": 288.21999999999997, "end": 290.21999999999997, "text": " And they were filled with great fear,", "tokens": [51419, 400, 436, 645, 6412, 365, 869, 4240, 11, 51519], "temperature": 0.0, "avg_logprob": -0.2542355307217302, "compression_ratio": 1.7282051282051283, "no_speech_prob": 0.0018965656636282802}, {"id": 135, "seek": 26714, "start": 290.36, "end": 291.46, "text": " and said to one another,", "tokens": [51526, 293, 848, 281, 472, 1071, 11, 51581], "temperature": 0.0, "avg_logprob": -0.2542355307217302, "compression_ratio": 1.7282051282051283, "no_speech_prob": 0.0018965656636282802}, {"id": 136, "seek": 26714, "start": 292.14, "end": 293.74, "text": " Who then is this,", "tokens": [51615, 2102, 550, 307, 341, 11, 51695], "temperature": 0.0, "avg_logprob": -0.2542355307217302, "compression_ratio": 1.7282051282051283, "no_speech_prob": 0.0018965656636282802}, {"id": 137, "seek": 26714, "start": 294.59999999999997, "end": 295.74, "text": " that even the wind", "tokens": [51738, 300, 754, 264, 2468, 51795], "temperature": 0.0, "avg_logprob": -0.2542355307217302, "compression_ratio": 1.7282051282051283, "no_speech_prob": 0.0018965656636282802}, {"id": 138, "seek": 26714, "start": 295.74, "end": 297.12, "text": " and the sea", "tokens": [51795, 293, 264, 4158, 51864], "temperature": 0.0, "avg_logprob": -0.2542355307217302, "compression_ratio": 1.7282051282051283, "no_speech_prob": 0.0018965656636282802}, {"id": 139, "seek": 29714, "start": 297.14, "end": 298.09999999999997, "text": " may obey him?", "tokens": [50365, 815, 19297, 796, 30, 50413], "temperature": 1.0, "avg_logprob": -2.0743777751922607, "compression_ratio": 0.6190476190476191, "no_speech_prob": 0.002490445738658309}, {"id": 140, "seek": 29810, "start": 298.1, "end": 328.08000000000004, "text": " Thank you.", "tokens": [50365, 1044, 291, 13, 51864], "temperature": 0.0, "avg_logprob": -0.46235036849975586, "compression_ratio": 0.5555555555555556, "no_speech_prob": 0.9415137767791748}], "language": "English"}