, 13, 50765], "temperature": 0.0, "avg_logprob": -0.3048365456717355, "compression_ratio": 1.6104651162790697, "no_speech_prob": 0.0047669424675405025}, {"id": 56, "seek": 20678, "start": 214.78, "end": 218.78, "text": " And great crowds followed him from Galilee and the Decapolis,", "tokens": [50765, 400, 869, 26070, 6263, 796, 490, 7336, 33914, 293, 264, 1346, 9485, 16466, 11, 50965], "temperature": 0.0, "avg_logprob": -0.3048365456717355, "compression_ratio": 1.6104651162790697, "no_speech_prob": 0.0047669424675405025}, {"id": 57, "seek": 20678, "start": 218.78, "end": 220.78, "text": " and from Jerusalem and Judea,", "tokens": [50965, 293, 490, 15393, 293, 36521, 64, 11, 51065], "temperature": 0.0, "avg_logprob": -0.3048365456717355, "compression_ratio": 1.6104651162790697, "no_speech_prob": 0.0047669424675405025}, {"id": 58, "seek": 20678, "start": 220.78, "end": 222.78, "text": " and from beyond the Jordan.", "tokens": [51065, 293, 490, 4399, 264, 10979, 13, 51165], "temperature": 0.0, "avg_logprob": -0.3048365456717355, "compression_ratio": 1.6104651162790697, "no_speech_prob": 0.0047669424675405025}], "language": "English"}