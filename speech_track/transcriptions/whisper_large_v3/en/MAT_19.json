67, 366, 264, 5185, 295, 2458, 11, 51864], "temperature": 0.0, "avg_logprob": -0.22046232604980467, "compression_ratio": 1.8277310924369747, "no_speech_prob": 0.0019873972050845623}, {"id": 48, "seek": 23424, "start": 234.24, "end": 239.48000000000002, "text": " you who have followed Me, will also sit on twelve thrones, judging the twelve tribes of Israel.", "tokens": [50365, 291, 567, 362, 6263, 1923, 11, 486, 611, 1394, 322, 14390, 739, 2213, 11, 23587, 264, 14390, 19035, 295, 5674, 13, 50627], "temperature": 0.0, "avg_logprob": -0.10157490885534952, "compression_ratio": 1.6517412935323383, "no_speech_prob": 0.0008899447275325656}, {"id": 49, "seek": 23424, "start": 240.18, "end": 244.76000000000002, "text": " And everyone who has left houses, or brothers, or sisters, or father, or mother,", "tokens": [50662, 400, 1518, 567, 575, 1411, 8078, 11, 420, 8452, 11, 420, 11589, 11, 420, 3086, 11, 420, 2895, 11, 50891], "temperature": 0.0, "avg_logprob": -0.10157490885534952, "compression_ratio": 1.6517412935323383, "no_speech_prob": 0.0008899447275325656}, {"id": 50, "seek": 23424, "start": 245.06, "end": 251.76000000000002, "text": " or children, or lands, for My namesake, will receive a hundredfold, and will inherit eternal", "tokens": [50906, 420, 2227, 11, 420, 5949, 11, 337, 1222, 5288, 619, 11, 486, 4774, 257, 3262, 18353, 11, 293, 486, 21389, 14503, 51241], "temperature": 0.0, "avg_logprob": -0.10157490885534952, "compression_ratio": 1.6517412935323383, "no_speech_prob": 0.0008899447275325656}, {"id": 51, "seek": 23424, "start": 251.76000000000002, "end": 257.14, "text": " life. But many who are first will be last, and the last first.", "tokens": [51241, 993, 13, 583, 867, 567, 366, 700, 486, 312, 1036, 11, 293, 264, 1036, 700, 13, 51510], "temperature": 0.0, "avg_logprob": -0.10157490885534952, "compression_ratio": 1.6517412935323383, "no_speech_prob": 0.0008899447275325656}], "language": "English"}