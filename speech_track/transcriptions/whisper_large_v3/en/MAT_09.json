emperature": 0.0, "avg_logprob": -0.14609110589120902, "compression_ratio": 1.6008064516129032, "no_speech_prob": 0.0017394819296896458}, {"id": 39, "seek": 14628, "start": 158.82, "end": 166.5, "text": " My daughter has just died, but come and lay your hand on her, and she will live.", "tokens": [50992, 1222, 4653, 575, 445, 4539, 11, 457, 808, 293, 2360, 428, 1011, 322, 720, 11, 293, 750, 486, 1621, 13, 51376], "temperature": 0.0, "avg_logprob": -0.14609110589120902, "compression_ratio": 1.6008064516129032, "no_speech_prob": 0.0017394819296896458}, {"id": 40, "seek": 14628, "start": 167.3, "end": 169.62, "text": " And Jesus rose and followed him with his disciples.", "tokens": [51416, 400, 2705, 10895, 293, 6263, 796, 365, 702, 17209, 13, 51532], "temperature": 0.0, "avg_logprob": -0.14609110589120902, "compression_ratio": 1.6008064516129032, "no_speech_prob": 0.0017394819296896458}, {"id": 41, "seek": 14628, "start": 170.18, "end": 175.6, "text": " And behold, a woman who had suffered from a discharge of blood for twelve years came up behind him,", "tokens": [51560, 400, 27234, 11, 257, 3059, 567, 632, 12770, 490, 257, 21718, 295, 3390, 337, 14390, 924, 1361, 493, 2261, 796, 11, 51831], "temperature": 0.0, "avg_logprob": -0.14609110589120902, "compression_ratio": 1.6008064516129032, "no_speech_prob": 0.0017394819296896458}, {"id": 42, "seek": 17560, "start": 175.6, "end": 177.92, "text": " and touched the fringe of his garment.", "tokens": [50365, 293, 9828, 264, 38764, 295, 702, 35084, 13, 50481], "temperature": 0.0, "avg_logprob": -0.16178065079909104, "compression_ratio": 1.6605504587155964, "no_speech_prob": 8.219961455324665e-05}, {"id": 43, "seek": 17560, "start": 178.42, "end": 179.9, "text": " For she said to herself,", "tokens": [50506, 1171, 750, 848, 281, 7530, 11, 50580], "temperature": 0.0, "avg_logprob": -0.16178065079909104, "compression_ratio": 1.6605504587155964, "no_speech_prob": 8.219961455324665e-05}, {"id": 44, "seek": 17560, "start": 180.78, "end": 184.9, "text": " If I only touch his garment, I will be made well.", "tokens": [50624, 759, 286, 787, 2557, 702, 35084, 11, 286, 486, 312, 1027, 731, 13, 50830], "temperature": 0.0, "avg_logprob": -0.16178065079909104, "compression_ratio": 1.6605504587155964, "no_speech_prob": 8.219961455324665e-05}, {"id": 45, "seek": 17560, "start": 185.72, "end": 188.64, "text": " Jesus turned, and seeing her, he said,", "tokens": [50871, 2705, 3574, 11, 293, 2577, 720, 11, 415, 848, 11, 51017], "temperature": 0.0, "avg_logprob": -0.16178065079909104, "compression_ratio": 1.6605504587155964, "no_speech_prob": 8.219961455324665e-05}, {"id": 46, "seek": 17560, "start": 189.44, "end": 192.94, "text": " Take heart, daughter, your faith has made you well.", "tokens": [51057, 3664, 1917, 11, 4653, 11, 428, 4522, 575, 1027, 291, 731, 13, 51232], "temperature": 0.0, "avg_logprob": -0.16178065079909104, "compression_ratio": 1.6605504587155964, "no_speech_prob": 8.219961455324665e-05}, {"id": 47, "seek": 17560, "start": 193.74, "end": 197.2, "text": " And instantly the woman was made well.", "tokens": [51272, 400, 13518, 264, 3059, 390, 1027, 731, 13, 51445], "temperature": 0.0, "avg_logprob": -0.16178065079909104, "compression_ratio": 1.6605504587155964, "no_speech_prob": 8.219961455324665e-05}, {"id": 48, "seek": 17560, "start": 197.94, "end": 203.14, "text": " And when Jesus came to the ruler's house and saw the flute players and the crowd making a commotion,", "tokens": [51482, 400, 562, 2705, 1361, 281, 264, 19661, 311, 1782, 293, 1866, 264, 33088, 4150, 293, 264, 6919, 1455, 257, 800, 19228, 11, 51742], "temperature": 0.0, "avg_logprob": -0.16178065079909104, "compression_ratio": 1.6605504587155964, "no_speech_prob": 8.219961455324665e-05}, {"id": 49, "seek": 17560, "start": 203.14, "end": 204.07999999999998, "text": " he said,", "tokens": [51742, 415, 848, 11, 51789], "temperature": 0.0, "avg_logprob": -0.16178065079909104, "compression_ratio": 1.6605504587155964, "no_speech_prob": 8.219961455324665e-05}, {"id": 50, "seek": 17560, "start": 204.24, "end": 205.14, "text": " Go away.", "tokens": [51797, 1037, 1314, 13, 51842], "temperature": 0.0, "avg_logprob": -0.16178065079909104, "compression_ratio": 1.6605504587155964, "no_speech_prob": 8.219961455324665e-05}, {"id": 51, "seek": 20560, "start": 205.6, "end": 209.38, "text": " Go away, for the girl is not dead, but sleeping.", "tokens": [50365, 1037, 1314, 11, 337, 264, 2013, 307, 406, 3116, 11, 457, 8296, 13, 50554], "temperature": 0.0, "avg_logprob": -0.19721466603905263, "compression_ratio": 1.550660792951542, "no_speech_prob": 0.0016872808337211609}, {"id": 52, "seek": 20560, "start": 210.0, "end": 211.98, "text": " And they laughed at him.", "tokens": [50585, 400, 436, 20881, 412, 796, 13, 50684], "temperature": 0.0, "avg_logprob": -0.19721466603905263, "compression_ratio": 1.550660792951542, "no_speech_prob": 0.0016872808337211609}, {"id": 53, "seek": 20560, "start": 212.44, "end": 217.28, "text": " But when the crowd had been put outside, he went in and took her by the hand,", "tokens": [50707, 583, 562, 264, 6919, 632, 668, 829, 2380, 11, 415, 1437, 294, 293, 1890, 720, 538, 264, 1011, 11, 50949], "temperature": 0.0, "avg_logprob": -0.19721466603905263, "compression_ratio": 1.550660792951542, "no_speech_prob": 0.0016872808337211609}, {"id": 54, "seek": 20560, "start": 217.6, "end": 222.54, "text": " and the girl arose, and the report of this went through all that district.", "tokens": [50965, 293, 264, 2013, 37192, 11, 293, 264, 2275, 295, 341, 1437, 807, 439, 300, 6566, 13, 51212], "temperature": 0.0, "avg_logprob": -0.19721466603905263, "compression_ratio": 1.550660792951542, "no_speech_prob": 0.0016872808337211609}, {"id": 55, "seek": 20560, "start": 223.74, "end": 229.4, "text": " And as Jesus passed on from there, two blind men followed him, crying aloud,", "tokens": [51272, 400, 382, 2705, 4678, 322, 490, 456, 11, 732, 6865, 1706, 6263, 796, 11, 8554, 43888, 11, 51555], "temperature": 0.0, "avg_logprob": -0.19721466603905263, "compression_ratio": 1.550660792951542, "no_speech_prob": 0.0016872808337211609}, {"id": 56, "seek": 20560, "start": 230.32, "end": 234.01999999999998, "text": " Have mercy on us, son of David.", "tokens": [51601, 3560, 13174, 322, 505, 11, 1872, 295, 4389, 13, 51786], "temperature": 0.0, "avg_logprob": -0.19721466603905263, "compression_ratio": 1.550660792951542, "no_speech_prob": 0.0016872808337211609}, {"id": 57, "seek": 20560, "start": 234.51999999999998, "end": 235.56, "text": " When he entered,", "tokens": [51811, 1133, 415, 9065, 11, 51863], "temperature": 0.0, "avg_logprob": -0.19721466603905263, "compression_ratio": 1.550660792951542, "no_speech_prob": 0.0016872808337211609}, {"id": 58, "seek": 23560, "start": 235.6, "end": 236.14, "text": " the house,", "tokens": [50365, 264, 1782, 11, 50392], "temperature": 0.0, "avg_logprob": -0.27005400099195875, "compression_ratio": 1.5954545454545455, "no_speech_prob": 0.007752907462418079}, {"id": 59, "seek": 23560, "start": 236.46, "end": 237.82, "text": " the blind men came to him.", "tokens": [50408, 264, 6865, 1706, 1361, 281, 796, 13, 50476], "temperature": 0.0, "avg_logprob": -0.27005400099195875, "compression_ratio": 1.5954545454545455, "no_speech_prob": 0.007752907462418079}, {"id": 60, "seek": 23560, "start": 238.34, "end": 239.73999999999998, "text": " And Jesus said to them,", "tokens": [50502, 400, 2705, 848, 281, 552, 11, 50572], "temperature": 0.0, "avg_logprob": -0.27005400099195875, "compression_ratio": 1.5954545454545455, "no_speech_prob": 0.007752907462418079}, {"id": 61, "seek": 23560, "start": 240.5, "end": 243.07999999999998, "text": " Do you believe that I am able to do this?", "tokens": [50610, 1144, 291, 1697, 300, 286, 669, 1075, 281, 360, 341, 30, 50739], "temperature": 0.0, "avg_logprob": -0.27005400099195875, "compression_ratio": 1.5954545454545455, "no_speech_prob": 0.007752907462418079}, {"id": 62, "seek": 23560, "start": 243.78, "end": 244.88, "text": " They said to him,", "tokens": [50774, 814, 848, 281, 796, 11, 50829], "temperature": 0.0, "avg_logprob": -0.27005400099195875, "compression_ratio": 1.5954545454545455, "no_speech_prob": 0.007752907462418079}, {"id": 63, "seek": 23560, "start": 245.57999999999998, "end": 246.66, "text": " Yes, Lord.", "tokens": [50864, 1079, 11, 3257, 13, 50918], "temperature": 0.0, "avg_logprob": -0.27005400099195875, "compression_ratio": 1.5954545454545455, "no_speech_prob": 0.007752907462418079}, {"id": 64, "seek": 23560, "start": 247.28, "end": 250.35999999999999, "text": " Then he touched their eyes, saying,", "tokens": [50949, 1396, 415, 9828, 641, 2575, 11, 1566, 11, 51103], "temperature": 0.0, "avg_logprob": -0.27005400099195875, "compression_ratio": 1.5954545454545455, "no_speech_prob": 0.007752907462418079}, {"id": 65, "seek": 23560, "start": 251.14, "end": 253.88, "text": " According to your faith, be it done to you.", "tokens": [51142, 7328, 281, 428, 4522, 11, 312, 309, 1096, 281, 291, 13, 51279], "temperature": 0.0, "avg_logprob": -0.27005400099195875, "compression_ratio": 1.5954545454545455, "no_speech_prob": 0.007752907462418079}, {"id": 66, "seek": 23560, "start": 254.54, "end": 256.65999999999997, "text": " And their eyes were opened.", "tokens": [51312, 400, 641, 2575, 645, 5625, 13, 51418], "temperature": 0.0, "avg_logprob": -0.27005400099195875, "compression_ratio": 1.5954545454545455, "no_speech_prob": 0.007752907462418079}, {"id": 67, "seek": 23560, "start": 257.2, "end": 258.98, "text": " And Jesus sternly warned them,", "tokens": [51445, 400, 2705, 38312, 356, 21284, 552, 11, 51534], "temperature": 0.0, "avg_logprob": -0.27005400099195875, "compression_ratio": 1.5954545454545455, "no_speech_prob": 0.007752907462418079}, {"id": 68, "seek": 23560, "start": 259.78, "end": 261.96, "text": " See that no one knows about it.", "tokens": [51574, 3008, 300, 572, 472, 3255, 466, 309, 13, 51683], "temperature": 0.0, "avg_logprob": -0.27005400099195875, "compression_ratio": 1.5954545454545455, "no_speech_prob": 0.007752907462418079}, {"id": 69, "seek": 23560, "start": 262.14, "end": 265.44, "text": " But they went away and spread his fame through,", "tokens": [51692, 583, 436, 1437, 1314, 293, 3974, 702, 16874, 807, 11, 51857], "temperature": 0.0, "avg_logprob": -0.27005400099195875, "compression_ratio": 1.5954545454545455, "no_speech_prob": 0.007752907462418079}, {"id": 70, "seek": 26560, "start": 265.6, "end": 266.76000000000005, "text": " all that district.", "tokens": [50365, 439, 300, 6566, 13, 50423], "temperature": 0.0, "avg_logprob": -0.2526740294236403, "compression_ratio": 1.5982532751091703, "no_speech_prob": 0.006680644582957029}, {"id": 71, "seek": 26560, "start": 267.76000000000005, "end": 269.20000000000005, "text": " As they were going away,", "tokens": [50473, 1018, 436, 645, 516, 1314, 11, 50545], "temperature": 0.0, "avg_logprob": -0.2526740294236403, "compression_ratio": 1.5982532751091703, "no_speech_prob": 0.006680644582957029}, {"id": 72, "seek": 26560, "start": 269.84000000000003, "end": 274.08000000000004, "text": " behold, a demon-oppressed man who was mute was brought to him.", "tokens": [50577, 27234, 11, 257, 14283, 12, 17158, 3805, 587, 567, 390, 24523, 390, 3038, 281, 796, 13, 50789], "temperature": 0.0, "avg_logprob": -0.2526740294236403, "compression_ratio": 1.5982532751091703, "no_speech_prob": 0.006680644582957029}, {"id": 73, "seek": 26560, "start": 274.66, "end": 276.92, "text": " And when the demon had been cast out,", "tokens": [50818, 400, 562, 264, 14283, 632, 668, 4193, 484, 11, 50931], "temperature": 0.0, "avg_logprob": -0.2526740294236403, "compression_ratio": 1.5982532751091703, "no_speech_prob": 0.006680644582957029}, {"id": 74, "seek": 26560, "start": 276.92, "end": 278.90000000000003, "text": " the mute man spoke.", "tokens": [50931, 264, 24523, 587, 7179, 13, 51030], "temperature": 0.0, "avg_logprob": -0.2526740294236403, "compression_ratio": 1.5982532751091703, "no_speech_prob": 0.006680644582957029}, {"id": 75, "seek": 26560, "start": 279.38, "end": 281.08000000000004, "text": " And the crowds marveled, saying,", "tokens": [51054, 400, 264, 26070, 23893, 292, 11, 1566, 11, 51139], "temperature": 0.0, "avg_logprob": -0.2526740294236403, "compression_ratio": 1.5982532751091703, "no_speech_prob": 0.006680644582957029}, {"id": 76, "seek": 26560, "start": 281.88, "end": 284.5, "text": " Never was anything like this seen in Israel.", "tokens": [51179, 7344, 390, 1340, 411, 341, 1612, 294, 5674, 13, 51310], "temperature": 0.0, "avg_logprob": -0.2526740294236403, "compression_ratio": 1.5982532751091703, "no_speech_prob": 0.006680644582957029}, {"id": 77, "seek": 26560, "start": 285.34000000000003, "end": 287.36, "text": " But the Pharisees said,", "tokens": [51352, 583, 264, 47742, 279, 848, 11, 51453], "temperature": 0.0, "avg_logprob": -0.2526740294236403, "compression_ratio": 1.5982532751091703, "no_speech_prob": 0.006680644582957029}, {"id": 78, "seek": 26560, "start": 288.12, "end": 291.28000000000003, "text": " He casts out demons by the prince of demons.", "tokens": [51491, 634, 41921, 484, 19733, 538, 264, 16467, 295, 19733, 13, 51649], "temperature": 0.0, "avg_logprob": -0.2526740294236403, "compression_ratio": 1.5982532751091703, "no_speech_prob": 0.006680644582957029}, {"id": 79, "seek": 26560, "start": 292.70000000000005, "end": 295.58000000000004, "text": " And Jesus went throughout all the cities and villages,", "tokens": [51720, 400, 2705, 1437, 3710, 439, 264, 6486, 293, 20444, 11, 51864], "temperature": 0.0, "avg_logprob": -0.2526740294236403, "compression_ratio": 1.5982532751091703, "no_speech_prob": 0.006680644582957029}, {"id": 80, "seek": 29560, "start": 295.6, "end": 299.16, "text": " teaching in their synagogues and proclaiming the gospel of the kingdom", "tokens": [50365, 4571, 294, 641, 5451, 31599, 1247, 293, 34604, 278, 264, 14943, 295, 264, 10231, 50543], "temperature": 0.0, "avg_logprob": -0.14429390316917784, "compression_ratio": 1.725, "no_speech_prob": 0.0047911228612065315}, {"id": 81, "seek": 29560, "start": 299.16, "end": 302.3, "text": " and healing every disease and every affliction.", "tokens": [50543, 293, 9745, 633, 4752, 293, 633, 2096, 75, 4105, 13, 50700], "temperature": 0.0, "avg_logprob": -0.14429390316917784, "compression_ratio": 1.725, "no_speech_prob": 0.0047911228612065315}, {"id": 82, "seek": 29560, "start": 302.98, "end": 305.6, "text": " When he saw the crowds, he had compassion for them", "tokens": [50734, 1133, 415, 1866, 264, 26070, 11, 415, 632, 12601, 337, 552, 50865], "temperature": 0.0, "avg_logprob": -0.14429390316917784, "compression_ratio": 1.725, "no_speech_prob": 0.0047911228612065315}, {"id": 83, "seek": 29560, "start": 305.6, "end": 309.64000000000004, "text": " because they were harassed and helpless like sheep without a shepherd.", "tokens": [50865, 570, 436, 645, 16910, 292, 293, 27596, 411, 14213, 1553, 257, 40317, 13, 51067], "temperature": 0.0, "avg_logprob": -0.14429390316917784, "compression_ratio": 1.725, "no_speech_prob": 0.0047911228612065315}, {"id": 84, "seek": 29560, "start": 310.24, "end": 311.76000000000005, "text": " Then he said to his disciples,", "tokens": [51097, 1396, 415, 848, 281, 702, 17209, 11, 51173], "temperature": 0.0, "avg_logprob": -0.14429390316917784, "compression_ratio": 1.725, "no_speech_prob": 0.0047911228612065315}, {"id": 85, "seek": 29560, "start": 312.16, "end": 316.62, "text": " The harvest is plentiful, but the laborers are few.", "tokens": [51193, 440, 11917, 307, 499, 317, 2069, 11, 457, 264, 5938, 433, 366, 1326, 13, 51416], "temperature": 0.0, "avg_logprob": -0.14429390316917784, "compression_ratio": 1.725, "no_speech_prob": 0.0047911228612065315}, {"id": 86, "seek": 29560, "start": 317.42, "end": 320.18, "text": " Therefore pray earnestly to the Lord of the harvest", "tokens": [51456, 7504, 3690, 6012, 11154, 281, 264, 3257, 295, 264, 11917, 51594], "temperature": 0.0, "avg_logprob": -0.14429390316917784, "compression_ratio": 1.725, "no_speech_prob": 0.0047911228612065315}, {"id": 87, "seek": 29560, "start": 320.18, "end": 322.96000000000004, "text": " to send out laborers into his harvest.", "tokens": [51594, 281, 2845, 484, 5938, 433, 666, 702, 11917, 13, 51733], "temperature": 0.0, "avg_logprob": -0.14429390316917784, "compression_ratio": 1.725, "no_speech_prob": 0.0047911228612065315}], "language": "English"}