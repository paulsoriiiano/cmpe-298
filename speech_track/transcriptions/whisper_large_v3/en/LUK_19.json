4, "compression_ratio": 1.6333333333333333, "no_speech_prob": 0.0044637396931648254}, {"id": 40, "seek": 9000, "start": 112.64, "end": 114.7, "text": " The first came before him, saying,", "tokens": [51497, 440, 700, 1361, 949, 796, 11, 1566, 11, 51600], "temperature": 0.0, "avg_logprob": -0.22932158410549164, "compression_ratio": 1.6333333333333333, "no_speech_prob": 0.0044637396931648254}, {"id": 41, "seek": 9000, "start": 115.16, "end": 117.88, "text": " Lord, your mina has made ten minas more.", "tokens": [51623, 3257, 11, 428, 48412, 575, 1027, 2064, 923, 296, 544, 13, 51759], "temperature": 0.0, "avg_logprob": -0.22932158410549164, "compression_ratio": 1.6333333333333333, "no_speech_prob": 0.0044637396931648254}, {"id": 42, "seek": 9000, "start": 118.38, "end": 119.62, "text": " And he said to him,", "tokens": [51784, 400, 415, 848, 281, 796, 11, 51846], "temperature": 0.0, "avg_logprob": -0.22932158410549164, "compression_ratio": 1.6333333333333333, "no_speech_prob": 0.0044637396931648254}, {"id": 43, "seek": 11962, "start": 119.62, "end": 121.62, "text": " Well done, good servant,", "tokens": [50365, 1042, 1096, 11, 665, 17896, 11, 50465], "temperature": 0.0, "avg_logprob": -0.1963602550446041, "compression_ratio": 1.6975806451612903, "no_speech_prob": 0.0011073083151131868}, {"id": 44, "seek": 11962, "start": 122.04, "end": 124.24000000000001, "text": " because you have been faithful in a very little.", "tokens": [50486, 570, 291, 362, 668, 17808, 294, 257, 588, 707, 13, 50596], "temperature": 0.0, "avg_logprob": -0.1963602550446041, "compression_ratio": 1.6975806451612903, "no_speech_prob": 0.0011073083151131868}, {"id": 45, "seek": 11962, "start": 124.76, "end": 127.28, "text": " You shall have authority over ten cities.", "tokens": [50622, 509, 4393, 362, 8281, 670, 2064, 6486, 13, 50748], "temperature": 0.0, "avg_logprob": -0.1963602550446041, "compression_ratio": 1.6975806451612903, "no_speech_prob": 0.0011073083151131868}, {"id": 46, "seek": 11962, "start": 128.12, "end": 129.48000000000002, "text": " And the second came, saying,", "tokens": [50790, 400, 264, 1150, 1361, 11, 1566, 11, 50858], "temperature": 0.0, "avg_logprob": -0.1963602550446041, "compression_ratio": 1.6975806451612903, "no_speech_prob": 0.0011073083151131868}, {"id": 47, "seek": 11962, "start": 130.02, "end": 132.3, "text": " Lord, your mina has made five minas.", "tokens": [50885, 3257, 11, 428, 48412, 575, 1027, 1732, 923, 296, 13, 50999], "temperature": 0.0, "avg_logprob": -0.1963602550446041, "compression_ratio": 1.6975806451612903, "no_speech_prob": 0.0011073083151131868}, {"id": 48, "seek": 11962, "start": 132.56, "end": 133.74, "text": " And he said to him,", "tokens": [51012, 400, 415, 848, 281, 796, 11, 51071], "temperature": 0.0, "avg_logprob": -0.1963602550446041, "compression_ratio": 1.6975806451612903, "no_speech_prob": 0.0011073083151131868}, {"id": 49, "seek": 11962, "start": 134.20000000000002, "end": 136.52, "text": " And you are to be over five cities.", "tokens": [51094, 400, 291, 366, 281, 312, 670, 1732, 6486, 13, 51210], "temperature": 0.0, "avg_logprob": -0.1963602550446041, "compression_ratio": 1.6975806451612903, "no_speech_prob": 0.0011073083151131868}, {"id": 50, "seek": 11962, "start": 137.36, "end": 138.6, "text": " Then another came, saying,", "tokens": [51252, 1396, 1071, 1361, 11, 1566, 11, 51314], "temperature": 0.0, "avg_logprob": -0.1963602550446041, "compression_ratio": 1.6975806451612903, "no_speech_prob": 0.0011073083151131868}, {"id": 51, "seek": 11962, "start": 139.26, "end": 143.72, "text": " Lord, here is your mina, which I kept laid away in a handkerchief.", "tokens": [51347, 3257, 11, 510, 307, 428, 48412, 11, 597, 286, 4305, 9897, 1314, 294, 257, 1011, 5767, 30189, 13, 51570], "temperature": 0.0, "avg_logprob": -0.1963602550446041, "compression_ratio": 1.6975806451612903, "no_speech_prob": 0.0011073083151131868}, {"id": 52, "seek": 11962, "start": 144.26, "end": 147.66, "text": " For I was afraid of you, because you are a severe man.", "tokens": [51597, 1171, 286, 390, 4638, 295, 291, 11, 570, 291, 366, 257, 8922, 587, 13, 51767], "temperature": 0.0, "avg_logprob": -0.1963602550446041, "compression_ratio": 1.6975806451612903, "no_speech_prob": 0.0011073083151131868}, {"id": 53, "seek": 11962, "start": 147.86, "end": 149.58, "text": " You take what you did not deserve,", "tokens": [51777, 509, 747, 437, 291, 630, 406, 9948, 11, 51863], "temperature": 0.0, "avg_logprob": -0.1963602550446041, "compression_ratio": 1.6975806451612903, "no_speech_prob": 0.0011073083151131868}, {"id": 54, "seek": 14958, "start": 149.58, "end": 152.22, "text": " deposit, and reap what you did not sow.", "tokens": [50365, 19107, 11, 293, 39178, 437, 291, 630, 406, 19766, 13, 50497], "temperature": 0.0, "avg_logprob": -0.20001380809032135, "compression_ratio": 1.776, "no_speech_prob": 0.014279543422162533}, {"id": 55, "seek": 14958, "start": 153.12, "end": 154.04000000000002, "text": " He said to him,", "tokens": [50542, 634, 848, 281, 796, 11, 50588], "temperature": 0.0, "avg_logprob": -0.20001380809032135, "compression_ratio": 1.776, "no_speech_prob": 0.014279543422162533}, {"id": 56, "seek": 14958, "start": 154.48000000000002, "end": 157.86, "text": " I will condemn you with your own words, you wicked servant.", "tokens": [50610, 286, 486, 30733, 291, 365, 428, 1065, 2283, 11, 291, 22663, 17896, 13, 50779], "temperature": 0.0, "avg_logprob": -0.20001380809032135, "compression_ratio": 1.776, "no_speech_prob": 0.014279543422162533}, {"id": 57, "seek": 14958, "start": 158.8, "end": 160.88000000000002, "text": " You knew that I was a severe man,", "tokens": [50826, 509, 2586, 300, 286, 390, 257, 8922, 587, 11, 50930], "temperature": 0.0, "avg_logprob": -0.20001380809032135, "compression_ratio": 1.776, "no_speech_prob": 0.014279543422162533}, {"id": 58, "seek": 14958, "start": 161.28, "end": 162.64000000000001, "text": " taking what I did not deposit,", "tokens": [50950, 1940, 437, 286, 630, 406, 19107, 11, 51018], "temperature": 0.0, "avg_logprob": -0.20001380809032135, "compression_ratio": 1.776, "no_speech_prob": 0.014279543422162533}, {"id": 59, "seek": 14958, "start": 163.02, "end": 164.66000000000003, "text": " and reaping what I did not sow.", "tokens": [51037, 293, 39178, 278, 437, 286, 630, 406, 19766, 13, 51119], "temperature": 0.0, "avg_logprob": -0.20001380809032135, "compression_ratio": 1.776, "no_speech_prob": 0.014279543422162533}, {"id": 60, "seek": 14958, "start": 165.38000000000002, "end": 168.28, "text": " Why then did you not put my money in the bank,", "tokens": [51155, 1545, 550, 630, 291, 406, 829, 452, 1460, 294, 264, 3765, 11, 51300], "temperature": 0.0, "avg_logprob": -0.20001380809032135, "compression_ratio": 1.776, "no_speech_prob": 0.014279543422162533}, {"id": 61, "seek": 14958, "start": 168.60000000000002, "end": 171.62, "text": " and at my coming I might have collected it with interest?", "tokens": [51316, 293, 412, 452, 1348, 286, 1062, 362, 11087, 309, 365, 1179, 30, 51467], "temperature": 0.0, "avg_logprob": -0.20001380809032135, "compression_ratio": 1.776, "no_speech_prob": 0.014279543422162533}, {"id": 62, "seek": 14958, "start": 172.20000000000002, "end": 174.26000000000002, "text": " And he said to those who stood by,", "tokens": [51496, 400, 415, 848, 281, 729, 567, 9371, 538, 11, 51599], "temperature": 0.0, "avg_logprob": -0.20001380809032135, "compression_ratio": 1.776, "no_speech_prob": 0.014279543422162533}, {"id": 63, "seek": 14958, "start": 174.70000000000002, "end": 176.10000000000002, "text": " Take the mina from him,", "tokens": [51621, 3664, 264, 48412, 490, 796, 11, 51691], "temperature": 0.0, "avg_logprob": -0.20001380809032135, "compression_ratio": 1.776, "no_speech_prob": 0.014279543422162533}, {"id": 64, "seek": 14958, "start": 176.14000000000001, "end": 178.18, "text": " and give it to the one who has the ten minas.", "tokens": [51693, 293, 976, 309, 281, 264, 472, 567, 575, 264, 2064, 923, 296, 13, 51795], "temperature": 0.0, "avg_logprob": -0.20001380809032135, "compression_ratio": 1.776, "no_speech_prob": 0.014279543422162533}, {"id": 65, "seek": 14958, "start": 178.70000000000002, "end": 179.56, "text": " And they said to him,", "tokens": [51821, 400, 436, 848, 281, 796, 11, 51864], "temperature": 0.0, "avg_logprob": -0.20001380809032135, "compression_ratio": 1.776, "no_speech_prob": 0.014279543422162533}, {"id": 66, "seek": 17956, "start": 180.08, "end": 182.38, "text": " Lord, he has ten minas.", "tokens": [50391, 3257, 11, 415, 575, 2064, 923, 296, 13, 50506], "temperature": 0.0, "avg_logprob": -0.17295520445879767, "compression_ratio": 1.6865671641791045, "no_speech_prob": 0.002957289107143879}, {"id": 67, "seek": 17956, "start": 183.04, "end": 186.32, "text": " I tell you that to everyone who has, more will be given.", "tokens": [50539, 286, 980, 291, 300, 281, 1518, 567, 575, 11, 544, 486, 312, 2212, 13, 50703], "temperature": 0.0, "avg_logprob": -0.17295520445879767, "compression_ratio": 1.6865671641791045, "no_speech_prob": 0.002957289107143879}, {"id": 68, "seek": 17956, "start": 186.78, "end": 188.22, "text": " But from the one who has not,", "tokens": [50726, 583, 490, 264, 472, 567, 575, 406, 11, 50798], "temperature": 0.0, "avg_logprob": -0.17295520445879767, "compression_ratio": 1.6865671641791045, "no_speech_prob": 0.002957289107143879}, {"id": 69, "seek": 17956, "start": 188.62, "end": 190.52, "text": " even what he has will be taken away.", "tokens": [50818, 754, 437, 415, 575, 486, 312, 2726, 1314, 13, 50913], "temperature": 0.0, "avg_logprob": -0.17295520445879767, "compression_ratio": 1.6865671641791045, "no_speech_prob": 0.002957289107143879}, {"id": 70, "seek": 17956, "start": 191.16, "end": 192.98, "text": " But as for these enemies of mine,", "tokens": [50945, 583, 382, 337, 613, 7805, 295, 3892, 11, 51036], "temperature": 0.0, "avg_logprob": -0.17295520445879767, "compression_ratio": 1.6865671641791045, "no_speech_prob": 0.002957289107143879}, {"id": 71, "seek": 17956, "start": 193.12, "end": 194.92000000000002, "text": " who did not want me to reign over them,", "tokens": [51043, 567, 630, 406, 528, 385, 281, 20350, 670, 552, 11, 51133], "temperature": 0.0, "avg_logprob": -0.17295520445879767, "compression_ratio": 1.6865671641791045, "no_speech_prob": 0.002957289107143879}, {"id": 72, "seek": 17956, "start": 195.36, "end": 198.1, "text": " bring them here and slaughter them before me.", "tokens": [51155, 1565, 552, 510, 293, 26609, 552, 949, 385, 13, 51292], "temperature": 0.0, "avg_logprob": -0.17295520445879767, "compression_ratio": 1.6865671641791045, "no_speech_prob": 0.002957289107143879}, {"id": 73, "seek": 17956, "start": 199.3, "end": 201.06, "text": " And when he had said these things,", "tokens": [51352, 400, 562, 415, 632, 848, 613, 721, 11, 51440], "temperature": 0.0, "avg_logprob": -0.17295520445879767, "compression_ratio": 1.6865671641791045, "no_speech_prob": 0.002957289107143879}, {"id": 74, "seek": 17956, "start": 201.34, "end": 203.32, "text": " he went on ahead going up to Jerusalem.", "tokens": [51454, 415, 1437, 322, 2286, 516, 493, 281, 15393, 13, 51553], "temperature": 0.0, "avg_logprob": -0.17295520445879767, "compression_ratio": 1.6865671641791045, "no_speech_prob": 0.002957289107143879}, {"id": 75, "seek": 17956, "start": 203.88, "end": 206.12, "text": " When he drew near to Bethphage and Bethany,", "tokens": [51581, 1133, 415, 12804, 2651, 281, 14011, 950, 609, 293, 14011, 1325, 11, 51693], "temperature": 0.0, "avg_logprob": -0.17295520445879767, "compression_ratio": 1.6865671641791045, "no_speech_prob": 0.002957289107143879}, {"id": 76, "seek": 17956, "start": 206.34, "end": 207.9, "text": " at the mount that is called Olivet,", "tokens": [51704, 412, 264, 3746, 300, 307, 1219, 42477, 302, 11, 51782], "temperature": 0.0, "avg_logprob": -0.17295520445879767, "compression_ratio": 1.6865671641791045, "no_speech_prob": 0.002957289107143879}, {"id": 77, "seek": 17956, "start": 207.9, "end": 209.54, "text": " he sent two of the disciples,", "tokens": [51782, 415, 2279, 732, 295, 264, 17209, 11, 51864], "temperature": 0.0, "avg_logprob": -0.17295520445879767, "compression_ratio": 1.6865671641791045, "no_speech_prob": 0.002957289107143879}, {"id": 78, "seek": 20956, "start": 209.72, "end": 210.08, "text": " saying,", "tokens": [50373, 1566, 11, 50391], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 79, "seek": 20956, "start": 210.08, "end": 212.62, "text": " Go into the village in front of you,", "tokens": [50391, 1037, 666, 264, 7288, 294, 1868, 295, 291, 11, 50518], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 80, "seek": 20956, "start": 212.98, "end": 214.94, "text": " where on entering you will find a colt tied,", "tokens": [50536, 689, 322, 11104, 291, 486, 915, 257, 1173, 83, 9601, 11, 50634], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 81, "seek": 20956, "start": 215.3, "end": 217.28, "text": " on which no one has ever yet sat.", "tokens": [50652, 322, 597, 572, 472, 575, 1562, 1939, 3227, 13, 50751], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 82, "seek": 20956, "start": 217.98, "end": 219.34, "text": " Untie it and bring it here.", "tokens": [50786, 8256, 414, 309, 293, 1565, 309, 510, 13, 50854], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 83, "seek": 20956, "start": 219.94, "end": 221.26, "text": " If anyone asks you,", "tokens": [50884, 759, 2878, 8962, 291, 11, 50950], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 84, "seek": 20956, "start": 221.62, "end": 222.86, "text": " Why are you untying it?", "tokens": [50968, 1545, 366, 291, 517, 874, 278, 309, 30, 51030], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 85, "seek": 20956, "start": 223.22, "end": 224.22, "text": " You shall say this,", "tokens": [51048, 509, 4393, 584, 341, 11, 51098], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 86, "seek": 20956, "start": 224.6, "end": 226.38, "text": " The Lord has need of it.", "tokens": [51117, 440, 3257, 575, 643, 295, 309, 13, 51206], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 87, "seek": 20956, "start": 227.0, "end": 228.2, "text": " So those who were sent away", "tokens": [51237, 407, 729, 567, 645, 2279, 1314, 51297], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 88, "seek": 20956, "start": 228.2, "end": 230.0, "text": " and found it just as he had told them.", "tokens": [51297, 293, 1352, 309, 445, 382, 415, 632, 1907, 552, 13, 51387], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 89, "seek": 20956, "start": 230.56, "end": 232.36, "text": " And as they were untying the colt,", "tokens": [51415, 400, 382, 436, 645, 517, 874, 278, 264, 1173, 83, 11, 51505], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 90, "seek": 20956, "start": 232.72, "end": 233.94, "text": " its owner said to them,", "tokens": [51523, 1080, 7289, 848, 281, 552, 11, 51584], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 91, "seek": 20956, "start": 234.38, "end": 235.92000000000002, "text": " Why are you untying the colt?", "tokens": [51606, 1545, 366, 291, 517, 874, 278, 264, 1173, 83, 30, 51683], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 92, "seek": 20956, "start": 236.34, "end": 237.4, "text": " And they said,", "tokens": [51704, 400, 436, 848, 11, 51757], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 93, "seek": 20956, "start": 237.68, "end": 239.36, "text": " The Lord has need of it.", "tokens": [51771, 440, 3257, 575, 643, 295, 309, 13, 51855], "temperature": 0.0, "avg_logprob": -0.23143950203396627, "compression_ratio": 1.7723577235772359, "no_speech_prob": 0.0004511356237344444}, {"id": 94, "seek": 23956, "start": 240.08, "end": 241.28, "text": " And they brought it to Jesus,", "tokens": [50391, 400, 436, 3038, 309, 281, 2705, 11, 50451], "temperature": 0.0, "avg_logprob": -0.21244453069731944, "compression_ratio": 1.6901960784313725, "no_speech_prob": 0.0010078828781843185}, {"id": 95, "seek": 23956, "start": 241.62, "end": 243.2, "text": " and throwing their cloaks on the colt,", "tokens": [50468, 293, 10238, 641, 20123, 5461, 322, 264, 1173, 83, 11, 50547], "temperature": 0.0, "avg_logprob": -0.21244453069731944, "compression_ratio": 1.6901960784313725, "no_speech_prob": 0.0010078828781843185}, {"id": 96, "seek": 23956, "start": 243.46, "end": 244.8, "text": " they set Jesus on it.", "tokens": [50560, 436, 992, 2705, 322, 309, 13, 50627], "temperature": 0.0, "avg_logprob": -0.21244453069731944, "compression_ratio": 1.6901960784313725, "no_speech_prob": 0.0010078828781843185}, {"id": 97, "seek": 23956, "start": 245.22, "end": 246.44, "text": " And as he rode along,", "tokens": [50648, 400, 382, 415, 21602, 2051, 11, 50709], "temperature": 0.0, "avg_logprob": -0.21244453069731944, "compression_ratio": 1.6901960784313725, "no_speech_prob": 0.0010078828781843185}, {"id": 98, "seek": 23956, "start": 246.7, "end": 248.12, "text": " they spread their cloaks on the road.", "tokens": [50722, 436, 3974, 641, 20123, 5461, 322, 264, 3060, 13, 50793], "temperature": 0.0, "avg_logprob": -0.21244453069731944, "compression_ratio": 1.6901960784313725, "no_speech_prob": 0.0010078828781843185}, {"id": 99, "seek": 23956, "start": 248.7, "end": 249.92000000000002, "text": " As he was drawing near,", "tokens": [50822, 1018, 415, 390, 6316, 2651, 11, 50883], "temperature": 0.0, "avg_logprob": -0.21244453069731944, "compression_ratio": 1.6901960784313725, "no_speech_prob": 0.0010078828781843185}, {"id": 100, "seek": 23956, "start": 250.36, "end": 252.56, "text": " already on the way down the Mount of Olives,", "tokens": [50905, 1217, 322, 264, 636, 760, 264, 8426, 295, 6141, 1539, 11, 51015], "temperature": 0.0, "avg_logprob": -0.21244453069731944, "compression_ratio": 1.6901960784313725, "no_speech_prob": 0.0010078828781843185}, {"id": 101, "seek": 23956, "start": 252.56, "end": 254.86, "text": " the whole multitude of his disciples", "tokens": [51015, 264, 1379, 36358, 295, 702, 17209, 51130], "temperature": 0.0, "avg_logprob": -0.21244453069731944, "compression_ratio": 1.6901960784313725, "no_speech_prob": 0.0010078828781843185}, {"id": 102, "seek": 23956, "start": 254.86, "end": 258.08, "text": " began to rejoice and praise God with a loud voice", "tokens": [51130, 4283, 281, 42397, 293, 13286, 1265, 365, 257, 6588, 3177, 51291], "temperature": 0.0, "avg_logprob": -0.21244453069731944, "compression_ratio": 1.6901960784313725, "no_speech_prob": 0.0010078828781843185}, {"id": 103, "seek": 23956, "start": 258.08, "end": 261.12, "text": " for all the mighty works that they had seen, saying,", "tokens": [51291, 337, 439, 264, 21556, 1985, 300, 436, 632, 1612, 11, 1566, 11, 51443], "temperature": 0.0, "avg_logprob": -0.21244453069731944, "compression_ratio": 1.6901960784313725, "no_speech_prob": 0.0010078828781843185}, {"id": 104, "seek": 23956, "start": 261.58, "end": 263.54, "text": " Blessed is the King", "tokens": [51466, 37501, 307, 264, 3819, 51564], "temperature": 0.0, "avg_logprob": -0.21244453069731944, "compression_ratio": 1.6901960784313725, "no_speech_prob": 0.0010078828781843185}, {"id": 105, "seek": 23956, "start": 263.54, "end": 266.6, "text": " who comes in the name of the Lord.", "tokens": [51564, 567, 1487, 294, 264, 1315, 295, 264, 3257, 13, 51717], "temperature": 0.0, "avg_logprob": -0.21244453069731944, "compression_ratio": 1.6901960784313725, "no_speech_prob": 0.0010078828781843185}, {"id": 106, "seek": 23956, "start": 267.64, "end": 269.4, "text": " Peace in heaven!", "tokens": [51769, 13204, 294, 7162, 0, 51857], "temperature": 0.0, "avg_logprob": -0.21244453069731944, "compression_ratio": 1.6901960784313725, "no_speech_prob": 0.0010078828781843185}, {"id": 107, "seek": 26956, "start": 269.56, "end": 271.76, "text": " And glory in the highest!", "tokens": [50365, 400, 11924, 294, 264, 6343, 0, 50475], "temperature": 0.0, "avg_logprob": -0.2118766165187216, "compression_ratio": 1.5897435897435896, "no_speech_prob": 0.0001243593724211678}, {"id": 108, "seek": 26956, "start": 272.7, "end": 275.18, "text": " And some of the Pharisees in the crowd said to him,", "tokens": [50522, 400, 512, 295, 264, 47742, 279, 294, 264, 6919, 848, 281, 796, 11, 50646], "temperature": 0.0, "avg_logprob": -0.2118766165187216, "compression_ratio": 1.5897435897435896, "no_speech_prob": 0.0001243593724211678}, {"id": 109, "seek": 26956, "start": 275.82, "end": 277.58, "text": " Teacher, rebuke your disciples.", "tokens": [50678, 19745, 11, 319, 6021, 330, 428, 17209, 13, 50766], "temperature": 0.0, "avg_logprob": -0.2118766165187216, "compression_ratio": 1.5897435897435896, "no_speech_prob": 0.0001243593724211678}, {"id": 110, "seek": 26956, "start": 278.48, "end": 279.2, "text": " He answered,", "tokens": [50811, 634, 10103, 11, 50847], "temperature": 0.0, "avg_logprob": -0.2118766165187216, "compression_ratio": 1.5897435897435896, "no_speech_prob": 0.0001243593724211678}, {"id": 111, "seek": 26956, "start": 280.0, "end": 282.18, "text": " I tell you, if these were silent,", "tokens": [50887, 286, 980, 291, 11, 498, 613, 645, 12784, 11, 50996], "temperature": 0.0, "avg_logprob": -0.2118766165187216, "compression_ratio": 1.5897435897435896, "no_speech_prob": 0.0001243593724211678}, {"id": 112, "seek": 26956, "start": 282.52, "end": 284.62, "text": " the very stones would cry out.", "tokens": [51013, 264, 588, 14083, 576, 3305, 484, 13, 51118], "temperature": 0.0, "avg_logprob": -0.2118766165187216, "compression_ratio": 1.5897435897435896, "no_speech_prob": 0.0001243593724211678}, {"id": 113, "seek": 26956, "start": 285.38, "end": 287.56, "text": " And when he drew near and saw the city,", "tokens": [51156, 400, 562, 415, 12804, 2651, 293, 1866, 264, 2307, 11, 51265], "temperature": 0.0, "avg_logprob": -0.2118766165187216, "compression_ratio": 1.5897435897435896, "no_speech_prob": 0.0001243593724211678}, {"id": 114, "seek": 26956, "start": 287.84000000000003, "end": 289.24, "text": " he wept over it, saying,", "tokens": [51279, 415, 321, 662, 670, 309, 11, 1566, 11, 51349], "temperature": 0.0, "avg_logprob": -0.2118766165187216, "compression_ratio": 1.5897435897435896, "no_speech_prob": 0.0001243593724211678}, {"id": 115, "seek": 26956, "start": 290.02, "end": 292.08, "text": " Would that you, even you,", "tokens": [51388, 6068, 300, 291, 11, 754, 291, 11, 51491], "temperature": 0.0, "avg_logprob": -0.2118766165187216, "compression_ratio": 1.5897435897435896, "no_speech_prob": 0.0001243593724211678}, {"id": 116, "seek": 26956, "start": 292.2, "end": 293.6, "text": " had known on this day", "tokens": [51497, 632, 2570, 322, 341, 786, 51567], "temperature": 0.0, "avg_logprob": -0.2118766165187216, "compression_ratio": 1.5897435897435896, "no_speech_prob": 0.0001243593724211678}, {"id": 117, "seek": 26956, "start": 293.6, "end": 295.74, "text": " the things that make for peace!", "tokens": [51567, 264, 721, 300, 652, 337, 4336, 0, 51674], "temperature": 0.0, "avg_logprob": -0.2118766165187216, "compression_ratio": 1.5897435897435896, "no_speech_prob": 0.0001243593724211678}, {"id": 118, "seek": 26956, "start": 296.08, "end": 298.78, "text": " But now they are hidden from your eyes.", "tokens": [51691, 583, 586, 436, 366, 7633, 490, 428, 2575, 13, 51826], "temperature": 0.0, "avg_logprob": -0.2118766165187216, "compression_ratio": 1.5897435897435896, "no_speech_prob": 0.0001243593724211678}, {"id": 119, "seek": 29956, "start": 299.56, "end": 301.52, "text": " For the days will come upon you", "tokens": [50365, 1171, 264, 1708, 486, 808, 3564, 291, 50463], "temperature": 0.0, "avg_logprob": -0.16399415334065756, "compression_ratio": 1.7671232876712328, "no_speech_prob": 0.00015117718430701643}, {"id": 120, "seek": 29956, "start": 301.52, "end": 304.82, "text": " when your enemies will set up a barricade around you", "tokens": [50463, 562, 428, 7805, 486, 992, 493, 257, 2159, 1341, 762, 926, 291, 50628], "temperature": 0.0, "avg_logprob": -0.16399415334065756, "compression_ratio": 1.7671232876712328, "no_speech_prob": 0.00015117718430701643}, {"id": 121, "seek": 29956, "start": 304.82, "end": 307.92, "text": " and surround you and hem you in on every side", "tokens": [50628, 293, 6262, 291, 293, 8636, 291, 294, 322, 633, 1252, 50783], "temperature": 0.0, "avg_logprob": -0.16399415334065756, "compression_ratio": 1.7671232876712328, "no_speech_prob": 0.00015117718430701643}, {"id": 122, "seek": 29956, "start": 307.92, "end": 310.82, "text": " and tear you down to the ground,", "tokens": [50783, 293, 12556, 291, 760, 281, 264, 2727, 11, 50928], "temperature": 0.0, "avg_logprob": -0.16399415334065756, "compression_ratio": 1.7671232876712328, "no_speech_prob": 0.00015117718430701643}, {"id": 123, "seek": 29956, "start": 310.82, "end": 314.1, "text": " you and your children within you.", "tokens": [50928, 291, 293, 428, 2227, 1951, 291, 13, 51092], "temperature": 0.0, "avg_logprob": -0.16399415334065756, "compression_ratio": 1.7671232876712328, "no_speech_prob": 0.00015117718430701643}, {"id": 124, "seek": 29956, "start": 314.52, "end": 317.98, "text": " And they will not leave one stone upon another in you,", "tokens": [51113, 400, 436, 486, 406, 1856, 472, 7581, 3564, 1071, 294, 291, 11, 51286], "temperature": 0.0, "avg_logprob": -0.16399415334065756, "compression_ratio": 1.7671232876712328, "no_speech_prob": 0.00015117718430701643}, {"id": 125, "seek": 29956, "start": 318.62, "end": 322.4, "text": " because you did not know the time of your visitation.", "tokens": [51318, 570, 291, 630, 406, 458, 264, 565, 295, 428, 3441, 399, 13, 51507], "temperature": 0.0, "avg_logprob": -0.16399415334065756, "compression_ratio": 1.7671232876712328, "no_speech_prob": 0.00015117718430701643}, {"id": 126, "seek": 29956, "start": 323.44, "end": 324.92, "text": " And he entered the temple", "tokens": [51559, 400, 415, 9065, 264, 10184, 51633], "temperature": 0.0, "avg_logprob": -0.16399415334065756, "compression_ratio": 1.7671232876712328, "no_speech_prob": 0.00015117718430701643}, {"id": 127, "seek": 29956, "start": 324.92, "end": 327.08, "text": " and began to drive out those who sold,", "tokens": [51633, 293, 4283, 281, 3332, 484, 729, 567, 3718, 11, 51741], "temperature": 0.0, "avg_logprob": -0.16399415334065756, "compression_ratio": 1.7671232876712328, "no_speech_prob": 0.00015117718430701643}, {"id": 128, "seek": 29956, "start": 327.28, "end": 327.94, "text": " saying to them,", "tokens": [51751, 1566, 281, 552, 11, 51784], "temperature": 0.0, "avg_logprob": -0.16399415334065756, "compression_ratio": 1.7671232876712328, "no_speech_prob": 0.00015117718430701643}, {"id": 129, "seek": 32794, "start": 327.94, "end": 329.64, "text": " It is written,", "tokens": [50365, 467, 307, 3720, 11, 50450], "temperature": 0.0, "avg_logprob": -0.1577617189158564, "compression_ratio": 1.5940594059405941, "no_speech_prob": 0.0006023279274813831}, {"id": 130, "seek": 32794, "start": 330.42, "end": 332.42, "text": " My house shall be a house of prayer,", "tokens": [50489, 1222, 1782, 4393, 312, 257, 1782, 295, 8767, 11, 50589], "temperature": 0.0, "avg_logprob": -0.1577617189158564, "compression_ratio": 1.5940594059405941, "no_speech_prob": 0.0006023279274813831}, {"id": 131, "seek": 32794, "start": 333.1, "end": 335.71999999999997, "text": " but you have made it a den of robbers.", "tokens": [50623, 457, 291, 362, 1027, 309, 257, 1441, 295, 3870, 1616, 13, 50754], "temperature": 0.0, "avg_logprob": -0.1577617189158564, "compression_ratio": 1.5940594059405941, "no_speech_prob": 0.0006023279274813831}, {"id": 132, "seek": 32794, "start": 336.21999999999997, "end": 338.38, "text": " And he was teaching daily in the temple.", "tokens": [50779, 400, 415, 390, 4571, 5212, 294, 264, 10184, 13, 50887], "temperature": 0.0, "avg_logprob": -0.1577617189158564, "compression_ratio": 1.5940594059405941, "no_speech_prob": 0.0006023279274813831}, {"id": 133, "seek": 32794, "start": 339.52, "end": 341.3, "text": " The chief priests and the scribes", "tokens": [50944, 440, 9588, 27192, 293, 264, 39435, 279, 51033], "temperature": 0.0, "avg_logprob": -0.1577617189158564, "compression_ratio": 1.5940594059405941, "no_speech_prob": 0.0006023279274813831}, {"id": 134, "seek": 32794, "start": 341.3, "end": 342.58, "text": " and the principal men of the people", "tokens": [51033, 293, 264, 9716, 1706, 295, 264, 561, 51097], "temperature": 0.0, "avg_logprob": -0.1577617189158564, "compression_ratio": 1.5940594059405941, "no_speech_prob": 0.0006023279274813831}, {"id": 135, "seek": 32794, "start": 342.58, "end": 344.26, "text": " were seeking to destroy him,", "tokens": [51097, 645, 11670, 281, 5293, 796, 11, 51181], "temperature": 0.0, "avg_logprob": -0.1577617189158564, "compression_ratio": 1.5940594059405941, "no_speech_prob": 0.0006023279274813831}, {"id": 136, "seek": 32794, "start": 344.46, "end": 346.7, "text": " but they did not find anything they could do,", "tokens": [51191, 457, 436, 630, 406, 915, 1340, 436, 727, 360, 11, 51303], "temperature": 0.0, "avg_logprob": -0.1577617189158564, "compression_ratio": 1.5940594059405941, "no_speech_prob": 0.0006023279274813831}, {"id": 137, "seek": 32794, "start": 347.04, "end": 349.24, "text": " for all the people were hanging on his words.", "tokens": [51320, 337, 439, 264, 561, 645, 8345, 322, 702, 2283, 13, 51430], "temperature": 0.0, "avg_logprob": -0.1577617189158564, "compression_ratio": 1.5940594059405941, "no_speech_prob": 0.0006023279274813831}], "language": "English"}