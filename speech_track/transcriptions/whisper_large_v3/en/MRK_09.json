o": 1.6910569105691058, "no_speech_prob": 0.0044581228867173195}, {"id": 35, "seek": 11898, "start": 131.58, "end": 135.28, "text": " So I asked your disciples that cast it out, and they were not able.", "tokens": [50995, 407, 286, 2351, 428, 17209, 300, 4193, 309, 484, 11, 293, 436, 645, 406, 1075, 13, 51180], "temperature": 0.0, "avg_logprob": -0.2569602481902592, "compression_ratio": 1.6910569105691058, "no_speech_prob": 0.0044581228867173195}, {"id": 36, "seek": 11898, "start": 135.98000000000002, "end": 137.18, "text": " And he answered them,", "tokens": [51215, 400, 415, 10103, 552, 11, 51275], "temperature": 0.0, "avg_logprob": -0.2569602481902592, "compression_ratio": 1.6910569105691058, "no_speech_prob": 0.0044581228867173195}, {"id": 37, "seek": 11898, "start": 137.78, "end": 141.88, "text": " O faithless generation, how long am I to be with you?", "tokens": [51305, 422, 4522, 1832, 5125, 11, 577, 938, 669, 286, 281, 312, 365, 291, 30, 51510], "temperature": 0.0, "avg_logprob": -0.2569602481902592, "compression_ratio": 1.6910569105691058, "no_speech_prob": 0.0044581228867173195}, {"id": 38, "seek": 11898, "start": 142.18, "end": 144.48000000000002, "text": " How long am I to bear with you?", "tokens": [51525, 1012, 938, 669, 286, 281, 6155, 365, 291, 30, 51640], "temperature": 0.0, "avg_logprob": -0.2569602481902592, "compression_ratio": 1.6910569105691058, "no_speech_prob": 0.0044581228867173195}, {"id": 39, "seek": 11898, "start": 145.38, "end": 146.38, "text": " Bring him to me.", "tokens": [51685, 12842, 796, 281, 385, 13, 51735], "temperature": 0.0, "avg_logprob": -0.2569602481902592, "compression_ratio": 1.6910569105691058, "no_speech_prob": 0.0044581228867173195}, {"id": 40, "seek": 11898, "start": 146.88, "end": 148.48000000000002, "text": " And they brought the boy to him.", "tokens": [51760, 400, 436, 3038, 264, 3237, 281, 796, 13, 51840], "temperature": 0.0, "avg_logprob": -0.2569602481902592, "compression_ratio": 1.6910569105691058, "no_speech_prob": 0.0044581228867173195}, {"id": 41, "seek": 14898, "start": 148.98, "end": 152.38, "text": " And when the spirit saw him, immediately it convulsed the boy,", "tokens": [50365, 400, 562, 264, 3797, 1866, 796, 11, 4258, 309, 3754, 9468, 292, 264, 3237, 11, 50535], "temperature": 0.0, "avg_logprob": -0.21604396916237198, "compression_ratio": 1.628099173553719, "no_speech_prob": 0.0011767374817281961}, {"id": 42, "seek": 14898, "start": 152.57999999999998, "end": 155.76, "text": " and he fell on the ground, and rolled about, foaming at the mouth.", "tokens": [50545, 293, 415, 5696, 322, 264, 2727, 11, 293, 14306, 466, 11, 726, 5184, 412, 264, 4525, 13, 50704], "temperature": 0.0, "avg_logprob": -0.21604396916237198, "compression_ratio": 1.628099173553719, "no_speech_prob": 0.0011767374817281961}, {"id": 43, "seek": 14898, "start": 156.07999999999998, "end": 157.64, "text": " And Jesus asked his father,", "tokens": [50720, 400, 2705, 2351, 702, 3086, 11, 50798], "temperature": 0.0, "avg_logprob": -0.21604396916237198, "compression_ratio": 1.628099173553719, "no_speech_prob": 0.0011767374817281961}, {"id": 44, "seek": 14898, "start": 158.38, "end": 160.7, "text": " How long has this been happening to him?", "tokens": [50835, 1012, 938, 575, 341, 668, 2737, 281, 796, 30, 50951], "temperature": 0.0, "avg_logprob": -0.21604396916237198, "compression_ratio": 1.628099173553719, "no_speech_prob": 0.0011767374817281961}, {"id": 45, "seek": 14898, "start": 161.38, "end": 162.16, "text": " And he said,", "tokens": [50985, 400, 415, 848, 11, 51024], "temperature": 0.0, "avg_logprob": -0.21604396916237198, "compression_ratio": 1.628099173553719, "no_speech_prob": 0.0011767374817281961}, {"id": 46, "seek": 14898, "start": 162.82, "end": 163.83999999999997, "text": " From childhood.", "tokens": [51057, 3358, 9278, 13, 51108], "temperature": 0.0, "avg_logprob": -0.21604396916237198, "compression_ratio": 1.628099173553719, "no_speech_prob": 0.0011767374817281961}, {"id": 47, "seek": 14898, "start": 164.7, "end": 168.98, "text": " And it is often cast him into fire, and into water, to destroy him.", "tokens": [51151, 400, 309, 307, 2049, 4193, 796, 666, 2610, 11, 293, 666, 1281, 11, 281, 5293, 796, 13, 51365], "temperature": 0.0, "avg_logprob": -0.21604396916237198, "compression_ratio": 1.628099173553719, "no_speech_prob": 0.0011767374817281961}, {"id": 48, "seek": 14898, "start": 168.98, "end": 173.67999999999998, "text": " But if you can do anything, have compassion on us, and help us.", "tokens": [51365, 583, 498, 291, 393, 360, 1340, 11, 362, 12601, 322, 505, 11, 293, 854, 505, 13, 51600], "temperature": 0.0, "avg_logprob": -0.21604396916237198, "compression_ratio": 1.628099173553719, "no_speech_prob": 0.0011767374817281961}, {"id": 49, "seek": 14898, "start": 174.39999999999998, "end": 175.73999999999998, "text": " And Jesus said to him,", "tokens": [51636, 400, 2705, 848, 281, 796, 11, 51703], "temperature": 0.0, "avg_logprob": -0.21604396916237198, "compression_ratio": 1.628099173553719, "no_speech_prob": 0.0011767374817281961}, {"id": 50, "seek": 14898, "start": 176.44, "end": 177.44, "text": " If you can,", "tokens": [51738, 759, 291, 393, 11, 51788], "temperature": 0.0, "avg_logprob": -0.21604396916237198, "compression_ratio": 1.628099173553719, "no_speech_prob": 0.0011767374817281961}, {"id": 51, "seek": 17744, "start": 177.44, "end": 180.6, "text": " then all things are possible for one who believes.", "tokens": [50365, 550, 439, 721, 366, 1944, 337, 472, 567, 12307, 13, 50523], "temperature": 0.0, "avg_logprob": -0.21139996627281452, "compression_ratio": 1.6626506024096386, "no_speech_prob": 0.0031939048785716295}, {"id": 52, "seek": 17744, "start": 181.4, "end": 184.54, "text": " Immediately the father of the child cried out and said,", "tokens": [50563, 34457, 264, 3086, 295, 264, 1440, 16266, 484, 293, 848, 11, 50720], "temperature": 0.0, "avg_logprob": -0.21139996627281452, "compression_ratio": 1.6626506024096386, "no_speech_prob": 0.0031939048785716295}, {"id": 53, "seek": 17744, "start": 185.04, "end": 186.07999999999998, "text": " I believe.", "tokens": [50745, 286, 1697, 13, 50797], "temperature": 0.0, "avg_logprob": -0.21139996627281452, "compression_ratio": 1.6626506024096386, "no_speech_prob": 0.0031939048785716295}, {"id": 54, "seek": 17744, "start": 186.9, "end": 188.64, "text": " Help my unbelief.", "tokens": [50838, 10773, 452, 46063, 2521, 13, 50925], "temperature": 0.0, "avg_logprob": -0.21139996627281452, "compression_ratio": 1.6626506024096386, "no_speech_prob": 0.0031939048785716295}, {"id": 55, "seek": 17744, "start": 189.35999999999999, "end": 192.12, "text": " And when Jesus saw that a crowd came running together,", "tokens": [50961, 400, 562, 2705, 1866, 300, 257, 6919, 1361, 2614, 1214, 11, 51099], "temperature": 0.0, "avg_logprob": -0.21139996627281452, "compression_ratio": 1.6626506024096386, "no_speech_prob": 0.0031939048785716295}, {"id": 56, "seek": 17744, "start": 192.38, "end": 194.94, "text": " he rebuked the unclean spirit, saying to it,", "tokens": [51112, 415, 12970, 2034, 292, 264, 9153, 282, 3797, 11, 1566, 281, 309, 11, 51240], "temperature": 0.0, "avg_logprob": -0.21139996627281452, "compression_ratio": 1.6626506024096386, "no_speech_prob": 0.0031939048785716295}, {"id": 57, "seek": 17744, "start": 195.78, "end": 200.84, "text": " You mute and deaf spirit, I command you, come out of him, and never enter him again.", "tokens": [51282, 509, 24523, 293, 15559, 3797, 11, 286, 5622, 291, 11, 808, 484, 295, 796, 11, 293, 1128, 3242, 796, 797, 13, 51535], "temperature": 0.0, "avg_logprob": -0.21139996627281452, "compression_ratio": 1.6626506024096386, "no_speech_prob": 0.0031939048785716295}, {"id": 58, "seek": 17744, "start": 201.54, "end": 204.28, "text": " And after crying out and convulsing him terribly,", "tokens": [51570, 400, 934, 8554, 484, 293, 3754, 9468, 278, 796, 22903, 11, 51707], "temperature": 0.0, "avg_logprob": -0.21139996627281452, "compression_ratio": 1.6626506024096386, "no_speech_prob": 0.0031939048785716295}, {"id": 59, "seek": 17744, "start": 204.28, "end": 207.0, "text": " it came out, and the boy was like a corpse.", "tokens": [51707, 309, 1361, 484, 11, 293, 264, 3237, 390, 411, 257, 30324, 13, 51843], "temperature": 0.0, "avg_logprob": -0.21139996627281452, "compression_ratio": 1.6626506024096386, "no_speech_prob": 0.0031939048785716295}, {"id": 60, "seek": 20744, "start": 207.44, "end": 208.78, "text": " So that most of them said,", "tokens": [50365, 407, 300, 881, 295, 552, 848, 11, 50432], "temperature": 0.0, "avg_logprob": -0.19922494080107092, "compression_ratio": 1.611764705882353, "no_speech_prob": 0.0016220416873693466}, {"id": 61, "seek": 20744, "start": 209.56, "end": 210.92, "text": " He is dead.", "tokens": [50471, 634, 307, 3116, 13, 50539], "temperature": 0.0, "avg_logprob": -0.19922494080107092, "compression_ratio": 1.611764705882353, "no_speech_prob": 0.0016220416873693466}, {"id": 62, "seek": 20744, "start": 211.7, "end": 215.46, "text": " But Jesus took him by the hand, and lifted him up, and he arose.", "tokens": [50578, 583, 2705, 1890, 796, 538, 264, 1011, 11, 293, 17854, 796, 493, 11, 293, 415, 37192, 13, 50766], "temperature": 0.0, "avg_logprob": -0.19922494080107092, "compression_ratio": 1.611764705882353, "no_speech_prob": 0.0016220416873693466}, {"id": 63, "seek": 20744, "start": 216.24, "end": 219.64, "text": " And when he had entered the house, his disciples asked him privately,", "tokens": [50805, 400, 562, 415, 632, 9065, 264, 1782, 11, 702, 17209, 2351, 796, 31919, 11, 50975], "temperature": 0.0, "avg_logprob": -0.19922494080107092, "compression_ratio": 1.611764705882353, "no_speech_prob": 0.0016220416873693466}, {"id": 64, "seek": 20744, "start": 220.34, "end": 221.9, "text": " Why could we not cast it out?", "tokens": [51010, 1545, 727, 321, 406, 4193, 309, 484, 30, 51088], "temperature": 0.0, "avg_logprob": -0.19922494080107092, "compression_ratio": 1.611764705882353, "no_speech_prob": 0.0016220416873693466}, {"id": 65, "seek": 20744, "start": 222.62, "end": 223.84, "text": " And he said to them,", "tokens": [51124, 400, 415, 848, 281, 552, 11, 51185], "temperature": 0.0, "avg_logprob": -0.19922494080107092, "compression_ratio": 1.611764705882353, "no_speech_prob": 0.0016220416873693466}, {"id": 66, "seek": 20744, "start": 224.64, "end": 227.94, "text": " This kind cannot be driven out by anything but prayer.", "tokens": [51225, 639, 733, 2644, 312, 9555, 484, 538, 1340, 457, 8767, 13, 51390], "temperature": 0.0, "avg_logprob": -0.19922494080107092, "compression_ratio": 1.611764705882353, "no_speech_prob": 0.0016220416873693466}, {"id": 67, "seek": 20744, "start": 229.86, "end": 232.38, "text": " They went on from there, and passed through Galilee.", "tokens": [51486, 814, 1437, 322, 490, 456, 11, 293, 4678, 807, 7336, 33914, 13, 51612], "temperature": 0.0, "avg_logprob": -0.19922494080107092, "compression_ratio": 1.611764705882353, "no_speech_prob": 0.0016220416873693466}, {"id": 68, "seek": 20744, "start": 232.38, "end": 236.76, "text": " And he did not want anyone to know, for he was teaching his disciples,", "tokens": [51612, 400, 415, 630, 406, 528, 2878, 281, 458, 11, 337, 415, 390, 4571, 702, 17209, 11, 51831], "temperature": 0.0, "avg_logprob": -0.19922494080107092, "compression_ratio": 1.611764705882353, "no_speech_prob": 0.0016220416873693466}, {"id": 69, "seek": 20744, "start": 237.12, "end": 237.34, "text": " saying,", "tokens": [51849, 1566, 11, 51860], "temperature": 0.0, "avg_logprob": -0.19922494080107092, "compression_ratio": 1.611764705882353, "no_speech_prob": 0.0016220416873693466}, {"id": 70, "seek": 23744, "start": 237.44, "end": 241.5, "text": " The Son of Man is going to be delivered into the hands of men,", "tokens": [50365, 440, 5185, 295, 2458, 307, 516, 281, 312, 10144, 666, 264, 2377, 295, 1706, 11, 50568], "temperature": 0.0, "avg_logprob": -0.18302439880371094, "compression_ratio": 1.7440944881889764, "no_speech_prob": 0.0017139193369075656}, {"id": 71, "seek": 23744, "start": 241.85999999999999, "end": 242.94, "text": " and they will kill him.", "tokens": [50586, 293, 436, 486, 1961, 796, 13, 50640], "temperature": 0.0, "avg_logprob": -0.18302439880371094, "compression_ratio": 1.7440944881889764, "no_speech_prob": 0.0017139193369075656}, {"id": 72, "seek": 23744, "start": 243.35999999999999, "end": 247.44, "text": " And when he is killed, after three days he will rise.", "tokens": [50661, 400, 562, 415, 307, 4652, 11, 934, 1045, 1708, 415, 486, 6272, 13, 50865], "temperature": 0.0, "avg_logprob": -0.18302439880371094, "compression_ratio": 1.7440944881889764, "no_speech_prob": 0.0017139193369075656}, {"id": 73, "seek": 23744, "start": 247.85999999999999, "end": 251.76, "text": " But they did not understand the saying, and were afraid to ask him.", "tokens": [50886, 583, 436, 630, 406, 1223, 264, 1566, 11, 293, 645, 4638, 281, 1029, 796, 13, 51081], "temperature": 0.0, "avg_logprob": -0.18302439880371094, "compression_ratio": 1.7440944881889764, "no_speech_prob": 0.0017139193369075656}, {"id": 74, "seek": 23744, "start": 253.54, "end": 257.88, "text": " And they came to Capernaum, and when he was in the house, he asked them,", "tokens": [51170, 400, 436, 1361, 281, 383, 2332, 629, 449, 11, 293, 562, 415, 390, 294, 264, 1782, 11, 415, 2351, 552, 11, 51387], "temperature": 0.0, "avg_logprob": -0.18302439880371094, "compression_ratio": 1.7440944881889764, "no_speech_prob": 0.0017139193369075656}, {"id": 75, "seek": 23744, "start": 258.54, "end": 260.28, "text": " What were you discussing on the way?", "tokens": [51420, 708, 645, 291, 10850, 322, 264, 636, 30, 51507], "temperature": 0.0, "avg_logprob": -0.18302439880371094, "compression_ratio": 1.7440944881889764, "no_speech_prob": 0.0017139193369075656}, {"id": 76, "seek": 23744, "start": 260.96, "end": 266.02, "text": " But they kept silent, for on the way they had argued with one another about who was the greatest.", "tokens": [51541, 583, 436, 4305, 12784, 11, 337, 322, 264, 636, 436, 632, 20219, 365, 472, 1071, 466, 567, 390, 264, 6636, 13, 51794], "temperature": 0.0, "avg_logprob": -0.18302439880371094, "compression_ratio": 1.7440944881889764, "no_speech_prob": 0.0017139193369075656}, {"id": 77, "seek": 23744, "start": 266.56, "end": 267.36, "text": " And he sat down, and said,", "tokens": [51821, 400, 415, 3227, 760, 11, 293, 848, 11, 51861], "temperature": 0.0, "avg_logprob": -0.18302439880371094, "compression_ratio": 1.7440944881889764, "no_speech_prob": 0.0017139193369075656}, {"id": 78, "seek": 26736, "start": 267.36, "end": 268.46000000000004, "text": " And he sat down, and called the twelve.", "tokens": [50365, 400, 415, 3227, 760, 11, 293, 1219, 264, 14390, 13, 50420], "temperature": 0.0, "avg_logprob": -0.16668618180369602, "compression_ratio": 1.8786610878661087, "no_speech_prob": 0.0023771615233272314}, {"id": 79, "seek": 26736, "start": 268.82, "end": 269.8, "text": " And he said to them,", "tokens": [50438, 400, 415, 848, 281, 552, 11, 50487], "temperature": 0.0, "avg_logprob": -0.16668618180369602, "compression_ratio": 1.8786610878661087, "no_speech_prob": 0.0023771615233272314}, {"id": 80, "seek": 26736, "start": 270.52000000000004, "end": 275.32, "text": " If anyone would be first, he must be last of all, and servant of all.", "tokens": [50523, 759, 2878, 576, 312, 700, 11, 415, 1633, 312, 1036, 295, 439, 11, 293, 17896, 295, 439, 13, 50763], "temperature": 0.0, "avg_logprob": -0.16668618180369602, "compression_ratio": 1.8786610878661087, "no_speech_prob": 0.0023771615233272314}, {"id": 81, "seek": 26736, "start": 276.02000000000004, "end": 278.40000000000003, "text": " And he took a child, and put him in the midst of them.", "tokens": [50798, 400, 415, 1890, 257, 1440, 11, 293, 829, 796, 294, 264, 18629, 295, 552, 13, 50917], "temperature": 0.0, "avg_logprob": -0.16668618180369602, "compression_ratio": 1.8786610878661087, "no_speech_prob": 0.0023771615233272314}, {"id": 82, "seek": 26736, "start": 278.56, "end": 280.78000000000003, "text": " And taking him in his arms, he said to them,", "tokens": [50925, 400, 1940, 796, 294, 702, 5812, 11, 415, 848, 281, 552, 11, 51036], "temperature": 0.0, "avg_logprob": -0.16668618180369602, "compression_ratio": 1.8786610878661087, "no_speech_prob": 0.0023771615233272314}, {"id": 83, "seek": 26736, "start": 281.5, "end": 285.12, "text": " Whoever receives one such child in my name receives me.", "tokens": [51072, 24743, 20717, 472, 1270, 1440, 294, 452, 1315, 20717, 385, 13, 51253], "temperature": 0.0, "avg_logprob": -0.16668618180369602, "compression_ratio": 1.8786610878661087, "no_speech_prob": 0.0023771615233272314}, {"id": 84, "seek": 26736, "start": 285.78000000000003, "end": 289.92, "text": " And whoever receives me receives not me, but him who sent me.", "tokens": [51286, 400, 11387, 20717, 385, 20717, 406, 385, 11, 457, 796, 567, 2279, 385, 13, 51493], "temperature": 0.0, "avg_logprob": -0.16668618180369602, "compression_ratio": 1.8786610878661087, "no_speech_prob": 0.0023771615233272314}, {"id": 85, "seek": 26736, "start": 290.58000000000004, "end": 291.64, "text": " John said to him,", "tokens": [51526, 2619, 848, 281, 796, 11, 51579], "temperature": 0.0, "avg_logprob": -0.16668618180369602, "compression_ratio": 1.8786610878661087, "no_speech_prob": 0.0023771615233272314}, {"id": 86, "seek": 26736, "start": 292.26, "end": 295.58000000000004, "text": " Teacher, we saw someone casting out demons in your name,", "tokens": [51610, 19745, 11, 321, 1866, 1580, 17301, 484, 19733, 294, 428, 1315, 11, 51776], "temperature": 0.0, "avg_logprob": -0.16668618180369602, "compression_ratio": 1.8786610878661087, "no_speech_prob": 0.0023771615233272314}, {"id": 87, "seek": 26736, "start": 295.58000000000004, "end": 296.94, "text": " and we tried to stop him,", "tokens": [51776, 293, 321, 3031, 281, 1590, 796, 11, 51844], "temperature": 0.0, "avg_logprob": -0.16668618180369602, "compression_ratio": 1.8786610878661087, "no_speech_prob": 0.0023771615233272314}, {"id": 88, "seek": 29736, "start": 297.36, "end": 298.58000000000004, "text": " but he was not following us.", "tokens": [50365, 457, 415, 390, 406, 3480, 505, 13, 50426], "temperature": 0.0, "avg_logprob": -0.1325277974528651, "compression_ratio": 1.6395348837209303, "no_speech_prob": 0.0016613071784377098}, {"id": 89, "seek": 29736, "start": 299.24, "end": 300.24, "text": " But Jesus said,", "tokens": [50459, 583, 2705, 848, 11, 50509], "temperature": 0.0, "avg_logprob": -0.1325277974528651, "compression_ratio": 1.6395348837209303, "no_speech_prob": 0.0016613071784377098}, {"id": 90, "seek": 29736, "start": 300.98, "end": 302.36, "text": " Do not stop him,", "tokens": [50546, 1144, 406, 1590, 796, 11, 50615], "temperature": 0.0, "avg_logprob": -0.1325277974528651, "compression_ratio": 1.6395348837209303, "no_speech_prob": 0.0016613071784377098}, {"id": 91, "seek": 29736, "start": 302.7, "end": 305.16, "text": " for no one who does a mighty work in my name", "tokens": [50632, 337, 572, 472, 567, 775, 257, 21556, 589, 294, 452, 1315, 50755], "temperature": 0.0, "avg_logprob": -0.1325277974528651, "compression_ratio": 1.6395348837209303, "no_speech_prob": 0.0016613071784377098}, {"id": 92, "seek": 29736, "start": 305.16, "end": 307.82, "text": " will be able soon afterward to speak evil of me.", "tokens": [50755, 486, 312, 1075, 2321, 40411, 281, 1710, 6724, 295, 385, 13, 50888], "temperature": 0.0, "avg_logprob": -0.1325277974528651, "compression_ratio": 1.6395348837209303, "no_speech_prob": 0.0016613071784377098}, {"id": 93, "seek": 29736, "start": 308.40000000000003, "end": 311.54, "text": " For the one who is not against us is for us.", "tokens": [50917, 1171, 264, 472, 567, 307, 406, 1970, 505, 307, 337, 505, 13, 51074], "temperature": 0.0, "avg_logprob": -0.1325277974528651, "compression_ratio": 1.6395348837209303, "no_speech_prob": 0.0016613071784377098}, {"id": 94, "seek": 29736, "start": 312.5, "end": 314.12, "text": " For truly I say to you,", "tokens": [51122, 1171, 4908, 286, 584, 281, 291, 11, 51203], "temperature": 0.0, "avg_logprob": -0.1325277974528651, "compression_ratio": 1.6395348837209303, "no_speech_prob": 0.0016613071784377098}, {"id": 95, "seek": 29736, "start": 314.40000000000003, "end": 317.72, "text": " whoever gives you a cup of water to drink because you belong to Christ", "tokens": [51217, 11387, 2709, 291, 257, 4414, 295, 1281, 281, 2822, 570, 291, 5784, 281, 2040, 51383], "temperature": 0.0, "avg_logprob": -0.1325277974528651, "compression_ratio": 1.6395348837209303, "no_speech_prob": 0.0016613071784377098}, {"id": 96, "seek": 29736, "start": 317.72, "end": 320.26, "text": " will by no means lose his reward.", "tokens": [51383, 486, 538, 572, 1355, 3624, 702, 7782, 13, 51510], "temperature": 0.0, "avg_logprob": -0.1325277974528651, "compression_ratio": 1.6395348837209303, "no_speech_prob": 0.0016613071784377098}, {"id": 97, "seek": 29736, "start": 321.52000000000004, "end": 325.46000000000004, "text": " Whoever causes one of these little ones who believe in me to sin,", "tokens": [51573, 24743, 7700, 472, 295, 613, 707, 2306, 567, 1697, 294, 385, 281, 3343, 11, 51770], "temperature": 0.0, "avg_logprob": -0.1325277974528651, "compression_ratio": 1.6395348837209303, "no_speech_prob": 0.0016613071784377098}, {"id": 98, "seek": 29736, "start": 325.46000000000004, "end": 327.12, "text": " it would be better for him,", "tokens": [51770, 309, 576, 312, 1101, 337, 796, 11, 51853], "temperature": 0.0, "avg_logprob": -0.1325277974528651, "compression_ratio": 1.6395348837209303, "no_speech_prob": 0.0016613071784377098}, {"id": 99, "seek": 32712, "start": 327.12, "end": 329.5, "text": " if a great millstone were hung around his neck,", "tokens": [50365, 498, 257, 869, 1728, 11243, 645, 5753, 926, 702, 6189, 11, 50484], "temperature": 0.0, "avg_logprob": -0.1801699267493354, "compression_ratio": 2.299492385786802, "no_speech_prob": 0.020310616120696068}, {"id": 100, "seek": 32712, "start": 329.7, "end": 331.24, "text": " and he were thrown into the sea.", "tokens": [50494, 293, 415, 645, 11732, 666, 264, 4158, 13, 50571], "temperature": 0.0, "avg_logprob": -0.1801699267493354, "compression_ratio": 2.299492385786802, "no_speech_prob": 0.020310616120696068}, {"id": 101, "seek": 32712, "start": 332.06, "end": 334.5, "text": " And if your hand causes you to sin,", "tokens": [50612, 400, 498, 428, 1011, 7700, 291, 281, 3343, 11, 50734], "temperature": 0.0, "avg_logprob": -0.1801699267493354, "compression_ratio": 2.299492385786802, "no_speech_prob": 0.020310616120696068}, {"id": 102, "seek": 32712, "start": 334.9, "end": 335.7, "text": " cut it off.", "tokens": [50754, 1723, 309, 766, 13, 50794], "temperature": 0.0, "avg_logprob": -0.1801699267493354, "compression_ratio": 2.299492385786802, "no_speech_prob": 0.020310616120696068}, {"id": 103, "seek": 32712, "start": 336.16, "end": 338.64, "text": " It is better for you to enter life crippled", "tokens": [50817, 467, 307, 1101, 337, 291, 281, 3242, 993, 37667, 1493, 50941], "temperature": 0.0, "avg_logprob": -0.1801699267493354, "compression_ratio": 2.299492385786802, "no_speech_prob": 0.020310616120696068}, {"id": 104, "seek": 32712, "start": 338.64, "end": 340.72, "text": " than with two hands to go to hell,", "tokens": [50941, 813, 365, 732, 2377, 281, 352, 281, 4921, 11, 51045], "temperature": 0.0, "avg_logprob": -0.1801699267493354, "compression_ratio": 2.299492385786802, "no_speech_prob": 0.020310616120696068}, {"id": 105, "seek": 32712, "start": 341.06, "end": 342.44, "text": " to the unquenchable fire.", "tokens": [51062, 281, 264, 517, 358, 40765, 712, 2610, 13, 51131], "temperature": 0.0, "avg_logprob": -0.1801699267493354, "compression_ratio": 2.299492385786802, "no_speech_prob": 0.020310616120696068}, {"id": 106, "seek": 32712, "start": 343.04, "end": 345.0, "text": " And if your foot causes you to sin,", "tokens": [51161, 400, 498, 428, 2671, 7700, 291, 281, 3343, 11, 51259], "temperature": 0.0, "avg_logprob": -0.1801699267493354, "compression_ratio": 2.299492385786802, "no_speech_prob": 0.020310616120696068}, {"id": 107, "seek": 32712, "start": 345.14, "end": 345.76, "text": " cut it off.", "tokens": [51266, 1723, 309, 766, 13, 51297], "temperature": 0.0, "avg_logprob": -0.1801699267493354, "compression_ratio": 2.299492385786802, "no_speech_prob": 0.020310616120696068}, {"id": 108, "seek": 32712, "start": 346.18, "end": 348.28000000000003, "text": " It is better for you to enter life lame", "tokens": [51318, 467, 307, 1101, 337, 291, 281, 3242, 993, 27635, 51423], "temperature": 0.0, "avg_logprob": -0.1801699267493354, "compression_ratio": 2.299492385786802, "no_speech_prob": 0.020310616120696068}, {"id": 109, "seek": 32712, "start": 348.28000000000003, "end": 350.78000000000003, "text": " than with two feet to be thrown into hell.", "tokens": [51423, 813, 365, 732, 3521, 281, 312, 11732, 666, 4921, 13, 51548], "temperature": 0.0, "avg_logprob": -0.1801699267493354, "compression_ratio": 2.299492385786802, "no_speech_prob": 0.020310616120696068}, {"id": 110, "seek": 32712, "start": 351.76, "end": 354.32, "text": " And if your eye causes you to sin,", "tokens": [51597, 400, 498, 428, 3313, 7700, 291, 281, 3343, 11, 51725], "temperature": 0.0, "avg_logprob": -0.1801699267493354, "compression_ratio": 2.299492385786802, "no_speech_prob": 0.020310616120696068}, {"id": 111, "seek": 32712, "start": 354.74, "end": 355.54, "text": " tear it out.", "tokens": [51746, 12556, 309, 484, 13, 51786], "temperature": 0.0, "avg_logprob": -0.1801699267493354, "compression_ratio": 2.299492385786802, "no_speech_prob": 0.020310616120696068}, {"id": 112, "seek": 32712, "start": 355.96, "end": 356.96, "text": " It is better for you to enter life lame,", "tokens": [51807, 467, 307, 1101, 337, 291, 281, 3242, 993, 27635, 11, 51857], "temperature": 0.0, "avg_logprob": -0.1801699267493354, "compression_ratio": 2.299492385786802, "no_speech_prob": 0.020310616120696068}, {"id": 113, "seek": 35696, "start": 356.96, "end": 358.91999999999996, "text": " than to enter the kingdom of God with one eye,", "tokens": [50365, 813, 281, 3242, 264, 10231, 295, 1265, 365, 472, 3313, 11, 50463], "temperature": 0.0, "avg_logprob": -0.21177171008421644, "compression_ratio": 1.6183574879227054, "no_speech_prob": 0.0009695400949567556}, {"id": 114, "seek": 35696, "start": 359.26, "end": 361.44, "text": " than with two eyes to be thrown into hell,", "tokens": [50480, 813, 365, 732, 2575, 281, 312, 11732, 666, 4921, 11, 50589], "temperature": 0.0, "avg_logprob": -0.21177171008421644, "compression_ratio": 1.6183574879227054, "no_speech_prob": 0.0009695400949567556}, {"id": 115, "seek": 35696, "start": 361.97999999999996, "end": 363.94, "text": " where their worm does not die,", "tokens": [50616, 689, 641, 23835, 775, 406, 978, 11, 50714], "temperature": 0.0, "avg_logprob": -0.21177171008421644, "compression_ratio": 1.6183574879227054, "no_speech_prob": 0.0009695400949567556}, {"id": 116, "seek": 35696, "start": 364.15999999999997, "end": 365.79999999999995, "text": " and the fire is not quenched.", "tokens": [50725, 293, 264, 2610, 307, 406, 421, 268, 19318, 13, 50807], "temperature": 0.0, "avg_logprob": -0.21177171008421644, "compression_ratio": 1.6183574879227054, "no_speech_prob": 0.0009695400949567556}, {"id": 117, "seek": 35696, "start": 366.34, "end": 368.68, "text": " For everyone will be salted with fire.", "tokens": [50834, 1171, 1518, 486, 312, 39783, 365, 2610, 13, 50951], "temperature": 0.0, "avg_logprob": -0.21177171008421644, "compression_ratio": 1.6183574879227054, "no_speech_prob": 0.0009695400949567556}, {"id": 118, "seek": 35696, "start": 369.74, "end": 370.56, "text": " Salt is good,", "tokens": [51004, 19503, 307, 665, 11, 51045], "temperature": 0.0, "avg_logprob": -0.21177171008421644, "compression_ratio": 1.6183574879227054, "no_speech_prob": 0.0009695400949567556}, {"id": 119, "seek": 35696, "start": 370.9, "end": 372.74, "text": " but if the salt is lost its saltiness,", "tokens": [51062, 457, 498, 264, 5139, 307, 2731, 1080, 5139, 1324, 11, 51154], "temperature": 0.0, "avg_logprob": -0.21177171008421644, "compression_ratio": 1.6183574879227054, "no_speech_prob": 0.0009695400949567556}, {"id": 120, "seek": 35696, "start": 373.29999999999995, "end": 375.02, "text": " how will you make it salty again?", "tokens": [51182, 577, 486, 291, 652, 309, 18443, 797, 30, 51268], "temperature": 0.0, "avg_logprob": -0.21177171008421644, "compression_ratio": 1.6183574879227054, "no_speech_prob": 0.0009695400949567556}, {"id": 121, "seek": 35696, "start": 376.14, "end": 377.78, "text": " Have salt in yourselves,", "tokens": [51324, 3560, 5139, 294, 14791, 11, 51406], "temperature": 0.0, "avg_logprob": -0.21177171008421644, "compression_ratio": 1.6183574879227054, "no_speech_prob": 0.0009695400949567556}, {"id": 122, "seek": 35696, "start": 378.32, "end": 380.26, "text": " and be at peace with one another.", "tokens": [51433, 293, 312, 412, 4336, 365, 472, 1071, 13, 51530], "temperature": 0.0, "avg_logprob": -0.21177171008421644, "compression_ratio": 1.6183574879227054, "no_speech_prob": 0.0009695400949567556}], "language": "English"}