e": 0.0, "avg_logprob": -0.18315882001604353, "compression_ratio": 1.8104265402843602, "no_speech_prob": 0.000651238311547786}, {"id": 48, "seek": 17566, "start": 175.66, "end": 177.0, "text": " talents.", "tokens": [50365, 19933, 13, 50432], "temperature": 1.0, "avg_logprob": -1.0185645693824406, "compression_ratio": 2.439252336448598, "no_speech_prob": 0.00035142345586791635}, {"id": 49, "seek": 17566, "start": 177.0, "end": 178.16, "text": " Here, I have made five talents more.", "tokens": [50432, 1692, 11, 286, 362, 1027, 1732, 19933, 544, 13, 50490], "temperature": 1.0, "avg_logprob": -1.0185645693824406, "compression_ratio": 2.439252336448598, "no_speech_prob": 0.00035142345586791635}, {"id": 50, "seek": 17566, "start": 178.16, "end": 179.26, "text": " Your master answer him, Through Amazing Word you have materialized many things, and I are", "tokens": [50490, 2260, 4505, 1867, 796, 11, 8927, 14165, 8725, 291, 362, 2527, 1602, 867, 721, 11, 293, 286, 366, 50545], "temperature": 1.0, "avg_logprob": -1.0185645693824406, "compression_ratio": 2.439252336448598, "no_speech_prob": 0.00035142345586791635}, {"id": 51, "seek": 17566, "start": 179.26, "end": 182.84, "text": " now better than they thought they were, but not as strong as you thought they were.", "tokens": [50545, 586, 1101, 813, 436, 1194, 436, 645, 11, 457, 406, 382, 2068, 382, 291, 1194, 436, 645, 13, 50724], "temperature": 1.0, "avg_logprob": -1.0185645693824406, "compression_ratio": 2.439252336448598, "no_speech_prob": 0.00035142345586791635}, {"id": 52, "seek": 17566, "start": 182.84, "end": 184.34, "text": " So I knew you to be a hard man, reaping where you did not sow, and gathering where you scattered", "tokens": [50724, 407, 286, 2586, 291, 281, 312, 257, 1152, 587, 11, 39178, 278, 689, 291, 630, 406, 19766, 11, 293, 13519, 689, 291, 21986, 50799], "temperature": 1.0, "avg_logprob": -1.0185645693824406, "compression_ratio": 2.439252336448598, "no_speech_prob": 0.00035142345586791635}, {"id": 53, "seek": 17566, "start": 184.34, "end": 185.34, "text": " no seed.", "tokens": [50799, 572, 8871, 13, 50849], "temperature": 1.0, "avg_logprob": -1.0185645693824406, "compression_ratio": 2.439252336448598, "no_speech_prob": 0.00035142345586791635}, {"id": 54, "seek": 17566, "start": 185.34, "end": 187.22, "text": " So I was afraid, and I went and hid your talent in the ground.", "tokens": [50849, 407, 286, 390, 4638, 11, 293, 286, 1437, 293, 16253, 428, 8301, 294, 264, 2727, 13, 50943], "temperature": 1.0, "avg_logprob": -1.0185645693824406, "compression_ratio": 2.439252336448598, "no_speech_prob": 0.00035142345586791635}, {"id": 55, "seek": 17566, "start": 187.22, "end": 190.68, "text": " Here, you have what is yours.", "tokens": [50943, 1692, 11, 291, 362, 437, 307, 6342, 13, 51116], "temperature": 1.0, "avg_logprob": -1.0185645693824406, "compression_ratio": 2.439252336448598, "no_speech_prob": 0.00035142345586791635}, {"id": 56, "seek": 17566, "start": 190.68, "end": 195.26, "text": " But his master answered him, You wicked and slothful servant, you knew that I reap where", "tokens": [51116, 583, 702, 4505, 10103, 796, 11, 509, 22663, 293, 1061, 900, 906, 17896, 11, 291, 2586, 300, 286, 39178, 689, 51345], "temperature": 1.0, "avg_logprob": -1.0185645693824406, "compression_ratio": 2.439252336448598, "no_speech_prob": 0.00035142345586791635}, {"id": 57, "seek": 17566, "start": 195.26, "end": 200.62, "text": " I have not sown, and gather where I scattered no seed.", "tokens": [51345, 286, 362, 406, 262, 648, 11, 293, 5448, 689, 286, 21986, 572, 8871, 13, 51613], "temperature": 1.0, "avg_logprob": -1.0185645693824406, "compression_ratio": 2.439252336448598, "no_speech_prob": 0.00035142345586791635}, {"id": 58, "seek": 17566, "start": 200.62, "end": 202.4, "text": " Then you ought to have invested my money with the bankers.", "tokens": [51613, 1396, 291, 13416, 281, 362, 13104, 452, 1460, 365, 264, 3765, 433, 13, 51702], "temperature": 1.0, "avg_logprob": -1.0185645693824406, "compression_ratio": 2.439252336448598, "no_speech_prob": 0.00035142345586791635}, {"id": 59, "seek": 17566, "start": 202.4, "end": 204.6, "text": " You ought to have invested my money with the bankers.", "tokens": [51702, 509, 13416, 281, 362, 13104, 452, 1460, 365, 264, 3765, 433, 13, 51812], "temperature": 1.0, "avg_logprob": -1.0185645693824406, "compression_ratio": 2.439252336448598, "no_speech_prob": 0.00035142345586791635}, {"id": 60, "seek": 17566, "start": 204.6, "end": 204.82, "text": " You ought to have invested my money with the bankers.", "tokens": [51812, 509, 13416, 281, 362, 13104, 452, 1460, 365, 264, 3765, 433, 13, 51823], "temperature": 1.0, "avg_logprob": -1.0185645693824406, "compression_ratio": 2.439252336448598, "no_speech_prob": 0.00035142345586791635}, {"id": 61, "seek": 17566, "start": 204.82, "end": 205.51999999999998, "text": " You ought to have invested my money with the bankers.", "tokens": [51823, 509, 13416, 281, 362, 13104, 452, 1460, 365, 264, 3765, 433, 13, 51858], "temperature": 1.0, "avg_logprob": -1.0185645693824406, "compression_ratio": 2.439252336448598, "no_speech_prob": 0.00035142345586791635}, {"id": 62, "seek": 20552, "start": 205.52, "end": 209.58, "text": " and at my coming I should have received what was my own with interest.", "tokens": [50365, 293, 412, 452, 1348, 286, 820, 362, 4613, 437, 390, 452, 1065, 365, 1179, 13, 50568], "temperature": 0.0, "avg_logprob": -0.13163299560546876, "compression_ratio": 1.694915254237288, "no_speech_prob": 0.0028447520453482866}, {"id": 63, "seek": 20552, "start": 210.52, "end": 214.54000000000002, "text": " So take the talent from him, and give it to him who has the ten talents.", "tokens": [50615, 407, 747, 264, 8301, 490, 796, 11, 293, 976, 309, 281, 796, 567, 575, 264, 2064, 19933, 13, 50816], "temperature": 0.0, "avg_logprob": -0.13163299560546876, "compression_ratio": 1.694915254237288, "no_speech_prob": 0.0028447520453482866}, {"id": 64, "seek": 20552, "start": 215.24, "end": 219.42000000000002, "text": " For to everyone who has will more be given, and he will have an abundance.", "tokens": [50851, 1171, 281, 1518, 567, 575, 486, 544, 312, 2212, 11, 293, 415, 486, 362, 364, 23391, 13, 51060], "temperature": 0.0, "avg_logprob": -0.13163299560546876, "compression_ratio": 1.694915254237288, "no_speech_prob": 0.0028447520453482866}, {"id": 65, "seek": 20552, "start": 220.08, "end": 223.96, "text": " But from the one who has not, even what he has will be taken away.", "tokens": [51093, 583, 490, 264, 472, 567, 575, 406, 11, 754, 437, 415, 575, 486, 312, 2726, 1314, 13, 51287], "temperature": 0.0, "avg_logprob": -0.13163299560546876, "compression_ratio": 1.694915254237288, "no_speech_prob": 0.0028447520453482866}, {"id": 66, "seek": 20552, "start": 224.3, "end": 227.3, "text": " And cast the worthless servant into the outer darkness.", "tokens": [51304, 400, 4193, 264, 34857, 17896, 666, 264, 10847, 11262, 13, 51454], "temperature": 0.0, "avg_logprob": -0.13163299560546876, "compression_ratio": 1.694915254237288, "no_speech_prob": 0.0028447520453482866}, {"id": 67, "seek": 20552, "start": 227.98000000000002, "end": 231.58, "text": " In that place there will be weeping and gnashing of teeth.", "tokens": [51488, 682, 300, 1081, 456, 486, 312, 321, 10921, 293, 49819, 11077, 295, 7798, 13, 51668], "temperature": 0.0, "avg_logprob": -0.13163299560546876, "compression_ratio": 1.694915254237288, "no_speech_prob": 0.0028447520453482866}, {"id": 68, "seek": 23158, "start": 231.58, "end": 237.74, "text": " When the Son of Man comes in his glory, and all the angels with him,", "tokens": [50365, 1133, 264, 5185, 295, 2458, 1487, 294, 702, 11924, 11, 293, 439, 264, 18175, 365, 796, 11, 50673], "temperature": 0.0, "avg_logprob": -0.1367147570458528, "compression_ratio": 1.8080357142857142, "no_speech_prob": 0.001610313542187214}, {"id": 69, "seek": 23158, "start": 238.14000000000001, "end": 240.58, "text": " then he will sit on his glorious throne.", "tokens": [50693, 550, 415, 486, 1394, 322, 702, 24026, 17678, 13, 50815], "temperature": 0.0, "avg_logprob": -0.1367147570458528, "compression_ratio": 1.8080357142857142, "no_speech_prob": 0.001610313542187214}, {"id": 70, "seek": 23158, "start": 241.32000000000002, "end": 246.58, "text": " Before him will be gathered all the nations, and he will separate people one from another,", "tokens": [50852, 4546, 796, 486, 312, 13032, 439, 264, 11035, 11, 293, 415, 486, 4994, 561, 472, 490, 1071, 11, 51115], "temperature": 0.0, "avg_logprob": -0.1367147570458528, "compression_ratio": 1.8080357142857142, "no_speech_prob": 0.001610313542187214}, {"id": 71, "seek": 23158, "start": 247.06, "end": 249.9, "text": " as a shepherd separates the sheep from the goats.", "tokens": [51139, 382, 257, 40317, 34149, 264, 14213, 490, 264, 34219, 13, 51281], "temperature": 0.0, "avg_logprob": -0.1367147570458528, "compression_ratio": 1.8080357142857142, "no_speech_prob": 0.001610313542187214}, {"id": 72, "seek": 23158, "start": 250.12, "end": 254.66000000000003, "text": " And he will place the sheep on his right, but the goats on the left.", "tokens": [51292, 400, 415, 486, 1081, 264, 14213, 322, 702, 558, 11, 457, 264, 34219, 322, 264, 1411, 13, 51519], "temperature": 0.0, "avg_logprob": -0.1367147570458528, "compression_ratio": 1.8080357142857142, "no_speech_prob": 0.001610313542187214}, {"id": 73, "seek": 23158, "start": 255.52, "end": 258.06, "text": " Then the king will say to those on his right,", "tokens": [51562, 1396, 264, 4867, 486, 584, 281, 729, 322, 702, 558, 11, 51689], "temperature": 0.0, "avg_logprob": -0.1367147570458528, "compression_ratio": 1.8080357142857142, "no_speech_prob": 0.001610313542187214}, {"id": 74, "seek": 23158, "start": 258.48, "end": 261.26, "text": " Come, you who are blessed by my Father.", "tokens": [51710, 2492, 11, 291, 567, 366, 12351, 538, 452, 7085, 13, 51849], "temperature": 0.0, "avg_logprob": -0.1367147570458528, "compression_ratio": 1.8080357142857142, "no_speech_prob": 0.001610313542187214}, {"id": 75, "seek": 26158, "start": 261.96, "end": 265.8, "text": " Inherit the kingdom prepared for you from the foundation of the world.", "tokens": [50384, 682, 511, 270, 264, 10231, 4927, 337, 291, 490, 264, 7030, 295, 264, 1002, 13, 50576], "temperature": 0.0, "avg_logprob": -0.15090531449976977, "compression_ratio": 1.84304932735426, "no_speech_prob": 0.004038289189338684}, {"id": 76, "seek": 26158, "start": 266.5, "end": 269.21999999999997, "text": " For I was hungry, and you gave me food.", "tokens": [50611, 1171, 286, 390, 8067, 11, 293, 291, 2729, 385, 1755, 13, 50747], "temperature": 0.0, "avg_logprob": -0.15090531449976977, "compression_ratio": 1.84304932735426, "no_speech_prob": 0.004038289189338684}, {"id": 77, "seek": 26158, "start": 269.59999999999997, "end": 271.82, "text": " I was thirsty, and you gave me drink.", "tokens": [50766, 286, 390, 28115, 11, 293, 291, 2729, 385, 2822, 13, 50877], "temperature": 0.0, "avg_logprob": -0.15090531449976977, "compression_ratio": 1.84304932735426, "no_speech_prob": 0.004038289189338684}, {"id": 78, "seek": 26158, "start": 272.2, "end": 274.46, "text": " I was a stranger, and you welcomed me.", "tokens": [50896, 286, 390, 257, 18834, 11, 293, 291, 23668, 385, 13, 51009], "temperature": 0.0, "avg_logprob": -0.15090531449976977, "compression_ratio": 1.84304932735426, "no_speech_prob": 0.004038289189338684}, {"id": 79, "seek": 26158, "start": 274.86, "end": 277.12, "text": " I was naked, and you clothed me.", "tokens": [51029, 286, 390, 15791, 11, 293, 291, 13619, 292, 385, 13, 51142], "temperature": 0.0, "avg_logprob": -0.15090531449976977, "compression_ratio": 1.84304932735426, "no_speech_prob": 0.004038289189338684}, {"id": 80, "seek": 26158, "start": 277.64, "end": 279.38, "text": " I was sick, and you visited me.", "tokens": [51168, 286, 390, 4998, 11, 293, 291, 11220, 385, 13, 51255], "temperature": 0.0, "avg_logprob": -0.15090531449976977, "compression_ratio": 1.84304932735426, "no_speech_prob": 0.004038289189338684}, {"id": 81, "seek": 26158, "start": 279.38, "end": 282.4, "text": " I was in prison, and you came to me.", "tokens": [51255, 286, 390, 294, 6168, 11, 293, 291, 1361, 281, 385, 13, 51406], "temperature": 0.0, "avg_logprob": -0.15090531449976977, "compression_ratio": 1.84304932735426, "no_speech_prob": 0.004038289189338684}, {"id": 82, "seek": 26158, "start": 283.41999999999996, "end": 285.71999999999997, "text": " Then the righteous will answer him, saying,", "tokens": [51457, 1396, 264, 16153, 486, 1867, 796, 11, 1566, 11, 51572], "temperature": 0.0, "avg_logprob": -0.15090531449976977, "compression_ratio": 1.84304932735426, "no_speech_prob": 0.004038289189338684}, {"id": 83, "seek": 26158, "start": 286.41999999999996, "end": 291.21999999999997, "text": " Lord, when did we see you hungry and feed you, or thirsty and give you drink?", "tokens": [51607, 3257, 11, 562, 630, 321, 536, 291, 8067, 293, 3154, 291, 11, 420, 28115, 293, 976, 291, 2822, 30, 51847], "temperature": 0.0, "avg_logprob": -0.15090531449976977, "compression_ratio": 1.84304932735426, "no_speech_prob": 0.004038289189338684}, {"id": 84, "seek": 29158, "start": 292.12, "end": 297.08, "text": " And when did we see you a stranger and welcome you, or naked and clothe you?", "tokens": [50392, 400, 562, 630, 321, 536, 291, 257, 18834, 293, 2928, 291, 11, 420, 15791, 293, 596, 24863, 291, 30, 50640], "temperature": 0.0, "avg_logprob": -0.17262712097167968, "compression_ratio": 1.7459016393442623, "no_speech_prob": 0.00016865173529367894}, {"id": 85, "seek": 29158, "start": 297.68, "end": 301.24, "text": " And when did we see you sick or in prison and visit you?", "tokens": [50670, 400, 562, 630, 321, 536, 291, 4998, 420, 294, 6168, 293, 3441, 291, 30, 50848], "temperature": 0.0, "avg_logprob": -0.17262712097167968, "compression_ratio": 1.7459016393442623, "no_speech_prob": 0.00016865173529367894}, {"id": 86, "seek": 29158, "start": 301.96, "end": 303.4, "text": " And the king will answer them,", "tokens": [50884, 400, 264, 4867, 486, 1867, 552, 11, 50956], "temperature": 0.0, "avg_logprob": -0.17262712097167968, "compression_ratio": 1.7459016393442623, "no_speech_prob": 0.00016865173529367894}, {"id": 87, "seek": 29158, "start": 303.96, "end": 308.74, "text": " Truly I say to you, as you did it to one of the least of these my brothers,", "tokens": [50984, 43548, 286, 584, 281, 291, 11, 382, 291, 630, 309, 281, 472, 295, 264, 1935, 295, 613, 452, 8452, 11, 51223], "temperature": 0.0, "avg_logprob": -0.17262712097167968, "compression_ratio": 1.7459016393442623, "no_speech_prob": 0.00016865173529367894}, {"id": 88, "seek": 29158, "start": 309.24, "end": 310.46, "text": " you did it to me.", "tokens": [51248, 291, 630, 309, 281, 385, 13, 51309], "temperature": 0.0, "avg_logprob": -0.17262712097167968, "compression_ratio": 1.7459016393442623, "no_speech_prob": 0.00016865173529367894}, {"id": 89, "seek": 29158, "start": 311.29999999999995, "end": 313.53999999999996, "text": " Then he will say to those on his left,", "tokens": [51351, 1396, 415, 486, 584, 281, 729, 322, 702, 1411, 11, 51463], "temperature": 0.0, "avg_logprob": -0.17262712097167968, "compression_ratio": 1.7459016393442623, "no_speech_prob": 0.00016865173529367894}, {"id": 90, "seek": 29158, "start": 314.03999999999996, "end": 320.0, "text": " Depart from me, you cursed, into the eternal fire prepared for the devil and his angels.", "tokens": [51488, 4056, 446, 490, 385, 11, 291, 29498, 11, 666, 264, 14503, 2610, 4927, 337, 264, 13297, 293, 702, 18175, 13, 51786], "temperature": 0.0, "avg_logprob": -0.17262712097167968, "compression_ratio": 1.7459016393442623, "no_speech_prob": 0.00016865173529367894}, {"id": 91, "seek": 29158, "start": 320.96, "end": 321.56, "text": " For I was hungry, and you gave me food.", "tokens": [51834, 1171, 286, 390, 8067, 11, 293, 291, 2729, 385, 1755, 13, 51864], "temperature": 0.0, "avg_logprob": -0.17262712097167968, "compression_ratio": 1.7459016393442623, "no_speech_prob": 0.00016865173529367894}, {"id": 92, "seek": 32156, "start": 321.56, "end": 324.1, "text": " I was hungry, and you gave me no food.", "tokens": [50365, 286, 390, 8067, 11, 293, 291, 2729, 385, 572, 1755, 13, 50492], "temperature": 0.0, "avg_logprob": -0.16722555009145584, "compression_ratio": 2.0050251256281406, "no_speech_prob": 0.005179143510758877}, {"id": 93, "seek": 32156, "start": 324.38, "end": 326.84, "text": " I was thirsty, and you gave me no drink.", "tokens": [50506, 286, 390, 28115, 11, 293, 291, 2729, 385, 572, 2822, 13, 50629], "temperature": 0.0, "avg_logprob": -0.16722555009145584, "compression_ratio": 2.0050251256281406, "no_speech_prob": 0.005179143510758877}, {"id": 94, "seek": 32156, "start": 327.22, "end": 330.22, "text": " I was a stranger, and you did not welcome me.", "tokens": [50648, 286, 390, 257, 18834, 11, 293, 291, 630, 406, 2928, 385, 13, 50798], "temperature": 0.0, "avg_logprob": -0.16722555009145584, "compression_ratio": 2.0050251256281406, "no_speech_prob": 0.005179143510758877}, {"id": 95, "seek": 32156, "start": 330.54, "end": 332.54, "text": " Naked, and you did not clothe me.", "tokens": [50814, 426, 7301, 11, 293, 291, 630, 406, 596, 24863, 385, 13, 50914], "temperature": 0.0, "avg_logprob": -0.16722555009145584, "compression_ratio": 2.0050251256281406, "no_speech_prob": 0.005179143510758877}, {"id": 96, "seek": 32156, "start": 333.06, "end": 336.44, "text": " Sick, and in prison, and you did not visit me.", "tokens": [50940, 43471, 11, 293, 294, 6168, 11, 293, 291, 630, 406, 3441, 385, 13, 51109], "temperature": 0.0, "avg_logprob": -0.16722555009145584, "compression_ratio": 2.0050251256281406, "no_speech_prob": 0.005179143510758877}, {"id": 97, "seek": 32156, "start": 337.22, "end": 339.82, "text": " Then they also will answer, saying,", "tokens": [51148, 1396, 436, 611, 486, 1867, 11, 1566, 11, 51278], "temperature": 0.0, "avg_logprob": -0.16722555009145584, "compression_ratio": 2.0050251256281406, "no_speech_prob": 0.005179143510758877}, {"id": 98, "seek": 32156, "start": 340.48, "end": 347.02, "text": " Lord, when did we see you hungry, or thirsty, or a stranger, or naked, or sick, or in prison,", "tokens": [51311, 3257, 11, 562, 630, 321, 536, 291, 8067, 11, 420, 28115, 11, 420, 257, 18834, 11, 420, 15791, 11, 420, 4998, 11, 420, 294, 6168, 11, 51638], "temperature": 0.0, "avg_logprob": -0.16722555009145584, "compression_ratio": 2.0050251256281406, "no_speech_prob": 0.005179143510758877}, {"id": 99, "seek": 32156, "start": 347.5, "end": 349.18, "text": " and did not minister to you?", "tokens": [51662, 293, 630, 406, 10563, 281, 291, 30, 51746], "temperature": 0.0, "avg_logprob": -0.16722555009145584, "compression_ratio": 2.0050251256281406, "no_speech_prob": 0.005179143510758877}, {"id": 100, "seek": 32156, "start": 349.68, "end": 351.54, "text": " Then he will answer them, saying,", "tokens": [51771, 1396, 415, 486, 1867, 552, 11, 1566, 11, 51864], "temperature": 0.0, "avg_logprob": -0.16722555009145584, "compression_ratio": 2.0050251256281406, "no_speech_prob": 0.005179143510758877}, {"id": 101, "seek": 35156, "start": 352.08, "end": 357.28000000000003, "text": " Truly I say to you, as you did not do it to one of the least of these,", "tokens": [50391, 43548, 286, 584, 281, 291, 11, 382, 291, 630, 406, 360, 309, 281, 472, 295, 264, 1935, 295, 613, 11, 50651], "temperature": 0.0, "avg_logprob": -0.17598303309026755, "compression_ratio": 1.5126050420168067, "no_speech_prob": 0.0012643797090277076}, {"id": 102, "seek": 35156, "start": 357.86, "end": 359.52, "text": " you did not do it to me.", "tokens": [50680, 291, 630, 406, 360, 309, 281, 385, 13, 50763], "temperature": 0.0, "avg_logprob": -0.17598303309026755, "compression_ratio": 1.5126050420168067, "no_speech_prob": 0.0012643797090277076}, {"id": 103, "seek": 35156, "start": 360.22, "end": 363.26, "text": " And these will go away into eternal punishment,", "tokens": [50798, 400, 613, 486, 352, 1314, 666, 14503, 14133, 11, 50950], "temperature": 0.0, "avg_logprob": -0.17598303309026755, "compression_ratio": 1.5126050420168067, "no_speech_prob": 0.0012643797090277076}, {"id": 104, "seek": 35156, "start": 363.26, "end": 366.7, "text": " but the righteous into eternal life.", "tokens": [50950, 457, 264, 16153, 666, 14503, 993, 13, 51122], "temperature": 0.0, "avg_logprob": -0.17598303309026755, "compression_ratio": 1.5126050420168067, "no_speech_prob": 0.0012643797090277076}], "language": "English"}