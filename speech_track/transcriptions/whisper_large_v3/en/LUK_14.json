t": " But he said to him,", "tokens": [50531, 583, 415, 848, 281, 796, 11, 50581], "temperature": 0.0, "avg_logprob": -0.2281471144223044, "compression_ratio": 1.7210144927536233, "no_speech_prob": 0.0021794678177684546}, {"id": 43, "seek": 11800, "start": 122.32, "end": 126.32, "text": " A man once gave a great banquet and invited many.", "tokens": [50581, 316, 587, 1564, 2729, 257, 869, 49796, 293, 9185, 867, 13, 50781], "temperature": 0.0, "avg_logprob": -0.2281471144223044, "compression_ratio": 1.7210144927536233, "no_speech_prob": 0.0021794678177684546}, {"id": 44, "seek": 11800, "start": 126.32, "end": 130.32, "text": " And at the time for the banquet he sent his servant to say to those who had been invited,", "tokens": [50781, 400, 412, 264, 565, 337, 264, 49796, 415, 2279, 702, 17896, 281, 584, 281, 729, 567, 632, 668, 9185, 11, 50981], "temperature": 0.0, "avg_logprob": -0.2281471144223044, "compression_ratio": 1.7210144927536233, "no_speech_prob": 0.0021794678177684546}, {"id": 45, "seek": 11800, "start": 130.32, "end": 133.32, "text": " Come, for everything is now ready.", "tokens": [50981, 2492, 11, 337, 1203, 307, 586, 1919, 13, 51131], "temperature": 0.0, "avg_logprob": -0.2281471144223044, "compression_ratio": 1.7210144927536233, "no_speech_prob": 0.0021794678177684546}, {"id": 46, "seek": 11800, "start": 133.32, "end": 136.32, "text": " But they all alike began to make excuses.", "tokens": [51131, 583, 436, 439, 20025, 4283, 281, 652, 24666, 13, 51281], "temperature": 0.0, "avg_logprob": -0.2281471144223044, "compression_ratio": 1.7210144927536233, "no_speech_prob": 0.0021794678177684546}, {"id": 47, "seek": 11800, "start": 136.32, "end": 138.32, "text": " The first said to him,", "tokens": [51281, 440, 700, 848, 281, 796, 11, 51381], "temperature": 0.0, "avg_logprob": -0.2281471144223044, "compression_ratio": 1.7210144927536233, "no_speech_prob": 0.0021794678177684546}, {"id": 48, "seek": 11800, "start": 138.32, "end": 141.32, "text": " I have bought a field, and I must go out and see it.", "tokens": [51381, 286, 362, 4243, 257, 2519, 11, 293, 286, 1633, 352, 484, 293, 536, 309, 13, 51531], "temperature": 0.0, "avg_logprob": -0.2281471144223044, "compression_ratio": 1.7210144927536233, "no_speech_prob": 0.0021794678177684546}, {"id": 49, "seek": 11800, "start": 141.32, "end": 143.32, "text": " Please have me excused.", "tokens": [51531, 2555, 362, 385, 20974, 292, 13, 51631], "temperature": 0.0, "avg_logprob": -0.2281471144223044, "compression_ratio": 1.7210144927536233, "no_speech_prob": 0.0021794678177684546}, {"id": 50, "seek": 11800, "start": 143.32, "end": 144.32, "text": " And another said,", "tokens": [51631, 400, 1071, 848, 11, 51681], "temperature": 0.0, "avg_logprob": -0.2281471144223044, "compression_ratio": 1.7210144927536233, "no_speech_prob": 0.0021794678177684546}, {"id": 51, "seek": 11800, "start": 144.32, "end": 146.32, "text": " I have bought five yoke of oxen,", "tokens": [51681, 286, 362, 4243, 1732, 288, 2949, 295, 5976, 268, 11, 51781], "temperature": 0.0, "avg_logprob": -0.2281471144223044, "compression_ratio": 1.7210144927536233, "no_speech_prob": 0.0021794678177684546}, {"id": 52, "seek": 11800, "start": 146.32, "end": 147.32, "text": " and I go to examine them.", "tokens": [51781, 293, 286, 352, 281, 17496, 552, 13, 51831], "temperature": 0.0, "avg_logprob": -0.2281471144223044, "compression_ratio": 1.7210144927536233, "no_speech_prob": 0.0021794678177684546}, {"id": 53, "seek": 14732, "start": 147.32, "end": 150.6, "text": " Please have me excused.", "tokens": [50365, 2555, 362, 385, 20974, 292, 13, 50529], "temperature": 0.8, "avg_logprob": -0.3322516030412379, "compression_ratio": 1.7903225806451613, "no_speech_prob": 0.0015961037715896964}, {"id": 54, "seek": 14732, "start": 150.6, "end": 151.72, "text": " And another said,", "tokens": [50529, 400, 1071, 848, 11, 50585], "temperature": 0.8, "avg_logprob": -0.3322516030412379, "compression_ratio": 1.7903225806451613, "no_speech_prob": 0.0015961037715896964}, {"id": 55, "seek": 14732, "start": 151.72, "end": 155.64, "text": " I have married a wife, and therefore I cannot come.", "tokens": [50585, 286, 362, 5259, 257, 3836, 11, 293, 4412, 286, 2644, 808, 13, 50781], "temperature": 0.8, "avg_logprob": -0.3322516030412379, "compression_ratio": 1.7903225806451613, "no_speech_prob": 0.0015961037715896964}, {"id": 56, "seek": 14732, "start": 155.64, "end": 159.64, "text": " So the servant came and reported these things to his master.", "tokens": [50781, 407, 264, 17896, 1361, 293, 7055, 613, 721, 281, 702, 4505, 13, 50981], "temperature": 0.8, "avg_logprob": -0.3322516030412379, "compression_ratio": 1.7903225806451613, "no_speech_prob": 0.0015961037715896964}, {"id": 57, "seek": 14732, "start": 159.64, "end": 162.56, "text": " Then the master of the house became angry and said to his servant,", "tokens": [50981, 1396, 264, 4505, 295, 264, 1782, 3062, 6884, 293, 848, 281, 702, 17896, 11, 51127], "temperature": 0.8, "avg_logprob": -0.3322516030412379, "compression_ratio": 1.7903225806451613, "no_speech_prob": 0.0015961037715896964}, {"id": 58, "seek": 14732, "start": 162.56, "end": 166.2, "text": " Go out quickly to the streets and lanes of the city,", "tokens": [51127, 1037, 484, 2661, 281, 264, 8481, 293, 25397, 295, 264, 2307, 11, 51309], "temperature": 0.8, "avg_logprob": -0.3322516030412379, "compression_ratio": 1.7903225806451613, "no_speech_prob": 0.0015961037715896964}, {"id": 59, "seek": 14732, "start": 166.2, "end": 169.32, "text": " and bring in the poor and crippled, and blind and lame.", "tokens": [51309, 293, 1565, 294, 264, 4716, 293, 37667, 1493, 11, 293, 6865, 293, 27635, 13, 51465], "temperature": 0.8, "avg_logprob": -0.3322516030412379, "compression_ratio": 1.7903225806451613, "no_speech_prob": 0.0015961037715896964}, {"id": 60, "seek": 14732, "start": 169.32, "end": 171.32, "text": " And the servant said,", "tokens": [51465, 400, 264, 17896, 848, 11, 51565], "temperature": 0.8, "avg_logprob": -0.3322516030412379, "compression_ratio": 1.7903225806451613, "no_speech_prob": 0.0015961037715896964}, {"id": 61, "seek": 14732, "start": 171.32, "end": 175.4, "text": " Sir, what you commanded has been done, and still there is room.", "tokens": [51565, 6144, 11, 437, 291, 34359, 575, 668, 1096, 11, 293, 920, 456, 307, 1808, 13, 51769], "temperature": 0.8, "avg_logprob": -0.3322516030412379, "compression_ratio": 1.7903225806451613, "no_speech_prob": 0.0015961037715896964}, {"id": 62, "seek": 14732, "start": 175.4, "end": 175.64, "text": " And the master said to him,", "tokens": [51769, 400, 264, 4505, 848, 281, 796, 11, 51781], "temperature": 0.8, "avg_logprob": -0.3322516030412379, "compression_ratio": 1.7903225806451613, "no_speech_prob": 0.0015961037715896964}, {"id": 63, "seek": 17564, "start": 175.64, "end": 177.83999999999997, "text": " And the master said to the servant,", "tokens": [50365, 400, 264, 4505, 848, 281, 264, 17896, 11, 50475], "temperature": 0.0, "avg_logprob": -0.16029432841709682, "compression_ratio": 1.6926229508196722, "no_speech_prob": 0.08032393455505371}, {"id": 64, "seek": 17564, "start": 178.57999999999998, "end": 182.29999999999998, "text": " Go out to the highways and hedges, and compel people to come in,", "tokens": [50512, 1037, 484, 281, 264, 43747, 293, 33653, 2880, 11, 293, 715, 338, 561, 281, 808, 294, 11, 50698], "temperature": 0.0, "avg_logprob": -0.16029432841709682, "compression_ratio": 1.6926229508196722, "no_speech_prob": 0.08032393455505371}, {"id": 65, "seek": 17564, "start": 182.64, "end": 184.55999999999997, "text": " that my house may be filled.", "tokens": [50715, 300, 452, 1782, 815, 312, 6412, 13, 50811], "temperature": 0.0, "avg_logprob": -0.16029432841709682, "compression_ratio": 1.6926229508196722, "no_speech_prob": 0.08032393455505371}, {"id": 66, "seek": 17564, "start": 184.98, "end": 189.51999999999998, "text": " For I tell you, none of those men who were invited shall taste my banquet.", "tokens": [50832, 1171, 286, 980, 291, 11, 6022, 295, 729, 1706, 567, 645, 9185, 4393, 3939, 452, 49796, 13, 51059], "temperature": 0.0, "avg_logprob": -0.16029432841709682, "compression_ratio": 1.6926229508196722, "no_speech_prob": 0.08032393455505371}, {"id": 67, "seek": 17564, "start": 190.72, "end": 194.83999999999997, "text": " Now great crowds accompanied him, and he turned and said to them,", "tokens": [51119, 823, 869, 26070, 24202, 796, 11, 293, 415, 3574, 293, 848, 281, 552, 11, 51325], "temperature": 0.0, "avg_logprob": -0.16029432841709682, "compression_ratio": 1.6926229508196722, "no_speech_prob": 0.08032393455505371}, {"id": 68, "seek": 17564, "start": 195.56, "end": 199.56, "text": " If anyone comes to me and does not hate his own father and mother,", "tokens": [51361, 759, 2878, 1487, 281, 385, 293, 775, 406, 4700, 702, 1065, 3086, 293, 2895, 11, 51561], "temperature": 0.0, "avg_logprob": -0.16029432841709682, "compression_ratio": 1.6926229508196722, "no_speech_prob": 0.08032393455505371}, {"id": 69, "seek": 17564, "start": 199.85999999999999, "end": 202.6, "text": " and wife and children and brothers and sisters,", "tokens": [51576, 293, 3836, 293, 2227, 293, 8452, 293, 11589, 11, 51713], "temperature": 0.0, "avg_logprob": -0.16029432841709682, "compression_ratio": 1.6926229508196722, "no_speech_prob": 0.08032393455505371}, {"id": 70, "seek": 17564, "start": 202.6, "end": 205.45999999999998, "text": " yes, and even his own life,", "tokens": [51713, 2086, 11, 293, 754, 702, 1065, 993, 11, 51856], "temperature": 0.0, "avg_logprob": -0.16029432841709682, "compression_ratio": 1.6926229508196722, "no_speech_prob": 0.08032393455505371}, {"id": 71, "seek": 20564, "start": 205.73999999999998, "end": 207.29999999999998, "text": " he cannot be my disciple.", "tokens": [50370, 415, 2644, 312, 452, 32100, 13, 50448], "temperature": 0.0, "avg_logprob": -0.18795745791369722, "compression_ratio": 1.855421686746988, "no_speech_prob": 4.575327329803258e-05}, {"id": 72, "seek": 20564, "start": 208.01999999999998, "end": 211.42, "text": " Whoever does not bear his own cross and come after me", "tokens": [50484, 24743, 775, 406, 6155, 702, 1065, 3278, 293, 808, 934, 385, 50654], "temperature": 0.0, "avg_logprob": -0.18795745791369722, "compression_ratio": 1.855421686746988, "no_speech_prob": 4.575327329803258e-05}, {"id": 73, "seek": 20564, "start": 211.42, "end": 213.33999999999997, "text": " cannot be my disciple.", "tokens": [50654, 2644, 312, 452, 32100, 13, 50750], "temperature": 0.0, "avg_logprob": -0.18795745791369722, "compression_ratio": 1.855421686746988, "no_speech_prob": 4.575327329803258e-05}, {"id": 74, "seek": 20564, "start": 214.44, "end": 217.44, "text": " For which of you, desiring to build a tower,", "tokens": [50805, 1171, 597, 295, 291, 11, 730, 5057, 281, 1322, 257, 10567, 11, 50955], "temperature": 0.0, "avg_logprob": -0.18795745791369722, "compression_ratio": 1.855421686746988, "no_speech_prob": 4.575327329803258e-05}, {"id": 75, "seek": 20564, "start": 217.83999999999997, "end": 220.1, "text": " does not first sit down and count the cost,", "tokens": [50975, 775, 406, 700, 1394, 760, 293, 1207, 264, 2063, 11, 51088], "temperature": 0.0, "avg_logprob": -0.18795745791369722, "compression_ratio": 1.855421686746988, "no_speech_prob": 4.575327329803258e-05}, {"id": 76, "seek": 20564, "start": 220.38, "end": 222.17999999999998, "text": " whether he has enough to complete it?", "tokens": [51102, 1968, 415, 575, 1547, 281, 3566, 309, 30, 51192], "temperature": 0.0, "avg_logprob": -0.18795745791369722, "compression_ratio": 1.855421686746988, "no_speech_prob": 4.575327329803258e-05}, {"id": 77, "seek": 20564, "start": 222.67999999999998, "end": 226.01999999999998, "text": " Otherwise, when he has laid a foundation and is not able to finish,", "tokens": [51217, 10328, 11, 562, 415, 575, 9897, 257, 7030, 293, 307, 406, 1075, 281, 2413, 11, 51384], "temperature": 0.0, "avg_logprob": -0.18795745791369722, "compression_ratio": 1.855421686746988, "no_speech_prob": 4.575327329803258e-05}, {"id": 78, "seek": 20564, "start": 226.35999999999999, "end": 228.98, "text": " all who see it begin to mock him, saying,", "tokens": [51401, 439, 567, 536, 309, 1841, 281, 17362, 796, 11, 1566, 11, 51532], "temperature": 0.0, "avg_logprob": -0.18795745791369722, "compression_ratio": 1.855421686746988, "no_speech_prob": 4.575327329803258e-05}, {"id": 79, "seek": 20564, "start": 229.29999999999998, "end": 232.67999999999998, "text": " This man began to build and was not able to finish.", "tokens": [51548, 639, 587, 4283, 281, 1322, 293, 390, 406, 1075, 281, 2413, 13, 51717], "temperature": 0.0, "avg_logprob": -0.18795745791369722, "compression_ratio": 1.855421686746988, "no_speech_prob": 4.575327329803258e-05}, {"id": 80, "seek": 20564, "start": 233.2, "end": 235.54, "text": " Or what king, going out to encounter", "tokens": [51743, 1610, 437, 4867, 11, 516, 484, 281, 8593, 51860], "temperature": 0.0, "avg_logprob": -0.18795745791369722, "compression_ratio": 1.855421686746988, "no_speech_prob": 4.575327329803258e-05}, {"id": 81, "seek": 20564, "start": 235.54, "end": 235.61999999999998, "text": " a man who was not able to finish,", "tokens": [51860, 257, 587, 567, 390, 406, 1075, 281, 2413, 11, 51864], "temperature": 0.0, "avg_logprob": -0.18795745791369722, "compression_ratio": 1.855421686746988, "no_speech_prob": 4.575327329803258e-05}, {"id": 82, "seek": 23562, "start": 235.62, "end": 236.68, "text": " or another king in war,", "tokens": [50365, 420, 1071, 4867, 294, 1516, 11, 50418], "temperature": 0.0, "avg_logprob": -0.11871441409119174, "compression_ratio": 1.68359375, "no_speech_prob": 0.000631211674772203}, {"id": 83, "seek": 23562, "start": 237.08, "end": 240.82, "text": " will not sit down first and deliberate whether he is able with ten thousand", "tokens": [50438, 486, 406, 1394, 760, 700, 293, 30515, 1968, 415, 307, 1075, 365, 2064, 4714, 50625], "temperature": 0.0, "avg_logprob": -0.11871441409119174, "compression_ratio": 1.68359375, "no_speech_prob": 0.000631211674772203}, {"id": 84, "seek": 23562, "start": 240.82, "end": 243.68, "text": " to meet him who comes against him with twenty thousand?", "tokens": [50625, 281, 1677, 796, 567, 1487, 1970, 796, 365, 7699, 4714, 30, 50768], "temperature": 0.0, "avg_logprob": -0.11871441409119174, "compression_ratio": 1.68359375, "no_speech_prob": 0.000631211674772203}, {"id": 85, "seek": 23562, "start": 244.34, "end": 247.34, "text": " And if not, while the other is yet a great way off,", "tokens": [50801, 400, 498, 406, 11, 1339, 264, 661, 307, 1939, 257, 869, 636, 766, 11, 50951], "temperature": 0.0, "avg_logprob": -0.11871441409119174, "compression_ratio": 1.68359375, "no_speech_prob": 0.000631211674772203}, {"id": 86, "seek": 23562, "start": 247.66, "end": 250.62, "text": " he sends a delegation and asks for terms of peace.", "tokens": [50967, 415, 14790, 257, 36602, 293, 8962, 337, 2115, 295, 4336, 13, 51115], "temperature": 0.0, "avg_logprob": -0.11871441409119174, "compression_ratio": 1.68359375, "no_speech_prob": 0.000631211674772203}, {"id": 87, "seek": 23562, "start": 251.46, "end": 256.02, "text": " So therefore, any one of you who does not renounce all that he has", "tokens": [51157, 407, 4412, 11, 604, 472, 295, 291, 567, 775, 406, 8124, 7826, 439, 300, 415, 575, 51385], "temperature": 0.0, "avg_logprob": -0.11871441409119174, "compression_ratio": 1.68359375, "no_speech_prob": 0.000631211674772203}, {"id": 88, "seek": 23562, "start": 256.02, "end": 257.72, "text": " cannot be my disciple.", "tokens": [51385, 2644, 312, 452, 32100, 13, 51470], "temperature": 0.0, "avg_logprob": -0.11871441409119174, "compression_ratio": 1.68359375, "no_speech_prob": 0.000631211674772203}, {"id": 89, "seek": 23562, "start": 259.08, "end": 262.62, "text": " Salt is good, but if salt has lost its taste,", "tokens": [51538, 19503, 307, 665, 11, 457, 498, 5139, 575, 2731, 1080, 3939, 11, 51715], "temperature": 0.0, "avg_logprob": -0.11871441409119174, "compression_ratio": 1.68359375, "no_speech_prob": 0.000631211674772203}, {"id": 90, "seek": 23562, "start": 262.62, "end": 264.92, "text": " how shall its saltiness be restored?", "tokens": [51715, 577, 4393, 1080, 5139, 1324, 312, 23143, 30, 51830], "temperature": 0.0, "avg_logprob": -0.11871441409119174, "compression_ratio": 1.68359375, "no_speech_prob": 0.000631211674772203}, {"id": 91, "seek": 26492, "start": 264.92, "end": 269.06, "text": " It is of no use either for the soil or for the manure pile.", "tokens": [50365, 467, 307, 295, 572, 764, 2139, 337, 264, 6704, 420, 337, 264, 48020, 14375, 13, 50572], "temperature": 0.0, "avg_logprob": -0.21226197794864052, "compression_ratio": 1.2717391304347827, "no_speech_prob": 0.006485499441623688}, {"id": 92, "seek": 26492, "start": 269.38, "end": 270.66, "text": " It is thrown away.", "tokens": [50588, 467, 307, 11732, 1314, 13, 50652], "temperature": 0.0, "avg_logprob": -0.21226197794864052, "compression_ratio": 1.2717391304347827, "no_speech_prob": 0.006485499441623688}, {"id": 93, "seek": 26492, "start": 271.96000000000004, "end": 275.34000000000003, "text": " He who has ears to hear, let him hear.", "tokens": [50717, 634, 567, 575, 8798, 281, 1568, 11, 718, 796, 1568, 13, 50886], "temperature": 0.0, "avg_logprob": -0.21226197794864052, "compression_ratio": 1.2717391304347827, "no_speech_prob": 0.006485499441623688}], "language": "English"}