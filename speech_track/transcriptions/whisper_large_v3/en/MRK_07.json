345381526104417, "no_speech_prob": 0.002957387128844857}, {"id": 40, "seek": 11700, "start": 135.98, "end": 138.8, "text": " What comes out of a person is what defiles him.", "tokens": [51314, 708, 1487, 484, 295, 257, 954, 307, 437, 1060, 4680, 796, 13, 51455], "temperature": 0.0, "avg_logprob": -0.14442342572507605, "compression_ratio": 1.6345381526104417, "no_speech_prob": 0.002957387128844857}, {"id": 41, "seek": 11700, "start": 139.34, "end": 141.92000000000002, "text": " For from within, out of the heart of man,", "tokens": [51482, 1171, 490, 1951, 11, 484, 295, 264, 1917, 295, 587, 11, 51611], "temperature": 0.0, "avg_logprob": -0.14442342572507605, "compression_ratio": 1.6345381526104417, "no_speech_prob": 0.002957387128844857}, {"id": 42, "seek": 11700, "start": 141.92000000000002, "end": 146.56, "text": " come evil thoughts, sexual immorality, theft, murder, adultery,", "tokens": [51611, 808, 6724, 4598, 11, 6701, 3397, 284, 1860, 11, 28508, 11, 6568, 11, 26885, 12733, 11, 51843], "temperature": 0.0, "avg_logprob": -0.14442342572507605, "compression_ratio": 1.6345381526104417, "no_speech_prob": 0.002957387128844857}, {"id": 43, "seek": 14656, "start": 146.56, "end": 152.98, "text": " coveting, wickedness, deceit, sensuality, envy, slander, pride, foolishness.", "tokens": [50365, 48497, 278, 11, 22663, 1287, 11, 14088, 270, 11, 2923, 901, 507, 11, 30530, 11, 1061, 4483, 11, 10936, 11, 23478, 1287, 13, 50686], "temperature": 0.0, "avg_logprob": -0.11876455661469856, "compression_ratio": 1.6235294117647059, "no_speech_prob": 0.003944565542042255}, {"id": 44, "seek": 14656, "start": 153.42000000000002, "end": 157.98, "text": " All these evil things come from within, and they defile a person.", "tokens": [50708, 1057, 613, 6724, 721, 808, 490, 1951, 11, 293, 436, 1060, 794, 257, 954, 13, 50936], "temperature": 0.0, "avg_logprob": -0.11876455661469856, "compression_ratio": 1.6235294117647059, "no_speech_prob": 0.003944565542042255}, {"id": 45, "seek": 14656, "start": 159.74, "end": 164.04, "text": " And from there he arose and went away to the region of Tyre and Sidon.", "tokens": [51024, 400, 490, 456, 415, 37192, 293, 1437, 1314, 281, 264, 4458, 295, 5569, 265, 293, 19797, 266, 13, 51239], "temperature": 0.0, "avg_logprob": -0.11876455661469856, "compression_ratio": 1.6235294117647059, "no_speech_prob": 0.003944565542042255}, {"id": 46, "seek": 14656, "start": 164.74, "end": 168.74, "text": " And he entered a house and did not want anyone to know, yet he could not be hidden.", "tokens": [51274, 400, 415, 9065, 257, 1782, 293, 630, 406, 528, 2878, 281, 458, 11, 1939, 415, 727, 406, 312, 7633, 13, 51474], "temperature": 0.0, "avg_logprob": -0.11876455661469856, "compression_ratio": 1.6235294117647059, "no_speech_prob": 0.003944565542042255}, {"id": 47, "seek": 14656, "start": 169.46, "end": 173.5, "text": " But immediately a woman whose little daughter had an unclean spirit heard of him", "tokens": [51510, 583, 4258, 257, 3059, 6104, 707, 4653, 632, 364, 9153, 282, 3797, 2198, 295, 796, 51712], "temperature": 0.0, "avg_logprob": -0.11876455661469856, "compression_ratio": 1.6235294117647059, "no_speech_prob": 0.003944565542042255}, {"id": 48, "seek": 14656, "start": 173.5, "end": 175.64000000000001, "text": " and came and fell down at his feet.", "tokens": [51712, 293, 1361, 293, 5696, 760, 412, 702, 3521, 13, 51819], "temperature": 0.0, "avg_logprob": -0.11876455661469856, "compression_ratio": 1.6235294117647059, "no_speech_prob": 0.003944565542042255}, {"id": 49, "seek": 17656, "start": 176.56, "end": 179.64000000000001, "text": " Now the woman was a Gentile, a Syrophoenician by birth.", "tokens": [50365, 823, 264, 3059, 390, 257, 33070, 794, 11, 257, 3902, 11741, 78, 268, 9027, 538, 3965, 13, 50519], "temperature": 0.0, "avg_logprob": -0.19227545601981028, "compression_ratio": 1.7020408163265306, "no_speech_prob": 0.0006931106909178197}, {"id": 50, "seek": 17656, "start": 180.38, "end": 183.08, "text": " And she begged him to cast the demon out of her daughter.", "tokens": [50556, 400, 750, 47653, 796, 281, 4193, 264, 14283, 484, 295, 720, 4653, 13, 50691], "temperature": 0.0, "avg_logprob": -0.19227545601981028, "compression_ratio": 1.7020408163265306, "no_speech_prob": 0.0006931106909178197}, {"id": 51, "seek": 17656, "start": 183.64000000000001, "end": 184.5, "text": " And he said to her,", "tokens": [50719, 400, 415, 848, 281, 720, 11, 50762], "temperature": 0.0, "avg_logprob": -0.19227545601981028, "compression_ratio": 1.7020408163265306, "no_speech_prob": 0.0006931106909178197}, {"id": 52, "seek": 17656, "start": 185.28, "end": 186.98, "text": " Let the children be fed first,", "tokens": [50801, 961, 264, 2227, 312, 4636, 700, 11, 50886], "temperature": 0.0, "avg_logprob": -0.19227545601981028, "compression_ratio": 1.7020408163265306, "no_speech_prob": 0.0006931106909178197}, {"id": 53, "seek": 17656, "start": 187.42000000000002, "end": 191.08, "text": " for it is not right to take the children's bread and throw it to the dogs.", "tokens": [50908, 337, 309, 307, 406, 558, 281, 747, 264, 2227, 311, 5961, 293, 3507, 309, 281, 264, 7197, 13, 51091], "temperature": 0.0, "avg_logprob": -0.19227545601981028, "compression_ratio": 1.7020408163265306, "no_speech_prob": 0.0006931106909178197}, {"id": 54, "seek": 17656, "start": 191.78, "end": 193.32, "text": " But she answered him,", "tokens": [51126, 583, 750, 10103, 796, 11, 51203], "temperature": 0.0, "avg_logprob": -0.19227545601981028, "compression_ratio": 1.7020408163265306, "no_speech_prob": 0.0006931106909178197}, {"id": 55, "seek": 17656, "start": 194.0, "end": 199.74, "text": " Yes, Lord, yet even the dogs under the table eat the children's crumbs.", "tokens": [51237, 1079, 11, 3257, 11, 1939, 754, 264, 7197, 833, 264, 3199, 1862, 264, 2227, 311, 42675, 13, 51524], "temperature": 0.0, "avg_logprob": -0.19227545601981028, "compression_ratio": 1.7020408163265306, "no_speech_prob": 0.0006931106909178197}, {"id": 56, "seek": 17656, "start": 200.38, "end": 201.86, "text": " And he said to her,", "tokens": [51556, 400, 415, 848, 281, 720, 11, 51630], "temperature": 0.0, "avg_logprob": -0.19227545601981028, "compression_ratio": 1.7020408163265306, "no_speech_prob": 0.0006931106909178197}, {"id": 57, "seek": 17656, "start": 202.74, "end": 204.94, "text": " For this statement you may go your way.", "tokens": [51674, 1171, 341, 5629, 291, 815, 352, 428, 636, 13, 51784], "temperature": 0.0, "avg_logprob": -0.19227545601981028, "compression_ratio": 1.7020408163265306, "no_speech_prob": 0.0006931106909178197}, {"id": 58, "seek": 17656, "start": 205.52, "end": 206.54, "text": " The demon has left you.", "tokens": [51813, 440, 14283, 575, 1411, 291, 13, 51864], "temperature": 0.0, "avg_logprob": -0.19227545601981028, "compression_ratio": 1.7020408163265306, "no_speech_prob": 0.0006931106909178197}, {"id": 59, "seek": 20654, "start": 207.42, "end": 211.72, "text": " And she went home and found the child lying in bed and the demon gone.", "tokens": [50409, 400, 750, 1437, 1280, 293, 1352, 264, 1440, 8493, 294, 2901, 293, 264, 14283, 2780, 13, 50624], "temperature": 0.0, "avg_logprob": -0.13372167452113834, "compression_ratio": 1.7272727272727273, "no_speech_prob": 0.017982853576540947}, {"id": 60, "seek": 20654, "start": 212.92, "end": 217.35999999999999, "text": " Then he returned from the region of Tyre and went through Sidon to the Sea of Galilee", "tokens": [50684, 1396, 415, 8752, 490, 264, 4458, 295, 5569, 265, 293, 1437, 807, 19797, 266, 281, 264, 11352, 295, 7336, 33914, 50906], "temperature": 0.0, "avg_logprob": -0.13372167452113834, "compression_ratio": 1.7272727272727273, "no_speech_prob": 0.017982853576540947}, {"id": 61, "seek": 20654, "start": 217.35999999999999, "end": 219.0, "text": " in the region of the Decapolis.", "tokens": [50906, 294, 264, 4458, 295, 264, 1346, 9485, 16466, 13, 50988], "temperature": 0.0, "avg_logprob": -0.13372167452113834, "compression_ratio": 1.7272727272727273, "no_speech_prob": 0.017982853576540947}, {"id": 62, "seek": 20654, "start": 219.89999999999998, "end": 223.44, "text": " And they brought to him a man who was deaf and had a speech impediment,", "tokens": [51033, 400, 436, 3038, 281, 796, 257, 587, 567, 390, 15559, 293, 632, 257, 6218, 22584, 2328, 11, 51210], "temperature": 0.0, "avg_logprob": -0.13372167452113834, "compression_ratio": 1.7272727272727273, "no_speech_prob": 0.017982853576540947}, {"id": 63, "seek": 20654, "start": 223.78, "end": 226.07999999999998, "text": " and they begged him to lay his hand on him.", "tokens": [51227, 293, 436, 47653, 796, 281, 2360, 702, 1011, 322, 796, 13, 51342], "temperature": 0.0, "avg_logprob": -0.13372167452113834, "compression_ratio": 1.7272727272727273, "no_speech_prob": 0.017982853576540947}, {"id": 64, "seek": 20654, "start": 226.85999999999999, "end": 229.07999999999998, "text": " And taking him aside from the crowd privately,", "tokens": [51381, 400, 1940, 796, 7359, 490, 264, 6919, 31919, 11, 51492], "temperature": 0.0, "avg_logprob": -0.13372167452113834, "compression_ratio": 1.7272727272727273, "no_speech_prob": 0.017982853576540947}, {"id": 65, "seek": 20654, "start": 229.44, "end": 233.34, "text": " he put his fingers into his ears and after spitting touched his tongue.", "tokens": [51510, 415, 829, 702, 7350, 666, 702, 8798, 293, 934, 637, 2414, 9828, 702, 10601, 13, 51705], "temperature": 0.0, "avg_logprob": -0.13372167452113834, "compression_ratio": 1.7272727272727273, "no_speech_prob": 0.017982853576540947}, {"id": 66, "seek": 20654, "start": 233.62, "end": 236.34, "text": " And looking up to heaven he sighed and said to him,", "tokens": [51719, 400, 1237, 493, 281, 7162, 415, 29472, 292, 293, 848, 281, 796, 11, 51855], "temperature": 0.0, "avg_logprob": -0.13372167452113834, "compression_ratio": 1.7272727272727273, "no_speech_prob": 0.017982853576540947}, {"id": 67, "seek": 23654, "start": 236.54, "end": 236.78, "text": " And he said to him,", "tokens": [50365, 400, 415, 848, 281, 796, 11, 50377], "temperature": 0.0, "avg_logprob": -0.3304175610812205, "compression_ratio": 1.628440366972477, "no_speech_prob": 0.004284196998924017}, {"id": 68, "seek": 23654, "start": 237.66, "end": 240.1, "text": " Ephatha,", "tokens": [50421, 35445, 29441, 11, 50543], "temperature": 0.0, "avg_logprob": -0.3304175610812205, "compression_ratio": 1.628440366972477, "no_speech_prob": 0.004284196998924017}, {"id": 69, "seek": 23654, "start": 240.94, "end": 241.64, "text": " that is,", "tokens": [50585, 300, 307, 11, 50620], "temperature": 0.0, "avg_logprob": -0.3304175610812205, "compression_ratio": 1.628440366972477, "no_speech_prob": 0.004284196998924017}, {"id": 70, "seek": 23654, "start": 242.38, "end": 244.51999999999998, "text": " be opened.", "tokens": [50657, 312, 5625, 13, 50764], "temperature": 0.0, "avg_logprob": -0.3304175610812205, "compression_ratio": 1.628440366972477, "no_speech_prob": 0.004284196998924017}, {"id": 71, "seek": 23654, "start": 245.39999999999998, "end": 249.48, "text": " And his ears were opened, his tongue was released, and he spoke plainly.", "tokens": [50808, 400, 702, 8798, 645, 5625, 11, 702, 10601, 390, 4736, 11, 293, 415, 7179, 11121, 356, 13, 51012], "temperature": 0.0, "avg_logprob": -0.3304175610812205, "compression_ratio": 1.628440366972477, "no_speech_prob": 0.004284196998924017}, {"id": 72, "seek": 23654, "start": 249.98, "end": 252.42, "text": " And Jesus charged them to tell no one.", "tokens": [51037, 400, 2705, 11109, 552, 281, 980, 572, 472, 13, 51159], "temperature": 0.0, "avg_logprob": -0.3304175610812205, "compression_ratio": 1.628440366972477, "no_speech_prob": 0.004284196998924017}, {"id": 73, "seek": 23654, "start": 252.78, "end": 255.98, "text": " But the more he charged them, the more zealously they proclaimed it.", "tokens": [51177, 583, 264, 544, 415, 11109, 552, 11, 264, 544, 5277, 304, 5098, 436, 49091, 309, 13, 51337], "temperature": 0.0, "avg_logprob": -0.3304175610812205, "compression_ratio": 1.628440366972477, "no_speech_prob": 0.004284196998924017}, {"id": 74, "seek": 23654, "start": 256.3, "end": 258.68, "text": " And they were astonished beyond measure, saying,", "tokens": [51353, 400, 436, 645, 25687, 4729, 4399, 3481, 11, 1566, 11, 51472], "temperature": 0.0, "avg_logprob": -0.3304175610812205, "compression_ratio": 1.628440366972477, "no_speech_prob": 0.004284196998924017}, {"id": 75, "seek": 23654, "start": 259.4, "end": 261.06, "text": " He has done all things well.", "tokens": [51508, 634, 575, 1096, 439, 721, 731, 13, 51591], "temperature": 0.0, "avg_logprob": -0.3304175610812205, "compression_ratio": 1.628440366972477, "no_speech_prob": 0.004284196998924017}, {"id": 76, "seek": 23654, "start": 261.15999999999997, "end": 263.78, "text": " He even makes the deaf hear and the mute speak.", "tokens": [51596, 634, 754, 1669, 264, 15559, 1568, 293, 264, 24523, 1710, 13, 51727], "temperature": 0.0, "avg_logprob": -0.3304175610812205, "compression_ratio": 1.628440366972477, "no_speech_prob": 0.004284196998924017}], "language": "English"}