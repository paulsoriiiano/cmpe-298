1215], "temperature": 0.0, "avg_logprob": -0.2724493571690151, "compression_ratio": 1.671641791044776, "no_speech_prob": 0.01847868040204048}, {"id": 72, "seek": 29712, "start": 314.12, "end": 317.12, "text": " Bimanaw ni Jesus iti dayta alugar,", "tokens": [51215, 363, 25504, 1607, 3867, 2705, 309, 72, 786, 1328, 419, 8307, 11, 51365], "temperature": 0.0, "avg_logprob": -0.2724493571690151, "compression_ratio": 1.671641791044776, "no_speech_prob": 0.01847868040204048}, {"id": 73, "seek": 29712, "start": 317.12, "end": 323.12, "text": " idi magmag na sinurot dagiti dua abulsek alalaki kit impokawda.", "tokens": [51365, 18014, 2258, 37941, 1667, 3343, 374, 310, 15460, 8707, 40173, 410, 19258, 74, 419, 304, 7421, 8260, 704, 453, 1607, 2675, 13, 51665], "temperature": 0.0, "avg_logprob": -0.2724493571690151, "compression_ratio": 1.671641791044776, "no_speech_prob": 0.01847868040204048}, {"id": 74, "seek": 29712, "start": 323.12, "end": 326.12, "text": " Anak ni David, kaasyan na kami!", "tokens": [51665, 1107, 514, 3867, 4389, 11, 6799, 5871, 282, 1667, 34502, 0, 51815], "temperature": 0.0, "avg_logprob": -0.2724493571690151, "compression_ratio": 1.671641791044776, "no_speech_prob": 0.01847868040204048}, {"id": 75, "seek": 32612, "start": 326.12, "end": 328.12, "text": " Kinakastrekan ni Jesus iti balay,", "tokens": [50365, 27950, 514, 525, 265, 5225, 3867, 2705, 309, 72, 3119, 320, 11, 50465], "temperature": 0.0, "avg_logprob": -0.32001719755284924, "compression_ratio": 1.61, "no_speech_prob": 0.0021137038711458445}, {"id": 76, "seek": 32612, "start": 328.12, "end": 331.12, "text": " imasidig kinkuan na dagiti dua abulsek.", "tokens": [50465, 566, 296, 327, 328, 350, 475, 6139, 1667, 15460, 8707, 40173, 410, 19258, 74, 13, 50615], "temperature": 0.0, "avg_logprob": -0.32001719755284924, "compression_ratio": 1.61, "no_speech_prob": 0.0021137038711458445}, {"id": 77, "seek": 32612, "start": 331.12, "end": 335.12, "text": " Patiyen niyo kadi akabailan kayong aagasan?", "