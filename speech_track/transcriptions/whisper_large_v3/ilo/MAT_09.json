: 1.5989304812834224, "no_speech_prob": 0.006732395850121975}, {"id": 105, "seek": 41212, "start": 431.12, "end": 434.12, "text": " Agdawat kayong harot itiakin kukuwa't itimaani,", "tokens": [51315, 2725, 67, 38036, 12446, 556, 2233, 310, 309, 72, 12709, 350, 24164, 4151, 380, 309, 4775, 3782, 11, 51465], "temperature": 0.0, "avg_logprob": -0.2636894952683222, "compression_ratio": 1.5989304812834224, "no_speech_prob": 0.006732395850121975}, {"id": 106, "seek": 41212, "start": 434.12, "end": 437.12, "text": " tap nung mangibaon kadagiti agani.", "tokens": [51465, 5119, 297, 1063, 32432, 17036, 266, 8064, 559, 8707, 623, 3782, 13, 51615], "temperature": 0.0, "avg_logprob": -0.2636894952683222, "compression_ratio": 1.5989304812834224, "no_speech_prob": 0.006732395850121975}], "language": "Tagalog"}