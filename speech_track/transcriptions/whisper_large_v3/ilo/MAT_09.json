onyo.", "tokens": [50915, 669, 656, 45944, 3187, 267, 6799, 15460, 8707, 20975, 2526, 78, 13, 51065], "temperature": 0.0, "avg_logprob": -0.2924496905403848, "compression_ratio": 1.6740088105726871, "no_speech_prob": 0.006640825420618057}, {"id": 94, "seek": 38312, "start": 397.12, "end": 402.12, "text": " Sinursor ni Jesus dagiti amin nga ilili kin Barbaryo,", "tokens": [51065, 11187, 2156, 284, 3867, 2705, 15460, 8707, 669, 259, 297, 3680, 1930, 2312, 15784, 14876, 822, 78, 11, 51315], "temperature": 0.0, "avg_logprob": -0.2924496905403848, "compression_ratio": 1.6740088105726871, "no_speech_prob": 0.006640825420618057}, {"id": 95, "seek": 38312, "start": 402.12, "end": 404.12, "text": " nang isoro kadagiti sinagoga da,", "tokens": [51315, 297, 656, 307, 10780, 8064, 559, 8707, 3343, 559, 9833, 1120, 11, 51415], "temperature": 0.0, "avg_logprob": -0.2924496905403848, "compression_ratio": 1.6740088105726871, "no_speech_prob": 0.006640825420618057}, {"id": 96, "seek": 38312, "start": 404.12, "end": 408.12, "text": " inkasabana tinimbag ka damag maipapan itipagaryan,", "tokens": [51415, 11276, 296, 455, 2095, 15935, 17306, 559, 6799, 2422, 559, 463, 647, 3140, 309, 647, 559, 822, 282, 11, 51615], "temperature": 0.0, "avg_logprob": -0.2924496905403848, "compression_ratio": 1.6740088105726871, "no_speech_prob": 0.006640825420618057}, {"id": 97, "seek": 38312, "start": 408.12, "end": 412.12, "text": " kin pinaimbag na dagiti tataw kadagiti amin nakita ti sakit,", "tokens": [51615, 15784, 280, 1426, 17306, 559, 1667, 15460, 8707, 9600, 1607, 8064, 559, 8707, 669, 259, 20332, 2786, 8757, 23366, 270, 11, 51815], "temperature": 0.0, "avg_logprob": -0.2924496905403848, "compression_ratio": 1.6740088105726871, "no_speech_prob": 0.006640825420618057}, {"id": 98, "seek": 41212, "start": 412.12, "end": 414.12, "text": " kin sagabaen.", "tokens": [50365, 15784, 15274, 5509, 268, 13, 50465], "temperature": 0.0, "avg_logprob": -0.2636894952683222, "compression_ratio": 1.59893048128