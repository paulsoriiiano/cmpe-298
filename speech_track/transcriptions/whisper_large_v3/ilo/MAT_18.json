89221556, "no_speech_prob": 0.06521543860435486}, {"id": 36, "seek": 17418, "start": 186.32, "end": 190.22, "text": " Inka ken kwa na kahit ilawlawag mo tinagbasulan na.", "tokens": [50972, 682, 2330, 18787, 350, 4151, 1667, 21651, 270, 1930, 1607, 5901, 559, 705, 15935, 559, 16342, 40701, 1667, 13, 51167], "temperature": 0.0, "avg_logprob": -0.3256573714609221, "compression_ratio": 1.6347305389221556, "no_speech_prob": 0.06521543860435486}, {"id": 37, "seek": 17418, "start": 191.38, "end": 193.78, "text": " Ngam aramidom na itoy nududwa kayo.", "tokens": [51225, 21198, 335, 594, 335, 327, 298, 1667, 309, 939, 40045, 532, 4151, 12446, 78, 13, 51345], "temperature": 0.0, "avg_logprob": -0.3256573714609221, "compression_ratio": 1.6347305389221556, "no_speech_prob": 0.06521543860435486}, {"id": 38, "seek": 17418, "start": 195.3, "end": 196.06, "text": " Nungagken ka.", "tokens": [51421, 426, 1063, 559, 2653, 6799, 13, 51459], "temperature": 0.0, "avg_logprob": -0.3256573714609221, "compression_ratio": 1.6347305389221556, "no_speech_prob": 0.06521543860435486}, {"id": 39, "seek": 17418, "start": 197.24, "end": 199.02, "text": " Napasublimon tikabsat mo.", "tokens": [51518, 18287, 296, 836, 4197, 266, 256, 1035, 17243, 267, 705, 13, 51607], "temperature": 0.0, "avg_logprob": -0.3256573714609221, "compression_ratio": 1.6347305389221556, "no_speech_prob": 0.06521543860435486}, {"id": 40, "seek": 17418, "start": 200.22, "end": 202.38, "text": " Ngam nudinaaklunin tibasol na.", "tokens": [51667, 21198, 335, 40045, 1426, 514, 75, 409, 259, 256, 897, 296, 401, 1667, 13, 51775], "temperature": 0.0, "avg_logprob": -0.3256573714609221, "compression_ratio": 1.6347305389221556, "no_speech_prob": 0.06521543860435486}, {"id": 41, "seek": 20238, "start": 202.38, "end": 210.57999999999998, "text": " Mang hikuyog ka itimaysa uinudwa akadwam tap nukas na ilanad itinasantuan asurat.", "tokens": [50365, 35487, 276, 1035, 7493, 664, 6799, 309, 332, 3772, 64, 344, 259, 532, 4151, 9308, 345, 86, 335, 5119, 297, 2034, 296, 1667, 1930, 282, 345, 309, 17094, 394, 6139, 382, 44108, 13, 50775], "temperature": 0.0, "avg_logprob": -0.3388448254815463, "compression_ratio": 1.544378698224852, "no_speech_prob": 0.012450370006263256}, {"id": 42, "seek": 20238, "start": 211.7, "end": 219.62, "text": " Mapatalgadan ti amin apamabasol babaan itipamanaknag itidwa uinutalo asaksi.", "tokens": [50831, 22053, 40478, 70, 11338, 8757, 669, 259, 1882, 335, 455, 296, 401, 31568, 282, 309, 647, 6147, 514, 77, 559, 309, 327, 4151, 344, 259, 325, 10334, 382, 45042, 13, 51227], "temperature": 0.0, "avg_logprob": -0.3388448254815463, "compression_ratio": 1.544378698224852, "no_speech_prob": 0.012450370006263256}, {"id": 43, "seek": 20238, "start": 221.01999999999998, "end": 222.54, "text": " Ngam nudina dingganida.", "tokens": [51297, 21198, 335, 40045, 1426, 21211, 1275, 2887, 13, 51373], "temperature": 0.0, "avg_logprob": -0.3388448254815463, "compression_ratio": 1.544378698224852, "no_speech_prob": 0.012450370006263256}, {"id": 44, "seek": 20238, "start": 223.72, "end": 225.2, "text": " Ipakaamom iti iglesia.", "tokens": [51432, 286, 79, 7849, 335, 298, 309, 72, 8508, 48507, 13, 51506], "temperature": 0.0, "avg_logprob": -0.3388448254815463, "compression_ratio": 1.544378698224852, "no_speech_prob": 0.012450370006263256}, {"id": 45, "seek": 20238, "start": 226.66, "end": 228.76, "text": " Ket nudinalatadenggan tiglesa.", "tokens": [51579, 591, 302, 40045, 2071, 267, 345, 1501, 1275, 256, 328, 904, 64, 13, 51684], "temperature": 0.0, "avg_logprob": -0.3388448254815463, "compression_ratio": 1.544378698224852, "no_speech_prob": 0.012450370006263256}, {"id": 46, "seek": 20238, "start": 229.56, "end": 231.76, "text": " Ibilang monday takabsat.", "tokens": [51724, 286, 15384, 656, 17606, 320, 991, 17243, 267, 13, 51834], "temperature": 0.0, "avg_logprob": -0.3388448254815463, "compression_ratio": 1.544378698224852, "no_speech_prob": 0.012450370006263256}, {"id": 47, "seek": 23238, "start": 232.38, "end": 234.07999999999998, "text": " Tapos may saaganggan na et.", "tokens": [50365, 13445, 329, 815, 601, 559, 656, 1275, 1667, 1030, 13, 50450], "temperature": 0.0, "avg_logprob": -0.3121512449240383, "compression_ratio": 1.8806818181818181, "no_speech_prob": 0.01220779586583376}, {"id": 48, "seek": 23238, "start": 234.68, "end": 236.64, "text": " When noagsingsinir itibuis.", "tokens": [50480, 1133, 572, 12109, 1109, 259, 347, 309, 897, 8479, 13, 50578], "temperature": 0.0, "avg_logprob": -0.3121512449240383, "compression_ratio": 1.8806818181818181, "no_speech_prob": 0.01220779586583376}, {"id": 49, "seek": 23238, "start": 237.38, "end": 238.85999999999999, "text": " Ibagak narod kada kayo.", "tokens": [50615, 286, 17282, 514, 6714, 378, 350, 1538, 12446, 78, 13, 50689], "temperature": 0.0, "avg_logprob": -0.3121512449240383, "compression_ratio": 1.8806818181818181, "no_speech_prob": 0.01220779586583376}, {"id": 50, "seek": 23238, "start": 239.62, "end": 241.84, "text": " Ti anyaman nga iparit yu dito'y daga.", "tokens": [50727, 20456, 604, 6147, 297, 3680, 28501, 289, 270, 288, 84, 274, 3528, 6, 88, 274, 9286, 13, 50838], "temperature": 0.0, "avg_logprob": -0.3121512449240383, "compression_ratio": 1.8806818181818181, "no_speech_prob": 0.01220779586583376}, {"id": 51, "seek": 23238, "start": 242.76, "end": 244.7, "text": " Maiparit tumet ijay langit.", "tokens": [50884, 4042, 647, 289, 270, 13102, 302, 741, 46451, 2265, 270, 13, 50981], "temperature": 0.0, "avg_logprob": -0.3121512449240383, "compression_ratio": 1.8806818181818181, "no_speech_prob": 0.01220779586583376}, {"id": 52, "seek": 23238, "start": 245.7, "end": 248.1, "text": " Ket ti anyaman nga ipalubos yu dito'y daga.", "tokens": [51031, 591, 302, 8757, 604, 6147, 297, 3680, 28501, 304, 836, 329, 288, 84, 274, 3528, 6, 88, 274, 9286, 13, 51151], "temperature": 0.0, "avg_logprob": -0.3121512449240383, "compression_ratio": 1.8806818181818181, "no_speech_prob": 0.01220779586583376}, {"id": 53, "seek": 23238, "start": 249.46, "end": 251.42, "text": " Maipalubos tumet ijay langit.", "tokens": [51219, 4042, 647, 304, 836, 329, 13102, 302, 741, 46451, 2265, 270, 13, 51317], "temperature": 0.0, "avg_logprob": -0.3121512449240383, "compression_ratio": 1.8806818181818181, "no_speech_prob": 0.01220779586583376}, {"id": 54, "seek": 23238, "start": 252.8, "end": 254.28, "text": " At dapat ibagak kada kayo.", "tokens": [51386, 1711, 35161, 741, 17282, 514, 350, 1538, 12446, 78, 13, 51460], "temperature": 0.0, "avg_logprob": -0.3121512449240383, "compression_ratio": 1.8806818181818181, "no_speech_prob": 0.01220779586583376}, {"id": 55, "seek": 23238, "start": 255.78, "end": 258.3, "text": " Nupagnumuan ti dua kada kayo dito'y daga.", "tokens": [51535, 426, 1010, 4535, 449, 6139, 8757, 40173, 350, 1538, 12446, 78, 274, 3528, 6, 88, 274, 9286, 13, 51661], "temperature": 0.0, "avg_logprob": -0.3121512449240383, "compression_ratio": 1.8806818181818181, "no_speech_prob": 0.01220779586583376}, {"id": 56, "seek": 23238, "start": 258.48, "end": 260.1, "text": " Ti anyaman adawaten nyo.", "tokens": [51670, 20456, 604, 6147, 11063, 86, 7186, 297, 8308, 13, 51751], "temperature": 0.0, "avg_logprob": -0.3121512449240383, "compression_ratio": 1.8806818181818181, "no_speech_prob": 0.01220779586583376}, {"id": 57, "seek": 23238, "start": 261.26, "end": 262.36, "text": " Itedto kada kayo.", "tokens": [51809, 467, 292, 1353, 350, 1538, 12446, 78, 13, 51864], "temperature": 0.0, "avg_logprob": -0.3121512449240383, "compression_ratio": 1.8806818181818181, "no_speech_prob": 0.01220779586583376}, {"id": 58, "seek": 26238, "start": 262.38, "end": 263.86, "text": " Itedto ni ama sa dilangit.", "tokens": [50365, 467, 292, 1353, 3867, 10889, 601, 11504, 656, 270, 13, 50439], "temperature": 0.6000000000000001, "avg_logprob": -0.5083234986262535, "compression_ratio": 1.5, "no_speech_prob": 0.009258896112442017}, {"id": 59, "seek": 26238, "start": 265.08, "end": 266.96, "text": " Tanusadino ti ayan ti dua.", "tokens": [50500, 17046, 301, 345, 2982, 8757, 257, 6277, 8757, 40173, 13, 50594], "temperature": 0.6000000000000001, "avg_logprob": -0.5083234986262535, "compression_ratio": 1.5, "no_speech_prob": 0.009258896112442017}, {"id": 60, "seek": 26238, "start": 267.65999999999997, "end": 270.4, "text": " Uinutalo nga ako umong ga po itinagan ko.", "tokens": [50629, 624, 259, 325, 10334, 297, 3680, 43567, 1105, 556, 5959, 714, 309, 259, 14167, 8384, 13, 50766], "temperature": 0.6000000000000001, "avg_logprob": -0.5083234986262535, "compression_ratio": 1.5, "no_speech_prob": 0.009258896112442017}, {"id": 61, "seek": 26238, "start": 271.06, "end": 273.28, "text": " At daa kada kwada sa djay.", "tokens": [50799, 1711, 1120, 64, 350, 1538, 23846, 1538, 601, 274, 46451, 13, 50910], "temperature": 0.6000000000000001, "avg_logprob": -0.5083234986262535, "compression_ratio": 1.5, "no_speech_prob": 0.009258896112442017}, {"id": 62, "seek": 26238, "start": 275.32, "end": 277.08, "text": " Napan ni Pedro kine Jesus.", "tokens": [51012, 426, 3140, 3867, 26662, 350, 533, 2705, 13, 51100], "temperature": 0.6000000000000001, "avg_logprob": -0.5083234986262535, "compression_ratio": 1.5, "no_speech_prob": 0.009258896112442017}, {"id": 63, "seek": 26238, "start": 277.44, "end": 278.58, "text": " Ket sinalutsod na.", "tokens": [51118, 591, 302, 262, 2071, 3648, 378, 1667, 13, 51175], "temperature": 0.6000000000000001, "avg_logprob": -0.5083234986262535, "compression_ratio": 1.5, "no_speech_prob": 0.009258896112442017}, {"id": 64, "seek": 26238, "start": 279.21999999999997, "end": 279.76, "text": " Apo.", "tokens": [51207, 316, 2259, 13, 51234], "temperature": 0.6000000000000001, "avg_logprob": -0.5083234986262535, "compression_ratio": 1.5, "no_speech_prob": 0.009258896112442017}, {"id": 65, "seek": 26238, "start": 280.68, "end": 283.21999999999997, "text": " Mamin ano apakawanak ti kabsat ko", "tokens": [51280, 376, 7428, 19816, 1882, 514, 1607, 282, 514, 8757, 350, 17243, 267, 8384, 51407], "temperature": 0.6000000000000001, "avg_logprob": -0.5083234986262535, "compression_ratio": 1.5, "no_speech_prob": 0.009258896112442017}, {"id": 66, "seek": 26238, "start": 283.21999999999997, "end": 285.64, "text": " nga agbas basol kanyak.", "tokens": [51407, 297, 3680, 623, 16342, 987, 401, 350, 1325, 514, 13, 51528], "temperature": 0.6000000000000001, "avg_logprob": -0.5083234986262535, "compression_ratio": 1.5, "no_speech_prob": 0.009258896112442017}, {"id": 67, "seek": 26238, "start": 286.24, "end": 287.0, "text": " Mamin pito.", "tokens": [51558, 376, 7428, 280, 3528, 13, 51596], "temperature": 0.6000000000000001, "avg_logprob": -0.5083234986262535, "compression_ratio": 1.5, "no_speech_prob": 0.009258896112442017}, {"id": 68, "seek": 26238, "start": 287.8, "end": 289.0, "text": " Kinunan ni Jesus.", "tokens": [51636, 27950, 409, 282, 3867, 2705, 13, 51696], "temperature": 0.6000000000000001, "avg_logprob": -0.5083234986262535, "compression_ratio": 1.5, "no_speech_prob": 0.009258896112442017}, {"id": 69, "seek": 26238, "start": 289.94, "end": 291.82, "text": " Saan laeng amamin pito?", "tokens": [51743, 6299, 282, 635, 1501, 669, 7428, 280, 3528, 30, 51837], "temperature": 0.6000000000000001, "avg_logprob": -0.5083234986262535, "compression_ratio": 1.5, "no_speech_prob": 0.009258896112442017}, {"id": 70, "seek": 29238, "start": 292.38, "end": 300.18, "text": " Nudiket mamimpitupulo apito, tatipagaryan ti langit mayarig itikastoy.", "tokens": [50365, 426, 532, 1035, 302, 13524, 8814, 270, 1010, 13455, 1882, 3528, 11, 9600, 647, 559, 822, 282, 8757, 2265, 270, 815, 289, 328, 309, 1035, 525, 939, 13, 50755], "temperature": 0.0, "avg_logprob": -0.2814357221619157, "compression_ratio": 1.606936416184971, "no_speech_prob": 0.033694978803396225}, {"id": 71, "seek": 29238, "start": 301.21999999999997, "end": 307.58, "text": " At daidi may sangaari anang ikadeng amakikwenta kadagitiagsir sirbi kenkwana.", "tokens": [50807, 1711, 1120, 12716, 815, 9980, 64, 3504, 364, 656, 4320, 345, 1501, 669, 514, 1035, 86, 8938, 8064, 559, 8707, 12109, 347, 4735, 5614, 18787, 74, 86, 2095, 13, 51125], "temperature": 0.0, "avg_logprob": -0.2814357221619157, "compression_ratio": 1.606936416184971, "no_speech_prob": 0.033694978803396225}, {"id": 72, "seek": 29238, "start": 308.5, "end": 310.12, "text": " Idimang rugi amakikwenta.", "tokens": [51171, 11506, 332, 656, 18329, 72, 669, 514, 1035, 86, 8938, 13, 51252], "temperature": 0.0, "avg_logprob": -0.2814357221619157, "compression_ratio": 1.606936416184971, "no_speech_prob": 0.033694978803396225}, {"id": 73, "seek": 29238, "start": 311.15999999999997, "end": 317.0, "text": " Inyagdakenkwana ti may sangaadipan anakautang itisangapulo ribu at alento.", "tokens": [51304, 682, 88, 559, 67, 9846, 74, 86, 2095, 8757, 815, 9980, 64, 345, 647, 282, 38042, 1375, 656, 309, 271, 656, 569, 13455, 9162, 84, 412, 419, 15467, 13, 51596], "temperature": 0.0, "avg_logprob": -0.2814357221619157, "compression_ratio": 1.606936416184971, "no_speech_prob": 0.033694978803396225}, {"id": 74, "seek": 29238, "start": 318.38, "end": 320.44, "text": " Awan ti umanay apagbayad na.", "tokens": [51665, 6381, 282, 8757, 1105, 282, 320, 1882, 559, 42484, 345, 1667, 13, 51768], "temperature": 0.0, "avg_logprob": -0.2814357221619157, "compression_ratio": 1.606936416184971, "no_speech_prob": 0.033694978803396225}, {"id": 75, "seek": 32044, "start": 320.44, "end": 322.44, "text": " Tap no makabayad?", "tokens": [50365, 13445, 572, 963, 455, 320, 345, 30, 50465], "temperature": 0.0, "avg_logprob": -0.29690430164337156, "compression_ratio": 0.68, "no_speech_prob": 0.009862557053565979}, {"id": 76, "seek": 35044, "start": 350.44, "end": 352.7, "text": " Utang na, sana pinagawid.", "tokens": [50365, 12555, 656, 1667, 11, 15490, 5447, 559, 1607, 327, 13, 50478], "temperature": 0.0, "avg_logprob": -0.22740796304518177, "compression_ratio": 1.558659217877095, "no_speech_prob": 0.08022608608007431}, {"id": 77, "seek": 35044, "start": 353.44, "end": 354.66, "text": " Rimuar ti lalaki.", "tokens": [50515, 44034, 20766, 8757, 287, 304, 7421, 13, 50576], "temperature": 0.0, "avg_logprob": -0.22740796304518177, "compression_ratio": 1.558659217877095, "no_speech_prob": 0.08022608608007431}, {"id": 78, "seek": 35044, "start": 356.32, "end": 361.82, "text": " Nasarakan na tipada nang aadipan anakautang kenkwana itisangagasot adinaryo.", "tokens": [50659, 16151, 289, 14910, 1667, 4125, 1538, 297, 656, 257, 345, 647, 282, 38042, 1375, 656, 18787, 74, 86, 2095, 309, 271, 656, 559, 296, 310, 614, 259, 822, 78, 13, 50934], "temperature": 0.0, "avg_logprob": -0.22740796304518177, "compression_ratio": 1.558659217877095, "no_speech_prob": 0.08022608608007431}, {"id": 79, "seek": 35044, "start": 363.06, "end": 365.24, "text": " Tiniliw na, sana binagkal.", "tokens": [50996, 47741, 2312, 86, 1667, 11, 15490, 5171, 559, 19990, 13, 51105], "temperature": 0.0, "avg_logprob": -0.22740796304518177, "compression_ratio": 1.558659217877095, "no_speech_prob": 0.08022608608007431}, {"id": 80, "seek": 35044, "start": 366.68, "end": 369.2, "text": " Bayadam ti utang mo, kinunana.", "tokens": [51177, 7840, 345, 335, 8757, 2839, 656, 705, 11, 15784, 409, 2095, 13, 51303], "temperature": 0.0, "avg_logprob": -0.22740796304518177, "compression_ratio": 1.558659217877095, "no_speech_prob": 0.08022608608007431}, {"id": 81, "seek": 35044, "start": 370.82, "end": 375.48, "text": " Nagparintumang tinakautang, kaya't nagpakpakaas si kenkwana.", "tokens": [51384, 18913, 2181, 686, 449, 656, 15935, 514, 1375, 656, 11, 350, 4427, 380, 17096, 45944, 79, 7849, 296, 1511, 18787, 74, 86, 2095, 13, 51617], "temperature": 0.0, "avg_logprob": -0.22740796304518177, "compression_ratio": 1.558659217877095, "no_speech_prob": 0.08022608608007431}, {"id": 82, "seek": 35044, "start": 376.08, "end": 379.48, "text": " Anusan na kadi, taagbayad ak tumatlaan.", "tokens": [51647, 1107, 39634, 1667, 350, 5688, 11, 1846, 559, 42484, 345, 9308, 13102, 267, 875, 282, 13, 51817], "temperature": 0.0, "avg_logprob": -0.22740796304518177, "compression_ratio": 1.558659217877095, "no_speech_prob": 0.08022608608007431}, {"id": 83, "seek": 38044, "start": 381.28, "end": 384.46, "text": " Di na pinatgan ti daw at tipada nang aadipan.", "tokens": [50407, 8789, 1667, 5447, 267, 1275, 8757, 43438, 412, 4125, 1538, 297, 656, 257, 345, 647, 282, 13, 50566], "temperature": 0.0, "avg_logprob": -0.22950632517574399, "compression_ratio": 1.65, "no_speech_prob": 0.025302071124315262}, {"id": 84, "seek": 38044, "start": 386.32, "end": 390.52, "text": " Pinaibalod na kit di, aging ga amabayadan na ti utang na.", "tokens": [50659, 430, 1426, 34764, 378, 1667, 8260, 1026, 11, 623, 278, 5959, 669, 455, 320, 11338, 1667, 8757, 2839, 656, 1667, 13, 50869], "temperature": 0.0, "avg_logprob": -0.22950632517574399, "compression_ratio": 1.65, "no_speech_prob": 0.025302071124315262}, {"id": 85, "seek": 38044, "start": 392.26, "end": 397.02, "text": " Nagladingit dagitidad do mga aadipan, idimakita dati na pasama.", "tokens": [50956, 18913, 75, 8166, 270, 15460, 270, 4580, 360, 275, 3680, 257, 345, 647, 282, 11, 4496, 332, 514, 2786, 1137, 72, 1667, 1736, 2404, 13, 51194], "temperature": 0.0, "avg_logprob": -0.22950632517574399, "compression_ratio": 1.65, "no_speech_prob": 0.025302071124315262}, {"id": 86, "seek": 38044, "start": 398.28, "end": 402.36, "text": " Napanda iti ari, kaya't impulong da amin kenkwana.", "tokens": [51257, 18287, 5575, 309, 72, 257, 470, 11, 350, 4427, 380, 704, 425, 556, 1120, 669, 259, 18787, 74, 86, 2095, 13, 51461], "temperature": 0.0, "avg_logprob": -0.22950632517574399, "compression_ratio": 1.65, "no_speech_prob": 0.025302071124315262}, {"id": 87, "seek": 38044, "start": 403.24, "end": 406.32, "text": " Ngarot, pinayaban ti ari ti aadipan.", "tokens": [51505, 426, 2976, 310, 11, 5447, 320, 18165, 8757, 257, 470, 8757, 257, 345, 647, 282, 13, 51659], "temperature": 0.0, "avg_logprob": -0.22950632517574399, "compression_ratio": 1.65, "no_speech_prob": 0.025302071124315262}, {"id": 88, "seek": 38044, "start": 407.36, "end": 410.32, "text": " Kinunana, nagdakis kakit din nga aadipan.", "tokens": [51711, 27950, 409, 2095, 11, 17096, 67, 39128, 350, 514, 270, 3791, 297, 3680, 257, 345, 647, 282, 13, 51859], "temperature": 0.0, "avg_logprob": -0.22950632517574399, "compression_ratio": 1.65, "no_speech_prob": 0.025302071124315262}, {"id": 89, "seek": 41044, "start": 411.28, "end": 415.32, "text": " Pinakawan ko ti amin nga utang mo, agsipod ta nagpakpakaasika.", "tokens": [50407, 22619, 514, 41814, 8384, 8757, 669, 259, 297, 3680, 2839, 656, 705, 11, 623, 82, 647, 378, 1846, 17096, 45944, 79, 7849, 296, 5439, 13, 50609], "temperature": 0.0, "avg_logprob": -0.20200492240287163, "compression_ratio": 1.70935960591133, "no_speech_prob": 0.02269081398844719}, {"id": 90, "seek": 41044, "start": 416.71999999999997, "end": 421.68, "text": " Kinaasyam met kumatipadam nga aadipan, akas itipan ang ngaasik kenka.", "tokens": [50679, 591, 1426, 5871, 335, 1131, 350, 449, 267, 647, 345, 335, 297, 3680, 257, 345, 647, 282, 11, 9308, 296, 309, 647, 282, 2562, 297, 3680, 296, 1035, 18787, 2330, 13, 50927], "temperature": 0.0, "avg_logprob": -0.20200492240287163, "compression_ratio": 1.70935960591133, "no_speech_prob": 0.02269081398844719}, {"id": 91, "seek": 41044, "start": 422.78, "end": 431.84, "text": " Itinapalalo apong to ti ari, pinayibalod na ti aadipan, tap no madusa, aging ga amabayadan na ti amin nga utang na.", "tokens": [50982, 467, 259, 569, 304, 10334, 1882, 556, 281, 8757, 257, 470, 11, 5447, 320, 34764, 378, 1667, 8757, 257, 345, 647, 282, 11, 5119, 572, 5244, 20318, 11, 623, 278, 5959, 669, 455, 320, 11338, 1667, 8757, 669, 259, 297, 3680, 2839, 656, 1667, 13, 51435], "temperature": 0.0, "avg_logprob": -0.20200492240287163, "compression_ratio": 1.70935960591133, "no_speech_prob": 0.02269081398844719}, {"id": 92, "seek": 41044, "start": 432.52, "end": 434.62, "text": " Kalpasan na, kinunani Jesus.", "tokens": [51469, 12655, 20990, 282, 1667, 11, 15784, 409, 3782, 2705, 13, 51574], "temperature": 0.0, "avg_logprob": -0.20200492240287163, "compression_ratio": 1.70935960591133, "no_speech_prob": 0.02269081398844719}, {"id": 93, "seek": 41044, "start": 435.32, "end": 440.22, "text": " Kastan to ti aramidin ni amak sa dilangit, ititunggal may sakadakayo.", "tokens": [51609, 591, 525, 282, 281, 8757, 594, 335, 327, 259, 3867, 669, 514, 601, 11504, 656, 270, 11, 309, 35563, 9800, 815, 23366, 345, 514, 48947, 13, 51854], "temperature": 0.0, "avg_logprob": -0.20200492240287163, "compression_ratio": 1.70935960591133, "no_speech_prob": 0.02269081398844719}, {"id": 94, "seek": 44044, "start": 440.8, "end": 444.14, "text": " No, itipuso yo, di yo pakawanan, tikapsat yo.", "tokens": [50383, 883, 11, 309, 647, 24431, 5290, 11, 1026, 5290, 20843, 1607, 29915, 11, 44994, 2382, 267, 5290, 13, 50550], "temperature": 0.0, "avg_logprob": -0.37204504013061523, "compression_ratio": 0.9183673469387755, "no_speech_prob": 0.0018299536313861609}, {"id": 95, "seek": 44414, "start": 444.14, "end": 446.14, "text": " Itipuso yo, di yo pakawanan, tikapsat yo.", "tokens": [50365, 467, 647, 24431, 5290, 11, 1026, 5290, 20843, 1607, 29915, 11, 44994, 2382, 267, 5290, 13, 50465], "temperature": 0.0, "avg_logprob": -0.4379411496614155, "compression_ratio": 0.8913043478260869, "no_speech_prob": 0.721178412437439}], "language": "Tagalog"}