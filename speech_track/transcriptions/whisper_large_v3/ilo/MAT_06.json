764027119}, {"id": 38, "seek": 13780, "start": 137.8, "end": 141.74, "text": " Akas iti pang makawan mi kadagiti nakabasol kada kami.", "tokens": [50365, 9629, 296, 309, 72, 280, 656, 963, 41814, 2752, 8064, 559, 8707, 20332, 455, 296, 401, 350, 1538, 34502, 13, 50562], "temperature": 0.0, "avg_logprob": -0.29592673660170105, "compression_ratio": 1.941860465116279, "no_speech_prob": 0.1132633313536644}, {"id": 39, "seek": 13780, "start": 142.94, "end": 145.48000000000002, "text": " Di nakam iturong itinakaro apakasuutan.", "tokens": [50622, 8789, 20332, 335, 309, 374, 556, 309, 259, 514, 9708, 1882, 514, 45612, 30624, 13, 50749], "temperature": 0.0, "avg_logprob": -0.29592673660170105, "compression_ratio": 1.941860465116279, "no_speech_prob": 0.1132633313536644}, {"id": 40, "seek": 13780, "start": 146.76000000000002, "end": 149.16000000000003, "text": " Ili si nakamikit di itimanagdakdakes.", "tokens": [50813, 286, 2081, 1511, 20332, 335, 48183, 1026, 309, 25504, 559, 67, 514, 67, 3419, 13, 50933], "temperature": 0.0, "avg_logprob": -0.29592673660170105, "compression_ratio": 1.941860465116279, "no_speech_prob": 0.1132633313536644}, {"id": 41, "seek": 13780, "start": 150.68, "end": 153.06, "text": " No pakawanin nyo dagiti nakabasol kada kayo,", "tokens": [51009, 883, 20843, 41814, 259, 297, 8308, 15460, 8707, 20332, 455, 296, 401, 350, 1538, 12446, 78, 11, 51128], "temperature": 0.0, "avg_logprob": -0.29592673660170105, "compression_ratio": 1.941860465116279, "no_speech_prob": 0.1132633313536644}, {"id": 42, "seek": 13780, "start": 154.18, "end": 156.98000000000002, "text": " Pakawanin na kay tumet ni amayo sa dilangit.", "tokens": [51184, 11543, 41814, 259, 1667, 12446, 13102, 302, 3867, 669, 48947, 601, 11504, 656, 270, 13, 51324], "temperature": 0.0, "avg_logprob": -0.29592673660170105, "compression_ratio": 1.941860465116279, "no_speech_prob": 0.1132633313536644}, {"id": 43, "seek": 13780, "start": 157.98000000000002, "end": 161.20000000000002, "text": " Ngem, no diyo pakawanin dagiti nakabasol kada kayo,", "tokens": [51374, 21198, 443, 11, 572, 1026, 8308, 20843, 41814, 259, 15460, 8707, 20332, 455, 296, 401, 350, 1538, 12446, 78, 11, 51535], "temperature": 0.0, "avg_logprob": -0.29592673660170105, "compression_ratio": 1.941860465116279, "no_speech_prob": 0.1132633313536644}, {"id": 44, "seek": 13780, "start": 162.16000000000003, "end": 165.54000000000002, "text": " Din tumet pakawanin ni amayo dagiti basbasol yo.", "tokens": [51583, 27156, 13102, 302, 20843, 41814, 259, 3867, 669, 48947, 15460, 8707, 987, 16342, 401, 5290, 13, 51752], "temperature": 0.0, "avg_logprob": -0.29592673660170105, "compression_ratio": 1.941860465116279, "no_speech_prob": 0.1132633313536644}, {"id": 45, "seek": 13780, "start": 166.92000000000002, "end": 167.64000000000001, "text": " Noong ito,", "tokens": [51821, 883, 556, 309, 78, 11, 51857], "temperature": 0.0, "avg_logprob": -0.29592673660170105, "compression_ratio": 1.941860465116279, "no_speech_prob": 0.1132633313536644}, {"id": 46, "seek": 16764, "start": 167.64, "end": 168.67999999999998, "text": " Noagayan nar kayo.", "tokens": [50365, 883, 559, 320, 282, 6714, 12446, 78, 13, 50417], "temperature": 0.0, "avg_logprob": -0.3487111871892756, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.17797788977622986}, {"id": 47, "seek": 16764, "start": 169.94, "end": 173.45999999999998, "text": " Di kayag parang analiday akas kadagiti aginsisingpwet,", "tokens": [50480, 8789, 12446, 559, 971, 656, 2624, 4708, 9308, 296, 8064, 559, 8707, 623, 1292, 3436, 79, 86, 302, 11, 50656], "temperature": 0.0, "avg_logprob": -0.3487111871892756, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.17797788977622986}, {"id": 48, "seek": 16764, "start": 174.05999999999997, "end": 175.98, "text": " Tagpamarangda anakakaasi,", "tokens": [50686, 11204, 79, 45207, 656, 2675, 38042, 7849, 8483, 11, 50782], "temperature": 0.0, "avg_logprob": -0.3487111871892756, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.17797788977622986}, {"id": 49, "seek": 16764, "start": 176.6, "end": 179.45999999999998, "text": " Tap numaamuan nagititatao na agay ayonarda.", "tokens": [50813, 13445, 29080, 335, 6139, 17096, 270, 270, 3274, 78, 1667, 623, 320, 7494, 266, 19218, 13, 50956], "temperature": 0.0, "avg_logprob": -0.3487111871892756, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.17797788977622986}, {"id": 50, "seek": 16764, "start": 180.55999999999997, "end": 183.5, "text": " Laglagay po nyo na inawat dan tigong gunada.", "tokens": [51011, 24886, 27298, 320, 714, 297, 8308, 1667, 294, 38036, 3277, 256, 328, 556, 3874, 1538, 13, 51158], "temperature": 0.0, "avg_logprob": -0.3487111871892756, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.17797788977622986}, {"id": 51, "seek": 16764, "start": 184.66, "end": 185.89999999999998, "text": " Ngem, noagayonarka.", "tokens": [51216, 21198, 443, 11, 572, 559, 320, 266, 809, 64, 13, 51278], "temperature": 0.0, "avg_logprob": -0.3487111871892756, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.17797788977622986}, {"id": 52, "seek": 16764, "start": 186.92, "end": 189.72, "text": " Agdiram uska katsagaysayam tibuok mo,", "tokens": [51329, 2725, 35043, 335, 505, 2330, 350, 1720, 559, 3772, 320, 335, 256, 897, 84, 453, 705, 11, 51469], "temperature": 0.0, "avg_logprob": -0.3487111871892756, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.17797788977622986}, {"id": 53, "seek": 16764, "start": 190.38, "end": 192.88, "text": " Tap nuawan makadlaw na agay ayonarka.", "tokens": [51502, 13445, 3822, 41814, 963, 345, 5901, 1667, 623, 320, 7494, 266, 809, 64, 13, 51627], "temperature": 0.0, "avg_logprob": -0.3487111871892756, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.17797788977622986}, {"id": 54, "seek": 16764, "start": 193.89999999999998, "end": 196.51999999999998, "text": " Nilalang amam adimakita timakam mo.", "tokens": [51678, 47398, 304, 656, 669, 335, 614, 332, 514, 2786, 524, 514, 335, 705, 13, 51809], "temperature": 0.0, "avg_logprob": -0.3487111871892756, "compression_ratio": 1.6326530612244898, "no_speech_prob": 0.17797788977622986}, {"id": 55, "seek": 19652, "start": 196.52, "end": 200.64000000000001, "text": " Ket iso ang makaimatang itiaramid mo analimit.", "tokens": [50365, 591, 302, 307, 78, 2562, 963, 64, 33862, 656, 309, 9448, 335, 327, 705, 2624, 332, 270, 13, 50571], "temperature": 0.0, "avg_logprob": -0.2715970292876038, "compression_ratio": 1.7291666666666667, "no_speech_prob": 0.11346571147441864}, {"id": 56, "seek": 19652, "start": 201.64000000000001, "end": 202.9, "text": " Gunggunaan na kanto.", "tokens": [50621, 460, 1063, 70, 5051, 282, 1667, 350, 5857, 13, 50684], "temperature": 0.0, "avg_logprob": -0.2715970292876038, "compression_ratio": 1.7291666666666667, "no_speech_prob": 0.11346571147441864}, {"id": 57, "seek": 19652, "start": 203.72, "end": 207.60000000000002, "text": " Di kay agurnong itikinabak na ngaagpaay kada kayo dito'y daga.", "tokens": [50725, 8789, 12446, 623, 925, 556, 309, 1035, 259, 455, 514, 1667, 297, 3680, 559, 4306, 320, 350, 1538, 12446, 78, 274, 3528, 6, 88, 274, 9286, 13, 50919], "temperature": 0.0, "avg_logprob": -0.2715970292876038, "compression_ratio": 1.7291666666666667, "no_speech_prob": 0.11346571147441864}, {"id": 58, "seek": 19652, "start": 208.26000000000002, "end": 208.9, "text": " Tadito'y,", "tokens": [50952, 314, 345, 3528, 6, 88, 11, 50984], "temperature": 0.0, "avg_logprob": -0.2715970292876038, "compression_ratio": 1.7291666666666667, "no_speech_prob": 0.11346571147441864}, {"id": 59, "seek": 19652, "start": 209.48000000000002, "end": 211.20000000000002, "text": " Dadaelin tisa nga kenlati.", "tokens": [51013, 413, 1538, 338, 259, 256, 3837, 297, 3680, 18787, 75, 6908, 13, 51099], "temperature": 0.0, "avg_logprob": -0.2715970292876038, "compression_ratio": 1.7291666666666667, "no_speech_prob": 0.11346571147441864}, {"id": 60, "seek": 19652, "start": 211.88, "end": 214.8, "text": " Ketserken ken takawin dagiti man nanakaw.", "tokens": [51133, 591, 1385, 260, 2653, 18787, 991, 1607, 259, 15460, 8707, 587, 14067, 514, 1607, 13, 51279], "temperature": 0.0, "avg_logprob": -0.2715970292876038, "compression_ratio": 1.7291666666666667, "no_speech_prob": 0.11346571147441864}, {"id": 61, "seek": 19652, "start": 215.76000000000002, "end": 219.78, "text": " Agurnong kayo kit di itikinabak na ngaagpaay kada kayo sa dilangit.", "tokens": [51327, 2725, 925, 556, 12446, 78, 8260, 1026, 309, 1035, 259, 455, 514, 1667, 297, 3680, 559, 4306, 320, 350, 1538, 12446, 78, 601, 11504, 656, 270, 13, 51528], "temperature": 0.0, "avg_logprob": -0.2715970292876038, "compression_ratio": 1.7291666666666667, "no_speech_prob": 0.11346571147441864}, {"id": 62, "seek": 19652, "start": 220.72, "end": 221.36, "text": " Tasadyay,", "tokens": [51575, 27293, 880, 320, 11, 51607], "temperature": 0.0, "avg_logprob": -0.2715970292876038, "compression_ratio": 1.7291666666666667, "no_speech_prob": 0.11346571147441864}, {"id": 63, "seek": 19652, "start": 222.10000000000002, "end": 223.52, "text": " Saan nga gratik ken aglati.", "tokens": [51644, 6299, 282, 297, 3680, 10158, 1035, 18787, 623, 75, 6908, 13, 51715], "temperature": 0.0, "avg_logprob": -0.2715970292876038, "compression_ratio": 1.7291666666666667, "no_speech_prob": 0.11346571147441864}, {"id": 64, "seek": 19652, "start": 224.70000000000002, "end": 225.98000000000002, "text": " Ketsaan aserken,", "tokens": [51774, 591, 1385, 21326, 382, 260, 2653, 11, 51838], "temperature": 0.0, "avg_logprob": -0.2715970292876038, "compression_ratio": 1.7291666666666667, "no_speech_prob": 0.11346571147441864}, {"id": 65, "seek": 22598, "start": 225.98, "end": 227.98, "text": " Ken takawin dagiti man nanakaw.", "tokens": [50365, 8273, 991, 1607, 259, 15460, 8707, 587, 14067, 514, 1607, 13, 50465], "temperature": 0.0, "avg_logprob": -0.3786527922659209, "compression_ratio": 1.8983050847457628, "no_speech_prob": 0.018420061096549034}, {"id": 66, "seek": 22598, "start": 227.98, "end": 229.98, "text": " Tano sa dino ti ayan tigamang mo.", "tokens": [50465, 314, 3730, 601, 274, 2982, 8757, 257, 6277, 256, 328, 335, 656, 705, 13, 50565], "temperature": 0.0, "avg_logprob": -0.3786527922659209, "compression_ratio": 1.8983050847457628, "no_speech_prob": 0.018420061096549034}, {"id": 67, "seek": 22598, "start": 229.98, "end": 231.98, "text": " At damat ijay ti pusom.", "tokens": [50565, 1711, 2422, 267, 741, 46451, 8757, 31252, 298, 13, 50665], "temperature": 0.0, "avg_logprob": -0.3786527922659209, "compression_ratio": 1.8983050847457628, "no_speech_prob": 0.018420061096549034}, {"id": 68, "seek": 22598, "start": 231.98, "end": 233.98, "text": " Ti mata ti pannakasilaw ti bagi.", "tokens": [50665, 20456, 46106, 8757, 280, 969, 514, 13353, 1607, 8757, 3411, 72, 13, 50765], "temperature": 0.0, "avg_logprob": -0.3786527922659209, "compression_ratio": 1.8983050847457628, "no_speech_prob": 0.018420061096549034}, {"id": 69, "seek": 22598, "start": 233.98, "end": 235.98, "text": " No nasalon at ti matam.", "tokens": [50765, 883, 5382, 34979, 412, 8757, 3803, 335, 13, 50865], "temperature": 0.0, "avg_logprob": -0.3786527922659209, "compression_ratio": 1.8983050847457628, "no_speech_prob": 0.018420061096549034}, {"id": 70, "seek": 22598, "start": 235.98, "end": 237.98, "text": " Nalawag ti entero abagim.", "tokens": [50865, 426, 304, 1607, 559, 8757, 948, 2032, 410, 559, 332, 13, 50965], "temperature": 0.0, "avg_logprob": -0.3786527922659209, "compression_ratio": 1.8983050847457628, "no_speech_prob": 0.018420061096549034}, {"id": 71, "seek": 22598, "start": 237.98, "end": 239.98, "text": " Ngem, no saan anasalon at ti matam.", "tokens": [50965, 21198, 443, 11, 572, 601, 282, 364, 296, 34979, 412, 8757, 3803, 335, 13, 51065], "temperature": 0.0, "avg_logprob": -0.3786527922659209, "compression_ratio": 1.8983050847457628, "no_speech_prob": 0.018420061096549034}, {"id": 72, "seek": 22598, "start": 239.98, "end": 241.98, "text": " Nasipngat ti entero abagim.", "tokens": [51065, 16151, 647, 872, 267, 8757, 948, 2032, 410, 559, 332, 13, 51165], "temperature": 0.0, "avg_logprob": -0.3786527922659209, "compression_ratio": 1.8983050847457628, "no_speech_prob": 0.018420061096549034}, {"id": 73, "seek": 22598, "start": 241.98, "end": 243.98, "text": " Isot ga po na anunakodret ti silaw mo.", "tokens": [51165, 1119, 310, 5959, 714, 1667, 364, 409, 514, 378, 1505, 8757, 3425, 1607, 705, 13, 51265], "temperature": 0.0, "avg_logprob": -0.3786527922659209, "compression_ratio": 1.8983050847457628, "no_speech_prob": 0.018420061096549034}, {"id": 74, "seek": 22598, "start": 243.98, "end": 245.98, "text": " Anyan aki nasipngat.", "tokens": [51265, 2639, 282, 257, 2984, 5382, 647, 872, 267, 13, 51365], "temperature": 0.0, "avg_logprob": -0.3786527922659209, "compression_ratio": 1.8983050847457628, "no_speech_prob": 0.018420061096549034}, {"id": 75, "seek": 22598, "start": 245.98, "end": 247.98, "text": " Ngunit,", "tokens": [51365, 426, 7414, 270, 11, 51465], "temperature": 0.0, "avg_logprob": -0.3786527922659209, "compression_ratio": 1.8983050847457628, "no_speech_prob": 0.018420061096549034}, {"id": 76, "seek": 22598, "start": 247.98, "end": 249.98, "text": " Ngunit,", "tokens": [51465, 426, 7414, 270, 11, 51565], "temperature": 0.0, "avg_logprob": -0.3786527922659209, "compression_ratio": 1.8983050847457628, "no_speech_prob": 0.018420061096549034}, {"id": 77, "seek": 22598, "start": 249.98, "end": 251.98, "text": " Ngunit,", "tokens": [51565, 426, 7414, 270, 11, 51665], "temperature": 0.0, "avg_logprob": -0.3786527922659209, "compression_ratio": 1.8983050847457628, "no_speech_prob": 0.018420061096549034}, {"id": 78, "seek": 22598, "start": 251.98, "end": 253.98, "text": " Ngunit,", "tokens": [51665, 426, 7414, 270, 11, 51765], "temperature": 0.0, "avg_logprob": -0.3786527922659209, "compression_ratio": 1.8983050847457628, "no_speech_prob": 0.018420061096549034}, {"id": 79, "seek": 22598, "start": 253.98, "end": 255.98, "text": " Ngunit,", "tokens": [51765, 426, 7414, 270, 11, 51865], "temperature": 0.0, "avg_logprob": -0.3786527922659209, "compression_ratio": 1.8983050847457628, "no_speech_prob": 0.018420061096549034}, {"id": 80, "seek": 25598, "start": 255.98, "end": 257.98, "text": " Ngunit pa ako.", "tokens": [50365, 426, 7414, 270, 2502, 43567, 13, 50465], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 81, "seek": 25598, "start": 257.98, "end": 260.78, "text": " Ang gagawin na sinet educya.", "tokens": [50465, 4521, 34833, 1607, 259, 1667, 3343, 302, 2400, 3016, 13, 50605], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 82, "seek": 25598, "start": 260.78, "end": 261.98, "text": " Ang dito,", "tokens": [50605, 4521, 274, 3528, 11, 50665], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 83, "seek": 25598, "start": 261.98, "end": 265.98, "text": " ito ay dati nasa pagkambahayan niya.", "tokens": [50665, 309, 78, 7494, 1137, 72, 5382, 64, 11812, 74, 2173, 545, 20506, 3867, 3016, 13, 50865], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 84, "seek": 25598, "start": 265.98, "end": 266.98, "text": " Kunjan.", "tokens": [50865, 19089, 14763, 13, 50915], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 85, "seek": 25598, "start": 266.98, "end": 268.98, "text": " Ang pagkambahayan na sablok siya.", "tokens": [50915, 4521, 11812, 74, 2173, 545, 20506, 1667, 5560, 75, 453, 1511, 3016, 13, 51015], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 86, "seek": 25598, "start": 268.98, "end": 270.98, "text": " Ang salaw para makamaskara yun.", "tokens": [51015, 4521, 1845, 1607, 1690, 963, 335, 3863, 2419, 288, 409, 13, 51115], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 87, "seek": 25598, "start": 270.98, "end": 271.98, "text": " Ang,", "tokens": [51115, 4521, 11, 51165], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 88, "seek": 25598, "start": 271.98, "end": 272.98, "text": " Ang hindi.", "tokens": [51165, 4521, 276, 10255, 13, 51215], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 89, "seek": 25598, "start": 272.98, "end": 273.98, "text": " jab goldgraph na kasulit.", "tokens": [51215, 33475, 3821, 34091, 1667, 19173, 425, 270, 13, 51265], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 90, "seek": 25598, "start": 273.98, "end": 275.86, "text": " Ang madami.", "tokens": [51265, 4521, 5244, 4526, 13, 51359], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 91, "seek": 25598, "start": 275.86, "end": 277.3, "text": " Ang palquito na dam\u6c92ta,", "tokens": [51359, 4521, 3984, 14856, 1667, 2422, 4913, 1328, 11, 51431], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 92, "seek": 25598, "start": 277.3, "end": 278.74, "text": " Ang sababing edo.", "tokens": [51431, 4521, 5560, 455, 278, 1257, 78, 13, 51503], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 93, "seek": 25598, "start": 278.74, "end": 280.65999999999997, "text": " Ang duwuh Christian.", "tokens": [51503, 4521, 1581, 86, 3232, 5778, 13, 51599], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 94, "seek": 25598, "start": 280.65999999999997, "end": 282.48, "text": " Ang per Yuntime.", "tokens": [51599, 4521, 680, 18007, 3766, 13, 51690], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 95, "seek": 25598, "start": 282.48, "end": 283.98, "text": " O\u307e\u3059 si Banjo.", "tokens": [51690, 422, 5368, 1511, 13850, 5134, 13, 51765], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 96, "seek": 25598, "start": 283.98, "end": 285.78, "text": " Si Mo Sl protegido.", "tokens": [51765, 4909, 3335, 6187, 49157, 2925, 13, 51855], "temperature": 1.0, "avg_logprob": -3.521072189529221, "compression_ratio": 1.4955752212389382, "no_speech_prob": 0.2657073438167572}, {"id": 97, "seek": 28578, "start": 285.78, "end": 288.5, "text": " Aya, anapatpatag tibiyag ngam titaraon?", "tokens": [50365, 316, 3016, 11, 364, 22602, 11584, 559, 256, 897, 4727, 559, 6415, 335, 3459, 2419, 266, 30, 50501], "temperature": 0.0, "avg_logprob": -0.31382943776028216, "compression_ratio": 1.710344827586207, "no_speech_prob": 0.13461531698703766}, {"id": 98, "seek": 28578, "start": 289.82, "end": 293.11999999999995, "text": " Saan aya, anapatpatag tibagi ngam tikawes?", "tokens": [50567, 6299, 282, 257, 3016, 11, 364, 22602, 11584, 559, 256, 897, 20291, 6415, 335, 44994, 1607, 279, 30, 50732], "temperature": 0.0, "avg_logprob": -0.31382943776028216, "compression_ratio": 1.710344827586207, "no_speech_prob": 0.13461531698703766}, {"id": 99, "seek": 28578, "start": 294.05999999999995, "end": 295.67999999999995, "text": " Kitahin nyo dagit itumatayab.", "tokens": [50779, 23037, 545, 259, 297, 8308, 15460, 270, 309, 449, 267, 320, 455, 13, 50860], "temperature": 0.0, "avg_logprob": -0.31382943776028216, "compression_ratio": 1.710344827586207, "no_speech_prob": 0.13461531698703766}, {"id": 100, "seek": 28578, "start": 296.76, "end": 297.52, "text": " Didag mula.", "tokens": [50914, 2589, 559, 275, 3780, 13, 50952], "temperature": 0.0, "avg_logprob": -0.31382943776028216, "compression_ratio": 1.710344827586207, "no_speech_prob": 0.13461531698703766}, {"id": 101, "seek": 28578, "start": 298.52, "end": 299.35999999999996, "text": " Didagani.", "tokens": [51002, 2589, 559, 3782, 13, 51044], "temperature": 0.0, "avg_logprob": -0.31382943776028216, "compression_ratio": 1.710344827586207, "no_speech_prob": 0.13461531698703766}, {"id": 102, "seek": 28578, "start": 300.34, "end": 302.4, "text": " Didagipampan itikamalig.", "tokens": [51093, 2589, 559, 647, 1215, 282, 309, 1035, 335, 304, 328, 13, 51196], "temperature": 0.0, "avg_logprob": -0.31382943776028216, "compression_ratio": 1.710344827586207, "no_speech_prob": 0.13461531698703766}, {"id": 103, "seek": 28578, "start": 303.2, "end": 306.11999999999995, "text": " Ngam taraonan idani amayo sa dilangit.", "tokens": [51236, 21198, 335, 23837, 266, 282, 4496, 3782, 669, 48947, 601, 11504, 656, 270, 13, 51382], "temperature": 0.0, "avg_logprob": -0.31382943776028216, "compression_ratio": 1.710344827586207, "no_speech_prob": 0.13461531698703766}, {"id": 104, "seek": 28578, "start": 307.29999999999995, "end": 310.47999999999996, "text": " Saan kayo aya, anapatpatag ngam dagit itumatayab?", "tokens": [51441, 6299, 282, 12446, 78, 257, 3016, 11, 364, 22602, 11584, 559, 6415, 335, 15460, 270, 309, 449, 267, 320, 455, 30, 51600], "temperature": 0.0, "avg_logprob": -0.31382943776028216, "compression_ratio": 1.710344827586207, "no_speech_prob": 0.13461531698703766}, {"id": 105, "seek": 31048, "start": 310.48, "end": 316.88, "text": " Sa sino kada kayo timakapa at tidog itibiyag na, babaen itipanagdandanag na?", "tokens": [50365, 6299, 18108, 350, 1538, 12446, 78, 524, 514, 7961, 412, 9422, 664, 309, 897, 4727, 559, 1667, 11, 31568, 268, 309, 647, 282, 559, 67, 39762, 559, 1667, 30, 50685], "temperature": 0.0, "avg_logprob": -0.19938423264194544, "compression_ratio": 1.607843137254902, "no_speech_prob": 0.041397422552108765}, {"id": 106, "seek": 31048, "start": 317.58000000000004, "end": 319.48, "text": " Kanapay apakadanagan nyo tipagananay?", "tokens": [50720, 11120, 569, 320, 1882, 514, 11338, 14167, 297, 8308, 4125, 14167, 282, 320, 30, 50815], "temperature": 0.0, "avg_logprob": -0.19938423264194544, "compression_ratio": 1.607843137254902, "no_speech_prob": 0.041397422552108765}, {"id": 107, "seek": 31048, "start": 321.1, "end": 323.48, "text": " Kitahin nyo tipanagdakal dagit liryo ititayak.", "tokens": [50896, 23037, 545, 259, 297, 8308, 4125, 282, 559, 67, 514, 304, 15460, 270, 287, 347, 8308, 309, 270, 320, 514, 13, 51015], "temperature": 0.0, "avg_logprob": -0.19938423264194544, "compression_ratio": 1.607843137254902, "no_speech_prob": 0.041397422552108765}, {"id": 108, "seek": 31048, "start": 325.26, "end": 327.5, "text": " Didag trabaho, wen no agabel.", "tokens": [51104, 2589, 559, 944, 65, 25825, 11, 11472, 572, 623, 18657, 13, 51216], "temperature": 0.0, "avg_logprob": -0.19938423264194544, "compression_ratio": 1.607843137254902, "no_speech_prob": 0.041397422552108765}, {"id": 109, "seek": 31048, "start": 328.56, "end": 331.0, "text": " Ngam ibagak kada kayo nga uray ni Solomon.", "tokens": [51269, 21198, 335, 741, 17282, 514, 350, 1538, 12446, 78, 297, 3680, 344, 3458, 3867, 32209, 13, 51391], "temperature": 0.0, "avg_logprob": -0.19938423264194544, "compression_ratio": 1.607843137254902, "no_speech_prob": 0.041397422552108765}, {"id": 110, "seek": 31048, "start": 331.94, "end": 339.34000000000003, "text": " Itiamin akin abaknang na, awan kawes na anapimpintas ngam itiuray may sakadagitoy asabsabong.", "tokens": [51438, 467, 2918, 259, 47540, 410, 514, 77, 656, 1667, 11, 1714, 282, 350, 1607, 279, 1667, 364, 569, 8814, 686, 296, 6415, 335, 309, 72, 374, 320, 815, 23366, 345, 559, 270, 939, 382, 17243, 455, 556, 13, 51808], "temperature": 0.0, "avg_logprob": -0.19938423264194544, "compression_ratio": 1.607843137254902, "no_speech_prob": 0.041397422552108765}, {"id": 111, "seek": 34048, "start": 340.48, "end": 343.36, "text": " Noti Diyos kawesan na dagit iroot ititayak.", "tokens": [50365, 1726, 72, 413, 4727, 329, 350, 1607, 279, 282, 1667, 15460, 270, 741, 340, 310, 309, 270, 320, 514, 13, 50509], "temperature": 0.0, "avg_logprob": -0.2906233174911398, "compression_ratio": 1.6108374384236452, "no_speech_prob": 0.015210104174911976}, {"id": 112, "seek": 34048, "start": 344.36, "end": 347.6, "text": " Root nga da ita, katintunbigat maisong rood.", "tokens": [50559, 3101, 310, 297, 3680, 1120, 309, 64, 11, 16536, 686, 409, 37660, 267, 2420, 556, 744, 378, 13, 50721], "temperature": 0.0, "avg_logprob": -0.2906233174911398, "compression_ratio": 1.6108374384236452, "no_speech_prob": 0.015210104174911976}, {"id": 113, "seek": 34048, "start": 348.74, "end": 351.66, "text": " Saan aya, anang nangroona akawesan na kayo?", "tokens": [50778, 6299, 282, 257, 3016, 11, 364, 656, 297, 656, 340, 4037, 9308, 1607, 279, 282, 1667, 12446, 78, 30, 50924], "temperature": 0.0, "avg_logprob": -0.2906233174911398, "compression_ratio": 1.6108374384236452, "no_speech_prob": 0.015210104174911976}, {"id": 114, "seek": 34048, "start": 352.56, "end": 354.74, "text": " Nagbasit kitdinti pa matiyo?", "tokens": [50969, 18913, 16342, 270, 8260, 67, 686, 72, 2502, 3803, 4727, 78, 30, 51078], "temperature": 0.0, "avg_logprob": -0.2906233174911398, "compression_ratio": 1.6108374384236452, "no_speech_prob": 0.015210104174911976}, {"id": 115, "seek": 34048, "start": 355.5, "end": 357.58000000000004, "text": " Isot gapuna adi kay masikuran.", "tokens": [51116, 1119, 310, 7417, 5051, 614, 72, 12446, 2300, 1035, 12125, 13, 51220], "temperature": 0.0, "avg_logprob": -0.2906233174911398, "compression_ratio": 1.6108374384236452, "no_speech_prob": 0.015210104174911976}, {"id": 116, "seek": 34048, "start": 358.82, "end": 359.68, "text": " Di yukon ko na.", "tokens": [51282, 8789, 288, 2034, 266, 8384, 1667, 13, 51325], "temperature": 0.0, "avg_logprob": -0.2906233174911398, "compression_ratio": 1.6108374384236452, "no_speech_prob": 0.015210104174911976}, {"id": 117, "seek": 34048, "start": 360.58000000000004, "end": 362.6, "text": " Pangalaan min tungarod itikanin mi.", "tokens": [51370, 49499, 5159, 282, 923, 41880, 289, 378, 309, 16048, 259, 2752, 13, 51471], "temperature": 0.0, "avg_logprob": -0.2906233174911398, "compression_ratio": 1.6108374384236452, "no_speech_prob": 0.015210104174911976}, {"id": 118, "seek": 34048, "start": 363.42, "end": 364.5, "text": " Wen no inuman mi.", "tokens": [51512, 23716, 572, 294, 6829, 2752, 13, 51566], "temperature": 0.0, "avg_logprob": -0.2906233174911398, "compression_ratio": 1.6108374384236452, "no_speech_prob": 0.015210104174911976}, {"id": 119, "seek": 34048, "start": 365.28000000000003, "end": 366.3, "text": " Wen no kawes mi.", "tokens": [51605, 23716, 572, 350, 1607, 279, 2752, 13, 51656], "temperature": 0.0, "avg_logprob": -0.2906233174911398, "compression_ratio": 1.6108374384236452, "no_speech_prob": 0.015210104174911976}, {"id": 120, "seek": 34048, "start": 367.34000000000003, "end": 369.68, "text": " Dagitoy tipang pangroona abirukan dagitihintil.", "tokens": [51708, 41866, 270, 939, 4125, 656, 280, 656, 340, 4037, 410, 347, 22324, 15460, 270, 4247, 686, 388, 13, 51825], "temperature": 0.0, "avg_logprob": -0.2906233174911398, "compression_ratio": 1.6108374384236452, "no_speech_prob": 0.015210104174911976}, {"id": 121, "seek": 37048, "start": 370.48, "end": 375.06, "text": " Ang muni amayo sa dilangit, amasapol yu amin dagitoy.", "tokens": [50365, 4521, 11864, 72, 669, 4894