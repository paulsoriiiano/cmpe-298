"seek": 9000, "start": 94.0, "end": 95.0, "text": " Saan?", "tokens": [50565, 6299, 282, 30, 50615], "temperature": 0.0, "avg_logprob": -0.35585039425519555, "compression_ratio": 1.597883597883598, "no_speech_prob": 0.040616199374198914}, {"id": 26, "seek": 9000, "start": 95.0, "end": 98.0, "text": " Kunam ket di kenkwana.", "tokens": [50615, 19089, 335, 14979, 1026, 18787, 74, 86, 2095, 13, 50765], "temperature": 0.0, "avg_logprob": -0.35585039425519555, "compression_ratio": 1.597883597883598, "no_speech_prob": 0.040616199374198914}, {"id": 27, "seek": 9000, "start": 98.0, "end": 100.0, "text": " Isa ganam tipang rabiik,", "tokens": [50765, 19718, 7574, 335, 4125, 656, 14085, 72, 1035, 11, 50865], "temperature": 0.0, "avg_logprob": -0.35585039425519555, "compression_ratio": 1.597883597883598, "no_speech_prob": 0.040616199374198914}, {"id": 28, "seek": 9000, "start": 100.0, "end": 103.0, "text": " Sa kanto agsukat nga agsirbi kanyak,", "tokens": [50865, 6299, 350, 5857, 623, 82, 2034, 267, 297, 3680, 623, 82, 347, 5614, 350, 1325, 514, 11, 51015], "temperature": 0.0, "avg_logprob": -0.35585039425519555, "compression_ratio": 1.597883597883598, "no_speech_prob": 0.040616199374198914}, {"id": 29, "seek": 9000, "start": 103.0, "end": 105.0, "text": " Bayat tipan nangan ko.", "tokens": [51015, 7840, 267, 4125, 282, 297, 17017, 8384, 13, 51115], "temperature": 0.0, "avg_logprob": -0.35585039425519555, "compression_ratio": 1.597883597883598, "no_speech_prob": 0.040616199374198914}, {"id": 30, "seek": 9000, "start": 105.0, "end": 107.0, "text": " Kalpasan na,", "tokens": [51115, 12655, 20990, 282, 1667, 11, 51215], "temperature": 0.0, "avg_logprob": -0.35585039425519555, "compression_ratio": 1.597883597883598, "no_speech_prob": 0.040616199374198914}, {"id": 31, "seek": 9000, "start": 107.0, "end": 109.0, "text": " Mabalin munton ti mangan.", "tokens": [51215, 376, 455, 24861, 275, 2760, 266, 8757, 587, 1275, 13, 51315], "temperature": 0.0, "avg_logprob": -0.3558503942551955