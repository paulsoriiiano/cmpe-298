4187459946}, {"id": 44, "seek": 14700, "start": 147.0, "end": 150.0, "text": " Nagtakdar da iti adayubasit,", "tokens": [50365, 426, 7665, 514, 20327, 1120, 309, 72, 614, 320, 836, 296, 270, 11, 50515], "temperature": 0.0, "avg_logprob": -0.22164114694746714, "compression_ratio": 1.5611111111111111, "no_speech_prob": 0.022893790155649185}, {"id": 45, "seek": 14700, "start": 150.0, "end": 152.0, "text": " Ket impukkaw da.", "tokens": [50515, 591, 302, 704, 2034, 74, 1607, 1120, 13, 50615], "temperature": 0.0, "avg_logprob": -0.22164114694746714, "compression_ratio": 1.5611111111111111, "no_speech_prob": 0.022893790155649185}, {"id": 46, "seek": 14700, "start": 152.0, "end": 156.0, "text": " Jesus! Maestro! Kasyan na kami!", "tokens": [50615, 2705, 0, 4042, 32389, 0, 591, 5871, 282, 1667, 34502, 0, 50815], "temperature": 0.0, "avg_logprob": -0.22164114694746714, "compression_ratio": 1.5611111111111111, "no_speech_prob": 0.022893790155649185}, {"id": 47, "seek": 14700, "start": 156.0, "end": 159.0, "text": " Nakita ida ni Jesus ket kinunan.", "tokens": [50815, 25779, 2786, 220, 2887, 3867, 2705, 14979, 15784, 409, 282, 13, 50965], "temperature": 0.0, "avg_logprob": -0.22164114694746714, "compression_ratio": 1.5611111111111111, "no_speech_prob": 0.022893790155649185}, {"id": 48, "seek": 14700, "start": 159.0, "end": 162.0, "text": " Inkay agpakita kadagiti papadi.", "tokens": [50965, 682, 789, 623, 45944, 2786, 8064, 559, 8707, 5806, 5688, 13, 51115], "temperature": 0.0, "avg_logprob": -0.22164114694746714, "compression_ratio": 1.5611111111111111, "no_speech_prob": 0.022893790155649185}, {"id": 49, "seek": 14700, "start": 162.0, "end": 166.0, "text": " Idi adada iti dalan na imbagan dan.", "tokens": [51115, 40187, 614, 1538, 309, 72, 11702, 282, 1667, 566, 65, 14167, 3277, 13, 51315], "temperature": 0.0, "avg_logprob": -0.22164114694746714, "compression_ratio": 1.5611111111111111, "no_speech_prob": 0.022893790155649185}, {"id": 50, "seek": 14700, "start": 166.0, "end": 