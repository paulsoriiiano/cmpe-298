prob": -0.18317796106207862, "compression_ratio": 1.6700507614213198, "no_speech_prob": 0.020184146240353584}, {"id": 56, "seek": 17500, "start": 188.0, "end": 191.0, "text": " Sa dino ti ayan dagiti siyam?", "tokens": [51015, 6299, 274, 2982, 8757, 257, 6277, 15460, 8707, 1511, 88, 335, 30, 51165], "temperature": 0.0, "avg_logprob": -0.18317796106207862, "compression_ratio": 1.6700507614213198, "no_speech_prob": 0.020184146240353584}, {"id": 57, "seek": 17500, "start": 191.0, "end": 196.0, "text": " Apay adaytoy laang ganggan na itinagsubli nga agyaman iti Diyos.", "tokens": [51165, 8723, 320, 614, 320, 83, 939, 635, 656, 10145, 1275, 1667, 309, 259, 12109, 836, 2081, 297, 3680, 623, 88, 6147, 309, 72, 413, 4727, 329, 13, 51415], "temperature": 0.0, "avg_logprob": -0.18317796106207862, "compression_ratio": 1.6700507614213198, "no_speech_prob": 0.020184146240353584}, {"id": 58, "seek": 17500, "start": 196.0, "end": 198.0, "text": " Kinunan ni Jesus ken kuwana.", "tokens": [51415, 27950, 409, 282, 3867, 2705, 18787, 17807, 86, 2095, 13, 51515], "temperature": 0.0, "avg_logprob": -0.18317796106207862, "compression_ratio": 1.6700507614213198, "no_speech_prob": 0.020184146240353584}, {"id": 59, "seek": 17500, "start": 198.0, "end": 200.0, "text": " Tumakter ka,", "tokens": [51515, 314, 449, 33557, 6799, 11, 51615], "temperature": 0.0, "avg_logprob": -0.18317796106207862, "compression_ratio": 1.6700507614213198, "no_speech_prob": 0.020184146240353584}, {"id": 60, "seek": 17500, "start": 200.0, "end": 202.0, "text": " Ket agawid ka.", "tokens": [51615, 591, 302, 623, 1607, 327, 6799, 13, 51715], "temperature": 0.0, "avg_logprob": -0.18317796106207862, "compression_ratio": 1.6700507614213198, "no_speech_prob": 0.020184146240353584}, {"id": 61, "seek": 17500, "start": 202.0, "end": 204.0, "text": " Pinaimbag na ka tapang matim.", "tokens": [51715, 430, 1426, 17306, 559, 1667, 6799, 5119, 656, 3803, 332, 13, 51815], "temperature": 0.0, "avg_logprob": -0.18317796106207862, "c