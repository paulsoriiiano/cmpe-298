ext": " dagiti panguloen apapadi,", "tokens": [50365, 15460, 8707, 280, 656, 13455, 268, 1882, 569, 5688, 11, 50491], "temperature": 0.0, "avg_logprob": -0.34488316738244257, "compression_ratio": 1.558974358974359, "no_speech_prob": 0.003059725509956479}, {"id": 61, "seek": 26008, "start": 263.28, "end": 265.35999999999996, "text": " kian dagiti mamaestro itilindag.", "tokens": [50525, 350, 952, 15460, 8707, 18775, 32389, 309, 388, 471, 559, 13, 50629], "temperature": 0.0, "avg_logprob": -0.34488316738244257, "compression_ratio": 1.558974358974359, "no_speech_prob": 0.003059725509956479}, {"id": 62, "seek": 26008, "start": 266.09999999999997, "end": 267.21999999999997, "text": " Mapapatayak to,", "tokens": [50666, 22053, 22602, 320, 514, 281, 11, 50722], "temperature": 0.0, "avg_logprob": -0.34488316738244257, "compression_ratio": 1.558974358974359, "no_speech_prob": 0.003059725509956479}, {"id": 63, "seek": 26008, "start": 268.14, "end": 271.14, "text": " ngam mapagungarak to iti maikatlongal daw.", "tokens": [50768, 6415, 335, 4471, 559, 1063, 23346, 281, 309, 72, 463, 36300, 13025, 304, 43438, 13, 50918], "temperature": 0.0, "avg_logprob": -0.34488316738244257, "compression_ratio": 1.558974358974359, "no_speech_prob": 0.003059725509956479}, {"id": 64, "seek": 26008, "start": 271.9, "end": 275.08, "text": " Inyadayo basit ni Pedro ni Jesus sa nabinabalaw.", "tokens": [50956, 682, 88, 345, 48947, 987, 270, 3867, 26662, 3867, 2705, 601, 297, 455, 259, 455, 304, 1607, 13, 51115], "temperature": 0.0, "avg_logprob": -0.34488316738244257, "compression_ratio": 1.558974358974359, "no_speech_prob": 0.003059725509956479}, {"id": 65, "seek": 26008, "start": 276.29999999999995, "end": 279.53999999999996, "text": " Apo, saan kumakasta tisa sa worm?", "tokens": [51176, 316, 2259, 11, 601, 282, 350, 449, 514, 12468, 256, 3837, 601, 23835, 30, 51338], "temperature": 0.0, "avg_logprob": -0.34488316738244257, "compression_ratio": 1.558974358974359, "no_speech_prob": 0.0030597255099