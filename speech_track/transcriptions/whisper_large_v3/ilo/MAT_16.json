5710233152}, {"id": 38, "seek": 17520, "start": 181.82, "end": 183.5, "text": " huwag numaysa kadagiti profeta.", "tokens": [50696, 2137, 86, 559, 1031, 3772, 64, 8064, 559, 8707, 1740, 7664, 13, 50780], "temperature": 0.0, "avg_logprob": -0.296594394473579, "compression_ratio": 1.5803108808290156, "no_speech_prob": 0.0009608165710233152}, {"id": 39, "seek": 17520, "start": 184.2, "end": 184.94, "text": " Kadakayo?", "tokens": [50815, 32248, 514, 48947, 30, 50852], "temperature": 0.0, "avg_logprob": -0.296594394473579, "compression_ratio": 1.5803108808290156, "no_speech_prob": 0.0009608165710233152}, {"id": 40, "seek": 17520, "start": 185.79999999999998, "end": 187.22, "text": " Sinaludsod ni Jesus.", "tokens": [50895, 318, 2071, 32083, 378, 3867, 2705, 13, 50966], "temperature": 0.0, "avg_logprob": -0.296594394473579, "compression_ratio": 1.5803108808290156, "no_speech_prob": 0.0009608165710233152}, {"id": 41, "seek": 17520, "start": 187.88, "end": 190.0, "text": " Siya sino ak itipanagkunayo?", "tokens": [50999, 4909, 3016, 18108, 9308, 309, 647, 282, 559, 22531, 48947, 30, 51105], "temperature": 0.0, "avg_logprob": -0.296594394473579, "compression_ratio": 1.5803108808290156, "no_speech_prob": 0.0009608165710233152}, {"id": 42, "seek": 17520, "start": 190.85999999999999, "end": 194.56, "text": " Sika ati Kristo, ti anak ti sibibiyaga Diyos.", "tokens": [51148, 318, 5439, 412, 72, 6332, 9334, 11, 8757, 38042, 8757, 35505, 897, 4727, 9286, 413, 4727, 329, 13, 51333], "temperature": 0.0, "avg_logprob": -0.296594394473579, "compression_ratio": 1.5803108808290156, "no_speech_prob": 0.0009608165710233152}, {"id": 43, "seek": 17520, "start": 195.39999999999998, "end": 199.1, "text": " Insong bat ni Simon Pedro, kinuna ni Jesus.", "tokens": [51375, 9442, 556, 7362, 3867, 13193, 26662, 11, 15784, 5051, 3867, 2705, 13, 51560], "temperature": 0.0, "avg_logprob": -0.296594394473579, "compression_ratio": 1.5803108808290156, "no_speech_prob": 0.0009608165710233152}, {"id": 44, "seek": 17520, "start": 199.95999999999998, "end": 203.29999999999998, "text": " Nagasat ka, Simon, nga anak ni Jonas.", "tokens": [51603, 18913, 296, 267, 6799, 11, 13193, 11, 297, 3680, 38042, 3867, 34630, 13, 51770], "temperature": 0.0, "avg_logprob": -0.296594394473579, "compression_ratio": 1.5803108808290156, "no_speech_prob": 0.0009608165710233152}, {"id": 45, "seek": 20330, "start": 203.3, "end": 211.58, "text": " Saan atao nudikat ni amak sa dilangit tinangipaltiinkan ka iti daytoy akinapudno?", "tokens": [50365, 6299, 282, 48639, 78, 297, 532, 36300, 3867, 669, 514, 601, 11504, 656, 270, 15935, 656, 647, 3198, 72, 475, 282, 6799, 309, 72, 786, 83, 939, 47540, 569, 532, 1771, 30, 50779], "temperature": 0.0, "avg_logprob": -0.3249215790719697, "compression_ratio": 1.5255102040816326, "no_speech_prob": 0.0372890941798687}, {"id": 46, "seek": 20330, "start": 212.60000000000002, "end": 215.34, "text": " Ibagak ngarodkan ka asika kat Pedro.", "tokens": [50830, 286, 17282, 514, 297, 2976, 378, 5225, 6799, 382, 5439, 16536, 26662, 13, 50967], "temperature": 0.0, "avg_logprob": -0.3249215790719697, "compression_ratio": 1.5255102040816326, "no_speech_prob": 0.0372890941798687}, {"id": 47, "seek": 20330, "start": 216.16000000000003, "end": 217.60000000000002, "text": " Itirabaw daytoy abato.", "tokens": [51008, 467, 347, 455, 1607, 786, 83, 939, 410, 2513, 13, 51080], "temperature": 0.0, "avg_logprob": -0.3249215790719697, "compression_ratio": 1.5255102040816326, "no_speech_prob": 0.0372890941798687}, {"id": 48, "seek": 20330, "start": 218.66000000000003, "end": 221.88000000000002, "text": " Pangunik to te iglesyak kat uray ni patay.", "tokens": [51133, 49499, 409, 1035, 281, 535, 8508, 904, 88, 514, 16536, 344, 3458, 3867, 1947, 320, 13, 51294], "temperature": 0.0, "avg_logprob": -0.3249215790719697, "compression_ratio": 1.5255102040816326, "no_speech_prob": 0.0372890941798687}, {"id": 49, "seek": 20330, "start": 222.54000000000002, "end": 224.16000000000003, "text": " Dinto agbaligikan kwa na.", "tokens": [51327, 413, 17246, 623, 2645, 328, 16048, 350, 4151, 1667, 13, 51408], "temperature": 0.0, "avg_logprob": -0.3249215790719697, "compression_ratio": 1.5255102040816326, "no_speech_prob": 0.0372890941798687}, {"id": 50, "seek": 20330, "start": 225.12, "end": 228.38000000000002, "text": " Itidkontoken ka dagit itulbag tipagarian tilangit.", "tokens": [51456, 467, 327, 74, 896, 8406, 6799, 15460, 270, 309, 425, 17282, 4125, 559, 10652, 8440, 656, 270, 13, 51619], "temperature": 0.0, "avg_logprob": -0.3249215790719697, "compression_ratio": 1.5255102040816326, "no_speech_prob": 0.0372890941798687}, {"id": 51, "seek": 20330, "start": 228.38000000000002, "end": 231.38000000000002, "text": " Kian yaman nga iparit mo dito'y daga,", "tokens": [51619, 591, 952, 288, 6147, 297, 3680, 28501, 289, 270, 705, 274, 3528, 6, 88, 274, 9286, 11, 51769], "temperature": 0.0, "avg_logprob": -0.3249215790719697, "compression_ratio": 1.5255102040816326, "no_speech_prob": 0.0372890941798687}, {"id": 52, "seek": 23138, "start": 231.38, "end": 234.14, "text": " maiparit tumet sa dilangit.", "tokens": [50365, 463, 647, 289, 270, 13102, 302, 601, 11504, 656, 270, 13, 50503], "temperature": 0.0, "avg_logprob": -0.20708652309604458, "compression_ratio": 1.7448979591836735, "no_speech_prob": 0.016008766368031502}, {"id": 53, "seek": 23138, "start": 234.56, "end": 237.5, "text": " Ket ti anyaman nga ipalubos mo dito'y daga,", "tokens": [50524, 591, 302, 8757, 604, 6147, 297, 3680, 28501, 304, 836, 329, 705, 274, 3528, 6, 88, 274, 9286, 11, 50671], "temperature": 0.0, "avg_logprob": -0.20708652309604458, "compression_ratio": 1.7448979591836735, "no_speech_prob": 0.016008766368031502}, {"id": 54, "seek": 23138, "start": 238.26, "end": 240.62, "text": " maipalubos tumet sa dilangit.", "tokens": [50709, 463, 647, 304, 836, 329, 13102, 302, 601, 11504, 656, 270, 13, 50827], "temperature": 0.0, "avg_logprob": -0.20708652309604458, "compression_ratio": 1.74489795918