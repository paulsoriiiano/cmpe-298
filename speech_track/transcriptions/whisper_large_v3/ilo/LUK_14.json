": 14998, "start": 165.78, "end": 168.89999999999998, "text": " Inton agungar dagiti na linteg at at tao.", "tokens": [51155, 5681, 266, 623, 1063, 289, 15460, 8707, 1667, 287, 686, 1146, 412, 412, 44292, 13, 51311], "temperature": 0.0, "avg_logprob": -0.2970204284225685, "compression_ratio": 1.6236559139784945, "no_speech_prob": 0.13319003582000732}, {"id": 34, "seek": 14998, "start": 169.28, "end": 175.07999999999998, "text": " Nang timaysa ka dagiti na kisango kene Jesus, itipanganan daytoy apang ngarig.", "tokens": [51330, 426, 656, 524, 3772, 64, 6799, 15460, 8707, 1667, 350, 271, 17150, 350, 1450, 2705, 11, 309, 647, 17017, 282, 786, 83, 939, 1882, 656, 297, 2976, 328, 13, 51620], "temperature": 0.0, "avg_logprob": -0.2970204284225685, "compression_ratio": 1.6236559139784945, "no_speech_prob": 0.13319003582000732}, {"id": 35, "seek": 14998, "start": 175.6, "end": 177.04, "text": " Kinunana kene Jesus.", "tokens": [51646, 27950, 409, 2095, 350, 1450, 2705, 13, 51718], "temperature": 0.0, "avg_logprob": -0.2970204284225685, "compression_ratio": 1.6236559139784945, "no_speech_prob": 0.13319003582000732}, {"id": 36, "seek": 14998, "start": 177.82, "end": 179.04, "text": " Anyan aragsak.", "tokens": [51757, 2639, 282, 257, 3731, 82, 514, 13, 51818], "temperature": 0.0, "avg_logprob": -0.2970204284225685, "compression_ratio": 1.6236559139784945, "no_speech_prob": 0.13319003582000732}, {"id": 37, "seek": 17904, "start": 179.04, "end": 182.73999999999998, "text": " Dagiti sumangon to itipanganan. Itipagaryan ti Diyos.", "tokens": [50365, 41866, 8707, 2408, 656, 266, 281, 309, 647, 17017, 282, 13, 467, 647, 559, 822, 282, 8757, 413, 4727, 329, 13, 50550], "temperature": 0.0, "avg_logprob": -0.2817222595214844, "compression_ratio": 1.6313131313131313, "no_speech_prob": 0.06779259443283081}, {"id": 38, "seek": 17904, "start": 183.44, "end": 185.26, "text": " Kinunana ni Jesus ken kuwana.", "tokens": [50585, 27950, 409, 2095, 3867, 2705, 18787, 17807, 86, 2095, 13, 50676], "temperature": 0.0, "avg_logprob": -0.2817222595214844, "compression_ratio": 1.6313131313131313, "no_speech_prob": 0.06779259443283081}, {"id": 39, "seek": 17904, "start": 186.04, "end": 192.29999999999998, "text": " Adda idimaysa at tao anang isagana itidakkal apadaya, ket adoti inawis na.", "tokens": [50715, 1999, 2675, 4496, 332, 3772, 64, 412, 44292, 364, 656, 307, 559, 2095, 309, 327, 514, 19990, 1882, 345, 4427, 11, 14979, 614, 8206, 294, 1607, 271, 1667, 13, 51028], "temperature": 0.0, "avg_logprob": -0.2817222595214844, "compression_ratio": 1.6313131313131313, "no_speech_prob": 0.06779259443283081}, {"id": 40, "seek": 17904, "start": 193.22, "end": 195.23999999999998, "text": " Ididimtengan ti oras tipadaya.", "tokens": [51074, 11506, 327, 332, 1147, 1275, 8757, 420, 296, 4125, 345, 4427, 13, 51175], "temperature": 0.0, "avg_logprob": -0.2817222595214844, "compression_ratio": 1.6313131313131313, "no_speech_prob": 0.06779259443283081}, {"id": 41, "seek": 17904, "start": 196.29999999999998, "end": 199.66, "text": " Binaun na ti adipan na amangibaga kadagiti na awis.", "tokens": [51228, 363, 1426, 409, 1667, 8757, 614, 647, 282, 1667, 669, 656, 897, 9286, 8064, 559, 8707, 1667, 1714, 271, 13, 51396], "temperature": 0.0, "avg_logprob": -0.2817222595214844, "compression_ratio": 1.6313131313131313, "no_speech_prob": 0.06779259443283081}, {"id": 42, "seek": 17904, "start": 200.82, "end": 203.51999999999998, "text": " Umay kayon, tanaisagana aminen.", "tokens": [51454, 3301, 320, 12446, 266, 11, 7603, 1527, 559, 2095, 669, 5636, 13, 51589], "temperature": 0.0, "avg_logprob": -0.2817222595214844, "compression_ratio": 1.6313131313131313, "no_speech_prob": 0.06779259443283081}, {"id": 43, "seek": 17904, "start": 204.42, "end": 206.12, "text": " Ngam nagpambarda amin.", "tokens": [51634, 21198, 335, 17096, 79, 2173, 19218, 669, 259, 13, 51719], "temperature": 0.0, "avg_logprob": -0.2817222595214844, "compression_ratio": 1.6313131313131313, "no_speech_prob": 0.06779259443283081}, {"id": 44, "seek": 17904, "start": 206.88, "end": 208.12, "text": " Kinunati may sa itiadipan.", "tokens": [51757, 27950, 409, 6908, 815, 601, 309, 38069, 647, 282, 13, 51819], "temperature": 0.0, "avg_logprob": -0.2817222595214844, "compression_ratio": 1.6313131313131313, "no_speech_prob": 0.06779259443283081}, {"id": 45, "seek": 20904, "start": 209.04, "end": 214.23999999999998, "text": " Ging matangak ititalon, kat masapol nga inakitain.", "tokens": [50365, 460, 278, 3803, 656, 514, 309, 1686, 266, 11, 16536, 2300, 569, 401, 297, 3680, 294, 514, 270, 491, 13, 50625], "temperature": 0.0, "avg_logprob": -0.27487424594252857, "compression_ratio": 1.7926829268292683, "no_speech_prob": 0.020493118092417717}, {"id": 46, "seek": 20904, "start": 215.22, "end": 216.79999999999998, "text": " Dispensar naklaangan.", "tokens": [50674, 4208, 79, 694, 289, 20332, 875, 17017, 13, 50753], "temperature": 0.0, "avg_logprob": -0.27487424594252857, "compression_ratio": 1.7926829268292683, "no_speech_prob": 0.020493118092417717}, {"id": 47, "seek": 20904, "start": 217.68, "end": 218.84, "text": " Kinunamit ti sabali.", "tokens": [50797, 27950, 409, 335, 270, 8757, 5560, 5103, 13, 50855], "temperature": 0.0, "avg_logprob": -0.27487424594252857, "compression_ratio": 1.7926829268292683, "no_speech_prob": 0.020493118092417717}, {"id": 48, "seek": 20904, "start": 219.57999999999998, "end": 224.51999999999998, "text": " Ging matangak itilimangag kasangol abaka, kat inak ipadasida.", "tokens": [50892, 460, 278, 3803, 656, 514, 309, 26026, 656, 559, 19173, 656, 401, 410, 7849, 11, 16536, 294, 514, 28501, 6872, 2887, 13, 51139], "temperature": 0.0, "avg_logprob": -0.27487424594252857, "compression_ratio": 1.7926829268292683, "no_speech_prob": 0.020493118092417717}, {"id": 49, "seek": 20904, "start": 225.42, "end": 226.92, "text": " Dispensar naklaangan.", "tokens": [51184, 4208, 79, 694, 289, 20332, 875, 17017, 13, 51259], "temperature": 0.0, "avg_logprob": -0.27487424594252857, "compression_ratio": 1.7926829268292683, "no_speech_prob": 0.020493118092417717}, {"id": 50, "seek": 20904, "start": 227.73999999999998, "end": 228.92, "text": " Kinunamit ti sabali.", "tokens": [51300, 27950, 409, 335, 270, 8757, 5560, 5103, 13, 51359], "temperature": 0.0, "avg_logprob": -0.27487424594252857, "compression_ratio": 1.7926829268292683, "no_speech_prob": 0.020493118092417717}, {"id": 51, "seek": 20904, "start": 229.78, "end": 230.82, "text": " Kakaskasarko.", "tokens": [51402, 36775, 3863, 296, 809, 78, 13, 51454], "temperature": 0.0, "avg_logprob": -0.27487424594252857, "compression_ratio": 1.7926829268292683, "no_speech_prob": 0.020493118092417717}, {"id": 52, "seek": 20904, "start": 231.57999999999998, "end": 233.85999999999999, "text": " Isotga puna ajak makaumay.", "tokens": [51492, 1119, 310, 3680, 4468, 64, 17680, 514, 963, 64, 449, 320, 13, 51606], "temperature": 0.0, "avg_logprob": -0.27487424594252857, "compression_ratio": 1.7926829268292683, "no_speech_prob": 0.020493118092417717}, {"id": 53, "seek": 20904, "start": 234.42, "end": 238.92, "text": " Nagawit ti adipan, kat imbaga na amin daytoy itiapuna.", "tokens": [51634, 18913, 1607, 270, 8757, 614, 647, 282, 11, 16536, 566, 65, 9286, 1667, 669, 259, 786, 83, 939, 309, 72, 569, 5051, 13, 51859], "temperature": 0.0, "avg_logprob": -0.27487424594252857, "compression_ratio": 1.7926829268292683, "no_speech_prob": 0.020493118092417717}, {"id": 54, "seek": 23904, "start": 239.04, "end": 241.04, "text": " Nakapungtot ti apo.", "tokens": [50365, 25779, 569, 1063, 83, 310, 8757, 50165, 13, 50465], "temperature": 0.0, "avg_logprob": -0.30026364508475967, "compression_ratio": 1.5737704918032787, "no_speech_prob": 0.05842066556215286}, {"id": 55, "seek": 23904, "start": 241.04, "end": 243.04, "text": " Binili na ti adipan na.", "tokens": [50465, 18983, 2312, 1667, 8757, 614, 647, 282, 1667, 13, 50565], "temperature": 0.0, "avg_logprob": -0.30026364508475967, "compression_ratio": 1.5737704918032787, "no_speech_prob": 0.05842066556215286}, {"id": 56, "seek": 23904, "start": 243.04, "end": 249.04, "text": " Darasem ti mapan kadagiti kalkalsada, ken daldalan itiili.", "tokens": [50565, 7803, 296, 443, 8757, 4471, 282, 8064, 559, 8707, 34960, 1124, 1538, 11, 18787, 274, 3976, 14163, 309, 72, 2312, 13, 50865], "temperature": 0.0, "avg_logprob": -0.30026364508475967, "compression_ratio": 1.5737704918032787, "no_speech_prob": 0.05842066556215286}, {"id": 57, "seek": 23904, "start": 249.04, "end": 257.03999999999996, "text": " Ket yeg mo ditoy dagiti na panglaw, dagiti lugpi, dagiti bulsek, ken dagiti pilay.", "tokens": [50865, 591, 302, 606, 70, 705, 6176, 939, 15460, 8707, 1667, 280, 656, 5901, 11, 15460, 8707, 23025, 22630, 11, 15460, 8707, 6493, 26141, 11, 18787, 15460, 8707, 6429, 320, 13, 51265], "temperature": 0.0, "avg_logprob": -0.30026364508475967, "compression_ratio": 1.5737704918032787, "no_speech_prob": 0.05842066556215286}, {"id": 58, "seek": 23904, "start": 257.03999999999996, "end": 259.03999999999996, "text": " Iti saan anabayag?", "tokens": [51265, 467, 72, 601, 282, 364, 455, 320, 559, 30, 51365], "temperature": 0.0, "avg_logprob": -0.30026364508475967, "compression_ratio": 1.5737704918032787, "no_speech_prob": 0.05842066556215286}, {"id": 59, "seek": 23904, "start": 259.03999999999996, "end": 261.03999999999996, "text": " Kinunati adipan.", "tokens": [51365, 27950, 409, 6908, 614, 647, 282, 13, 51465], "temperature": 0.0, "avg_logprob": -0.30026364508475967, "compression_ratio": 1.5737704918032787, "no_speech_prob": 0.05842066556215286}, {"id": 60, "seek": 23904, "start": 261.03999999999996, "end": 264.03999999999996, "text": " Apo, natumpal ti bilin mo.", "tokens": [51465, 316, 2259, 11, 2249, 1420, 304, 8757, 8588, 259, 705, 13, 51615], "temperature": 0.0, "avg_logprob": -0.30026364508475967, "compression_ratio": 1.5737704918032787, "no_speech_prob": 0.05842066556215286}, {"id": 61, "seek": 23904, "start": 264.03999999999996, "end": 267.03999999999996, "text": " Ngam adupay laeng tipagyanan.", "tokens": [51615, 21198, 335, 614, 1010, 320, 635, 1501, 4125, 559, 6277, 282, 13, 51765], "temperature": 0.0, "avg_logprob": -0.30026364508475967, "compression_ratio": 1.5737704918032787, "no_speech_prob": 0.05842066556215286}, {"id": 62, "seek": 23904, "start": 267.03999999999996, "end": 268.21999999999997, "text": " Itikasta.", "tokens": [51765, 467, 1035, 12468, 13, 51824], "temperature": 0.0, "avg_logprob": -0.30026364508475967, "compression_ratio": 1.5737704918032787, "no_speech_prob": 0.05842066556215286}, {"id": 63, "seek": 26822, "start": 268.22, "end": 271.22, "text": " Kinunamanin ti apo itiadipan.", "tokens": [50365, 27950, 409, 6147, 259, 8757, 50165, 309, 72, 345, 647, 282, 13, 50515], "temperature": 0.0, "avg_logprob": -0.2276381695364404, "compression_ratio": 1.6507936507936507, "no_speech_prob": 0.10034678876399994}, {"id": 64, "seek": 26822, "start": 271.22, "end": 275.22, "text": " Inka kadagiti daldalan ken bitbitang.", "tokens": [50515, 682, 2330, 8064, 559, 8707, 274, 3976, 14163, 18787, 857, 5260, 656, 13, 50715], "temperature": 0.0, "avg_logprob": -0.2276381695364404, "compression_ratio": 1.6507936507936507, "no_speech_prob": 0.10034678876399994}, {"id": 65, "seek": 26822, "start": 275.22, "end": 280.22, "text": " Ket pilitan dagiti tattao nga umay, tap numapnot ti palay ko.", "tokens": [50715, 591, 302, 6429, 9670, 15460, 8707, 9600, 1328, 78, 297, 3680, 1105, 320, 11, 5119, 1031, 569, 2247, 8757, 3984, 320, 8384, 13, 50965], "temperature": 0.0, "avg_logprob": -0.2276381695364404, "compression_ratio": 1.6507936507936507, "no_speech_prob": 0.10034678876399994}, {"id": 66, "seek": 26822, "start": 280.22, "end": 287.22, "text": " Tay bagak kadakay amin, nga awanto kadagiti inawis ko ti makaraman iti sa ganak.", "tokens": [50965, 10132, 3411, 514, 8064, 514, 320, 669, 259, 11, 297, 3680, 1714, 5857, 8064, 559, 8707, 294, 1607, 271, 8384, 8757, 963, 289, 6147, 309, 72, 601, 7574, 514, 13, 51315], "temperature": 0.0, "avg_logprob": -0.2276381695364404, "compression_ratio": 1.6507936507936507, "no_speech_prob": 0.10034678876399994}, {"id": 67, "seek": 26822, "start": 287.22, "end": 293.22, "text": " Iti na minsan, nakadado at atao ti sumursurot ken ni Jesus.", "tokens": [51315, 467, 72, 1667, 923, 11491, 11, 20332, 345, 1573, 412, 48639, 78, 8757, 2408, 2156, 374, 310, 18787, 3867, 2705, 13, 51615], "temperature": 0.0, "avg_logprob": -0.2276381695364404, "compression_ratio": 1.6507936507936507, "no_speech_prob": 0.10034678876399994}, {"id": 68, "seek": 26822, "start": 293.22, "end": 296.22, "text": " Simango ni Jesus kadakwada kat kinunanak.", "tokens": [51615, 3998, 17150, 3867, 2705, 8064, 514, 86, 1538, 16536, 15784, 409, 282, 514, 13, 51765], "temperature": 0.0, "avg_logprob": -0.2276381695364404, "compression_ratio": 1.6507936507936507, "no_speech_prob": 0.10034678876399994}, {"id": 69, "seek": 29622, "start": 296.22, "end": 303.22, "text": " Saan ang makapagbaling nga adalak, ti siya sino man nga umay kanyak?", "tokens": [50365, 6299, 282, 2562, 963, 569, 559, 2645, 278, 297, 3680, 614, 304, 514, 11, 8757, 1511, 3016, 18108, 587, 297, 3680, 1105, 320, 350, 1325, 514, 30, 50715], "temperature": 0.0, "avg_logprob": -0.1853698343038559, "compression_ratio": 1.883435582822086, "no_speech_prob": 0.0703108161687851}, {"id": 70, "seek": 29622, "start": 303.22, "end": 311.22, "text": " Malaksid, no dakdakkel ti panagayat na kanyak, ngam ti panagayat na, kadagiti na ganak ken kuwana.", "tokens": [50715, 5746, 5461, 327, 11, 572, 25329, 67, 514, 7124, 8757, 2462, 559, 320, 267, 1667, 350, 1325, 514, 11, 6415, 335, 8757, 2462, 559, 320, 267, 1667, 11, 8064, 559, 8707, 1667, 7574, 514, 18787, 17807, 86, 2095, 13, 51115], "temperature": 0.0, "avg_logprob": -0.1853698343038559, "compression_ratio": 1.883435582822086, "no_speech_prob": 0.0703108161687851}, {"id": 71, "seek": 29622, "start": 311.22, "end": 314.22, "text": " Ti asawa na, ken dagiti anak na.", "tokens": [51115, 20456, 382, 10449, 1667, 11, 18787, 15460, 8707, 38042, 1667, 13, 51265], "temperature": 0.0, "avg_logprob": -0.1853698343038559, "compression_ratio": 1.883435582822086, "no_speech_prob": 0.0703108161687851}, {"id": 72, "seek": 29622, "start": 314.22, "end": 319.22, "text": " Dagiti kakabsat na, ken uray ti bagina met laeng.", "tokens": [51265, 41866, 8707, 350, 514, 17243, 267, 1667, 11, 18787, 344, 3458, 8757, 3411, 1426, 1131, 635, 1501, 13, 51515], "temperature": 0.0, "avg_logprob": -0.1853698343038559, "compression_ratio": 1.883435582822086, "no_speech_prob": 0.0703108161687851}, {"id": 73, "seek": 29622, "start": 319.22, "end": 324.22, "text": " Saan met ang makapagbaling nga adalak, ti siya sino man?", "tokens": [51515, 6299, 282, 1131, 2562, 963, 569, 559, 2645, 278, 297, 3680, 614, 304, 514, 11, 8757, 1511, 3016, 18108, 587, 30, 51765], "temperature": 0.0, "avg_logprob": -0.1853698343038559, "compression_ratio": 1.883435582822086, "no_speech_prob": 0.0703108161687851}, {"id": 74, "seek": 32422, "start": 324.22, "end": 329.22, "text": " Adi mang baklay iti krus na, ken sumurot kanyak.", "tokens": [50365, 1999, 72, 32432, 5657, 8376, 309, 72, 350, 13783, 1667, 11, 18787, 2408, 374, 310, 350, 1325, 514, 13, 50615], "temperature": 0.0, "avg_logprob": -0.2084077790726063, "compression_ratio": 1.8073394495412844, "no_speech_prob": 0.03843569755554199}, {"id": 75, "seek": 32422, "start": 329.22, "end": 333.22, "text": " Numaysa kadakayo, ti agpanggap amang bangon iti torre.", "tokens": [50615, 22592, 3772, 64, 8064, 514, 48947, 11, 8757, 623, 79, 656, 70, 569, 669, 656, 8550, 266, 309, 72, 3930, 265, 13, 50815], "temperature": 0.0, "avg_logprob": -0.2084077790726063, "compression_ratio": 1.8073394495412844, "no_speech_prob": 0.03843569755554199}, {"id": 76, "seek": 32422, "start": 333.22, "end": 339.22, "text": " Saan aya, nga agtugaw nga umuna, tap no panunuten na ti magastunan to?", "tokens": [50815, 6299, 282, 257, 3016, 11, 297, 3680, 623, 83, 697, 1607, 297, 3680, 1105, 5051, 11, 5119, 572, 2462, 409, 7886, 1667, 8757, 2258, 525, 409, 282, 281, 30, 51115], "temperature": 0.0, "avg_logprob": -0.2084077790726063, "compression_ratio": 1.8073394495412844, "no_speech_prob": 0.03843569755554199}, {"id": 77, "seek": 32422, "start": 339.22, "end": 342.22, "text": " No at damakaanay akwartana apang lepas na?", "tokens": [51115, 883, 412, 2422, 7849, 282, 320, 9308, 29587, 2095, 1882, 656, 476, 20990, 1667, 30, 51265], "temperature": 0.0, "avg_logprob": -0.2084077790726063, "compression_ratio": 1.8073394495412844, "no_speech_prob": 0.03843569755554199}, {"id": 78, "seek": 32422, "start": 342.22, "end": 344.22, "text": " No saan?", "tokens": [51265, 883, 601, 282, 30, 51365], "temperature": 0.0, "avg_logprob": -0.2084077790726063, "compression_ratio": 1.8073394495412844, "no_speech_prob": 0.03843569755554199}, {"id": 79, "seek": 32422, "start": 344.22, "end": 350.22, "text": " Di nanto maituloy ti torre kalpasan ti panangikabil na iti fundasyon.", "tokens": [51365, 8789, 297, 5857, 463, 270, 425, 939, 8757, 3930, 265, 7788, 20990, 282, 8757, 2462, 656, 1035, 5177, 1667, 309, 72, 2374, 5871, 266, 13, 51665], "temperature": 0.0, "avg_logprob": -0.2084077790726063, "compression_ratio": 1.8073394495412844, "no_speech_prob": 0.03843569755554199}, {"id": 80, "seek": 32422, "start": 350.22, "end": 352.22, "text": " Ang angawento dagiti amin, amakakita iti inrubo.", "tokens": [51665, 4521, 2562, 1607, 15467, 15460, 8707, 669, 259, 11, 669, 514, 514, 2786, 309, 72, 294, 81, 836, 78, 13, 51765], "temperature": 0.0, "avg_logprob": -0.2084077790726063, "compression_ratio": 1.8073394495412844, "no_speech_prob": 0.03843569755554199}, {"id": 81, "seek": 32422, "start": 352.22, "end": 353.22, "text": " Ang angawento dagiti amin, amakakita iti inrubo.", "tokens": [51765, 4521, 2562, 1607, 15467, 15460, 8707, 669, 259, 11, 669, 514, 514, 2786, 309, 72, 294, 81, 836, 78, 13, 51815], "temperature": 0.0, "avg_logprob": -0.2084077790726063, "compressi