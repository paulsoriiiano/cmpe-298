51565, 6299, 282, 268, 10889, 2502, 569, 70, 345, 13, 51715], "temperature": 0.0, "avg_logprob": -0.22395468758536385, "compression_ratio": 1.614213197969543, "no_speech_prob": 0.02859155274927616}, {"id": 100, "seek": 38222, "start": 409.22, "end": 411.22, "text": " Awanen ti maisirbi na iti daga.", "tokens": [51715, 6381, 282, 268, 8757, 2420, 347, 5614, 1667, 309, 72, 274, 9286, 13, 51815], "temperature": 0.0, "avg_logprob": -0.22395468758536385, "compression_ratio": 1.614213197969543, "no_speech_prob": 0.02859155274927616}, {"id": 101, "seek": 41122, "start": 411.22, "end": 414.22, "text": " Wen no iti pagibuntunan iti rugit ti animal.", "tokens": [50365, 23716, 572, 309, 72, 11812, 897, 2760, 409, 282, 309, 72, 18329, 270, 8757, 5496, 13, 50515], "temperature": 0.0, "avg_logprob": -0.26858110247917893, "compression_ratio": 1.1938775510204083, "no_speech_prob": 0.11518201231956482}, {"id": 102, "seek": 41122, "start": 414.22, "end": 418.22, "text": " Ket iti kasta may baleng.", "tokens": [50515, 591, 302, 309, 72, 350, 12468, 815, 3119, 1501, 13, 50715], "temperature": 0.0, "avg_logprob": -0.26858110247917893, "compression_ratio": 1.1938775510204083, "no_speech_prob": 0.11518201231956482}, {"id": 103, "seek": 41122, "start": 418.22, "end": 420.22, "text": " Dumngeg kayo nga rod.", "tokens": [50715, 29572, 872, 1146, 12446, 78, 297, 3680, 8685, 13, 50815], "temperature": 0.0, "avg_logprob": -0.26858110247917893, "compression_ratio": 1.1938775510204083, "no_speech_prob": 0.11518201231956482}, {"id": 104, "seek": 41122, "start": 420.22, "end": 422.22, "text": " No ada panna kaawat iyo.", "tokens": [50815, 883, 11063, 280, 1795, 6799, 38036, 741, 8308, 13, 50915], "temperature": 0.0, "avg_logprob": -0.26858110247917893, "compression_ratio": 1.1938775510204083, "no_speech_prob": 0.11518201231956482}], "language": "Tagalog"}