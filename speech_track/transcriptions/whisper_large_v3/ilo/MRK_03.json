10, "start": 279.28000000000003, "end": 281.46000000000004, "text": " Tapno italaw na dagiti sa nikwana.", "tokens": [51174, 13445, 1771, 309, 304, 1607, 1667, 15460, 8707, 601, 44336, 86, 2095, 13, 51283], "temperature": 0.0, "avg_logprob": -0.3113275543461001, "compression_ratio": 1.6022727272727273, "no_speech_prob": 0.039378710091114044}, {"id": 73, "seek": 26310, "start": 282.68, "end": 285.28000000000003, "text": " Repeten na painga umuna tinapig sa atao.", "tokens": [51344, 3696, 19865, 1667, 2502, 41705, 1105, 5051, 15935, 569, 328, 601, 48639, 78, 13, 51474], "temperature": 0.0, "avg_logprob": -0.3113275543461001, "compression_ratio": 1.6022727272727273, "no_speech_prob": 0.039378710091114044}, {"id": 74, "seek": 26310, "start": 286.02000000000004, "end": 288.56, "text": " Santo ag samsam itiuneg tibalay.", "tokens": [51511, 49639, 623, 3247, 19988, 309, 72, 409, 1146, 256, 34764, 320, 13, 51638], "temperature": 0.0, "avg_logprob": -0.3113275543461001, "compression_ratio": 1.6022727272727273, "no_speech_prob": 0.039378710091114044}, {"id": 75, "seek": 26310, "start": 289.62, "end": 290.54, "text": " Laglagipin niyo,", "tokens": [51691, 24886, 27298, 647, 259, 3867, 8308, 11, 51737], "temperature": 0.0, "avg_logprob": -0.3113275543461001, "compression_ratio": 1.6022727272727273, "no_speech_prob": 0.039378710091114044}, {"id": 76, "seek": 29054, "start": 290.54, "end": 294.1, "text": " Amapakawan amin abasol dagiti tattao", "tokens": [50365, 2012, 569, 514, 41814, 669, 259, 410, 296, 401, 15460, 8707, 9600, 1328, 78, 50543], "temperature": 0.0, "avg_logprob": -0.26361233255137567, "compression_ratio": 1.5958549222797926, "no_speech_prob": 0.0066945538856089115}, {"id": 77, "seek": 29054, "start": 294.1, "end": 298.44, "text": " kan amin nga isasauda amaibusur iti Diyos.", "tokens": [50543, 4608, 669, 259, 297, 3680, 307, 9994, 11152, 10889, 897, 301, 374, 309, 72, 413, 4727, 329, 13, 50760], "temperature": 0.0, "avg_logprob": -0.26361233255137567, "compressio