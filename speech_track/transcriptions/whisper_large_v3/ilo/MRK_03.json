5, "compression_ratio": 1.7121212121212122, "no_speech_prob": 0.0023579495027661324}, {"id": 39, "seek": 14506, "start": 157.8, "end": 165.5, "text": " Ibaon kayong tupay amapan mga skasaba, ket maikkan kayo itipan na kabalin amang paksyat kadagiti dimonyo.", "tokens": [51002, 286, 4231, 266, 12446, 556, 256, 1010, 320, 669, 3140, 275, 3680, 1110, 296, 5509, 11, 14979, 463, 1035, 5225, 12446, 78, 309, 647, 282, 1667, 27835, 24861, 669, 656, 280, 5461, 88, 267, 8064, 559, 8707, 5013, 2526, 78, 13, 51387], "temperature": 0.0, "avg_logprob": -0.2165280074524365, "compression_ratio": 1.7121212121212122, "no_speech_prob": 0.0023579495027661324}, {"id": 40, "seek": 14506, "start": 166.22, "end": 168.92000000000002, "text": " Dagitoy dagitisangapulo ket dwa apinili na.", "tokens": [51423, 41866, 270, 939, 15460, 16074, 656, 569, 13455, 14979, 35045, 1882, 259, 2312, 1667, 13, 51558], "temperature": 0.0, "avg_logprob": -0.2165280074524365, "compression_ratio": 1.7121212121212122, "no_speech_prob": 0.0023579495027661324}, {"id": 41, "seek": 14506, "start": 169.7, "end": 172.92000000000002, "text": " Ni Simon apinanaganan na itipedro.", "tokens": [51597, 12370, 13193, 1882, 259, 282, 14167, 282, 1667, 309, 647, 292, 340, 13, 51758], "temperature": 0.0, "avg_logprob": -0.2165280074524365, "compression_ratio": 1.7121212121212122, "no_speech_prob": 0.0023579495027661324}, {"id": 42, "seek": 14506, "start": 173.26, "end": 174.92000000000002, "text": " Da Santiago kenkwana.", "tokens": [51775, 3933, 37621, 18787, 74, 86, 2095, 13, 51858], "temperature": 0.0, "avg_logprob": -0.2165280074524365, "compression_ratio": 1.7121212121212122, "no_speech_prob": 0.0023579495027661324}, {"id": 43, "seek": 17506, "start": 175.06, "end": 176.7, "text": " Ibaon nga anak ni Zebedio.", "tokens": [50365, 286, 4231, 266, 297, 3680, 38042, 3867, 4853, 2883, 1004, 13, 50447], "temperature": 0.0, "avg_logprob": -0.29477095970740685, "compression_ratio": 1.4567307692307692, "no_speech_prob": 0.005242988