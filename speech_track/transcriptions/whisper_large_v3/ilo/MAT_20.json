ion_ratio": 1.625, "no_speech_prob": 0.020049579441547394}, {"id": 94, "seek": 29868, "start": 307.34000000000003, "end": 311.32, "text": " kanyawat natibiyag na apangsubot kadagiti ado at at tao.", "tokens": [50798, 350, 1325, 38036, 2249, 897, 4727, 559, 1667, 1882, 656, 30131, 310, 8064, 559, 8707, 22450, 412, 412, 44292, 13, 50997], "temperature": 0.0, "avg_logprob": -0.31999075090562973, "compression_ratio": 1.625, "no_speech_prob": 0.020049579441547394}, {"id": 95, "seek": 29868, "start": 312.92, "end": 317.04, "text": " Idi pumanaw ni Jesus kandagiti adalan na iji Heriko,", "tokens": [51077, 40187, 280, 6829, 1607, 3867, 2705, 350, 474, 559, 8707, 614, 14163, 1667, 741, 4013, 3204, 10770, 11, 51283], "temperature": 0.0, "avg_logprob": -0.31999075090562973, "compression_ratio": 1.625, "no_speech_prob": 0.020049579441547394}, {"id": 96, "seek": 29868, "start": 317.62, "end": 319.86, "text": " na kad ado at at tao ti simurot,", "tokens": [51312, 1667, 8064, 22450, 412, 412, 44292, 8757, 1034, 374, 310, 11, 51424], "temperature": 0.0, "avg_logprob": -0.31999075090562973, "compression_ratio": 1.625, "no_speech_prob": 0.020049579441547394}, {"id": 97, "seek": 29868, "start": 320.52, "end": 324.3, "text": " at da dua bulsek alalaking agtugtugaw itiigit tidalan,", "tokens": [51457, 412, 1120, 40173, 6493, 26141, 419, 304, 2456, 623, 83, 697, 83, 697, 1607, 309, 72, 328, 270, 9422, 14163, 11, 51646], "temperature": 0.0, "avg_logprob": -0.31999075090562973, "compression_ratio": 1.625, "no_speech_prob": 0.020049579441547394}, {"id": 98, "seek": 29868, "start": 324.98, "end": 327.26, "text": " apaman ang nanggagdaa lumabas ni Jesus,", "tokens": [51680, 1882, 6147, 2562, 297, 656, 70, 559, 2675, 64, 24635, 455, 296, 3867, 2705, 11, 51794], "temperature": 0.0, "avg_logprob": -0.31999075090562973, "compression_ratio": 1.625, "no_speech_prob": 0.020049579441547394}, {"id": 99, "seek": 29868, "start": 327.8, "end": 328.66, "text": " impukaw dan,", "tokens": [51821, 704, 2034,