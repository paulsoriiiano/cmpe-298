 154.58, "end": 155.5, "text": " Umapal kakadi.", "tokens": [50594, 3301, 569, 304, 350, 514, 5688, 13, 50640], "temperature": 0.0, "avg_logprob": -0.38372388093367865, "compression_ratio": 1.5463917525773196, "no_speech_prob": 0.029656503349542618}, {"id": 42, "seek": 15000, "start": 155.86, "end": 157.52, "text": " Agsipod tanaparaburak.", "tokens": [50658, 2725, 82, 647, 378, 7603, 569, 289, 455, 374, 514, 13, 50741], "temperature": 0.0, "avg_logprob": -0.38372388093367865, "compression_ratio": 1.5463917525773196, "no_speech_prob": 0.029656503349542618}, {"id": 43, "seek": 15000, "start": 158.92, "end": 160.24, "text": " Ingibus ni Jesus.", "tokens": [50811, 25731, 897, 301, 3867, 2705, 13, 50877], "temperature": 0.0, "avg_logprob": -0.38372388093367865, "compression_ratio": 1.5463917525773196, "no_speech_prob": 0.029656503349542618}, {"id": 44, "seek": 15000, "start": 160.8, "end": 161.26, "text": " Ngarod.", "tokens": [50905, 426, 2976, 378, 13, 50928], "temperature": 0.0, "avg_logprob": -0.38372388093367865, "compression_ratio": 1.5463917525773196, "no_speech_prob": 0.029656503349542618}, {"id": 45, "seek": 15000, "start": 161.94, "end": 163.36, "text": " Umunan to dagiti maudi.", "tokens": [50962, 3301, 409, 282, 281, 15460, 8707, 463, 26000, 13, 51033], "temperature": 0.0, "avg_logprob": -0.38372388093367865, "compression_ratio": 1.5463917525773196, "no_speech_prob": 0.029656503349542618}, {"id": 46, "seek": 15000, "start": 164.18, "end": 166.28, "text": " Ket mauding to dagiti umuna.", "tokens": [51074, 591, 302, 463, 33703, 281, 15460, 8707, 1105, 5051, 13, 51179], "temperature": 0.0, "avg_logprob": -0.38372388093367865, "compression_ratio": 1.5463917525773196, "no_speech_prob": 0.029656503349542618}, {"id": 47, "seek": 15000, "start": 168.34, "end": 171.02, "text": " Idisumangsang at ni Jesus ije Jerusalem,", "tokens": [51282, 11506, 271, 449, 28686, 656, 412, 3867, 2705, 741, 2884, 15393, 11, 51416], "temperature": 0.0, "avg_logprob": -0.38372388093367865, "compression_ratio": 1.5463917525773196, "no_speech_prob": 0.029656503349542618}, {"id": 48, "seek": 15000, "start": 171.7, "end": 174.68, "text": " inyadayuna dagiti sang apulokit duwang adalan", "tokens": [51450, 294, 88, 345, 320, 5051, 15460, 8707, 9980, 1882, 425, 453, 270, 1581, 19031, 614, 14163, 51599], "temperature": 0.0, "avg_logprob": -0.38372388093367865, "compression_ratio": 1.5463917525773196, "no_speech_prob": 0.029656503349542618}, {"id": 49, "seek": 15000, "start": 174.68, "end": 178.12, "text": " kit kinasaritan na ita bayat tipan nagnada.", "tokens": [51599, 8260, 15784, 296, 289, 9670, 1667, 309, 64, 13642, 267, 4125, 282, 297, 4535, 1538, 13, 51771], "temperature": 0.0, "avg_logprob": -0.38372388093367865, "compression_ratio": 1.5463917525773196, "no_speech_prob": 0.029656503349542618}, {"id": 50, "seek": 15000, "start": 178.12, "end": 179.92000000000002, "text": " Kinunana kadakwada.", "tokens": [51771, 27950, 409, 2095, 8064, 514, 86, 1538, 13, 51861], "temperature": 0.0, "avg_logprob": -0.38372388093367865, "compression_ratio": 1.5463917525773196, "no_speech_prob": 0.029656503349542618}, {"id": 51, "seek": 18000, "start": 180.0, "end": 184.34, "text": " Deng ganyo, sumangat tayo ije Jerusalem,", "tokens": [50365, 413, 1501, 290, 1325, 78, 11, 2408, 656, 267, 39224, 78, 741, 2884, 15393, 11, 50582], "temperature": 0.0, "avg_logprob": -0.34178629055829113, "compression_ratio": 1.6261682242990654, "no_speech_prob": 0.499944269657135}, {"id": 52, "seek": 18000, "start": 184.94, "end": 189.04, "text": " ket mayawat to sa djay ti anak ti tao kadagiti panguluen apapadi", "tokens": [50612, 14979, 815, 38036, 281, 601, 274, 46451, 8757, 38042, 8757, 44292, 8064, 559, 8707, 280, 656, 425, 7801, 1882, 569, 5688, 50817], "temperature": 0.0, "avg_logprob": -0.34178629055829113, "compression_ratio": 1.6261682242990654, "no_speech_prob": 0.499944269657135}, {"id": 53, "seek": 18000, "start": 189.04, "end": 191.9, "text": " ken kadagiti mamaestro iti linteg.", "tokens": [50817, 18787, 8064, 559, 8707, 18775, 32389, 309, 72, 287, 686, 1146, 13, 50960], "temperature": 0.0, "avg_logprob": -0.34178629055829113, "compression_ratio": 1.6261682242990654, "no_speech_prob": 0.499944269657135}, {"id": 54, "seek": 18000, "start": 192.98, "end": 197.64, "text": " Ikat deng danto amapapatay sa danto yawat kadagiti hintil amangang angaw.", "tokens": [51014, 8316, 267, 1441, 70, 274, 5857, 669, 569, 22602, 320, 601, 274, 5857, 288, 38036, 8064, 559, 8707, 12075, 388, 669, 656, 656, 2562, 1607, 13, 51247], "temperature": 0.0, "avg_logprob": -0.34178629055829113, "compression_ratio": 1.6261682242990654, "no_speech_prob": 0.499944269657135}, {"id": 55, "seek": 18000, "start": 198.5, "end": 202.16, "text": " Mang sapsaplit, ken manglilan sa ken kwana iti krus.", "tokens": [51290, 35487, 262, 2382, 64, 564, 270, 11, 18787, 587, 7191, 21752, 601, 18787, 23846, 2095, 309, 72, 350, 13783, 13, 51473], "temperature": 0.0, "avg_logprob": -0.34178629055829113, "compression_ratio": 1.6261682242990654, "no_speech_prob": 0.499944269657135}, {"id": 56, "seek": 18000, "start": 203.0, "end": 206.46, "text": " Ngem, mapagungar to iti maikatlongal daw.", "tokens": [51515, 21198, 443, 11, 4471, 559, 1063, 289, 281, 309, 72, 463, 36300, 13025, 304, 43438, 13, 51688], "temperature": 0.0, "avg_logprob": -0.34178629055829113, "compression_ratio": 1.6261682242990654, "no_speech_prob": 0.499944269657135}, {"id": 57, "seek": 18000, "start": 206.66, "end": 209.46, "text": " Ima si Degnesus iti asawa ni Sebedeus.", "tokens": [51698, 286, 1696, 1511, 413, 1146, 4081, 301, 309, 72, 382, 10449, 3867, 1100, 2883, 68, 301, 13, 51838], "temperature": 0.0, "avg_logprob": -0.34178629055829113, "compression_ratio": 1.6261682242990654, "no_speech_prob": 0.499944269657135}, {"id": 58, "seek": 21000, "start": 210.0, "end": 212.74, "text": " Diyo, agraman dagiti anak na alalaki,", "tokens": [50365, 413, 4727, 78, 11, 623, 2356, 282, 15460, 8707, 38042, 1667, 419, 304, 7421, 11, 50502], "temperature": 0.0, "avg_logprob": -0.36017302143780483, "compression_ratio": 1.7022222222222223, "no_speech_prob": 0.0366961769759655}, {"id": 59, "seek": 21000, "start": 213.26, "end": 217.34, "text": " nagparintomong itisangwanan na kit nagdawat kin kwana.", "tokens": [50528, 17096, 2181, 686, 298, 556, 309, 271, 656, 7916, 282, 1667, 8260, 17096, 67, 38036, 15784, 23846, 2095, 13, 50732], "temperature": 0.0, "avg_logprob": -0.36017302143780483, "compression_ratio": 1.7022222222222223, "no_speech_prob": 0.0366961769759655}, {"id": 60, "seek": 21000, "start": 217.98, "end": 218.98, "text": " Anya ti kayat mo?", "tokens": [50764, 2639, 64, 8757, 12446, 267, 705, 30, 50814], "temperature": 0.0, "avg_logprob": -0.36017302143780483, "compression_ratio": 1.7022222222222223, "no_speech_prob": 0.0366961769759655}, {"id": 61, "seek": 21000, "start": 219.78, "end": 221.0, "text": " Sinaludsod ni Jesus.", "tokens": [50854, 318, 2071, 32083, 378, 3867, 2705, 13, 50915], "temperature": 0.0, "avg_logprob": -0.36017302143780483, "compression_ratio": 1.7022222222222223, "no_speech_prob": 0.0366961769759655}, {"id": 62, "seek": 21000, "start": 222.02, "end": 223.22, "text": " Simong bat ti ina?", "tokens": [50966, 3998, 556, 7362, 8757, 294, 64, 30, 51026], "temperature": 0.0, "avg_logprob": -0.36017302143780483, "compression_ratio": 1.7022222222222223, "no_speech_prob": 0.0366961769759655}, {"id": 63, "seek": 21000, "start": 223.94, "end": 225.96, "text": " Palubos mo kumangain to nagari ka,", "tokens": [51062, 6116, 836, 329, 705, 350, 449, 656, 491, 281, 17096, 3504, 6799, 11, 51163], "temperature": 0.0, "avg_logprob": -0.36017302143780483, "compression_ratio": 1.7022222222222223, "no_speech_prob": 0.0366961769759655}, {"id": 64, "seek": 21000, "start": 226.36, "end": 228.92000000000002, "text": " makitugato kin ka dagit tuidwa nga anak ko,", "tokens": [51183, 963, 270, 697, 2513, 15784, 6799, 15460, 270, 2604, 327, 4151, 297, 3680, 38042, 8384, 11, 51311], "temperature": 0.0, "avg_logprob": -0.36017302143780483, "compression_ratio": 1.7022222222222223, "no_speech_prob": 0.0366961769759655}, {"id": 65, "seek": 21000, "start": 229.36, "end": 230.98, "text": " timaysa iti makanawan mo,", "tokens": [51333, 524, 3772, 64, 309, 72, 963, 282, 41814, 705, 11, 51414], "temperature": 0.0, "avg_logprob": -0.36017302143780483, "compression_ratio": 1.7022222222222223, "no_speech_prob": 0.0366961769759655}, {"id": 66, "seek": 21000, "start": 231.22, "end": 233.02, "text": " kit tisabali iti makanigid mo.", "tokens": [51426, 8260, 256, 271, 455, 5103, 309, 72, 963, 282, 328, 327, 705, 13, 51516], "temperature": 0.0, "avg_logprob": -0.36017302143780483, "compression_ratio": 1.7022222222222223, "no_speech_prob": 0.0366961769759655}, {"id": 67, "seek": 21000, "start": 233.86, "end": 235.62, "text": " Diyo amot, itaw dawatin niyo.", "tokens": [51558, 413, 4727, 78, 669, 310, 11, 309, 1607, 43438, 22685, 3867, 8308, 13, 51646], "temperature": 0.0, "avg_logprob": -0.36017302143780483, "compression_ratio": 1.7022222222222223, "no_speech_prob": 0.0366961769759655}, {"id": 68, "seek": 21000, "start": 236.38, "end": 238.76, "text": " Kinunana ni Jesus kadagiti agkabsat.", "tokens": [51684, 27950, 409, 2095, 3867, 2705, 8064, 559, 8707, 623, 74, 17243, 267, 13, 51803], "temperature": 0.0, "avg_logprob": -0.36017302143780483, "compression_ratio": 1.7022222222222223, "no_speech_prob": 0.0366961769759655}, {"id": 69, "seek": 21000, "start": 239.12, "end": 239.84, "text": " Kabailan niya.", "tokens": [51821, 25848, 864, 282, 3867, 3016, 13, 51857], "temperature": 0.0, "avg_logprob": -0.36017302143780483, "compression_ratio": 1.7022222222222223, "no_speech_prob": 0.0366961769759655}, {"id": 70, "seek": 21000, "start": 239.84, "end": 239.86, "text": " Kabailan niya.", "tokens": [51857, 25848, 864, 282, 3867, 3016, 13, 51858], "temperature": 0.0, "avg_logprob": -0.36017302143780483, "compression_ratio": 1.7022222222222223, "no_speech_prob": 0.0366961769759655}, {"id": 71, "seek": 23986, "start": 239.86, "end": 242.48000000000002, "text": " Kailan niyo kadinga uminom iti kopa apag inumak?", "tokens": [50365, 591, 864, 282, 3867, 8308, 350, 8166, 64, 1105, 259, 298, 309, 72, 28920, 64, 1882, 559, 294, 449, 514, 30, 50496], "temperature": 0.0, "avg_logprob": -0.34191109999170843, "compression_ratio": 1.6650943396226414, "no_speech_prob": 0.029503822326660156}, {"id": 72, "seek": 23986, "start": 243.22000000000003, "end": 245.0, "text": " Win! Kabailan mi!", "tokens": [50533, 10427, 0, 25848, 864, 282, 2752, 0, 50622], "temperature": 0.0, "avg_logprob": -0.34191109999170843, "compression_ratio": 1.6650943396226414, "no_speech_prob": 0.029503822326660156}, {"id": 73, "seek": 23986, "start": 245.74, "end": 246.70000000000002, "text": " Insong batda.", "tokens": [50659, 9442, 556, 7362, 2675, 13, 50707], "temperature": 0.0, "avg_logprob": -0.34191109999170843, "compression_ratio": 1.6650943396226414, "no_speech_prob": 0.029503822326660156}, {"id": 74, "seek": 23986, "start": 247.48000000000002, "end": 250.20000000000002, "text": " Agpaysonga uminom kayo iti kopa apag inumak?", "tokens": [50746, 2725, 79, 3772, 556, 64, 1105, 259, 298, 12446, 78, 309, 72, 28920, 64, 1882, 559, 294, 449, 514, 30, 50882], "temperature": 0.0, "avg_logprob": -0.34191109999170843, "compression_ratio": 1.6650943396226414, "no_speech_prob": 0.029503822326660156}, {"id": 75, "seek": 23986, "start": 250.92000000000002, "end": 251.9, "text": " Kinunana ni Jesus.", "tokens": [50918, 27950, 409, 2095, 3867, 2705, 13, 50967], "temperature": 0.0, "avg_logprob": -0.34191109999170843, "compression_ratio": 1.6650943396226414, "no_speech_prob": 0.029503822326660156}, {"id": 76, "seek": 23986, "start": 252.96, "end": 255.36, "text": " Ngem, awan ti karbangak amang pili,", "tokens": [51020, 21198, 443, 11, 1714, 282, 8757, 7917, 20106, 514, 669, 656, 280, 2312, 11, 51140], "temperature": 0.0, "avg_logprob": -0.34191109999170843, "compression_ratio": 1.6650943396226414, "no_speech_prob": 0.029503822326660156}, {"id": 77, "seek": 23986, "start": 255.88000000000002, "end": 259.38, "text": " no siya sinuntiti agtugaw iti makanawan kanmakanigid ko.", "tokens": [51166, 572, 1511, 3016, 3343, 2760, 8707, 623, 83, 697, 1607, 309, 72, 963, 282, 41814, 4608, 8520, 282, 328, 327, 8384, 13, 51341], "temperature": 0.0, "avg_logprob": -0.34191109999170843, "compression_ratio": 1.6650943396226414, "no_speech_prob": 0.029503822326660156}, {"id": 78, "seek": 23986, "start": 260.74, "end": 264.40000000000003, "text": " Maitad dagit uy apag saadan kadagiti nang isaganaan ni amak.", "tokens": [51409, 376, 1001, 345, 15460, 270, 344, 88, 1882, 559, 601, 11338, 8064, 559, 8707, 297, 656, 307, 559, 2095, 282, 3867, 669, 514, 13, 51592], "temperature": 0.0, "avg_logprob": -0.34191109999170843, "compression_ratio": 1.6650943396226414, "no_speech_prob": 0.029503822326660156}, {"id": 79, "seek": 23986, "start": 265.16, "end": 268.84000000000003, "text": " Idi manggag daytoy dagit isang apulo akadwa ng adalan,", "tokens": [51630, 40187, 587, 1615, 559, 786, 83, 939, 15460, 270, 307, 656, 1882, 13455, 9308, 345, 4151, 6415, 614, 14163, 11, 51814], "temperature": 0.0, "avg_logprob": -0.34191109999170843, "compression_ratio": 1.6650943396226414, "no_speech_prob": 0.029503822326660156}, {"id": 80, "seek": 26884, "start": 268.84, "end": 271.67999999999995, "text": " na kapungtot da kadagiti agkabsat.", "tokens": [50365, 1667, 13816, 1063, 83, 310, 1120, 8064, 559, 8707, 623, 74, 17243, 267, 13, 50507], "temperature": 0.0, "avg_logprob": -0.27478982160191334, "compression_ratio": 1.7095238095238094, "no_speech_prob": 0.06772179901599884}, {"id": 81, "seek": 26884, "start": 272.2, "end": 276.21999999999997, "text": " Itikasta, inayaban amin idan ni Jesus kit kinunana.", "tokens": [50533, 467, 1035, 12468, 11, 294, 320, 18165, 669, 259, 4496, 282, 3867, 2705, 8260, 15784, 409, 2095, 13, 50734], "temperature": 0.0, "avg_logprob": -0.27478982160191334, "compression_ratio": 1.7095238095238094, "no_speech_prob": 0.06772179901599884}, {"id": 82, "seek": 26884, "start": 276.71999999999997, "end": 278.82, "text": " Pagkaamuyo akadagiti hentil,", "tokens": [50759, 430, 559, 2330, 335, 7493, 78, 9308, 345, 559, 8707, 276, 317, 388, 11, 50864], "temperature": 0.0, "avg_logprob": -0.27478982160191334, "compression_ratio": 1.7095238095238094, "no_speech_prob": 0.06772179901599884}, {"id": 83, "seek": 26884, "start": 279.9, "end": 280.9, "text": " dagiti agturay,", "tokens": [50918, 15460, 8707, 623, 24906, 320, 11, 50968], "temperature": 0.0, "avg_logprob": -0.27478982160191334, "compression_ratio": 1.7095238095238094, "no_speech_prob": 0.06772179901599884}, {"id": 84, "seek": 26884, "start": 281.23999999999995, "end": 284.44, "text": " at daan da itidakkal apan nakabalin kadagiti tattao da.", "tokens": [50985, 412, 1120, 282, 1120, 309, 327, 514, 19990, 1882, 282, 20332, 455, 24861, 8064, 559, 8707, 9600, 1328, 78, 1120, 13, 51145], "temperature": 0.0, "avg_logprob": -0.27478982160191334, "compression_ratio": 1.7095238095238094, "no_speech_prob": 0.06772179901599884}, {"id": 85, "seek": 26884, "start": 285.78, "end": 287.76, "text": " Saan to kumaakasta ti aramidin niyo?", "tokens": [51212, 6299, 282, 281, 350, 5544, 514, 12468, 8757, 594, 335, 327, 259, 3867, 8308, 30, 51311], "temperature": 0.0, "avg_logprob": -0.27478982160191334, "compression_ratio": 1.7095238095238094, "no_speech_prob": 0.06772179901599884}, {"id": 86, "seek": 26884, "start": 288.62, "end": 290.34, "text": " Tiagtarigagay nga agpangulo,", "tokens": [51354, 20456, 7665, 289, 328, 559, 320, 297, 3680, 623, 79, 656, 13455, 11, 51440], "temperature": 0.0, "avg_logprob": -0.27478982160191334, "compression_ratio": 1.7095238095238094, "no_speech_prob": 0.06772179901599884}, {"id": 87, "seek": 26884, "start": 290.96, "end": 293.02, "text": " masapol nga agsirbika da kayo amin.", "tokens": [51471, 2300, 569, 401, 297, 3680, 623, 82, 347, 65, 5439, 1120, 12446, 78, 