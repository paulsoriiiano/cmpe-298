], "temperature": 0.0, "avg_logprob": -0.37138057890392484, "compression_ratio": 2.010989010989011, "no_speech_prob": 0.010116860270500183}, {"id": 106, "seek": 32868, "start": 347.68, "end": 349.88, "text": " inayaban na ida kit sinalutsod na.", "tokens": [51315, 294, 320, 18165, 1667, 220, 2887, 8260, 262, 2071, 3648, 378, 1667, 13, 51425], "temperature": 0.0, "avg_logprob": -0.37138057890392484, "compression_ratio": 2.010989010989011, "no_speech_prob": 0.010116860270500183}, {"id": 107, "seek": 32868, "start": 350.56, "end": 352.48, "text": " Anya ti kahit yung aramidag kada kayo?", "tokens": [51459, 2639, 64, 8757, 21651, 270, 288, 1063, 594, 335, 327, 559, 350, 1538, 12446, 78, 30, 51555], "temperature": 0.0, "avg_logprob": -0.37138057890392484, "compression_ratio": 2.010989010989011, "no_speech_prob": 0.010116860270500183}, {"id": 108, "seek": 32868, "start": 353.2, "end": 353.76, "text": " Apo!", "tokens": [51591, 316, 2259, 0, 51619], "temperature": 0.0, "avg_logprob": -0.37138057890392484, "compression_ratio": 2.010989010989011, "no_speech_prob": 0.010116860270500183}, {"id": 109, "seek": 32868, "start": 354.56, "end": 355.16, "text": " Kinunada,", "tokens": [51659, 27950, 409, 1538, 11, 51689], "temperature": 0.0, "avg_logprob": -0.37138057890392484, "compression_ratio": 2.010989010989011, "no_speech_prob": 0.010116860270500183}, {"id": 110, "seek": 32868, "start": 356.06, "end": 357.42, "text": " makakita kami kuma!", "tokens": [51734, 963, 514, 2786, 34502, 350, 5544, 0, 51802], "temperature": 0.0, "avg_logprob": -0.37138057890392484, "compression_ratio": 2.010989010989011, "no_speech_prob": 0.010116860270500183}, {"id": 111, "seek": 32868, "start": 357.42, "end": 357.54, "text": " Nga!", "tokens": [51802, 426, 3680, 0, 51808], "temperature": 0.0, "avg_logprob": -0.37138057890392484, "compression_ratio": 2.010989010989011, "no_speech_prob": 0.010116860270500183}, {"id": 112, "seek": 32868, "start": 357.54, "end": 357.56, "text": " Nga!", "tokens": [51808