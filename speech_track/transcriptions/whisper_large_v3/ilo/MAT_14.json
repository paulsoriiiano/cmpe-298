2, "start": 163.20000000000002, "end": 165.96, "text": " Lima at tinapay kendwa ngay kanlayang tiada.", "tokens": [51244, 50217, 412, 15935, 569, 320, 17016, 4151, 6415, 320, 4608, 8376, 656, 8757, 1538, 13, 51382], "temperature": 0.0, "avg_logprob": -0.31443415821849047, "compression_ratio": 1.6963350785340314, "no_speech_prob": 0.0032692551612854004}, {"id": 37, "seek": 14562, "start": 166.82, "end": 167.56, "text": " Kinunada.", "tokens": [51425, 27950, 409, 1538, 13, 51462], "temperature": 0.0, "avg_logprob": -0.31443415821849047, "compression_ratio": 1.6963350785340314, "no_speech_prob": 0.0032692551612854004}, {"id": 38, "seek": 14562, "start": 168.36, "end": 169.46, "text": " Yegyo ida dito'y.", "tokens": [51502, 835, 1480, 78, 220, 2887, 274, 3528, 6, 88, 13, 51557], "temperature": 0.0, "avg_logprob": -0.31443415821849047, "compression_ratio": 1.6963350785340314, "no_speech_prob": 0.0032692551612854004}, {"id": 39, "seek": 14562, "start": 170.24, "end": 171.4, "text": " Kinunan ni Jesus.", "tokens": [51596, 27950, 409, 282, 3867, 2705, 13, 51654], "temperature": 0.0, "avg_logprob": -0.31443415821849047, "compression_ratio": 1.6963350785340314, "no_speech_prob": 0.0032692551612854004}, {"id": 40, "seek": 14562, "start": 172.06, "end": 174.4, "text": " Pinagtugaw na dagiti tataw itikaruotan.", "tokens": [51687, 22619, 7665, 697, 1607, 1667, 15460, 8707, 9600, 1607, 309, 1035, 16870, 310, 282, 13, 51804], "temperature": 0.0, "avg_logprob": -0.31443415821849047, "compression_ratio": 1.6963350785340314, "no_speech_prob": 0.0032692551612854004}, {"id": 41, "seek": 17562, "start": 175.62, "end": 177.94, "text": " Inalana dagiti tinapay ken ikan.", "tokens": [50365, 682, 304, 2095, 15460, 8707, 15935, 569, 320, 18787, 4320, 282, 13, 50481], "temperature": 0.0, "avg_logprob": -0.2746237885180137, "compression_ratio": 1.745, "no_speech_prob": 0.0632668137550354}, {"id": 42, "seek": 17562, "start": 178.58, "end": 181.82, "text": " Timangad sa dilangit sa nagyaman iti D